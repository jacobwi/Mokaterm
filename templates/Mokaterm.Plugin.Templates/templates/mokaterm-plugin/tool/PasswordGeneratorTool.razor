@using Mokaterm.UI.Common.Platform
@inherits AppToolBase

<div class="password">
	<output class="password-value" aria-label="Generated password" aria-live="polite">@_password</output>
	<span class="password-facts">@Facts</span>
	<div class="password-actions">
		<MokaButton Variant="MokaVariant.Outlined"
					Size="MokaSize.Sm"
					StartIcon="MokaIcons.Action.Refresh"
					OnClick="Generate"
					data-autofocus>
			New password
		</MokaButton>
		<MokaButton Variant="MokaVariant.Outlined"
					Size="MokaSize.Sm"
					StartIcon="MokaIcons.Content.Copy"
					Class="@CopyClick.Class"
					OnClick="CopyAsync">
			Copy
		</MokaButton>
	</div>
</div>
