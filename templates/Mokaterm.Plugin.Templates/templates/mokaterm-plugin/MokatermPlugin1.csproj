<!--#if (kind == "theme") -->
<Project Sdk="Microsoft.NET.Sdk">

	<!--
		A Mokaterm theme pack: terminal themes and no code, so it installs without asking the user to trust anything. Every
		build writes bin/<configuration>/net10.0/<id>-<version>.mokaplugin. A theme can be in any format Mokaterm's theme
		import reads: Windows Terminal, iTerm2, Alacritty, X resources or VS Code.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<Version>1.0.0</Version>
	</PropertyGroup>
<!--#else -->
<Project Sdk="Microsoft.NET.Sdk.Razor">

	<!--
		A Mokaterm plugin. Every build writes bin/<configuration>/net10.0/<id>-<version>.mokaplugin, which the desktop app
		installs from Settings, Plugins, and the web host loads from its plugins folder. Mokaterm.UI.Common and everything it
		brings are the host's at run time, so the package carries this project's own files and nothing else.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<Version>1.0.0</Version>
		<!-- One valid name for the assembly, its namespace and _content/<AssemblyName>/, where Mokaterm serves wwwroot. -->
		<AssemblyName>MokatermPlugin1</AssemblyName>
		<RootNamespace>MokatermPlugin1</RootNamespace>
	</PropertyGroup>
<!--#endif -->

	<!--
		What plugin.json says. The id is lower-case letters and digits joined by dots or dashes; it names the plugin's
		folder and its settings, so it stays the same from release to release. Hosts are desktop, web or both (desktop;web).
	-->
	<PropertyGroup>
		<MokatermPluginId>PLUGIN_ID</MokatermPluginId>
		<MokatermPluginName>MokatermPlugin1</MokatermPluginName>
		<MokatermPluginPublisher>PLUGIN_PUBLISHER</MokatermPluginPublisher>
		<MokatermPluginDescription>PLUGIN_DESCRIPTION</MokatermPluginDescription>
		<MokatermPluginHosts>PLUGIN_HOSTS</MokatermPluginHosts>
		<MokatermPluginPackOnBuild>true</MokatermPluginPackOnBuild>
<!--#if (kind == "theme") -->
		<MokatermPluginDataOnly>true</MokatermPluginDataOnly>
<!--#endif -->
	</PropertyGroup>

<!--#if (kind == "theme") -->
	<!-- Builds the package. Themes need no particular Mokaterm version, so any version of the SDK writes one that loads. -->
	<ItemGroup>
		<PackageReference Include="Mokaterm.Plugin.Sdk" Version="MOKATERM_VERSION" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<MokatermPluginTheme Include="themes/*.json" />
	</ItemGroup>
<!--#else -->
	<!--
		Mokaterm runs a plugin built against the same minor version it is (any 0.2.x for one built against 0.2) while it
		is on 0.x, and from 1.0 the same major version. Move both references together when Mokaterm moves on.
	-->
	<ItemGroup>
		<PackageReference Include="Mokaterm.UI.Common" Version="MOKATERM_VERSION" />
		<PackageReference Include="Mokaterm.Plugin.Sdk" Version="MOKATERM_VERSION" PrivateAssets="all" />
	</ItemGroup>
<!--#endif -->

</Project>
