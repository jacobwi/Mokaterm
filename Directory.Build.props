<Project>

	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>Recommended</AnalysisMode>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<Deterministic>true</Deterministic>
	</PropertyGroup>

	<!-- Everything targets .NET 10 LTS. The desktop host adds its platform to it (net10.0-windows...). -->
	<PropertyGroup>
		<MokatermTargetFramework>net10.0</MokatermTargetFramework>
	</PropertyGroup>

	<!--
		CA2007: ConfigureAwait is noise here; UI code resumes on the renderer and services never block on tasks.
		CA1515: public types in app assemblies are how modules and the shell see each other.
		CA1848/CA1873: LoggerMessage delegates for every log call; the arguments are cheap property reads.
		CA1062: nullable reference types already cover argument null checks.
		CA1031: session and transfer loops must survive any failure and surface it to the UI.
		CA1812: DI constructs internal services, the analyzer cannot see that.
		CA1716/CA1724: namespaces like Mokaterm.Abstractions.Security collide with framework names by design.
		CA1040: marker interfaces (capabilities) are intentional.
		CA1711: names such as ConnectionCollection read better than the alternatives.
		CA1819: crypto records expose byte arrays on purpose.
		CA1000: static factory members on generic result types.
	-->
	<PropertyGroup>
		<NoWarn>$(NoWarn);CA2007;CA1515;CA1848;CA1873;CA1062;CA1031;CA1812;CA1716;CA1724;CA1040;CA1711;CA1819;CA1000</NoWarn>
	</PropertyGroup>

	<!--
		The version of every assembly and both hosts: bump VersionPrefix for a release. A CI build adds a prerelease label
		with -p:VersionSuffix=beta.1. The MAUI host takes its display version from VersionPrefix, because a Windows version
		cannot carry a label, and the hosts show the informational version without its "+commit" metadata.
	-->
	<PropertyGroup>
		<Authors>Moka</Authors>
		<Company>Moka</Company>
		<Product>Mokaterm</Product>
		<Copyright>Copyright (c) Moka 2026</Copyright>
		<VersionPrefix>0.1.0</VersionPrefix>
	</PropertyGroup>

	<!--
		CI servers set CI (GitHub Actions, GitLab, AppVeyor) or TF_BUILD (Azure Pipelines). Their builds map source paths
		to /_/, so binaries and PDBs do not depend on where the tree was checked out. Local builds keep real paths for
		debugging.
	-->
	<PropertyGroup Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

</Project>
