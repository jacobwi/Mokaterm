@namespace Mokaterm.Plugins.Sample.Fail2ban
@inherits SystemPageBase

@* A System view page from a plugin: the frame and the detail panel come from UI.Common, and the rows use the view's
   own list styles (mta-table, mta-row, mta-kv), so it looks like the pages around it. *@
<ToolPageFrame Title="Fail2ban"
			   Summary="@Summary"
			   Search="@_filter"
			   SearchChanged="OnFilterChanged"
			   SearchPlaceholder="Filter by jail or address"
			   Loading="Loading"
			   Loaded="Loaded"
			   Error="@LoadError"
			   OnRefresh="ReloadAsync"
			   ListPage
			   Detail="@(Selected is null ? null : DetailPanel)">
	@if (Unavailable is { } reason)
	{
		<MokaEmptyState Icon="MokatermIcons.Shield" Title="No fail2ban" Description="@reason" />
	}
	else if (_needsRoot)
	{
		<div class="f2b-root">
			<MokaAlert Severity="MokaToastSeverity.Warning" Dense>fail2ban only answers root on this server. Turn root mode on to read its jails.</MokaAlert>
			<div>
				<Hint Text="@Context.RootChangeBlocked">
					<MokaButton Variant="MokaVariant.Outlined"
								Size="MokaSize.Xs"
								StartIcon="MokatermIcons.Root"
								Disabled="@(Context.RootChangeBlocked is not null)"
								OnClick="EnableRootAsync">
						Root mode
					</MokaButton>
				</Hint>
			</div>
		</div>
	}
	else if (Shown.Count == 0)
	{
		<MokaEmptyState Icon="MokatermIcons.Shield"
						Title="@(_status.Jails.Count == 0 ? "No jails" : "Nothing matches")"
						Description="@(_status.Jails.Count == 0 ? "fail2ban runs, but no jail is turned on." : "No jail or banned address matches the filter.")" />
	}
	else
	{
		<div class="mta-table" style="--mta-cols: 14px minmax(0, 1fr) 88px 88px; --mta-cols-narrow: 14px minmax(0, 1fr) 88px">
			<div class="mta-row mta-row--head">
				<span></span>
				<span>Jail</span>
				<span>Banned</span>
				<span class="mta-wide">Failing</span>
			</div>
			@foreach (Fail2banJail jail in Shown)
			{
				<div class="@(jail.Name == _selected ? "mta-row mta-row--clickable mta-row--selected" : "mta-row mta-row--clickable")"
					 @key="jail.Name"
					 role="button"
					 tabindex="0"
					 aria-pressed="@(jail.Name == _selected ? "true" : "false")"
					 @onclick="@(() => Select(jail))"
					 @onkeydown="@(args => OnRowKey(args, jail))">
					<MokaStatusDot Size="MokaSize.Xs" Color="@DotColor(jail)" Glow="@(jail.CurrentlyBanned > 0 || jail.Problem is not null)" />
					<Hint Text="@jail.Source" Position="MokaTooltipPosition.BottomStart" Class="mta-cell mta-mono">@jail.Name</Hint>
					<span class="mta-cell mta-mono">@Number(jail.CurrentlyBanned)</span>
					<span class="mta-cell mta-mono mta-dim mta-wide">@Number(jail.CurrentlyFailed)</span>
				</div>
			}
		</div>
	}
</ToolPageFrame>

@code {
	private RenderFragment DetailPanel => @<text>
		@if (Selected is { } jail)
		{
			<ToolDetailPanel Title="@jail.Name"
							 Subtitle="@jail.Source"
							 DotColor="@DotColor(jail)"
							 DotGlow="@(jail.CurrentlyBanned > 0)"
							 OnClose="CloseDetail">
				@if (jail.Problem is { } problem)
				{
					<MokaAlert Severity="MokaToastSeverity.Error" Dense>@problem</MokaAlert>
				}
				<dl class="mta-kv">
					<dt>Banned now</dt>
					<dd class="mta-mono">@Number(jail.CurrentlyBanned)</dd>
					<dt>Banned in all</dt>
					<dd class="mta-mono">@Number(jail.TotalBanned)</dd>
					<dt>Failing now</dt>
					<dd class="mta-mono">@Number(jail.CurrentlyFailed)</dd>
					<dt>Failed in all</dt>
					<dd class="mta-mono">@Number(jail.TotalFailed)</dd>
					<dt>Reads</dt>
					<dd class="mta-mono">@(jail.Source.Length > 0 ? jail.Source : "-")</dd>
				</dl>

				<MokaText Element="span" Size="MokaSize.Xs" Weight="MokaFontWeight.Semibold" Class="mta-label">Banned addresses</MokaText>
				@if (jail.BannedAddresses.Count == 0)
				{
					<MokaText Element="span" Size="MokaSize.Sm" Class="mta-dim">Nobody is banned in this jail.</MokaText>
				}
				else
				{
					<div class="mta-table" style="--mta-cols: minmax(0, 1fr) auto">
						@foreach (string address in jail.BannedAddresses)
						{
							string? refused = UnbanRefusal(address);
							<div class="mta-row" @key="address">
								<span class="mta-cell mta-mono" title="@address">@address</span>
								<span class="mta-cell mta-cell--end">
									<Hint Text="@(refused ?? $"Let {address} in again")">
										<MokaButton Variant="MokaVariant.Outlined"
													Size="MokaSize.Xs"
													Disabled="@(Busy || refused is not null)"
													OnClick="@(() => UnbanAsync(jail, address))">
											Unban
										</MokaButton>
									</Hint>
								</span>
							</div>
						}
					</div>
				}
			</ToolDetailPanel>
		}
	</text>;
}
