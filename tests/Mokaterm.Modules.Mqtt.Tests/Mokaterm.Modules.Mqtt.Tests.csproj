<Project Sdk="Microsoft.NET.Sdk">

	<!-- The broker half of MQTTnet 5 is a package of its own, and the tests run one in process. -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
		<PackageReference Include="MQTTnet.Server" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Modules\Mokaterm.Modules.Mqtt\Mokaterm.Modules.Mqtt.csproj" />
	</ItemGroup>

	<!-- FakeJsRuntime: Microsoft.JSInterop arrives with the module's UI.Common reference, which Core and Sessions tests have not. -->
	<ItemGroup>
		<Compile Include="..\Shared\Interop\*.cs" LinkBase="Shared" />
	</ItemGroup>

</Project>
