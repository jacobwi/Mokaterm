<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Modules\Mokaterm.Modules.Ssh\Mokaterm.Modules.Ssh.csproj" />

		<!-- Security key files are read by Core, which a login reaches through ISshSecurityKeyReader in the hosts. -->
		<ProjectReference Include="..\..\src\Mokaterm.Core\Mokaterm.Core.csproj" />
	</ItemGroup>

	<!-- SoftwareSecurityKey signs Ed25519 with BouncyCastle, which SSH.NET brings along. -->
	<ItemGroup>
		<Compile Include="..\Shared\SecurityKeys\*.cs" LinkBase="Shared" />
	</ItemGroup>

	<!-- PuTTY key files written from the published format, for want of puttygen; Argon2 comes with Core. -->
	<ItemGroup>
		<Compile Include="..\Shared\Keys\*.cs" LinkBase="Shared" />
	</ItemGroup>

	<!-- Eventually.AdvanceUntilAsync, for the page poller. -->
	<ItemGroup>
		<Compile Include="..\Shared\FakeTime\*.cs" LinkBase="Shared" />
	</ItemGroup>

</Project>
