<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
		<!-- The Docker manager's pages are rendered for real with Blazor's static HtmlRenderer. -->
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Modules\Mokaterm.Modules.Ssh\Mokaterm.Modules.Ssh.csproj" />

		<!-- Security key files are read by Core, which a login reaches through ISshSecurityKeyReader in the hosts. -->
		<ProjectReference Include="..\..\src\Mokaterm.Core\Mokaterm.Core.csproj" />
	</ItemGroup>

	<!-- SoftwareSecurityKey signs Ed25519 with BouncyCastle, which SSH.NET brings along. -->
	<ItemGroup>
		<Compile Include="..\Shared\SecurityKeys\*.cs" LinkBase="Shared" />
	</ItemGroup>

	<!-- PuTTY key files written from the published format, for want of puttygen; Argon2 comes with Core. -->
	<ItemGroup>
		<Compile Include="..\Shared\Keys\*.cs" LinkBase="Shared" />
	</ItemGroup>

	<!-- Eventually.AdvanceUntilAsync, for the page poller. -->
	<ItemGroup>
		<Compile Include="..\Shared\FakeTime\*.cs" LinkBase="Shared" />
		<Compile Include="..\Shared\Rendering\*.cs" LinkBase="Shared" />
	</ItemGroup>

	<!--
		The DevHost's demo docker engine and the file tree it reads, so its registry, build and push flows are played end
		to end through the module's own shell, client and readers. The tree's seed is left out: it needs the rest of the demo.
	-->
	<ItemGroup>
		<Compile Include="..\..\samples\Mokaterm.DevHost\Demo\Docker\*.cs" LinkBase="DevHost\Docker" />
		<Compile Include="..\..\samples\Mokaterm.DevHost\Demo\FileSystem\*.cs" Exclude="..\..\samples\Mokaterm.DevHost\Demo\FileSystem\DemoTreeSeed.cs" LinkBase="DevHost\FileSystem" />
		<Compile Include="..\..\samples\Mokaterm.DevHost\Demo\GeneratedStream.cs;..\..\samples\Mokaterm.DevHost\Demo\DemoRandom.cs" LinkBase="DevHost" />
	</ItemGroup>

</Project>
