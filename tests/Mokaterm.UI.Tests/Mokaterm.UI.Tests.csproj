<Project Sdk="Microsoft.NET.Sdk">

	<!--
		UI logic that can be tested without a browser: prompt parsing, searching, the snippets the shell builds, and
		components rendered for real with Blazor's static HtmlRenderer.
	-->
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\UI\Mokaterm.UI\Mokaterm.UI.csproj" />
	</ItemGroup>

	<!-- StaticRender: Blazor's static renderer, which needs Components.Web and the logging package. -->
	<ItemGroup>
		<Compile Include="..\Shared\Rendering\*.cs" LinkBase="Shared" />
	</ItemGroup>

	<!-- Eventually.AdvanceUntilAsync, for the page poller. -->
	<ItemGroup>
		<Compile Include="..\Shared\FakeTime\*.cs" LinkBase="Shared" />
	</ItemGroup>

	<!--
		NativeDropPoint: the desktop host's screen-to-page arithmetic for native file drops. Plain numbers with no
		Windows call in them, compiled in here because the host targets net10.0-windows and no test project can
		reference it.
	-->
	<ItemGroup>
		<Compile Include="..\..\src\Hosts\Mokaterm.Maui\Platforms\Windows\NativeDropPoint.cs" LinkBase="Shared" />
	</ItemGroup>

	<!--
		NotificationClick: the ids a Windows notification carries back to the desktop host, and the session a click selects.
		Plain data with no Windows call, compiled in here so what reaches the system's notification store is checked.
	-->
	<ItemGroup>
		<Compile Include="..\..\src\Hosts\Mokaterm.Maui\Services\NotificationClick.cs" LinkBase="Shared" />
	</ItemGroup>

	<!--
		WebAuthnInterop: the desktop host's webauthn.dll structures and HRESULT grouping. Plain data with no Windows call,
		here so their layout is checked against webauthn.h without a security key.
	-->
	<ItemGroup>
		<Compile Include="..\..\src\Hosts\Mokaterm.Maui\Platforms\Windows\WebAuthnInterop.cs" LinkBase="Shared" />
	</ItemGroup>

	<!--
		ToolPageServices: how the desktop's tool windows borrow the main window's services. Plain dependency injection,
		checked here against the shell's real registrations so a service that changes sides is caught before it becomes a
		second vault in a tool window.
	-->
	<ItemGroup>
		<Compile Include="..\..\src\Hosts\Mokaterm.Maui\ToolWindows\ToolPageServices.cs" LinkBase="Shared" />
	</ItemGroup>

</Project>
