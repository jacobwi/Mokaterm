<Project Sdk="Microsoft.NET.Sdk">

	<!--
		The connection runtime: protocol registry, session manager and connect flow, terminal stream pump and
		the transfer queue. Talks to storage and security only through Mokaterm.Abstractions.
	-->
	<PropertyGroup>
		<TargetFramework>$(MokatermTargetFramework)</TargetFramework>
		<RootNamespace>Mokaterm.Sessions</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mokaterm.Sessions.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Mokaterm.Abstractions\Mokaterm.Abstractions.csproj" />
	</ItemGroup>

</Project>
