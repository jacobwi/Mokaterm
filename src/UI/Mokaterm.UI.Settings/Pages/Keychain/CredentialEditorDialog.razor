@using Moka.Red.Forms.Checkbox
@using Mokaterm.Abstractions.Credentials
@inherits DraftDialogBase

<MokaDialog Open="Open"
			OpenChanged="OnOpenChangedAsync"
			Title="@DialogTitle"
			DialogSize="MokaDialogSize.Medium"
			CloseOnBackdropClick="false"
			CloseOnEscape="!IsBusy"
			ShowCloseButton="!IsBusy">
	<ChildContent>
		<form id="@FormId" @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
			<MokaFlexbox Direction="MokaDirection.Column" Gap="MokaSpacingScale.Md">
				<MokaTextField Label="Name"
							   @bind-Value="_name"
							   Required
							   ErrorText="@_nameError"
							   Disabled="_saving"
							   Placeholder="@(IsPassword ? "Database admin" : "Deploy key")"
							   autocomplete="off"
							   data-autofocus="true" />
				<MokaTextField Label="Username"
							   @bind-Value="_username"
							   Disabled="_saving"
							   HelperText="Suggested when a login uses this credential."
							   autocomplete="off"
							   spellcheck="false" />
				@if (IsPassword)
				{
					<MokaPasswordField Label="Password"
									   @bind-Value="_password"
									   Required="IsNew"
									   ErrorText="@_secretError"
									   Disabled="_saving"
									   HelperText="@(IsNew ? null : "Leave blank to keep the saved password.")"
									   autocomplete="new-password" />
				}
				else
				{
					<PrivateKeyInput @bind-PrivateKey="_privateKey"
									 @bind-Passphrase="_passphrase"
									 HasSavedKey="!IsNew"
									 Disabled="_saving" />
					@if (_secretError is not null)
					{
						<MokaText Element="span" Size="MokaSize.Xs" Color="MokaColor.Error">@_secretError</MokaText>
					}
				}
				<MokaPasswordField Label="Proxy password"
								   @bind-Value="_proxyPassword"
								   HelperText="@ProxyPasswordHelp"
								   Placeholder="@(HasSavedProxyPassword ? "Saved" : "")"
								   Disabled="@(_saving || _forgetProxyPassword)"
								   autocomplete="new-password" />
				@if (HasSavedProxyPassword)
				{
					<MokaCheckbox Label="Forget saved proxy password" @bind-Value="_forgetProxyPassword" Disabled="_saving" />
				}
				<MokaTextArea Label="Notes" @bind-Value="_notes" Rows="2" Disabled="_saving" />
				@if (_error is not null)
				{
					<MokaAlert Severity="MokaToastSeverity.Error" Dense>@_error</MokaAlert>
				}
			</MokaFlexbox>
		</form>
	</ChildContent>
	<Actions>
		<MokaButton Variant="MokaVariant.Text" Disabled="_saving" OnClick="CloseAsync">Cancel</MokaButton>
		<MokaButton Type="submit" form="@FormId" StartIcon="MokaIcons.Action.Save" Loading="_saving">Save</MokaButton>
	</Actions>
</MokaDialog>
