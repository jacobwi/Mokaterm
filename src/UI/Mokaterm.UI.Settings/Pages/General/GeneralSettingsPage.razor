@inherits SettingsSectionBase<GeneralSettings>

@{
	GeneralSettings settings = Settings;
}

<SettingsPage Title="General"
			  OnReset="ResetAsync"
			  ResetMessage="Put every general setting back to its default?">
	<SettingsSection Title="Sessions">
		<SettingsRow Label="Confirm closing connected sessions"
					 Description="Ask before closing a tab while its session is still connected. The prompt can turn this off itself.">
			<MokaSwitch Value="settings.ConfirmCloseConnectedSessions"
						ValueChanged="value => SaveAsync(s => s with { ConfirmCloseConnectedSessions = value })"
						aria-label="Confirm closing connected sessions" />
		</SettingsRow>
		<SettingsRow Label="Reconnect automatically"
					 Description="Try again when a connection drops on its own. Sessions you close yourself stay closed.">
			<MokaSwitch Value="settings.AutoReconnect"
						ValueChanged="value => SaveAsync(s => s with { AutoReconnect = value })"
						aria-label="Reconnect automatically" />
		</SettingsRow>
		<SettingsRow Label="Reconnect delay" Description="Seconds to wait before each reconnect attempt.">
			<NumberSetting TValue="int"
						   Value="settings.AutoReconnectDelaySeconds"
						   ValueChanged="value => SaveAsync(s => s with { AutoReconnectDelaySeconds = value })"
						   Min="GeneralSettings.MinAutoReconnectDelaySeconds"
						   Max="GeneralSettings.MaxAutoReconnectDelaySeconds"
						   Suffix="s"
						   Disabled="!settings.AutoReconnect"
						   AriaLabel="Reconnect delay in seconds" />
		</SettingsRow>
		<SettingsRow Label="Reopen at start"
					 Description="What to do with the tabs that were open when Mokaterm last closed. Quick-connect tabs are never reopened.">
			<EnumSegmentedControl TEnum="SessionRestoreMode"
								  Value="settings.RestoreSessions"
								  ValueChanged="value => SaveAsync(s => s with { RestoreSessions = value })"
								  Options="RestoreOptions"
								  AriaLabel="Reopen sessions at start" />
		</SettingsRow>
	</SettingsSection>

	<SettingsSection Title="Connections">
		<SettingsRow Label="Recent connections" Description="How many recently used connections to list. 0 hides the list.">
			<NumberSetting TValue="int"
						   Value="settings.RecentConnectionsLimit"
						   ValueChanged="value => SaveAsync(s => s with { RecentConnectionsLimit = value })"
						   Min="GeneralSettings.MinRecentConnectionsLimit"
						   Max="GeneralSettings.MaxRecentConnectionsLimit"
						   AriaLabel="Number of recent connections" />
		</SettingsRow>
	</SettingsSection>

	@if (Files is not null)
	{
		<SettingsSection Title="Backup"
						 Description="Every setting in one JSON file, to move to another machine or to keep. Connections, passwords, keys and saved commands are not in it: they stay in the vault.">
			<SettingsRow Label="Export settings"
						 Description="Saves the file. Folders, the update feed and the other values that only fit this machine are left out.">
				<MokaButton Variant="MokaVariant.Outlined"
							Size="MokaSize.Sm"
							StartIcon="MokatermIcons.Download"
							Loading="_exporting"
							Disabled="Busy"
							OnClick="ExportAsync">
					Export
				</MokaButton>
			</SettingsRow>
			<SettingsRow Label="Import settings"
						 Description="Replaces every setting with the ones in an exported file. This machine keeps its own folders and update feed.">
				<MokaButton Variant="MokaVariant.Outlined"
							Size="MokaSize.Sm"
							StartIcon="MokaIcons.Action.Upload"
							Loading="_importing"
							Disabled="Busy"
							OnClick="ImportAsync">
					Import
				</MokaButton>
			</SettingsRow>
		</SettingsSection>
	}
</SettingsPage>
