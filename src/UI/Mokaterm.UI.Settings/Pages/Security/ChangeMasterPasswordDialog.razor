@inherits DraftDialogBase

<MokaDialog Open="Open"
			OpenChanged="OnOpenChangedAsync"
			Title="Change master password"
			DialogSize="MokaDialogSize.Small"
			CloseOnBackdropClick="false"
			CloseOnEscape="!IsBusy"
			ShowCloseButton="!IsBusy">
	<ChildContent>
		<form id="@FormId" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
			<MokaFlexbox Direction="MokaDirection.Column" Gap="MokaSpacingScale.Md">
				<MokaPasswordField Label="Current password"
								   @bind-Value="_current"
								   ErrorText="@_currentError"
								   Disabled="_busy"
								   autocomplete="current-password"
								   data-autofocus="true" />
				<MokaFlexbox Direction="MokaDirection.Column" Gap="MokaSpacingScale.Xs">
					<MokaPasswordField Label="New password"
									   @bind-Value="_new"
									   ErrorText="@_newError"
									   Disabled="_busy"
									   HelperText="@VaultPasswordPolicy.Requirement"
									   autocomplete="new-password" />
					<MokaPasswordStrength Password="@_new" MinLength="VaultPasswordPolicy.MinimumLength" />
				</MokaFlexbox>
				<MokaPasswordField Label="Confirm new password"
								   @bind-Value="_confirm"
								   ErrorText="@_confirmError"
								   Disabled="_busy"
								   autocomplete="new-password" />
				@if (_error is not null)
				{
					<MokaAlert Severity="MokaToastSeverity.Error" Dense>@_error</MokaAlert>
				}
			</MokaFlexbox>
		</form>
	</ChildContent>
	<Actions>
		<MokaButton Variant="MokaVariant.Text" Disabled="_busy" OnClick="CloseAsync">Cancel</MokaButton>
		<MokaButton Type="submit" form="@FormId" StartIcon="MokatermIcons.Key" Loading="_busy">Change password</MokaButton>
	</Actions>
</MokaDialog>
