@using Mokaterm.Abstractions.Plugins

@{
	IReadOnlyList<PluginRecord> plugins = Listed;
}

<SettingsPage Title="Plugins">
	@if (Plugins.IsSafeStart)
	{
		<MokaCallout Type="MokaCalloutType.Warning" Title="Plugins are off for this start">
			The last start ended while plugins were loading, or MOKATERM_NO_PLUGINS was set, so this one loaded none. The
			ones marked Skipped load again at the next start.
			@if (Plugins.CanInstall)
			{
				<text>If one of them stopped the app, turn it off before you restart.</text>
			}
			@RestartButton
		</MokaCallout>
	}

	@if (Plugins.RestartRequired)
	{
		<MokaCallout Type="MokaCalloutType.Note" Title="Restart Mokaterm to apply">
			Plugin changes take effect at the next start, because a plugin that is loaded cannot be unloaded.
			@RestartButton
		</MokaCallout>
	}

	@if (ShowsBrowse)
	{
		<ViewTabs Tabs="Tabs" Active="@_tab" ActiveChanged="ShowTab" Label="Plugin views" Panel="Views(plugins)" />
	}
	else
	{
		@Views(plugins)
	}
</SettingsPage>

<PluginInstallDialog Open="_installOpen" OpenChanged="OnInstallOpenChanged" Package="_package" />

@code {
	// Both notices offer the same restart, only where the host can restart itself (the desktop app).
	private RenderFragment RestartButton => __builder =>
	{
		@if (Restarter is not null)
		{
			<MokaFlexbox Direction="MokaDirection.Row" Style="margin-top: var(--moka-spacing-xs)">
				<MokaButton Variant="MokaVariant.Outlined"
							Size="MokaSize.Sm"
							StartIcon="MokatermIcons.Reconnect"
							Loading="_restarting"
							Disabled="Busy"
							OnClick="RestartAsync">
					Restart now
				</MokaButton>
			</MokaFlexbox>
		}
	};

	private RenderFragment Views(IReadOnlyList<PluginRecord> plugins) => @<div class="plugins-views">
		@if (UpdateCount is { } updates)
		{
			@* What the startup check or a Browse read already knows, said once above the rows: the cards install it. *@
			<MokaCallout Type="MokaCalloutType.Note" Title="@(updates == 1 ? "1 plugin has an update" : $"{updates} plugins have updates")">
				@(updates == 1 ? "Its card in Browse installs it; nothing downloads on its own." : "Their cards in Browse install them; nothing downloads on its own.")
				@if (ShowsBrowse)
				{
					<MokaFlexbox Direction="MokaDirection.Row" Style="margin-top: var(--moka-spacing-xs)">
						<MokaButton Variant="MokaVariant.Outlined"
									Size="MokaSize.Sm"
									StartIcon="MokatermIcons.Plugin"
									OnClick="@(() => ShowTab(BrowseTab))">
							Browse updates
						</MokaButton>
					</MokaFlexbox>
				}
			</MokaCallout>
		}

		@if (_tab == InstalledTab)
		{
			<div class="plugins-views__panel">
				<SettingsSection Title="Installed" Description="@InstalledDescription">
					<Actions>
						@if (_gallery is not null)
						{
							<MokaButton Variant="MokaVariant.Outlined"
										Size="MokaSize.Sm"
										StartIcon="MokaIcons.Action.Refresh"
										Loading="_checkingUpdates"
										Disabled="Busy"
										OnClick="CheckForUpdatesAsync">
								Check for updates
							</MokaButton>
						}
						@if (CanInstall)
						{
							<MokaButton Variant="MokaVariant.Outlined"
										Size="MokaSize.Sm"
										StartIcon="MokaIcons.Action.Upload"
										Loading="_picking"
										Disabled="Busy"
										OnClick="PickPackageAsync">
								Install from file
							</MokaButton>
						}
					</Actions>
					<ChildContent>
						@if (plugins.Count == 0)
						{
							<MokaEmptyState Icon="MokatermIcons.Plugin" Title="No plugins installed" Description="@EmptyDescription" />
						}
						@foreach (PluginRecord plugin in plugins)
						{
							<PluginRow @key="plugin.Id"
									   Plugin="plugin"
									   CanManage="Plugins.CanInstall"
									   Busy="Busy"
									   OnTurnOn="TurnOnAsync"
									   OnTurnOff="TurnOffAsync"
									   OnTrust="TrustChangedFilesAsync"
									   OnRemove="RemoveAsync"
									   SettingsPageId="@SettingsPageOf(plugin)"
									   OnOpenSettings="OpenSettings"
									   Update="UpdateOf(plugin)"
									   Withdrawn="WithdrawnOf(plugin)" />
						}
					</ChildContent>
				</SettingsSection>

				<SettingsSection Title="Folder">
					<SettingsRow Label="Plugins folder" Description="@FolderDescription">
						<MokaFlexbox Direction="MokaDirection.Row" Align="MokaAlign.Center" Gap="MokaSpacingScale.Xxs">
							<MokaText Element="span"
									  Size="MokaSize.Xs"
									  Mono
									  Truncate
									  Style="@TextStyles.TruncateBox"
									  title="@Plugins.Directory">@Plugins.Directory</MokaText>
							<CopyButton Text="@Plugins.Directory" Label="Copy folder path" />
						</MokaFlexbox>
					</SettingsRow>
				</SettingsSection>
			</div>
		}

		@* Kept once opened, hidden behind the other tab, so the search and the category survive a look at the list. *@
		@if (_browseOpened && ShowsBrowse)
		{
			<div hidden="@(_tab != BrowseTab)">
				<PluginGalleryView Installed="plugins" Busy="Busy" Downloading="@_downloading" OnInstall="InstallFromGalleryAsync" />
			</div>
		}
	</div>;
}
