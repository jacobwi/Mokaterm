@using Mokaterm.Abstractions.Platform
@using Mokaterm.Abstractions.Presentation
@using Mokaterm.UI.Common.Contributions
@inherits SettingsSectionBase<AppearanceSettings>

@{
	AppearanceSettings settings = Settings;
}

<SettingsPage Title="Appearance"
			  OnReset="ResetAsync"
			  ResetMessage="Put the theme, accent color, density, font scale, status bar, session toolbar and tool windows back to their defaults?">
	<SettingsSection Title="Theme">
		<SettingsRow Label="Mode" Description="Dark suits long terminal sessions. Light reads better in bright rooms.">
			<EnumSegmentedControl TEnum="ThemeMode"
								  Value="settings.Mode"
								  ValueChanged="value => UpdateAsync(s => s with { Mode = value })"
								  Options="ModeOptions"
								  AriaLabel="Theme mode" />
		</SettingsRow>
		<SettingsRow Label="Accent color" Description="@AccentHelp">
			<div class="accent-picker">
				<MokaColorSwatch Colors="AccentPresets"
								 SelectedColor="@SelectedPreset(settings.AccentColor)"
								 SelectedColorChanged="SelectPresetAsync"
								 Columns="AccentPresets.Length"
								 SwatchSize="20px" />
				<ColorSetting Value="@settings.AccentColor"
							  ValueChanged="value => SaveAsync(s => s with { AccentColor = value })"
							  Forms="HexColorForms.Accent"
							  Placeholder="@AppearanceSettings.DefaultAccentColor"
							  Width="132px"
							  AriaLabel="Accent color" />
			</div>
		</SettingsRow>
	</SettingsSection>

	<SettingsSection Title="Layout">
		<SettingsRow Label="Density" Description="Spacing around controls, lists and tables.">
			<EnumSegmentedControl TEnum="UiDensity"
								  Value="settings.Density"
								  ValueChanged="value => UpdateAsync(s => s with { Density = value })"
								  Options="DensityOptions"
								  AriaLabel="Density" />
		</SettingsRow>
		<SettingsRow Label="Font scale" Description="Scales every font in the app. 100% is the Moka default." ControlWidth="240px">
			<MokaSlider Value="settings.FontScale"
						ValueChanged="SetFontScaleAsync"
						Min="AppearanceSettings.MinFontScale"
						Max="AppearanceSettings.MaxFontScale"
						Step="FontScaleStep"
						ValueFormat="P0"
						aria-label="Font scale" />
		</SettingsRow>
		<SettingsRow Label="Status bar" Description="Show the bar with session and transfer status along the bottom of the window.">
			<MokaSwitch Value="settings.ShowStatusBar"
						ValueChanged="value => UpdateAsync(s => s with { ShowStatusBar = value })"
						aria-label="Show status bar" />
		</SettingsRow>
	</SettingsSection>

	<SettingsSection Title="Session toolbar" Description="The bar above every session, with its buttons and the tools modules add.">
		<SettingsRow Label="Toolbar layout"
					 Description="Grouped puts a line between panels, view, session, a menu of tools and closing. Flat shows every button in one row. Compact keeps one menu for everything.">
			<EnumSegmentedControl TEnum="SessionToolbarLayout"
								  Value="settings.ToolbarLayout"
								  ValueChanged="value => UpdateAsync(s => s with { ToolbarLayout = value })"
								  Options="ToolbarLayoutOptions"
								  AriaLabel="Session toolbar layout" />
		</SettingsRow>
		<SettingsRow Label="Toolbar buttons"
					 Description="Turn off the buttons you never use. They stay in the toolbar's menu and in the command palette."
					 Stacked>
			<div class="toolbar-buttons">
				@foreach (SessionToolbarButton button in ToolbarButtons)
				{
					string id = button.Id;
					<div class="toolbar-button">
						<MokaIcon Icon="button.Icon" SizeValue="14px" />
						<span class="toolbar-button__title">@button.Title</span>
						<MokaSwitch Value="@(!settings.HiddenToolbarButtons.Contains(id))"
									ValueChanged="shown => SetButtonShownAsync(id, shown)"
									aria-label="@($"Show {button.Title} on the toolbar")" />
					</div>
				}
			</div>
		</SettingsRow>
	</SettingsSection>

	@* The window rows are the desktop's: a browser keeps every tool in a dialog, so there they would change nothing. *@
	<SettingsSection Title="Tool windows" Description="Docker, System and the tools in the top bar's Tools menu: where they open and what their header shows.">
		@if (AppEnvironment.Kind == HostKind.Desktop)
		{
			<SettingsRow Label="Open tools in their own window"
						 Description="Tools open as windows you can move beside the terminal or to another screen. Off, they open over the session or the app, and a tool's own button still moves it to a window.">
				<MokaSwitch Value="settings.ToolsInOwnWindow"
							ValueChanged="value => UpdateAsync(s => s with { ToolsInOwnWindow = value })"
							aria-label="Open tools in their own window" />
			</SettingsRow>
			<SettingsRow Label="Reopen tool windows at start"
						 Description="Tool windows open when Mokaterm closed come back: the Tools menu's once the vault is unlocked, a session's once that session is reopened and connected. A window you closed yourself stays closed.">
				<MokaSwitch Value="settings.ReopenToolWindows"
							ValueChanged="value => UpdateAsync(s => s with { ReopenToolWindows = value })"
							aria-label="Reopen tool windows at start" />
			</SettingsRow>
			<SettingsRow Label="Remember tool window places"
						 Description="Each tool's window opens where it was last, at the same size, and stays on top if it did. Off, windows open at the tool's usual size and nothing about them is kept.">
				<MokaSwitch Value="settings.RememberToolWindowPlaces"
							ValueChanged="value => UpdateAsync(s => s with { RememberToolWindowPlaces = value })"
							aria-label="Remember tool window places" />
			</SettingsRow>
		}
		<SettingsRow Label="Show tool descriptions"
					 Description="Puts a tool's one-line description after its title, in its dialog and in its window. Off, the description shows when you point at the title.">
			<MokaSwitch Value="settings.ShowToolDescriptions"
						ValueChanged="value => UpdateAsync(s => s with { ShowToolDescriptions = value })"
						aria-label="Show tool descriptions" />
		</SettingsRow>
	</SettingsSection>

	<SettingsSection Title="Preview" Description="Follows the settings above as you change them.">
		<div class="appearance-preview">
			<MokaFlexbox Direction="MokaDirection.Row" Align="MokaAlign.Center" Gap="MokaSpacingScale.Sm" Wrap>
				<MokaStatusDot Label="Connected" Color="MokaColor.Success" />
				<MokaChip Text="production" Size="MokaSize.Sm" Color="MokaColor.Primary" Selected />
				<MokaTag Text="ssh-ed25519" Size="MokaSize.Xs" />
			</MokaFlexbox>
			<MokaTextField @bind-Value="_previewHost" Label="Host" Placeholder="user@host:22" Size="MokaSize.Sm" />
			<MokaFlexbox Direction="MokaDirection.Row" Align="MokaAlign.Center" Gap="MokaSpacingScale.Sm" Wrap>
				<MokaButton Size="MokaSize.Sm" StartIcon="MokatermIcons.Connect">Connect</MokaButton>
				<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Outlined">Edit</MokaButton>
				<MokaButton Size="MokaSize.Sm" Variant="MokaVariant.Text">Cancel</MokaButton>
			</MokaFlexbox>
		</div>
	</SettingsSection>
</SettingsPage>
