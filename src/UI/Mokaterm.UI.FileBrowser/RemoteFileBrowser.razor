@namespace Mokaterm.UI.FileBrowser

<div @ref="_root" class="@RootClass" style="@Style" tabindex="-1">
	<MokaFileBrowser @key="_mount"
					 @ref="_browser"
					 TItem="RemoteFileEntry"
					 Load="LoadFolderAsync"
					 Describe="Describe"
					 Folder="@_path"
					 FolderChanged="OnFolderChangedAsync"
					 Crumbs="Crumbs"
					 Selected="_selected"
					 SelectedChanged="OnSelectedChanged"
					 View="_sort"
					 ViewChanged="OnViewChanged"
					 Columns="ColumnList"
					 FitWidths="ColumnFitNow"
					 ResizableColumns
					 Text="_text"
					 Filter="@_filter"
					 FilterChanged="OnFilterChanged"
					 ItemFilter="ShowsEntry"
					 KeepListOnLoadFailure
					 ReselectOnReturn
					 Controls="ShownControls"
					 Keys="TakenKeys"
					 DragText="EntryPath"
					 Move="MoveDraggedAsync"
					 OnOpenFile="OpenEntryAsync"
					 ItemMenu="ItemMenu"
					 BackgroundMenu="BackgroundMenu"
					 Details="@(ShowsDetails ? DetailsContent : null)">
		<ToolbarControl Context="control">
			@switch (control.Which)
			{
				case MokaFileControls.Back:
					<IconButton Icon="MokaIcons.Navigation.ArrowLeft"
								Disabled="@(!CanBrowse || !control.Enabled)" OnClick="control.Run!" Label="Back" Shortcut="Alt+Left"
								Position="MokaTooltipPosition.BottomStart" />
					break;
				case MokaFileControls.Forward:
					<IconButton Icon="MokaIcons.Navigation.ArrowRight"
								Disabled="@(!CanBrowse || !control.Enabled)" OnClick="control.Run!" Label="Forward" Shortcut="Alt+Right" />
					break;
				case MokaFileControls.Up:
					<IconButton Icon="MokaIcons.Navigation.ArrowUp"
								Disabled="@(!CanBrowse || RemotePath.IsRoot(_path))" OnClick="GoUpAsync" Label="Up" Shortcut="Backspace" />
					<IconButton Icon="MokaIcons.Navigation.Home"
								Disabled="@(_fileSystem is null)" OnClick="GoHomeAsync" Label="Home" />
					@if (CanBookmark)
					{
						<IconButton Color="@(IsBookmarked ? MokaColor.Primary : MokaColor.Surface)"
									Icon="@(IsBookmarked ? MokaIcons.Toggle.Star : MokaIcons.Toggle.StarOutline)"
									Disabled="@(!CanBrowse)"
									OnClick="ShowBookmarksMenuAsync"
									Label="Bookmarks"
									aria-haspopup="menu" />
					}
					break;
				case MokaFileControls.Path:
					@if (_editingPath)
					{
						<MokaTextField Value="@_pathText"
									   ValueChanged="OnPathTextChanged"
									   Size="MokaSize.Sm"
									   Placeholder="/path/to/folder or ~"
									   OnBlur="CancelPathEdit"
									   Style="width:100%"
									   spellcheck="false"
									   autocomplete="off"
									   data-path-editor="true"
									   @onkeydown="OnPathKeyDownAsync" />
					}
					else if (_loaded)
					{
						@* The hint carries the whole path as well, since a long one scrolls its start out of the well: a title
						   beside it would show twice. Moka's own copy button writes the clipboard itself, which would slip past
						   the schedule that clears copied secrets, so the copy is ours. *@
						<div class="fb-crumbs" @onclick="BeginPathEdit">
							<Hint Text="@($"{_path} (click to type a path, Ctrl+L)")" Position="MokaTooltipPosition.BottomStart" Class="fb-crumbs-hint">
								<MokaBreadcrumb @key="_path" Look="MokaBreadcrumbLook.Path">
									<Root>
										<span class="@RootCrumbClass" @onclick="() => NavigateAsync(RemotePath.Root)" @onclick:stopPropagation="true">/</span>
									</Root>
									<ChildContent>
										@foreach (RemotePathSegment segment in FolderSegments)
										{
											<MokaBreadcrumbItem>
												<span class="fb-crumb" @onclick="() => NavigateAsync(segment.Path)" @onclick:stopPropagation="true">@segment.Name</span>
											</MokaBreadcrumbItem>
										}
									</ChildContent>
								</MokaBreadcrumb>
							</Hint>
							<span class="fb-crumbs-copy" @onclick:stopPropagation="true">
								<CopyButton Text="@_path" Label="Copy folder path" Position="MokaTooltipPosition.BottomEnd" />
							</span>
						</div>
					}
					break;
				case MokaFileControls.Refresh:
					<IconButton Icon="MokaIcons.Action.Refresh" Class="fb-refresh"
								Disabled="@(_fileSystem is null)" OnClick="() => RefreshAsync()" Label="Refresh" Shortcut="F5" />
					<IconButton Icon="MokaIcons.Action.Search" Class="fb-find"
								Disabled="@(!CanBrowse)" OnClick="() => FindFilesAsync(_path)" Label="Find files" Shortcut="Ctrl+Shift+F"
								Position="MokaTooltipPosition.BottomEnd" />
					break;
			}
		</ToolbarControl>
		<ToolbarEnd>
			@* A narrow browser leaves the create and upload buttons to its More actions menu, so nothing there can drop out. *@
			<MokaToolbar Dense Expandable Bordered="false" Rounded="MokaRounding.None" Class="fb-actions">
				@if (!IsNarrow)
				{
					<MokaToolbarGroup Priority="-1">
						<IconButton Icon="MokatermIcons.FolderPlus"
									Disabled="@(!CanBrowse)" OnClick="CreateFolderAsync" Label="New folder"
									Position="MokaTooltipPosition.BottomStart" />
						<IconButton Icon="MokatermIcons.FilePlus"
									Disabled="@(!CanBrowse)" OnClick="CreateFileAsync" Label="New file" Shortcut="Shift+F4" />
					</MokaToolbarGroup>
					<MokaToolbarGroup Priority="-2">
						<IconButton Icon="MokatermIcons.FileUpload"
									Disabled="@(!CanBrowse)" OnClick="PickAndUploadFilesAsync" Label="Upload files" />
						@if (LocalFiles.CanPickFolders)
						{
							<IconButton Icon="MokaIcons.Action.Upload"
										Disabled="@(!CanBrowse)" OnClick="PickAndUploadFolderAsync" Label="Upload folder" />
						}
					</MokaToolbarGroup>
					<MokaToolbarDivider />
				}
				<div class="fb-filter" data-moka-priority="3">
					<MokaTextField Value="@_filter"
								   ValueChanged="OnFilterChanged"
								   Size="MokaSize.Sm"
								   Placeholder="Filter"
								   StartIcon="MokaIcons.Content.Filter"
								   Clearable
								   DebounceDelay="150"
								   Disabled="@(!CanBrowse)"
								   Style="width:100%"
								   spellcheck="false"
								   autocomplete="off"
								   data-moka-file-filter=""
								   @onkeydown="OnFilterKeyDown" />
				</div>
				<MokaToolbarGroup Priority="1">
					<IconButton Variant="@(ShowHidden ? MokaVariant.Soft : MokaVariant.Text)"
								Color="@(ShowHidden ? MokaColor.Primary : MokaColor.Surface)"
								Icon="@(ShowHidden ? MokaIcons.Toggle.Eye : MokaIcons.Toggle.EyeOff)"
								OnClick="ToggleHiddenAsync"
								Label="@(ShowHidden ? "Hide hidden files" : "Show hidden files")"
								AriaLabel="Show hidden files"
								Pressed="ShowHidden" />
					@if (CanFollowTerminal)
					{
						<IconButton Variant="@(FollowTerminal ? MokaVariant.Soft : MokaVariant.Text)"
									Color="@(FollowTerminal ? MokaColor.Primary : MokaColor.Surface)"
									Icon="MokaIcons.Content.Link"
									OnClick="ToggleFollowTerminalAsync"
									Label="@FollowTitle"
									AriaLabel="Follow the terminal's folder"
									Pressed="FollowTerminal" />
					}
					@* A narrow browser has both in its More actions menu, and the pane only fits a roomy one. *@
					@if (!IsNarrow)
					{
						<IconButton Variant="@(IsTiles ? MokaVariant.Soft : MokaVariant.Text)"
									Color="@(IsTiles ? MokaColor.Primary : MokaColor.Surface)"
									Icon="MokaIcons.Navigation.Grid"
									OnClick="ToggleTiles"
									Label="@TilesTitle"
									AriaLabel="Show as tiles"
									Pressed="IsTiles" />
					}
					@if (CanShowDetails)
					{
						<IconButton Variant="@(_detailsOpen ? MokaVariant.Soft : MokaVariant.Text)"
									Color="@(_detailsOpen ? MokaColor.Primary : MokaColor.Surface)"
									Icon="MokaIcons.Navigation.PanelRight"
									OnClick="ToggleDetails"
									Label="@(_detailsOpen ? "Hide details" : "Show details")"
									AriaLabel="Show details"
									Pressed="_detailsOpen" />
					}
				</MokaToolbarGroup>
				@if (IsNarrow)
				{
					<MokaToolbarGroup Priority="2">
						<IconButton Icon="MokaIcons.Navigation.MoreHorizontal"
									Disabled="@(!CanBrowse)" OnClick="ShowActionsMenu" Label="More actions" aria-haspopup="menu"
									Position="@(CanElevate ? MokaTooltipPosition.Bottom : MokaTooltipPosition.BottomEnd)" />
						@if (CanElevate)
						{
							<IconButton Variant="@(ModeValue == RootMode ? MokaVariant.Soft : MokaVariant.Text)"
										Color="@(ModeValue == RootMode ? MokaColor.Error : MokaColor.Surface)"
										Icon="MokatermIcons.Root"
										Disabled="@(_switchingMode || _fileSystem is null)"
										OnClick="() => OnModeChangedAsync(IsElevated ? UserMode : RootMode)"
										Label="Run as root"
										Pressed="IsElevated"
										Position="MokaTooltipPosition.BottomEnd" />
						}
					</MokaToolbarGroup>
				}
				else if (CanElevate)
				{
					<MokaSpacer />
					<MokaToolbarGroup Priority="2">
						<MokaSegmentedControl Size="MokaSize.Xs" Value="@ModeValue" ValueChanged="OnModeChangedAsync" AriaLabel="Run as">
							<MokaSegment Value="@UserMode" Text="User" Icon="MokatermIcons.User" Disabled="@(_switchingMode || _fileSystem is null)" />
							<MokaSegment Value="@RootMode" Text="Root" Icon="MokatermIcons.Root" Disabled="@(_switchingMode || _fileSystem is null)" />
						</MokaSegmentedControl>
					</MokaToolbarGroup>
				}
			</MokaToolbar>
			@if (_alert is { } alert)
			{
				<div class="fb-alert">
					<MokaAlert @key="alert" Severity="MokaToastSeverity.Error" Title="@alert.Title" Dense Closable OnClose="() => DismissAlert(alert)">
						<div class="fb-alert-body">
							<span>@alert.Message</span>
							@if (alert.RetryAsRoot is not null)
							{
								<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Error" Size="MokaSize.Xs" StartIcon="MokatermIcons.Root"
											OnClick="() => RetryAsRootAsync(alert)">Retry as root</MokaButton>
							}
						</div>
					</MokaAlert>
				</div>
			}
			<div class="fb-progress">
				@if (IsBusy)
				{
					<MokaProgress />
				}
			</div>
		</ToolbarEnd>
		<NameCell Context="cell">
			@if (cell.Item.Path == _renamingPath)
			{
				@* The row opens a file on a double click and selects on a click, and the field needs both for itself. *@
				<div class="fb-name--renaming" @onclick:stopPropagation="true" @ondblclick:stopPropagation="true">
					<EntryRenameField Entry="cell.Item"
									  TakenNames="TakenNames(except: cell.Item.Name)"
									  Save="name => SaveRenameAsync(cell.Item, name)"
									  Closed="EndRename" />
				</div>
			}
			else
			{
				@cell.Name
				@if (cell.Item.LinkTarget is { Length: > 0 } target)
				{
					<span class="fb-link" title="@target">&rarr; @target</span>
				}
			}
		</NameCell>
		<Empty Context="empty">
			@if (!ShowsList)
			{
				StateInfo state = DescribeState();
				<MokaEmptyState Icon="@state.Icon" Title="@state.Title" Description="@state.Description">
					@if (state.CanRetry)
					{
						<MokaButton Size="MokaSize.Sm" StartIcon="MokatermIcons.Reconnect" OnClick="RetryOpenAsync">Try again</MokaButton>
					}
				</MokaEmptyState>
			}
			else if (IsFirstListing)
			{
				<div class="fb-skeleton">
					<MokaSkeleton Lines="6" />
				</div>
			}
			else if (IsFiltering)
			{
				@empty.Default
			}
			else if (OnlyHiddenEntries)
			{
				<MokaEmptyState Icon="MokaIcons.Toggle.EyeOff" Title="Only hidden items" Description="@HiddenOnlyText" Live="true">
					<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" StartIcon="MokaIcons.Toggle.Eye" OnClick="ToggleHiddenAsync">Show hidden files</MokaButton>
				</MokaEmptyState>
			}
			else
			{
				<MokaEmptyState Icon="MokatermIcons.FolderOpen" Title="Empty folder" Description="Drop files here to upload them." Live="true" />
			}
		</Empty>
		<StatusEnd>
			@* A narrow browser has no room beside the counts; Paste in the menus still says something is held. *@
			@if (!IsNarrow && CanBrowse && ClipboardText is { } held)
			{
				<MokaStatusBarItem Text="@held" Tooltip="Ctrl+V pastes them into the folder on screen" />
			}
			@if (IsElevated)
			{
				<MokaTag Text="Root" Icon="MokatermIcons.Root" Color="MokaColor.Error" Size="MokaSize.Xs" />
			}
			else if (_fileSystem is not null)
			{
				<MokaStatusBarItem Tooltip="Operations run as this account">
					<span class="fb-account">@AccountLabel</span>
				</MokaStatusBarItem>
			}
		</StatusEnd>
	</MokaFileBrowser>

	@if (_dragOver)
	{
		<div class="fb-drop">
			<MokaFlexbox Direction="MokaDirection.Column" Align="MokaAlign.Center" Gap="MokaSpacingScale.Sm">
				<MokaIcon Icon="MokatermIcons.FileUpload" SizeValue="32px" Color="MokaColor.Primary" />
				<MokaText Element="span" Size="MokaSize.Md" Weight="MokaFontWeight.Semibold">Drop to upload</MokaText>
				<MokaText Element="span" Size="MokaSize.Sm" Mono>@_path</MokaText>
				@if (IsElevated)
				{
					<MokaTag Text="As root" Icon="MokatermIcons.Root" Color="MokaColor.Error" />
				}
				else
				{
					<MokaTag Text="@DropAccountText" Icon="MokatermIcons.User" />
				}
			</MokaFlexbox>
		</div>
	}
</div>

@code {

	private static RenderFragment<RemoteFileEntry> CellOf(Func<RemoteFileEntry, string> text) => entry =>
		@<span title="@text(entry)">@text(entry)</span>;

	private RenderFragment<IReadOnlyList<RemoteFileEntry>> DetailsContent => entries =>
		@<EntryDetails Entries="entries" FileSystem="_fileSystem" Active="IsActive" Folder="@_path" FolderSummary="@ItemCountText" />;

}
