@namespace Mokaterm.UI.FileBrowser.Dialogs
@using Mokaterm.UI.Common.Components
@using Mokaterm.UI.FileBrowser.Compare

<DialogFrame>
	<ChildContent>
		<div class="fc">
			<div class="fc-sides">
				<div class="fc-side">
					<MokaText Element="span" SizeValue="10px" Weight="MokaFontWeight.Semibold" Transform="MokaTextTransform.Uppercase" Style="@TextStyles.MicroLabel">Local</MokaText>
					<MokaText Element="span" Size="MokaSize.Sm" Mono Truncate title="@LocalName">@LocalName</MokaText>
					<MokaText Element="span" Size="MokaSize.Xs" Style="@TextStyles.Muted">@EntryVisuals.Count(_local.Count, "file", "files")</MokaText>
				</div>
				<MokaIcon Icon="MokaIcons.Navigation.ArrowRight" Size="MokaSize.Sm" />
				<div class="fc-side">
					<MokaText Element="span" SizeValue="10px" Weight="MokaFontWeight.Semibold" Transform="MokaTextTransform.Uppercase" Style="@TextStyles.MicroLabel">Server</MokaText>
					<MokaText Element="span" Size="MokaSize.Sm" Mono Truncate title="@Destination">@Destination</MokaText>
					@if (AsRoot)
					{
						<MokaTag Text="as root" Icon="MokatermIcons.Root" Color="MokaColor.Error" Size="MokaSize.Xs" />
					}
					else
					{
						<MokaText Element="span" Size="MokaSize.Xs" Style="@TextStyles.Muted">@RemoteCountText</MokaText>
					}
				</div>
			</div>

			@switch (_state)
			{
				case CompareState.Reading:
					<div class="fc-reading">
						<MokaSpinner SizeValue="12px" />
						<MokaText Element="span" Size="MokaSize.Xs" Style="@TextStyles.Muted" Truncate title="@ReadingText">@ReadingText</MokaText>
					</div>
					break;
				case CompareState.Failed:
					<MokaAlert Severity="MokaToastSeverity.Error" Title="Could not read the server folder" Dense>
						<div class="fc-failed">
							<span>@_error</span>
							<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Error" Size="MokaSize.Xs" OnClick="ReadAsync">Try again</MokaButton>
						</div>
					</MokaAlert>
					break;
				default:
					@* Enter on these, and on a check box below, must not press Upload: it replaces files without asking. *@
					<div class="fc-bar" data-no-submit="true">
						<MokaSegmentedControl Size="MokaSize.Xs" Value="@FilterValue" ValueChanged="OnFilterChanged" AriaLabel="Show">
							<MokaSegment Value="@DifferencesFilter" Text="Differences" />
							<MokaSegment Value="@AllFilter" Text="All" />
						</MokaSegmentedControl>
						<Hint Text="For a server whose times cannot be trusted. Changing this ticks the files again.">
							<MokaCheckbox Label="Compare sizes only" Value="@_ignoreTimes" ValueChanged="OnIgnoreTimesChanged" Size="MokaSize.Sm" />
						</Hint>
						@if (CheckContents is not null && (_contentCandidates > 0 || _contentChecking))
						{
							<Hint Text="Hash both copies of the files whose sizes match and only the times differ. Matching ones count as the same.">
								<MokaButton Variant="MokaVariant.Outlined"
											Color="MokaColor.Surface"
											Size="MokaSize.Xs"
											StartIcon="MokaIcons.Status.CheckCircle"
											Disabled="_contentChecking"
											OnClick="CheckContentsAsync">
									@ContentButtonText
								</MokaButton>
							</Hint>
						}
					</div>

					<div class="fc-counts">
						@foreach (FolderCompareStatus status in StatusOrder)
						{
							@if (_counts.GetValueOrDefault(status) is > 0 and var count)
							{
								<MokaTag @key="status" Text="@CountText(status, count)" Size="MokaSize.Xs" Color="@StatusColor(status)" />
							}
						}
					</div>

					@if (_contentError is { } contentError)
					{
						<MokaAlert Severity="MokaToastSeverity.Warning" Dense>@contentError</MokaAlert>
					}

					@if (IncompleteNote is { } note)
					{
						<MokaCallout Type="MokaCalloutType.Warning" Title="The server side is incomplete">@note</MokaCallout>
					}

					<div class="fc-table" data-no-submit="true">
						<MokaTable TItem="FolderCompareRow"
								   Items="_shown"
								   ItemKey="RowKey"
								   ShowToolbar="false"
								   ShowPagination="false"
								   Dense="true"
								   FixedHeader="true"
								   Height="320px"
								   Virtualize="@(_shown.Count > VirtualizeThreshold)"
								   VirtualRowHeight="RowHeight">
							<ChildContent>
								<MokaColumn TItem="FolderCompareRow" Sortable="false" Resizable="false" Width="36px">
									<HeaderTemplate>
										<MokaCheckbox Value="@AllShownChecked"
													  Indeterminate="@(!AllShownChecked && SomeShownChecked)"
													  ValueChanged="SetAllShown"
													  Disabled="@(!AnyShownUploadable)"
													  Size="MokaSize.Sm"
													  aria-label="Tick every file shown" />
									</HeaderTemplate>
									<CellTemplate Context="row">
										<Hint Text="@(row.CanUpload ? null : "Nothing on the server is deleted")">
											<MokaCheckbox Value="@_checked.Contains(row.RelativePath)"
														  ValueChanged="@(value => SetChecked(row, value))"
														  Disabled="@(!row.CanUpload)"
														  Size="MokaSize.Sm"
														  aria-label="@("Upload " + row.RelativePath)" />
										</Hint>
									</CellTemplate>
								</MokaColumn>
								<MokaColumn TItem="FolderCompareRow" Title="Path" Field="PathField" MinWidth="140px">
									<CellTemplate Context="row">
										<div class="fc-cell fc-mono" title="@row.RelativePath">@row.RelativePath</div>
									</CellTemplate>
								</MokaColumn>
								<MokaColumn TItem="FolderCompareRow" Title="Status" Field="StatusField" Width="104px">
									<CellTemplate Context="row">
										<div class="@StatusClass(row.Status)">@StatusLabel(row.Status)</div>
									</CellTemplate>
								</MokaColumn>
								<MokaColumn TItem="FolderCompareRow" Title="Local" Sortable="false" Width="176px">
									<CellTemplate Context="row">
										@if (row.Local is { } local)
										{
											<div class="fc-cell fc-copy" title="@ExactTime(local.LastModified)">
												<span class="fc-size">@LocalSize(local)</span>
												<span>@DisplayFormat.Timestamp(local.LastModified)</span>
											</div>
										}
									</CellTemplate>
								</MokaColumn>
								<MokaColumn TItem="FolderCompareRow" Title="Server" Sortable="false" Width="176px">
									<CellTemplate Context="row">
										@if (row.Remote is { } remote)
										{
											<div class="fc-cell fc-copy" title="@ExactTime(remote.LastModified)">
												<span class="fc-size">@EntryVisuals.SizeText(remote)</span>
												<span>@DisplayFormat.Timestamp(remote.LastModified)</span>
											</div>
										}
									</CellTemplate>
								</MokaColumn>
							</ChildContent>
							<EmptyContent>
								<MokaEmptyState Icon="MokaIcons.Status.CheckCircle" Title="No differences" Description="@SameText" />
							</EmptyContent>
						</MokaTable>
					</div>

					<MokaText Size="MokaSize.Xs" Style="@TextStyles.Muted">Files only on the server stay as they are: nothing there is deleted.</MokaText>
					break;
			}
		</div>
	</ChildContent>
	<Actions>
		<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" Size="MokaSize.Sm" OnClick="Cancel">Cancel</MokaButton>
		<Hint Text="Replaces what the server has at these paths without asking again" Position="MokaTooltipPosition.TopEnd">
			<MokaButton Size="MokaSize.Sm"
						Color="@(AsRoot ? MokaColor.Error : MokaColor.Primary)"
						StartIcon="@(AsRoot ? MokatermIcons.Root : MokatermIcons.FileUpload)"
						Disabled="@(!CanUpload)"
						OnClick="Upload"
						data-dialog-default="true">
				@UploadText
			</MokaButton>
		</Hint>
	</Actions>
</DialogFrame>
