@using Moka.Red.Feedback.Dialog

@* The app tool on screen, in a dialog sized like a session tool's. The boundary keeps a tool's failure inside it. *@
@if (Shell.AppTool is { } tool)
{
	bool wide = tool.Size == SessionToolSize.Wide;
	<HeadedDialog Open="true"
				  OpenChanged="OnOpenChanged"
				  Icon="tool.Icon"
				  Title="@tool.Title"
				  DialogSize="@(wide ? MokaDialogSize.ExtraLarge : MokaDialogSize.Large)"
				  Fill="wide">
		<ViewBoundary @key="tool" Name="@tool.Title" Fill="wide">
			<DynamicComponent Type="tool.Component" />
		</ViewBoundary>
	</HeadedDialog>
}
