@* Asks for a username and password during login. *@
@inherits PromptDialogBase

<MokaDialog Open="true"
			Title="@Prompt.Title"
			DialogSize="MokaDialogSize.Small"
			CloseOnBackdropClick="false"
			OnClose="CancelAsync">
	<ChildContent>
		<PromptBody @ref="Body">
			@if (!string.IsNullOrWhiteSpace(Prompt.Message))
			{
				<MokaText Size="MokaSize.Sm" Style="color:var(--moka-color-on-surface-variant)">@Prompt.Message</MokaText>
			}
			<MokaTextField Label="Username"
						   @bind-Value="_username"
						   ReadOnly="@(!Prompt.AllowUsernameEdit)"
						   spellcheck="false"
						   autocomplete="off"
						   data-autofocus="@Flag(_focusUsername)" />
			<MokaPasswordField Label="Password"
							   @bind-Value="_password"
							   autocomplete="off"
							   data-autofocus="@Flag(!_focusUsername)" />
			@if (Prompt.OfferSave)
			{
				<MokaCheckbox Label="Save password" @bind-Value="_save" />
			}
		</PromptBody>
	</ChildContent>
	<Actions>
		<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" OnClick="CancelAsync">Cancel</MokaButton>
		<MokaButton Disabled="@(Prompt.RequireUsername && string.IsNullOrWhiteSpace(_username))" data-primary="true" OnClick="SubmitAsync">Log in</MokaButton>
	</Actions>
</MokaDialog>

@code {
	private string _username = "";
	private string _password = "";
	private bool _save;
	private bool _focusUsername;

	[Parameter, EditorRequired]
	public CredentialPrompt Prompt { get; set; } = default!;

	/// <summary>Raised once with the answer, or null when cancelled.</summary>
	[Parameter]
	public EventCallback<CredentialPromptResult?> OnResult { get; set; }

	protected override void OnInitialized()
	{
		_username = Prompt.Username ?? "";
		_focusUsername = Prompt.AllowUsernameEdit && _username.Length == 0;
	}

	private Task SubmitAsync()
	{
		CredentialPromptResult result = new(_username.Trim(), _password, _save);
		_password = "";
		return AnswerAsync(OnResult, result);
	}

	private Task CancelAsync()
	{
		_password = "";
		return AnswerAsync(OnResult, (CredentialPromptResult?)null);
	}
}
