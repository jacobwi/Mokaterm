@* Asks for one secret, such as a key passphrase or a sudo password. *@
@inherits PromptDialogBase

<MokaDialog Open="true"
			Title="@Prompt.Title"
			DialogSize="MokaDialogSize.Small"
			CloseOnBackdropClick="false"
			OnClose="CancelAsync">
	<ChildContent>
		<PromptBody @ref="Body">
			@if (!string.IsNullOrWhiteSpace(Prompt.Message))
			{
				<MokaText Size="MokaSize.Sm" Style="color:var(--moka-color-on-surface-variant)">@Prompt.Message</MokaText>
			}
			<MokaPasswordField Label="@Prompt.Label" @bind-Value="_secret" autocomplete="off" data-autofocus="true" />
			@if (Prompt.OfferRemember)
			{
				<MokaCheckbox Label="Remember for this session" @bind-Value="_remember" />
			}
		</PromptBody>
	</ChildContent>
	<Actions>
		<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" OnClick="CancelAsync">Cancel</MokaButton>
		<MokaButton data-primary="true" OnClick="SubmitAsync">OK</MokaButton>
	</Actions>
</MokaDialog>

@code {
	private string _secret = "";
	private bool _remember;

	[Parameter, EditorRequired]
	public SecretPrompt Prompt { get; set; } = default!;

	/// <summary>Raised once with the answer, or null when cancelled.</summary>
	[Parameter]
	public EventCallback<SecretPromptResult?> OnResult { get; set; }

	private Task SubmitAsync()
	{
		SecretPromptResult result = new(_secret, _remember);
		_secret = "";
		return AnswerAsync(OnResult, result);
	}

	private Task CancelAsync()
	{
		_secret = "";
		return AnswerAsync(OnResult, (SecretPromptResult?)null);
	}
}
