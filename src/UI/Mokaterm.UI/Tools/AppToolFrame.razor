@* An app tool in the shared frame. Its one-line description goes after the title only when the settings ask for it;
   otherwise pointing at the title shows it. *@
<ToolFrame Presentation="Presentation"
		   Target="AppToolActions.Target(Tool)"
		   Icon="Tool.Icon"
		   Title="@Tool.Title"
		   Size="Tool.Size"
		   Detail="Description"
		   Hint="@(_showDescription ? null : Tool.Description)"
		   OnPopOut="PopOutAsync"
		   OnReturn="ReturnToDialog"
		   OnClose="CloseDialog">
	@* The tool's own boundary, so a tool that throws says so itself and can be loaded again. *@
	<ViewBoundary Name="@Tool.Title" Fill>
		<DynamicComponent Type="Tool.Component" />
	</ViewBoundary>
</ToolFrame>

@code {
	private RenderFragment? Description => _showDescription && Tool.Description is { Length: > 0 } text
		? @<span class="mt-tool-description" title="@text">@text</span>
		: null;
}
