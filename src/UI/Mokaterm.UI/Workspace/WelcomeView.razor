@using Moka.Red.Layout.Card
@using Moka.Red.Layout.GridBackground
@using Moka.Red.Layout.PageHeader
@using Moka.Red.Primitives.Avatar

@* The workspace's home screen. A vault with no host in it is led through getting started, a filled one gets its
   favorites and recent logins back, and every action carries the keys in force for it. *@

<div class="mt-welcome">
	@if (!Catalog.IsLoaded)
	{
		@* Leading with "nothing saved yet" before the catalog is read would be wrong for everyone who has hosts. *@
		<div class="mt-welcome-loading" role="status" aria-label="Reading your connections">
			<MokaSpinner SpinnerStyle="MokaSpinnerStyle.Dots" Size="MokaSize.Sm" />
		</div>
	}
	else
	{
		<MokaGridBackground Class="mt-welcome-hero"
							Pattern="MokaGridPattern.Dots"
							CellSize="16"
							PatternOpacity="1"
							FadeMask="radial-gradient(ellipse 70% 150% at 50% 0%, black 15%, transparent 80%)"
							BackgroundColor="transparent">
			<div class="mt-welcome-column mt-welcome-hero-column">
				<MokaPageHeader Class="mt-welcome-head" Media="Mark" TitleContent="TitleLine" Said="@Summary" Lead="@Lede" />
			</div>
		</MokaGridBackground>

		<div class="mt-welcome-column mt-welcome-body">
			@if (_restore.Count > 0)
			{
				<MokaCallout Type="MokaCalloutType.Note" Icon="MokatermIcons.History" Title="Where you left off">
					<FixAction>
						<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" StartIcon="MokatermIcons.Reconnect" OnClick="ReopenAsync">
							Reopen
						</MokaButton>
						<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" Size="MokaSize.Sm" OnClick="DismissRestore">
							Not now
						</MokaButton>
					</FixAction>
					<ChildContent>
						<p class="mt-welcome-restore-text">@RestoreText</p>
						<div class="mt-welcome-restore-logins">
							@* No @key: two tabs of one login leave its id in the list twice. *@
							@foreach ((HostProfile host, ConnectionProfile login) in _restore.Take(RestoreNamesShown))
							{
								<MokaTag Text="@login.GetTitle(host)" Icon="@Contributions.GetProtocolIcon(login.ProtocolId)" />
							}
							@if (_restore.Count > RestoreNamesShown)
							{
								<span class="mt-welcome-restore-more">@(_restore.Count - RestoreNamesShown) more</span>
							}
						</div>
					</ChildContent>
				</MokaCallout>
			}

			@if (_hasHosts)
			{
				@if (_favorites.Count == 0 && _recent.Count == 0)
				{
					<MokaEmptyState Framed
									Icon="MokaIcons.Toggle.Star"
									Title="Your hosts are in the connections panel"
									Description="A login joins Recent once you have connected to it, and a favorite stays here for good: select the star beside a login.">
						@if (Shell.ConnectionsPanelCollapsed)
						{
							<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" StartIcon="MokatermIcons.PanelLeft" OnClick="ShowConnections">
								Show the connections panel
							</MokaButton>
						}
						@* The sentence only makes sense while the panel has a shortcut, which the user can take away. *@
						@if (Keys(ShellCommandIds.ToggleConnections) is { } panelKeys)
						{
							<span class="mt-welcome-sentence">Hide that panel, or bring it back, with @panelKeys.</span>
						}
					</MokaEmptyState>
				}
				else
				{
					<MokaGrid MinColumn="320px" GapValue="var(--moka-grid-gap)" AlignItems="MokaAlign.Start" Class="mt-welcome-lists">
						@if (_favorites.Count > 0)
						{
							<section class="mt-welcome-section" aria-labelledby="@SectionId("favorites")">
								@SectionHead("favorites", "Favorites", _favoritesTotal)
								<MokaCard NoPadding Class="mt-welcome-card">
									<MokaList Dense>
										@foreach ((HostProfile host, ConnectionProfile login) in _favorites)
										{
											@LoginRow(host, login, null)
										}
									</MokaList>
								</MokaCard>
								@if (_favoritesTotal > _favorites.Count)
								{
									<p class="mt-welcome-more">@(_favoritesTotal - _favorites.Count) more in the connections panel.</p>
								}
							</section>
						}

						@if (_recent.Count > 0)
						{
							<section class="mt-welcome-section" aria-labelledby="@SectionId("recent")">
								@SectionHead("recent", "Recent", null)
								<MokaCard NoPadding Class="mt-welcome-card">
									<MokaList Dense>
										@foreach ((HostProfile host, ConnectionProfile login) in _recent)
										{
											@LoginRow(host, login, login.LastConnectedAt)
										}
									</MokaList>
								</MokaCard>
							</section>
						}
					</MokaGrid>
				}

				@* The same actions as the empty screen, without the explanations: this user has been here before. *@
				<section class="mt-welcome-section" aria-labelledby="@SectionId("start")">
					@SectionHead("start", "Start", null)
					<div class="mt-welcome-tiles mt-welcome-tiles--compact">
						@ActionTile(MokatermIcons.Server, "New host", null, ShellCommandIds.NewHost, () => Connections.NewHost())
						@ActionTile(MokatermIcons.QuickConnect, "Quick connect", null, ShellCommandIds.QuickConnect, Shell.FocusQuickConnect)
						@ActionTile(MokatermIcons.FileUpload, "Import hosts", null, ShellCommandIds.ImportConnections, () => Connections.ImportConnections())
						@ActionTile(MokatermIcons.Keyboard, "Keyboard shortcuts", null, ShellCommandIds.Shortcuts, () => Shell.SetShortcutsOpen(true))
					</div>
				</section>
			}
			else
			{
				<section class="mt-welcome-section" aria-labelledby="@SectionId("start")">
					@SectionHead("start", "Start here", null)
					<div class="mt-welcome-tiles">
						@ActionTile(
							MokatermIcons.Server,
							"Add a host",
							"An address, a user and a protocol, kept in the vault.",
							ShellCommandIds.NewHost,
							() => Connections.NewHost(),
							lead: true)
						@ActionTile(
							MokatermIcons.FileUpload,
							"Import from another client",
							"Reads an OpenSSH config, PuTTY or WinSCP. Passwords stay where they are.",
							ShellCommandIds.ImportConnections,
							() => Connections.ImportConnections())
						@ActionTile(
							MokatermIcons.QuickConnect,
							"Connect without saving",
							"Puts the cursor in the quick connect box at the top. Type user@host; nothing is written to the vault.",
							ShellCommandIds.QuickConnect,
							Shell.FocusQuickConnect)
						@ActionTile(
							MokatermIcons.Keyboard,
							"Keyboard shortcuts",
							"Every command and the keys for it. Rebind them in Settings, Keyboard.",
							ShellCommandIds.Shortcuts,
							() => Shell.SetShortcutsOpen(true))
					</div>
				</section>

				@if (Protocols.Protocols.Count > 0)
				{
					<section class="mt-welcome-section" aria-labelledby="@SectionId("protocols")">
						@SectionHead("protocols", "Connects over", null)
						<div class="mt-welcome-protocols">
							@foreach (ProtocolDescriptor protocol in Protocols.Protocols)
							{
								<Hint @key="protocol.Id" Text="@protocol.Description">
									<MokaTag Text="@protocol.DisplayName" Icon="@Contributions.GetProtocolIcon(protocol.Id)" />
								</Hint>
							}
						</div>
					</section>
				}
			}
		</div>
	}
</div>

@code {
	private RenderFragment Mark => @<span class="mt-welcome-mark" aria-hidden="true">&gt;_</span>;

	private RenderFragment TitleLine => @<h2 class="mt-welcome-title">@(_hasHosts ? "Ready to connect" : "Nothing saved yet")</h2>;

	private RenderFragment SectionHead(string id, string label, int? count) =>
		@<div class="mt-welcome-section-head">
			<h3 class="mt-welcome-label" id="@SectionId(id)">@label</h3>
			@if (count is { } total)
			{
				<span class="mt-welcome-count">@total.ToString(CultureInfo.CurrentCulture)</span>
			}
		</div>;

	private RenderFragment LoginRow(HostProfile host, ConnectionProfile login, DateTimeOffset? lastConnected) =>
		@<MokaListItem @key="login.Id"
					   OnClick="() => Sessions.OpenAsync(login.Id, reuseExisting: true)"
					   OnContextMenu="e => Menu.Show(e, Connections.LoginMenu(host, login))">
			<ChildContent>
				@* The row carries its own text rather than the list's one-line secondary text, so a long user@host wraps. *@
				<div class="mt-welcome-login">
					<MokaAvatar Tile Icon="@Contributions.GetProtocolIcon(login.ProtocolId)" SizeValue="2.25rem" Class="mt-welcome-login-icon" />
					<span class="mt-welcome-login-text">
						<span class="mt-welcome-login-title">@login.GetTitle(host)</span>
						<span class="mt-welcome-login-meta">
							<span class="mt-welcome-login-host" style="color:@HostAccent.For(host)">@host.DisplayName</span>
							<span>@Protocols.DisplayName(login.ProtocolId)</span>
							@if (PortOf(login) is { } port)
							{
								<span class="mt-welcome-login-port">:@port.ToString(CultureInfo.InvariantCulture)</span>
							}
							@if (HostEnvironmentDisplay.Tag(host.Environment) is { } environment)
							{
								<MokaTag Text="@environment" Size="MokaSize.Xs" Color="@HostEnvironmentDisplay.Color(host.Environment)" />
							}
						</span>
					</span>
				</div>
			</ChildContent>
			<EndContent>
				@* The row opens the login on a click, and the star's click would reach it too. *@
				<span class="mt-welcome-login-end" @onclick:stopPropagation="true">
					@if (lastConnected is { } connectedAt)
					{
						<Hint Text="@DisplayFormat.Timestamp(connectedAt)" Position="MokaTooltipPosition.BottomEnd">
							<span class="mt-welcome-when">@DisplayFormat.Relative(connectedAt, Time.GetUtcNow())</span>
						</Hint>
					}
					@* A favorite is more than a menu item: the star is the affordance, on the row, for mouse and keyboard. *@
					<IconButton Icon="MokaIcons.Toggle.Star"
								Label="@(login.IsFavorite ? "Remove from favorites" : "Add to favorites")"
								AriaLabel="@(login.IsFavorite ? $"Remove {login.GetTitle(host)} from favorites" : $"Add {login.GetTitle(host)} to favorites")"
								Active="login.IsFavorite"
								Pressed="login.IsFavorite"
								Size="MokaSize.Xs"
								Position="MokaTooltipPosition.BottomEnd"
								OnClick="() => Connections.ToggleFavoriteAsync(login)" />
				</span>
			</EndContent>
		</MokaListItem>;

	// The detail wraps rather than being cut: what an action does is the point of the first-run tiles.
	private RenderFragment ActionTile(MokaIconDefinition icon, string title, string? detail, string commandId, Action run, bool lead = false) =>
		@<MokaCard Clickable NoPadding OnClick="run" Class="@(lead ? "mt-welcome-tile mt-welcome-tile--lead" : "mt-welcome-tile")">
			<div class="mt-welcome-tile-body">
				<MokaAvatar Tile Icon="icon" SizeValue="@(detail is null ? "2rem" : "2.5rem")" Class="mt-welcome-tile-icon" />
				<span class="mt-welcome-tile-text">
					<span class="mt-welcome-tile-title">@title</span>
					@if (detail is not null)
					{
						<span class="mt-welcome-tile-detail">@detail</span>
					}
					@Keys(commandId)
				</span>
			</div>
		</MokaCard>;

	/// <summary>The keys a command answers to now, so a binding changed in settings shows here.</summary>
	private static RenderFragment? Keys(string commandId) =>
		ShellShortcuts.KeysFor(commandId) is { Count: > 0 } keys ? KeyCaps(keys) : null;

	private static RenderFragment KeyCaps(IReadOnlyList<string> keys) =>
		@<span class="mt-welcome-keys">
			@foreach (string key in keys)
			{
				<MokaKbd>@key</MokaKbd>
			}
		</span>;
}
