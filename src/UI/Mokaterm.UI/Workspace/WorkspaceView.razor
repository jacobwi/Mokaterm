<div class="mt-workspace">
	<div class="mt-workspace-body">
		<div class="mt-workspace-sessions" style="@(Shell.SettingsOpen ? "display:none" : null)">
			<PaneLayoutView Layout="_layout">
				<Pane>
					<WorkspacePane @key="context" PaneId="context" Focused="@(_split && context == _focusedPane)" />
				</Pane>
			</PaneLayoutView>
		</div>

		@if (Shell.SettingsOpen)
		{
			<SettingsView />
		}
	</div>
</div>
