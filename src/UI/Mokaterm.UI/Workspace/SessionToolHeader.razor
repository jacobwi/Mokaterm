@* The header of a session tool's own window. Its dialog draws the same icon, title and session in Moka's header. *@
<DialogHeader Icon="Tool.Icon" Title="@Tool.Title" Class="@Class">
	<Detail>
		<SessionToolSubject Session="Session" />
	</Detail>
</DialogHeader>

@code {
	[Parameter, EditorRequired]
	public SessionToolDescriptor Tool { get; set; } = default!;

	[Parameter, EditorRequired]
	public ISessionHandle Session { get; set; } = default!;

	[Parameter]
	public string? Class { get; set; }
}
