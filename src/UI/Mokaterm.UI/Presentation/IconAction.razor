@* An icon-only button with a tooltip, used in the app bar, panel headers and the session toolbar. It keeps the
   parameters those callers use; the button and its tooltip are IconButton's. *@

<IconButton Icon="Icon"
			Label="@Title"
			Shortcut="@Shortcut"
			Size="Size"
			Active="Active"
			Pressed="@(Active ? true : null)"
			Dot="@DotColor"
			Disabled="Disabled"
			Position="TooltipPosition"
			OnClick="OnClick" />

@code {
	[Parameter, EditorRequired]
	public MokaIconDefinition Icon { get; set; }

	[Parameter, EditorRequired]
	public string Title { get; set; } = "";

	/// <summary>Shown after the title, for example <c>Ctrl+Shift+L</c>.</summary>
	[Parameter]
	public string? Shortcut { get; set; }

	[Parameter]
	public EventCallback<MouseEventArgs> OnClick { get; set; }

	[Parameter]
	public bool Disabled { get; set; }

	/// <summary>Colors the icon with the accent, for toggles that are on.</summary>
	[Parameter]
	public bool Active { get; set; }

	/// <summary>
	/// A small glowing dot on the icon's corner, in this CSS colour, for something going on behind the button such as a
	/// recording. The title says what it means.
	/// </summary>
	[Parameter]
	public string? DotColor { get; set; }

	[Parameter]
	public MokaSize Size { get; set; } = MokaSize.Sm;

	/// <summary>
	/// Where the tooltip goes, which must never be over the icons next to it. In a row of icons (a toolbar, a panel
	/// header) that is Bottom, or BottomStart and BottomEnd for the first and last button against a window or panel edge;
	/// Top for a row at the bottom of a view (a status bar, a footer); Left or Right only in a column of icons (a side
	/// rail). The tooltip is placed against the window and moves to the side with room at its edges.
	/// </summary>
	[Parameter]
	public MokaTooltipPosition TooltipPosition { get; set; } = MokaTooltipPosition.Bottom;
}
