@namespace Mokaterm.UI.Common.ToolPages
@typeparam TItem
@using Moka.Red.Core.Theming
@using Moka.Red.Data.Table

<div class="@WrapperClass" style="@RowStyle">
	<MokaTable TItem="TItem"
			   Items="Items"
			   ItemKey="ItemKey"
			   Label="@Label"
			   ShowToolbar="ShowColumnToggle"
			   ShowColumnToggle="ShowColumnToggle"
			   ShowPagination="false"
			   Density="MokaTableDensity.Compact"
			   FixedHeader="true"
			   Height="100%"
			   Virtualize="Virtualize"
			   VirtualRowHeight="RowPixels"
			   Selectable="IsPickable"
			   SelectedItems="SelectedSet"
			   SelectedItemsChanged="PickedChanged"
			   BulkActions="BulkActions"
			   ItemName="ItemName"
			   ItemsName="@ItemsName"
			   BulkClearIcon="true"
			   OnRowClick="OnRowClick"
			   OnRowContextMenu="OnRowMenu"
			   RowClass="RowClassFor"
			   RowActions="RowActions"
			   Text="Words"
			   ActionsColumnWidth="@ActionsWidth"
			   GroupBy="@GroupColumnTitle"
			   GroupHeaderTemplate="GroupHeader"
			   InitiallyCollapsedGroups="CollapsedGroups"
			   OnGroupToggled="GroupToggled"
			   State="_state"
			   StateChanged="_stateChanged"
			   Loading="Loading"
			   EmptyIcon="EmptyIcon"
			   EmptyTitle="@EmptyTitle"
			   EmptyText="@EmptyText"
			   FootContent="FootContent">
		@if (GroupBy is not null)
		{
			<MokaColumn TItem="TItem" Title="@GroupColumn" GroupKey="GroupBy" Visible="false" Fixed="true" Sortable="false" Resizable="false" />
		}
		@ChildContent
	</MokaTable>
</div>
