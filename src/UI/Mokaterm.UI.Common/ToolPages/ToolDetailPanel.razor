@namespace Mokaterm.UI.Common.ToolPages
@using Moka.Red.Primitives.StatusDot
@using Moka.Red.Primitives.Typography

@* The selected row's panel on a list page (ToolPageFrame's Detail): a title, the row's actions and its details. Row
   actions live here and in the row's menu, never as a line of buttons on every row. *@
<aside class="mt-detail" aria-label="@Title">
	<header class="mt-detail-head">
		@if (DotColor is { } color)
		{
			<MokaStatusDot Size="MokaSize.Xs" Color="color" Glow="DotGlow" />
		}
		<div class="mt-detail-title">
			<MokaText Element="h4" Size="MokaSize.Sm" Weight="MokaFontWeight.Semibold" Mono="Mono" Truncate title="@Title">@Title</MokaText>
			@if (Subtitle is { Length: > 0 } subtitle)
			{
				<MokaText Element="span" Size="MokaSize.Xs" Truncate Class="mt-detail-subtitle" title="@subtitle">@subtitle</MokaText>
			}
		</div>
		@if (OnClose.HasDelegate)
		{
			<MokaButton Variant="MokaVariant.Text"
						Color="MokaColor.Surface"
						Size="MokaSize.Xs"
						StartIcon="MokaIcons.Navigation.Close"
						OnClick="OnClose"
						title="Close the details"
						aria-label="Close the details" />
		}
	</header>
	@if (Actions is not null)
	{
		<div class="mt-detail-actions">@Actions</div>
	}
	<div class="mt-detail-body">@ChildContent</div>
</aside>

@code {
	[Parameter, EditorRequired]
	public string Title { get; set; } = "";

	[Parameter]
	public string? Subtitle { get; set; }

	/// <summary>Names, units and paths read best in mono; a form's title does not.</summary>
	[Parameter]
	public bool Mono { get; set; } = true;

	[Parameter]
	public MokaColor? DotColor { get; set; }

	[Parameter]
	public bool DotGlow { get; set; }

	[Parameter]
	public RenderFragment? Actions { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	[Parameter]
	public EventCallback OnClose { get; set; }
}
