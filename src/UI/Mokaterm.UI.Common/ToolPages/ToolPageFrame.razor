@namespace Mokaterm.UI.Common.ToolPages
@using Moka.Red.Feedback.Alert
@using Moka.Red.Feedback.Loading
@using Moka.Red.Feedback.Toast
@using Moka.Red.Forms.SearchInput
@using Moka.Red.Primitives.Typography

@* Every page of a paged tool has this shape: a header (title, one-line summary, filter, one primary action, refresh),
   optional chips, then either a list with its detail panel beside it or below it, or a page that scrolls. *@
<section class="mt-page" aria-label="@Title">
	<header class="mt-page-head">
		<div class="mt-page-title">
			<MokaText Element="h3" Size="MokaSize.Sm" Weight="MokaFontWeight.Semibold" Truncate>@Title</MokaText>
			@if (Summary is { Length: > 0 } summary)
			{
				<MokaText Element="span" Size="MokaSize.Xs" Mono Truncate Class="mt-page-summary" title="@summary">@summary</MokaText>
			}
		</div>
		<div class="mt-page-actions">
		@if (SearchChanged.HasDelegate)
		{
			<div class="mt-page-search">
				<MokaSearchInput Value="@Search" ValueChanged="SearchChanged" Placeholder="@SearchPlaceholder" Debounce="150" aria-label="@SearchPlaceholder" />
			</div>
		}
		@if (PrimaryText is { Length: > 0 } primary)
		{
			<Hint Text="@PrimaryTitle">
				<MokaButton Variant="MokaVariant.Outlined"
							Size="MokaSize.Xs"
							StartIcon="PrimaryIcon"
							Disabled="PrimaryDisabled"
							OnClick="OnPrimary">
					@primary
				</MokaButton>
			</Hint>
		}
		@if (OnRefresh.HasDelegate)
		{
			<IconButton Size="MokaSize.Xs"
						Icon="MokaIcons.Action.Refresh"
						Loading="@(Loading && Loaded)"
						Disabled="Loading"
						OnClick="OnRefresh"
						Label="Read again"
						Position="MokaTooltipPosition.BottomEnd" />
		}
		</div>
	</header>

	@if (Chips is not null || ChipsEnd is not null)
	{
		<div class="mt-page-subhead">
			@Chips
			<span class="mt-page-gap"></span>
			@ChipsEnd
		</div>
	}

	@if (Error is { } error)
	{
		<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
	}

	@if (!Loaded && Loading)
	{
		<div class="mt-page-loading">
			<MokaSpinner Label="@LoadingText" />
		</div>
	}
	else if (Loaded || Error is null)
	{
		@if (ListPage)
		{
			<div class="@(Detail is null ? "mt-page-md" : "mt-page-md mt-page-md--open")">
				<div class="mt-page-list">@ChildContent</div>
				@if (Detail is not null)
				{
					<div class="mt-page-detail">@Detail</div>
				}
			</div>
		}
		else
		{
			<div class="mt-page-scroll">@ChildContent</div>
		}
	}
</section>

@code {
	[Parameter, EditorRequired]
	public string Title { get; set; } = "";

	/// <summary>One line under the title, such as "42 services, 3 failed".</summary>
	[Parameter]
	public string? Summary { get; set; }

	[Parameter]
	public string Search { get; set; } = "";

	/// <summary>Shows the filter box when set.</summary>
	[Parameter]
	public EventCallback<string> SearchChanged { get; set; }

	[Parameter]
	public string SearchPlaceholder { get; set; } = "Filter";

	/// <summary>The page's one primary action, such as "Add user". Null shows none.</summary>
	[Parameter]
	public string? PrimaryText { get; set; }

	[Parameter]
	public MokaIconDefinition? PrimaryIcon { get; set; }

	[Parameter]
	public bool PrimaryDisabled { get; set; }

	/// <summary>Why the primary action is off, as a tooltip.</summary>
	[Parameter]
	public string? PrimaryTitle { get; set; }

	[Parameter]
	public EventCallback OnPrimary { get; set; }

	[Parameter]
	public RenderFragment? Chips { get; set; }

	/// <summary>A quiet link at the right end of the chip row, such as "Refresh lists".</summary>
	[Parameter]
	public RenderFragment? ChipsEnd { get; set; }

	[Parameter]
	public bool Loading { get; set; }

	[Parameter]
	public bool Loaded { get; set; }

	[Parameter]
	public string? Error { get; set; }

	[Parameter]
	public string LoadingText { get; set; } = "Reading";

	[Parameter]
	public EventCallback OnRefresh { get; set; }

	/// <summary>The content is a list that scrolls on its own, with <see cref="Detail"/> beside or below it.</summary>
	[Parameter]
	public bool ListPage { get; set; }

	/// <summary>The selected row's panel; null while nothing is selected.</summary>
	[Parameter]
	public RenderFragment? Detail { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }
}
