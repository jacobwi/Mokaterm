@using Moka.Red.Primitives.StatusDot

@* An uppercase state with a glowing dot: VALID, EXPIRING, MATCHES, OPEN. *@
<span class="mt-pui-chip mt-pui-chip--@ColorClass" title="@Title">
	<MokaStatusDot Size="MokaSize.Xs" Color="Color" Glow="Glow" />
	<span class="mt-pui-chip-text">@Text</span>
</span>

@code {
	[Parameter, EditorRequired]
	public string Text { get; set; } = "";

	[Parameter]
	public MokaColor Color { get; set; } = MokaColor.Success;

	[Parameter]
	public bool Glow { get; set; } = true;

	[Parameter]
	public string? Title { get; set; }

	private string ColorClass => Color switch
	{
		MokaColor.Error => "error",
		MokaColor.Warning => "warning",
		MokaColor.Info => "info",
		MokaColor.Surface => "plain",
		MokaColor.Primary => "primary",
		_ => "success",
	};
}
