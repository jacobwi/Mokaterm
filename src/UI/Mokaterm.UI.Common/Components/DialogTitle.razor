@namespace Mokaterm.UI.Common.Components

@* A title with what it is about after it (a session's label for a tool), inside a heading: Moka's dialog heading through
   HeadedDialog, and a tool window's own header, so the two read the same. *@
<span class="mt-dialog-title">
	<Hint Text="@Hint" Position="MokaTooltipPosition.BottomStart" Class="mt-dialog-title-text">
		<span class="mt-dialog-title-name">@Title</span>
	</Hint>
	@if (Detail is not null)
	{
		<span class="mt-dialog-detail">@Detail</span>
	}
</span>

@code {
	[Parameter]
	public string? Title { get; set; }

	[Parameter]
	public RenderFragment? Detail { get; set; }

	/// <summary>Shown when the title is pointed at, such as what a tool does when its header leaves that out.</summary>
	[Parameter]
	public string? Hint { get; set; }
}
