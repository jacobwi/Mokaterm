@namespace Mokaterm.UI.Common.Components

@* A header bar for a page that is not a dialog, such as a session tool's own window, drawn the way Moka draws a dialog's
   header so a tool looks the same in its window and in its dialog. *@
<div class="mt-dialog-head @Class">
	@if (Icon is { } icon)
	{
		<MokaIcon Icon="icon" SizeValue="18px" Class="mt-dialog-head-icon" />
	}
	<h2 class="mt-dialog-head-title">
		<DialogTitle Title="@Title" Detail="Detail" />
	</h2>
</div>

@code {
	[Parameter]
	public MokaIconDefinition? Icon { get; set; }

	[Parameter]
	public string? Title { get; set; }

	/// <summary>What the page is about, after the title: a session's label for a tool.</summary>
	[Parameter]
	public RenderFragment? Detail { get; set; }

	[Parameter]
	public string? Class { get; set; }
}
