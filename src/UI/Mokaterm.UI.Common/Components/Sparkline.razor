@namespace Mokaterm.UI.Common.Components
@using Moka.Red.Data.Chart

<div class="@CssClass" style="@HeightStyle" aria-hidden="@(Label is { Length: > 0 } ? null : "true")">
	<MokaSparkline Values="_window"
				   Min="0"
				   Max="_top"
				   ShowArea="true"
				   ShowLastPoint="false"
				   Label="@Label"
				   ColorValue="var(--mt-sparkline-color, var(--moka-color-primary))" />
</div>
