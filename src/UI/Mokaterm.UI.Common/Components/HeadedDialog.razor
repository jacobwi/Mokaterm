@namespace Mokaterm.UI.Common.Components
@using Moka.Red.Feedback.Dialog

<MokaDialog Open="Open"
			OpenChanged="OpenChanged"
			OnClose="OnClose"
			Title="@Title"
			Icon="Icon"
			TitleContent="TitleContent"
			HeaderActions="HeaderActions"
			ShowCloseButton="ShowCloseButton"
			DialogSize="DialogSize"
			BodyPadding="@(!Fill)"
			ScrollBody="@(!Fill)"
			CloseOnEscape="CloseOnEscape"
			CloseOnBackdropClick="CloseOnBackdropClick"
			PreventScroll="PreventScroll"
			Class="@Class"
			Style="@Style"
			Actions="Actions"
			@attributes="AdditionalAttributes">
	@ChildContent
</MokaDialog>

@code {
	// Inside Moka's heading, so the dialog is named by both: "System root@web-1".
	private RenderFragment? TitleContent => HeaderDetail is null
		? null
		: @<DialogTitle Title="@Title" Detail="HeaderDetail" />;
}
