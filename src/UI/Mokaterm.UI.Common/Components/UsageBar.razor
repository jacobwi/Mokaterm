@namespace Mokaterm.UI.Common.Components
@using Moka.Red.Primitives.Meter

<MokaMeter Value="Clamped"
		   Max="100"
		   ShowValue="false"
		   Size="MokaSize.Xs"
		   Color="LevelColor"
		   Class="@CssClass"
		   aria-label="@NamedLabel"
		   aria-valuetext="@(NamedLabel is null ? null : $"{ValueText}%")"
		   aria-hidden="@(NamedLabel is null ? "true" : null)" />
