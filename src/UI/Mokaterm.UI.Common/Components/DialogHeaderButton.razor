@namespace Mokaterm.UI.Common.Components

@* A quiet icon button for a dialog header, drawn like Moka's own close button so the two sit side by side. *@
<button type="button"
		class="mt-dialog-head-button"
		aria-label="@Title"
		title="@Title"
		disabled="@Disabled"
		@onclick="OnClick">
	<MokaIcon Icon="Icon" SizeValue="@SizeValue" />
</button>

@code {
	[Parameter, EditorRequired]
	public MokaIconDefinition Icon { get; set; }

	/// <summary>Tooltip and accessible name.</summary>
	[Parameter, EditorRequired]
	public string Title { get; set; } = "";

	[Parameter]
	public EventCallback<MouseEventArgs> OnClick { get; set; }

	[Parameter]
	public bool Disabled { get; set; }

	[Parameter]
	public string SizeValue { get; set; } = "16px";
}
