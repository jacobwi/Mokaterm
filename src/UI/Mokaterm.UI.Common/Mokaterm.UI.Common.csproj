<Project Sdk="Microsoft.NET.Sdk.Razor">

	<!--
		Shared UI building blocks for the shell, the terminal and file browser libraries, and protocol modules:
		icons, UI contribution descriptors, editor base classes, the settings fields and rows every settings page is
		built from, JS interop helpers and platform UI contracts.
	-->
	<PropertyGroup>
		<TargetFramework>$(MokatermTargetFramework)</TargetFramework>
		<RootNamespace>Mokaterm.UI.Common</RootNamespace>
	</PropertyGroup>

	<!-- Packed for plugin authors, who compile against it; the host supplies the assembly and its static files at run time. -->
	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>Mokaterm.UI.Common</PackageId>
		<Description>Shared Blazor building blocks for Mokaterm plugins and modules: UI contributions, session views, editor and settings base classes, the settings fields, icons and the page interop helpers. Plugins compile against it; the Mokaterm host supplies it at run time.</Description>
		<PackageTags>mokaterm;plugin;blazor;terminal</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mokaterm.UI.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" />
		<PackageReference Include="Moka.Red" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Mokaterm.Abstractions\Mokaterm.Abstractions.csproj" />
	</ItemGroup>

</Project>
