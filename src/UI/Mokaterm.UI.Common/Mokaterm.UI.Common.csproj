	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" />
		<PackageReference Include="Moka.Red" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Mokaterm.Abstractions\Mokaterm.Abstractions.csproj" />
	</ItemGroup>

</Project>
