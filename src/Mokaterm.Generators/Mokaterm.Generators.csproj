<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Source generators the Razor projects run at build time (see Directory.Build.targets). netstandard2.0 because the
		compiler loads analyzers into its own process, and Microsoft.CodeAnalysis.CSharp is pinned low enough that every
		compiler able to build this repo can load it.
	-->
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<RootNamespace>Mokaterm.Generators</RootNamespace>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
	</ItemGroup>

</Project>
