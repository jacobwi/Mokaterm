@namespace Mokaterm.Modules.Vnc.Components
@inherits SessionViewBase

<div class="mt-vnc" @ref="_root">
	<div class="mt-vnc-toolbar">
		<MokaSegmentedControl AriaLabel="Scaling" Value="@_scaling" ValueChanged="OnScalingChangedAsync" Size="MokaSize.Sm">
			<Hint Text="Scale the whole screen into the view" Position="MokaTooltipPosition.BottomStart">
				<MokaSegment Value="fit" Text="FIT" />
			</Hint>
			<Hint Text="One remote pixel per pixel, with scrollbars">
				<MokaSegment Value="actual" Text="1:1" />
			</Hint>
			<Hint Text="Ask the server to resize its screen to this view">
				<MokaSegment Value="remote" Text="SERVER" />
			</Hint>
		</MokaSegmentedControl>

		<IconButton Variant="@ToggleVariant(_viewOnly)"
					Color="@ToggleColor(_viewOnly)"
					Icon="@(_viewOnly ? MokaIcons.Toggle.EyeOff : MokaIcons.Toggle.Eye)"
					Disabled="@(!IsRunning)"
					OnClick="ToggleViewOnlyAsync"
					Label="@(_viewOnly ? "View only: keys and mouse stay here" : "Keys and mouse go to the session")"
					AriaLabel="View only"
					Pressed="_viewOnly" />

		<IconButton Class="mt-vnc-wide"
					Icon="MokatermIcons.Keyboard"
					Disabled="@(!IsRunning || _viewOnly)"
					OnClick="ShowKeysMenu"
					Label="Send a key combination this machine would swallow"
					AriaLabel="Send keys" />

		<IconButton Class="mt-vnc-wide"
					Icon="MokaIcons.Content.Paste"
					Disabled="@(!IsRunning || _viewOnly)"
					OnClick="SendClipboardAsync"
					Label="Send the clipboard of this machine to the session"
					AriaLabel="Send clipboard" />

		<IconButton Class="mt-vnc-wide"
					Icon="MokaIcons.Content.Copy"
					Disabled="@(!IsRunning || _clipboardLength == 0)"
					OnClick="ReceiveClipboardAsync"
					Label="@ReceiveClipboardTitle"
					AriaLabel="Copy the clipboard of the session" />

		<IconButton Class="mt-vnc-wide"
					Icon="MokatermIcons.Sliders"
					Disabled="@(!IsRunning)"
					OnClick="ShowQualityMenu"
					Label="@QualityTitle"
					AriaLabel="Quality and compression" />
		<Hint Text="@QualityTitle" Class="mt-vnc-meta mt-vnc-quality">
			<MokaText Element="span" Size="MokaSize.Xs" Mono>@QualityText</MokaText>
		</Hint>

		<IconButton Class="mt-vnc-wide"
					Icon="MokaIcons.Action.Download"
					Disabled="@(!IsRunning)"
					OnClick="SaveScreenshotAsync"
					Label="Save a picture of the screen" />

		<IconButton Variant="@ToggleVariant(_fullscreen)"
					Color="@ToggleColor(_fullscreen)"
					Class="mt-vnc-wide"
					Icon="MokatermIcons.Maximize"
					Disabled="@(!IsRunning)"
					OnClick="ToggleFullscreenAsync"
					Label="Full screen"
					Pressed="_fullscreen" />

		<IconButton Class="mt-vnc-compact"
					Icon="MokaIcons.Navigation.MoreHorizontal"
					Disabled="@(!IsRunning)"
					OnClick="ShowActionsMenu"
					Label="Keys, clipboard, quality, screenshot and full screen"
					AriaLabel="More actions"
					aria-haspopup="menu" />

		<span class="mt-vnc-spacer"></span>

		@if (_info is not null)
		{
			<MokaText Element="span" Size="MokaSize.Xs" Mono Truncate Class="mt-vnc-meta mt-vnc-name" title="@DesktopName">@DesktopName</MokaText>
			@if (ScreenSizeText.Length > 0)
			{
				<MokaText Element="span" Size="MokaSize.Xs" Mono Class="mt-vnc-meta mt-vnc-size">@ScreenSizeText</MokaText>
			}

			@if (IsEncrypted)
			{
				<Hint Text="@SecurityText" Position="MokaTooltipPosition.BottomEnd">
					<MokaTag Text="TLS" Icon="MokatermIcons.Lock" Color="MokaColor.Success" Size="MokaSize.Xs" />
				</Hint>
			}
			else
			{
				<Hint Text="@($"{SecurityText}. Anyone on the path can read this screen and every key you type.")" Position="MokaTooltipPosition.BottomEnd">
					<MokaTag Text="NOT ENCRYPTED"
							 Icon="MokatermIcons.Unlock"
							 Color="MokaColor.Warning"
							 Size="MokaSize.Xs" />
				</Hint>
			}
		}
	</div>

	<div class="mt-vnc-body">
		@* noVNC renders into this element, so Blazor must never give it child content. *@
		<div class="mt-vnc-screen" @ref="_screen"></div>

		@if (IsRunning && _viewOnly)
		{
			@* The screen looks live while it ignores every key, so it says so. *@
			<div class="mt-vnc-badge">
				<MokaTag Text="VIEW ONLY" Icon="MokaIcons.Toggle.EyeOff" Color="MokaColor.Warning" Size="MokaSize.Xs" />
			</div>
		}

		@if (_state == ScreenState.Starting)
		{
			<div class="mt-vnc-overlay">
				<MokaSpinner Label="Opening the remote screen" />
			</div>
		}
		else if (_state == ScreenState.Failed)
		{
			<div class="mt-vnc-overlay">
				<div class="mt-vnc-card">
					<MokaAlert Severity="MokaToastSeverity.Error" Title="The remote screen stopped">
						@(_error ?? "The screen could not be shown.")
					</MokaAlert>
					<MokaFlexbox Direction="MokaDirection.Row" Gap="MokaSpacingScale.Sm" Justify="MokaJustify.End">
						<MokaButton Size="MokaSize.Sm" StartIcon="MokatermIcons.Reconnect" OnClick="RetryAsync">Try again</MokaButton>
					</MokaFlexbox>
				</div>
			</div>
		}
		else if (_state == ScreenState.Ended)
		{
			<div class="mt-vnc-overlay">
				<MokaEmptyState Icon="MokatermIcons.Monitor"
								Title="The screen was closed"
								Description="The session ended it. Reconnect the session to see it again." />
			</div>
		}
		else if (_state == ScreenState.Idle)
		{
			<div class="mt-vnc-overlay">
				<MokaEmptyState Icon="MokatermIcons.Monitor"
								Title="Not connected"
								Description="@IdleDescription" />
			</div>
		}
	</div>
</div>
