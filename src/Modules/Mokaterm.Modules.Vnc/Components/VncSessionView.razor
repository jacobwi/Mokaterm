@namespace Mokaterm.Modules.Vnc.Components
@inherits SessionViewBase

<div class="mt-vnc" @ref="_root">
	<div class="mt-vnc-toolbar">
		<MokaSegmentedControl AriaLabel="Scaling" Value="@_scaling" ValueChanged="OnScalingChangedAsync" Size="MokaSize.Sm">
			<MokaSegment Value="fit" Text="FIT" title="Scale the whole screen into the view" />
			<MokaSegment Value="actual" Text="1:1" title="One remote pixel per pixel, with scrollbars" />
			<MokaSegment Value="remote" Text="SERVER" title="Ask the server to resize its screen to this view" />
		</MokaSegmentedControl>

		<MokaButton Variant="@ToggleVariant(_viewOnly)"
					Color="@ToggleColor(_viewOnly)"
					Size="MokaSize.Sm"
					StartIcon="@(_viewOnly ? MokaIcons.Toggle.EyeOff : MokaIcons.Toggle.Eye)"
					Disabled="@(!IsRunning)"
					OnClick="ToggleViewOnlyAsync"
					title="@(_viewOnly ? "View only: keys and mouse stay here" : "Keys and mouse go to the session")"
					aria-label="View only"
					aria-pressed="@Pressed(_viewOnly)" />

		<MokaButton Variant="MokaVariant.Text"
					Color="MokaColor.Surface"
					Size="MokaSize.Sm"
					Class="mt-vnc-wide"
					StartIcon="MokatermIcons.Keyboard"
					Disabled="@(!IsRunning || _viewOnly)"
					OnClick="ShowKeysMenu"
					title="Send a key combination this machine would swallow"
					aria-label="Send keys" />

		<MokaButton Variant="MokaVariant.Text"
					Color="MokaColor.Surface"
					Size="MokaSize.Sm"
					Class="mt-vnc-wide"
					StartIcon="MokaIcons.Content.Paste"
					Disabled="@(!IsRunning || _viewOnly)"
					OnClick="SendClipboardAsync"
					title="Send the clipboard of this machine to the session"
					aria-label="Send clipboard" />

		<MokaButton Variant="MokaVariant.Text"
					Color="MokaColor.Surface"
					Size="MokaSize.Sm"
					Class="mt-vnc-wide"
					StartIcon="MokaIcons.Content.Copy"
					Disabled="@(!IsRunning || _clipboardLength == 0)"
					OnClick="ReceiveClipboardAsync"
					title="@ReceiveClipboardTitle"
					aria-label="Copy the clipboard of the session" />

		<MokaButton Variant="MokaVariant.Text"
					Color="MokaColor.Surface"
					Size="MokaSize.Sm"
					Class="mt-vnc-wide"
					StartIcon="MokatermIcons.Sliders"
					Disabled="@(!IsRunning)"
					OnClick="ShowQualityMenu"
					title="@QualityTitle"
					aria-label="Quality and compression" />
		<MokaText Element="span" Size="MokaSize.Xs" Mono Class="mt-vnc-meta mt-vnc-quality" title="@QualityTitle">@QualityText</MokaText>

		<MokaButton Variant="MokaVariant.Text"
					Color="MokaColor.Surface"
					Size="MokaSize.Sm"
					Class="mt-vnc-wide"
					StartIcon="MokaIcons.Action.Download"
					Disabled="@(!IsRunning)"
					OnClick="SaveScreenshotAsync"
					title="Save a picture of the screen"
					aria-label="Save a picture of the screen" />

		<MokaButton Variant="@ToggleVariant(_fullscreen)"
					Color="@ToggleColor(_fullscreen)"
					Size="MokaSize.Sm"
					Class="mt-vnc-wide"
					StartIcon="MokatermIcons.Maximize"
					Disabled="@(!IsRunning)"
					OnClick="ToggleFullscreenAsync"
					title="Full screen"
					aria-label="Full screen"
					aria-pressed="@Pressed(_fullscreen)" />

		<MokaButton Variant="MokaVariant.Text"
					Color="MokaColor.Surface"
					Size="MokaSize.Sm"
					Class="mt-vnc-compact"
					StartIcon="MokaIcons.Navigation.MoreHorizontal"
					Disabled="@(!IsRunning)"
					OnClick="ShowActionsMenu"
					title="Keys, clipboard, quality, screenshot and full screen"
					aria-label="More actions"
					aria-haspopup="menu" />

		<span class="mt-vnc-spacer"></span>

		@if (_info is not null)
		{
			<MokaText Element="span" Size="MokaSize.Xs" Mono Truncate Class="mt-vnc-meta mt-vnc-name" title="@DesktopName">@DesktopName</MokaText>
			@if (ScreenSizeText.Length > 0)
			{
				<MokaText Element="span" Size="MokaSize.Xs" Mono Class="mt-vnc-meta mt-vnc-size">@ScreenSizeText</MokaText>
			}

			@if (IsEncrypted)
			{
				<MokaTag Text="TLS" Icon="MokatermIcons.Lock" Color="MokaColor.Success" Size="MokaSize.Xs" title="@SecurityText" />
			}
			else
			{
				<MokaTag Text="NOT ENCRYPTED"
						 Icon="MokatermIcons.Unlock"
						 Color="MokaColor.Warning"
						 Size="MokaSize.Xs"
						 title="@($"{SecurityText}. Anyone on the path can read this screen and every key you type.")" />
			}
		}
	</div>

	<div class="mt-vnc-body">
		@* noVNC renders into this element, so Blazor must never give it child content. *@
		<div class="mt-vnc-screen" @ref="_screen"></div>

		@if (IsRunning && _viewOnly)
		{
			@* The screen looks live while it ignores every key, so it says so. *@
			<div class="mt-vnc-badge">
				<MokaTag Text="VIEW ONLY" Icon="MokaIcons.Toggle.EyeOff" Color="MokaColor.Warning" Size="MokaSize.Xs" />
			</div>
		}

		@if (_state == ScreenState.Starting)
		{
			<div class="mt-vnc-overlay">
				<MokaSpinner Label="Opening the remote screen" />
			</div>
		}
		else if (_state == ScreenState.Failed)
		{
			<div class="mt-vnc-overlay">
				<div class="mt-vnc-card">
					<MokaAlert Severity="MokaToastSeverity.Error" Title="The remote screen stopped">
						@(_error ?? "The screen could not be shown.")
					</MokaAlert>
					<MokaFlexbox Direction="MokaDirection.Row" Gap="MokaSpacingScale.Sm" Justify="MokaJustify.End">
						<MokaButton Size="MokaSize.Sm" StartIcon="MokatermIcons.Reconnect" OnClick="RetryAsync">Try again</MokaButton>
					</MokaFlexbox>
				</div>
			</div>
		}
		else if (_state == ScreenState.Ended)
		{
			<div class="mt-vnc-overlay">
				<MokaEmptyState Icon="MokatermIcons.Monitor"
								Title="The screen was closed"
								Description="The session ended it. Reconnect the session to see it again." />
			</div>
		}
		else if (_state == ScreenState.Idle)
		{
			<div class="mt-vnc-overlay">
				<MokaEmptyState Icon="MokatermIcons.Monitor"
								Title="Not connected"
								Description="@IdleDescription" />
			</div>
		}
	</div>
</div>
