<Project Sdk="Microsoft.NET.Sdk.Razor">

	<!--
		A shell on this computer through a pseudo terminal (ConPTY on Windows): the shell is the terminal channel, so
		sessions get the built-in terminal view. Only a host that runs on the user's own machine registers it, which
		today means the desktop app and the workbench.
	-->
	<PropertyGroup>
		<TargetFramework>$(MokatermTargetFramework)</TargetFramework>
		<RootNamespace>Mokaterm.Modules.Local</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Mokaterm.Modules.Local.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\UI\Mokaterm.UI.Common\Mokaterm.UI.Common.csproj" />
	</ItemGroup>

</Project>
