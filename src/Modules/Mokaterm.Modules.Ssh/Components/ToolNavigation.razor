@typeparam TPage

@* The page list down the side of a session tool (System, Docker) with the page beside it. It narrows to icons and then
   becomes a dropdown above the page, following the tool's own width through the mt-ssh-tool container. *@
<div class="mt-toolnav">
	<nav class="mt-toolnav-list" aria-label="@Label">
		@foreach (ToolNavEntry<TPage> entry in Entries)
		{
			<button type="button"
					class="@ItemClass(entry)"
					aria-current="@(IsCurrent(entry) ? "page" : null)"
					title="@(entry.Unavailable is { } reason ? $"{entry.Label}: {reason}" : entry.Label)"
					@key="entry.Page"
					@onclick="@(() => CurrentChanged.InvokeAsync(entry.Page))">
				<MokaIcon Icon="entry.Icon" Size="MokaSize.Xs" />
				<span class="mt-toolnav-label">@entry.Label</span>
			</button>
		}
	</nav>

	<div class="mt-toolnav-select">
		<MokaSelect TValue="TPage"
					Items="_pages"
					Value="Current"
					ValueChanged="CurrentChanged"
					ValueSelector="SelectLabel"
					Size="MokaSize.Sm"
					aria-label="@Label" />
	</div>

	<div class="mt-toolnav-stage">
		@ChildContent
	</div>
</div>
