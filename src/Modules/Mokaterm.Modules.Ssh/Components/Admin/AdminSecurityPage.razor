@using Moka.Red.ContextMenu
@using Mokaterm.Modules.Ssh.Admin.Network
@using Mokaterm.Modules.Ssh.Admin.Security
@using Mokaterm.UI.Common.Editing
@inherits AdminPageBase

<ToolPageFrame Title="Security"
				Summary="@Summary"
				Search="@_filter"
				SearchChanged="FilterChanged"
				SearchPlaceholder="@(_view == "logins" ? "Filter by address or user" : "Filter by port or process")"
				Loading="Loading"
				Loaded="Loaded"
				Error="@LoadError"
				OnRefresh="ReloadAsync"
				LoadingText="Reading the SSH server, logins, fail2ban and ports"
				ListPage
				Detail="@DetailFragment">
	<Chips>
		<AdminChips Items="Chips" Value="@_view" ValueChanged="OnViewChanged" AriaLabel="Security part to show" />
	</Chips>
	<ChipsEnd>
		@if (_snapshot is { AsRoot: false } && Context.RootChangeBlocked is null)
		{
			<Hint Text="sshd -T, the login log, fail2ban and other users' ports need root">
				<button type="button" class="mta-link" disabled="@Busy" @onclick="Context.EnableRoot">read more as root</button>
			</Hint>
		}
	</ChipsEnd>
	<ChildContent>
		@if (_snapshot is { } snapshot)
		{
			@switch (_view)
			{
				case "logins":
					@LoginsView(snapshot)
					break;
				case "ports":
					@PortsView(snapshot)
					break;
				case "fail2ban":
					@Fail2BanView(snapshot)
					break;
				default:
					@ChecksView
					break;
			}
		}
	</ChildContent>
</ToolPageFrame>

@code {

	private SecuritySnapshot? _snapshot;
	private IReadOnlyList<SecurityCheck> _checks = [];
	private List<AdminRow<FailedLogin>> _loginsShown = [];
	private List<AdminRow<ListeningSocket>> _portsShown = [];
	private HashSet<ListeningSocket> _openToAll = [];
	private SessionLogin? _login;
	private int? _securityUpdates;
	private string? _securityUpdatesNote;
	private string _view = "checks";
	private string _filter = "";
	private string? _selected;
	private string? _editProblem;
	private bool _editing;

	[Inject]
	private IRemoteTextEditor Editor { get; set; } = default!;

	protected override bool ReadsMoreAsRoot => true;

	private string Summary => _snapshot is null
		? ""
		: $"{_checks.Count(check => check.Level == SecurityLevel.Warning)} warnings, {_checks.Count(check => check.Level == SecurityLevel.Notice)} notes · {(_snapshot.AsRoot ? "read as root" : $"read as {Context.LoginName}")}";

	private IReadOnlyList<AdminChip> Chips
	{
		get
		{
			List<AdminChip> chips =
			[
				new("checks", "Checks", _checks.Count(check => check.Level == SecurityLevel.Warning), Alert: true),
				new("logins", "Failed logins", _snapshot?.FailedLogins.Count),
				new("ports", "Listening", _snapshot?.Listening.Count),
			];

			if (_snapshot?.Fail2Ban is { } fail2ban)
			{
				chips.Add(new("fail2ban", "fail2ban", fail2ban.Jails.Count));
			}

			return chips;
		}
	}

	private SecurityCheck? Selected => _view == "checks" && _selected is { } id ? _checks.FirstOrDefault(check => check.Id == id) : null;

	private Fail2BanJail? SelectedJail => _view == "fail2ban" && _selected is { } name ? _snapshot?.Fail2Ban?.Jails.FirstOrDefault(jail => jail.Name == name) : null;

	private RenderFragment? DetailFragment => _view switch
	{
		"checks" when Selected is not null => CheckPanel,
		"fail2ban" when SelectedJail is not null => JailPanel,
		"logins" when _snapshot is { FailedLogins.Count: > 0 } => LoginsPanel,
		"ports" when _snapshot is { Listening.Count: > 0 } => PortsPanel,
		_ => null,
	};

	protected override async Task LoadAsync(CancellationToken cancellationToken)
	{
		_ = LoadSecurityUpdatesAsync(cancellationToken);
		AdminOutcome outcome = await ReadAsync(SecurityCommands.Read(ReadAsRoot), cancellationToken);
		_snapshot = SecurityCommands.Parse(outcome.Output);
		_login = await Context.Login();
		Rebuild();
		ApplyFilter();
	}

	private void ApplyFilter()
	{
		if (_snapshot is not { } snapshot)
		{
			return;
		}

		_loginsShown = [.. snapshot.FailedLogins.Reverse().Select((login, index) => new AdminRow<FailedLogin>(login, index)).Where(row => Matches(row.Item))];
		_openToAll = [.. SecurityChecks.OpenToAll(snapshot.Listening)];
		_portsShown =
		[
			.. snapshot.Listening
				.OrderByDescending(_openToAll.Contains)
				.ThenBy(socket => socket.Port)
				.Select((socket, index) => new AdminRow<ListeningSocket>(socket, index))
				.Where(row => Matches(row.Item)),
		];
	}

	private void Rebuild()
	{
		if (_snapshot is { } snapshot && _login is { } login)
		{
			_checks = SecurityChecks.Build(snapshot, login, _securityUpdates, _securityUpdatesNote);
		}
	}

	private async Task LoadSecurityUpdatesAsync(CancellationToken cancellationToken)
	{
		_securityUpdates = null;
		_securityUpdatesNote = Capabilities.Packages is { } packages ? $"Asking {packages.DisplayName}." : null;
		try
		{
			(IReadOnlyList<Mokaterm.Modules.Ssh.Admin.Packages.PackageUpdate>? updates, string? note) =
				await AdminUpdateReads.SecurityUpdatesAsync(Feature, Capabilities.Packages, Capabilities.PackagesMissing, cancellationToken);
			_securityUpdates = updates?.Count;
			_securityUpdatesNote = note;
		}
		catch (OperationCanceledException)
		{
			return;
		}

		Rebuild();
		await InvokeAsync(StateHasChanged);
	}

	private RenderFragment ChecksView => __builder =>
	{
		<ToolTable TItem="SecurityCheck"
				   Items="_checks"
				   ItemKey="@(check => check.Id)"
				   Label="Security checks"
				   IsSelected="@(check => check.Id == _selected)"
				   OnRowClick="@(check => Select(check.Id))"
				   OnRowMenu="@(args => ShowRowMenu(args.MouseEvent, MenuFor(args.Item)))"
				   ActionsWidth="var(--moka-button-height-sm)">
			<RowActions Context="check">
				<IconButton Size="MokaSize.Xs"
							Icon="MokaIcons.Navigation.MoreHorizontal"
							OnClick="@(args => ShowRowMenu(args, MenuFor(check)))"
							Label="More actions"
							AriaLabel="@($"Actions for {check.Title}")"
							Position="MokaTooltipPosition.BottomEnd" />
			</RowActions>
			<ChildContent>
				<MokaColumn TItem="SecurityCheck" Title="" Sortable="false" Resizable="false" Class="mt-col-dot">
					<CellTemplate Context="check">
						<MokaStatusDot Size="MokaSize.Xs" Color="@LevelColor(check.Level)" Glow="@(check.Level is SecurityLevel.Warning)" />
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="SecurityCheck" Title="Check" Field="@(check => check.Title)" Class="mt-col-main">
					<CellTemplate Context="check">
						<span title="@check.Summary">
							<span>@check.Title</span>
							<span class="mta-dim mta-after mta-wide">@check.Summary</span>
						</span>
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="SecurityCheck" Title="Value" Field="@(check => check.Value)" Mono Class="mta-col-cut">
					<CellTemplate Context="check">
						<span title="@check.Value">@check.Value</span>
					</CellTemplate>
				</MokaColumn>
			</ChildContent>
		</ToolTable>
	};

	private RenderFragment LoginsView(SecuritySnapshot snapshot) => __builder =>
	{
		if (snapshot.FailedLoginSource.Length == 0)
		{
			<MokaEmptyState Icon="MokatermIcons.Shield"
							Title="No login log was read"
							Description="@(snapshot.AsRoot ? "There is no journal, auth.log, secure or btmp to read SSH logins from." : "The login log is root's. Turn on root mode to read it.")" />
			return;
		}

		<div class="mta-stack">
			<ToolTable TItem="AdminRow<FailedLogin>"
					   Items="_loginsShown"
					   ItemKey="@(row => row.Index)"
					   Label="Failed logins"
					   Virtualize="@(_loginsShown.Count > VirtualizeAbove)"
					   EmptyIcon="MokatermIcons.ShieldCheck"
					   EmptyTitle="@(snapshot.FailedLogins.Count == 0 ? "No failed logins" : "Nothing matches")"
					   EmptyText="@(snapshot.FailedLogins.Count == 0 ? $"None in the recent lines of {snapshot.FailedLoginSource}." : "No failed login matches the filter.")">
				<MokaColumn TItem="AdminRow<FailedLogin>" Title="When" Field="@(row => row.Item.Time)" Mono Class="mt-col-wide">
					<CellTemplate Context="row">
						<span class="mta-dim" title="@row.Item.Time">@row.Item.Time</span>
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="AdminRow<FailedLogin>" Title="User" Field="@(row => row.Item.User)" Mono Class="mta-col-cut">
					<CellTemplate Context="row">
						<span title="@row.Item.User">@row.Item.User</span>
						@if (row.Item.InvalidUser)
						{
							<span class="mta-dim mta-after">no such user</span>
						}
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="AdminRow<FailedLogin>" Title="From" Field="@(row => row.Item.Address)" Mono Class="mt-col-main">
					<CellTemplate Context="row">
						<span title="@row.Item.Address">@row.Item.Address</span>
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="AdminRow<FailedLogin>" Title="Method" Field="@(row => row.Item.Method)" Mono Class="mt-col-wide">
					<CellTemplate Context="row">
						<span class="mta-dim">@row.Item.Method</span>
					</CellTemplate>
				</MokaColumn>
			</ToolTable>
		</div>
	};

	private RenderFragment PortsView(SecuritySnapshot snapshot) => __builder =>
	{
		if (snapshot.ListeningSource.Length == 0)
		{
			<MokaEmptyState Icon="SshIcons.Network" Title="No port list" Description="Neither ss nor netstat is installed, so listening ports cannot be read." />
			return;
		}

		<div class="mta-stack">
			<ToolTable TItem="AdminRow<ListeningSocket>"
					   Items="_portsShown"
					   ItemKey="@(row => row.Index)"
					   Label="Listening ports"
					   EmptyIcon="SshIcons.Network"
					   EmptyTitle="@(snapshot.Listening.Count == 0 ? "Nothing listens" : "Nothing matches")"
					   EmptyText="@(snapshot.Listening.Count == 0 ? $"{snapshot.ListeningSource} listed no listening sockets." : "No port matches the filter.")">
				<MokaColumn TItem="AdminRow<ListeningSocket>" Title="Proto" Field="@(row => row.Item.Protocol)" Mono>
					<CellTemplate Context="row">
						<span class="mta-dim">@row.Item.Protocol</span>
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="AdminRow<ListeningSocket>" Title="Address" Field="@(row => row.Item.Address)" Mono Class="mta-col-cut">
					<CellTemplate Context="row">
						<span title="@row.Item.Address">@row.Item.Address</span>
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="AdminRow<ListeningSocket>" Title="Port" Field="@(row => row.Item.Port)" Mono />
				<MokaColumn TItem="AdminRow<ListeningSocket>" Title="Process" Field="@(row => row.Item.Process)" Mono Class="mt-col-main mt-col-wide">
					<CellTemplate Context="row">
						<span class="mta-dim" title="@row.Item.Process">@(row.Item.Process.Length > 0 ? row.Item.Process : snapshot.AsRoot ? "" : "(root only)")</span>
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="AdminRow<ListeningSocket>" Title="Reachable" Field="@(row => Reach(row.Item))" Mono Class="mt-col-wide">
					<CellTemplate Context="row">
						<MokaTag Text="@Reach(row.Item)" Size="MokaSize.Xs" Variant="MokaVariant.Soft" Color="@ReachColor(row.Item)" />
					</CellTemplate>
				</MokaColumn>
			</ToolTable>
		</div>
	};

	private RenderFragment Fail2BanView(SecuritySnapshot snapshot) => __builder =>
	{
		if (snapshot.Fail2Ban is not { } fail2ban)
		{
			return;
		}

		if (fail2ban.Problem is { } problem)
		{
			<MokaEmptyState Icon="MokatermIcons.Shield" Title="fail2ban did not say" Description="@problem" />
			return;
		}

		<ToolTable TItem="Fail2BanJail"
				   Items="fail2ban.Jails"
				   ItemKey="@(jail => jail.Name)"
				   Label="fail2ban jails"
				   IsSelected="@(jail => jail.Name == _selected)"
				   OnRowClick="@(jail => Select(jail.Name))"
				   EmptyIcon="MokatermIcons.Shield"
				   EmptyTitle="No jails"
				   EmptyText="fail2ban runs no jails.">
			<MokaColumn TItem="Fail2BanJail" Title="Jail" Field="@(jail => jail.Name)" Mono Class="mt-col-main" />
			<MokaColumn TItem="Fail2BanJail" Title="Failing now" Field="@(jail => jail.CurrentlyFailed)" Mono Align="MokaTextAlign.Right" Class="mt-col-wide">
				<CellTemplate Context="jail">
					<span class="mta-dim">@jail.CurrentlyFailed</span>
				</CellTemplate>
			</MokaColumn>
			<MokaColumn TItem="Fail2BanJail" Title="Banned now" Field="@(jail => jail.CurrentlyBanned)" Mono Align="MokaTextAlign.Right" />
			<MokaColumn TItem="Fail2BanJail" Title="Banned in all" Field="@(jail => jail.TotalBanned)" Mono Align="MokaTextAlign.Right" Class="mt-col-wide">
				<CellTemplate Context="jail">
					<span class="mta-dim">@jail.TotalBanned</span>
				</CellTemplate>
			</MokaColumn>
		</ToolTable>
	};
	private RenderFragment CheckPanel => __builder =>
	{
		if (Selected is not { } check || _snapshot is not { } snapshot)
		{
			return;
		}

		SshdConfig sshd = snapshot.Sshd;
		<ToolDetailPanel Title="@check.Title"
						  Subtitle="@check.Keyword"
						  Mono="false"
						  DotColor="@LevelColor(check.Level)"
						  DotGlow="@(check.Level == SecurityLevel.Warning)"
						  OnClose="@(() => _selected = null)">
			<Actions>
				@if (check.Fix is { } fix && check.Keyword is { } keyword)
				{
					@if (sshd.RouteFor(keyword) is { } route)
					{
						<Hint Text="@(Context.RootChangeBlocked ?? (route.UsesDropIn ? $"Writes {fix.Keyword} {fix.Value} into {route.File}" : $"Opens {route.File} to change {fix.Keyword}"))">
							<MokaButton Variant="MokaVariant.Outlined"
										Color="@(fix.CutsConnection ? MokaColor.Error : MokaColor.Primary)"
										Size="MokaSize.Xs"
										Disabled="@(Busy || _editing || Context.RootChangeBlocked is not null)"
										OnClick="@(() => FixAsync(fix, route))">
								@(route.UsesDropIn ? fix.Label : $"Edit {route.File}")
							</MokaButton>
						</Hint>
					}
				}
				@if (check.Shows is { } shows)
				{
					<MokaButton Variant="MokaVariant.Text" Size="MokaSize.Xs" OnClick="@(() => Show(shows))">@ShowsText(shows)</MokaButton>
				}
			</Actions>
			<ChildContent>
				<MokaText Element="p" Size="MokaSize.Sm">@check.Summary</MokaText>
				@if (check.Keyword is { } keyword)
				{
					<MokaChainCheck Steps="SshdSteps(check, sshd, keyword)" Label="@($"How sshd arrives at {keyword}")" FindingsLabel="What each step says" Class="mta-chain" />
				}
				else
				{
					<div class="mta-tiles">
						<MokaStat Tile Value="@(check.Value.Length > 0 ? check.Value : "?")" Label="Value" HelpText="@check.Title" Color="@LevelColor(check.Level)" />
						<MokaStat Tile Value="@LevelWord(check.Level)" Label="Status" HelpText="@LevelText(check.Level)" Color="@LevelColor(check.Level)" />
					</div>
				}
				@if (check.Fix is { Warning: { } warning } offered)
				{
					<MokaAlert Severity="@(offered.CutsConnection ? MokaToastSeverity.Error : MokaToastSeverity.Warning)" Dense>@warning</MokaAlert>
				}
				@if (_editProblem is { } problem)
				{
					<MokaAlert Severity="MokaToastSeverity.Error" Dense Closable OnClose="@(() => _editProblem = null)">@problem</MokaAlert>
				}
				@if (check.Keyword is not null && sshd.TestProblem is { } broken)
				{
					<MokaAlert Severity="MokaToastSeverity.Error" Dense>@($"sshd -T refused its settings: {broken}")</MokaAlert>
				}
			</ChildContent>
		</ToolDetailPanel>
	};

	private RenderFragment JailPanel => __builder =>
	{
		if (SelectedJail is not { } jail)
		{
			return;
		}

		<ToolDetailPanel Title="@jail.Name" Subtitle="@jail.Watches" DotColor="@(jail.CurrentlyBanned > 0 ? MokaColor.Warning : MokaColor.Success)" OnClose="@(() => _selected = null)">
			<div class="mta-tiles">
				<MokaStat Tile Value="@Number(jail.CurrentlyFailed)" Label="Failing now" HelpText="@($"{Number(jail.TotalFailed)} in all")" />
				<MokaStat Tile Value="@Number(jail.CurrentlyBanned)" Label="Banned now" HelpText="@($"{Number(jail.TotalBanned)} in all")" Color="@(jail.CurrentlyBanned > 0 ? MokaColor.Warning : MokaColor.Surface)" />
			</div>
			@if (jail.Banned.Count == 0)
			{
				<AdminFacts Items="@([new MokaDataListItem("Banned now", "nobody")])" />
			}
			else
			{
				<AdminOutput Label="Banned now" Text="@(string.Join('\n', jail.Banned))" CopyLabel="Copy the banned addresses" />
			}
		</ToolDetailPanel>
	};

	private RenderFragment LoginsPanel => __builder =>
	{
		if (_snapshot is not { } snapshot)
		{
			return;
		}

		IReadOnlyList<(string Address, int Count, string Last)> byAddress = FailedLoginParser.ByAddress(snapshot.FailedLogins);
		int most = byAddress.Count > 0 ? byAddress[0].Count : 1;
		<ToolDetailPanel Title="Failed logins" Subtitle="@($"From {snapshot.FailedLoginSource}")" Mono="false" DotColor="MokaColor.Error" DotGlow>
			<div class="mta-tiles">
				<MokaStat Tile Value="@AdminFormat.Count(snapshot.FailedLogins.Count)" Label="Failures" HelpText="in the recent lines" Color="MokaColor.Error" />
				<MokaStat Tile Value="@AdminFormat.Count(byAddress.Count)" Label="Addresses" HelpText="trying" />
				<MokaStat Tile Value="@AdminFormat.Count(snapshot.FailedLogins.Count(login => login.InvalidUser))" Label="No such user" HelpText="names guessed" />
			</div>
			<section class="mta-section" aria-label="Most tries">
				<MokaText Element="span" Size="MokaSize.Xs" Weight="MokaFontWeight.Semibold" Class="mta-label">Most tries</MokaText>
				@foreach ((string address, int count, string last) in byAddress.Take(5))
				{
					<Hint @key="address" Text="@($"Last at {last}")" Class="mta-meter-hint">
						<MokaMeter Value="count" Max="most" Label="@address" Color="MokaColor.Error" Size="MokaSize.Sm" Class="mta-meter-row" />
					</Hint>
				}
			</section>
			<section class="mta-section" aria-label="Latest">
				<MokaText Element="span" Size="MokaSize.Xs" Weight="MokaFontWeight.Semibold" Class="mta-label">Latest</MokaText>
				<MokaTimeline role="list" Class="mta-timeline">
					@foreach (FailedLogin login in snapshot.FailedLogins.Reverse().Take(5))
					{
						<MokaTimelineItem role="listitem"
										  Title="@($"{login.User} from {login.Address}")"
										  Timestamp="@(login.Method.Length > 0 ? $"{login.Time} · {login.Method}" : login.Time)"
										  DotColor="@(login.InvalidUser ? MokaColor.Surface : MokaColor.Error)" />
					}
				</MokaTimeline>
			</section>
		</ToolDetailPanel>
	};

	private RenderFragment PortsPanel => _snapshot is { } snapshot
		? AdminListening.Panel(snapshot.Listening, snapshot.ListeningSource, Profile.Facts.SshServerPort, snapshot.AsRoot ? null : RootNote)
		: _ => { };

	private static RenderFragment RootNote => __builder =>
	{
		<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">The processes behind other users' ports show as root.</MokaText>
	};

	// Where sshd's value comes from and what can be done about it, in the order sshd itself goes: it reads its files,
	// the last one that sets the keyword wins, and the value is what it then does.
	private IReadOnlyList<MokaChainStep> SshdSteps(SecurityCheck check, SshdConfig sshd, string keyword)
	{
		bool setInFile = sshd.Sources.TryGetValue(keyword.ToLowerInvariant(), out string? file);
		SshdChangeRoute? route = sshd.RouteFor(keyword);
		MokaChainStep fix = check switch
		{
			{ Level: SecurityLevel.Good } => new(MokaIcons.Status.CheckCircle, "Fix", MokaChainTone.Ok, "Nothing to do", ""),
			{ Fix: { } offered } when route is { UsesDropIn: true } =>
				new(MokaIcons.Action.Edit, "Fix", MokaChainTone.Warn, "Drop-in", $"{offered.Label} writes {offered.Keyword} {offered.Value} into {route.File}; sshd -t checks it before sshd reloads."),
			{ Fix: { } offered } when route is { } byHand =>
				new(MokaIcons.Action.Edit, "Fix", MokaChainTone.Warn, "By hand", $"A drop-in would not win here, so {byHand.File} opens in the editor: set {offered.Keyword} {offered.Value} there. sshd -t checks it before sshd reloads."),
			_ when !sshd.Effective =>
				new(MokatermIcons.Root, "Fix", MokaChainTone.Wait, "Needs root", "Changing it needs sshd's own reading of its settings (sshd -T), which only root gets. Turn on root mode."),
			_ => new(MokaIcons.Action.Edit, "Fix", MokaChainTone.Off, "Not offered", ""),
		};

		return
		[
			new(MokaIcons.Action.Search, "Read", sshd.TestProblem is not null ? MokaChainTone.Fail : sshd.Effective ? MokaChainTone.Ok : MokaChainTone.Warn,
				sshd.TestProblem is not null ? "Refused" : sshd.Effective ? "sshd -T" : "From files",
				sshd.TestProblem is { } broken
					? $"sshd -T refused its settings: {broken}"
					: sshd.Effective ? "" : "Worked out from the files the way sshd reads them. Root mode asks sshd itself."),
			new(MokaIcons.File.FileText, "Set in", setInFile ? MokaChainTone.Ok : MokaChainTone.Off, setInFile ? FileName(file!) : sshd.KnowsFiles ? "Default" : "Not read",
				setInFile ? $"{keyword} is set in {file}." : sshd.KnowsFiles ? $"No file sets {keyword}, so sshd's default applies." : ""),
			new(MokatermIcons.Shield, "Value", check.Level switch
				{
					SecurityLevel.Good => MokaChainTone.Ok,
					SecurityLevel.Notice or SecurityLevel.Warning => MokaChainTone.Warn,
					_ => MokaChainTone.Wait,
				},
				check.Value.Length > 0 ? check.Value : "?",
				""),
			fix,
		];
	}

	private static string FileName(string path) => path.LastIndexOf('/') is var slash and >= 0 && slash < path.Length - 1 ? path[(slash + 1)..] : path;

	private static string LevelWord(SecurityLevel level) => level switch
	{
		SecurityLevel.Good => "Fine",
		SecurityLevel.Notice => "A look",
		SecurityLevel.Warning => "Weak",
		_ => "Not read",
	};

	private static string Number(int? value) => value?.ToString(CultureInfo.InvariantCulture) ?? "?";

	private MokaColor ReachColor(ListeningSocket socket) => AdminListening.ReachOf(socket) switch
	{
		ListeningReach.Every => MokaColor.Warning,
		ListeningReach.Loopback => MokaColor.Success,
		_ => MokaColor.Info,
	};

	private static MokaColor LevelColor(SecurityLevel level) => level switch
	{
		SecurityLevel.Good => MokaColor.Success,
		SecurityLevel.Notice => MokaColor.Info,
		SecurityLevel.Warning => MokaColor.Warning,
		_ => MokaColor.Surface,
	};

	private static string LevelText(SecurityLevel level) => level switch
	{
		SecurityLevel.Good => "fine",
		SecurityLevel.Notice => "worth a look",
		SecurityLevel.Warning => "weakens the machine",
		_ => "not read",
	};

	private static string ShowsText(string shows) => shows switch
	{
		"logins" => "Show the logins",
		"ports" => "Show the ports",
		"fail2ban" => "Show the jails",
		"security-updates" => "Show the updates",
		_ => "Open Packages",
	};

	private static string Reach(ListeningSocket socket) => AdminListening.ReachOf(socket) switch
	{
		ListeningReach.Every => "Every address",
		ListeningReach.Loopback => "This machine",
		_ => "One address",
	};

	private bool Matches(FailedLogin login) => _filter.Trim().Length == 0
		|| login.Address.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase)
		|| login.User.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase);

	private bool Matches(ListeningSocket socket) => _filter.Trim().Length == 0
		|| socket.Port.ToString(System.Globalization.CultureInfo.InvariantCulture).Contains(_filter.Trim(), StringComparison.Ordinal)
		|| socket.Process.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase)
		|| socket.Address.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase);

	private IReadOnlyList<MokaContextMenuItem> MenuFor(SecurityCheck check)
	{
		List<MokaContextMenuItem> items = [new MokaContextMenuItem { Text = "Details", OnClickSync = () => Select(check.Id, keepOpen: true) }];
		if (check.Shows is { } shows)
		{
			items.Add(new MokaContextMenuItem { Text = ShowsText(shows), OnClickSync = () => Show(shows) });
		}

		if (check.Fix is { } fix && check.Keyword is { } keyword && _snapshot?.Sshd.RouteFor(keyword) is { } route)
		{
			items.Add(new MokaContextMenuItem
			{
				Text = route.UsesDropIn ? fix.Label : $"Edit {route.File}",
				DividerBefore = true,
				Disabled = Busy || _editing || Context.RootChangeBlocked is not null,
				OnClick = () => FixAsync(fix, route),
			});
		}

		return items;
	}

	// Only the lists that grow long take a filter; the checks fit on a page.
	private EventCallback<string> FilterChanged => _view is "logins" or "ports"
		? EventCallback.Factory.Create<string>(this, value =>
		{
			_filter = value;
			ApplyFilter();
		})
		: default;

	private void OnViewChanged(string value)
	{
		_view = value;
		_selected = null;
		_filter = "";
		ApplyFilter();
	}

	private void Show(string shows)
	{
		if (shows == "security-updates")
		{
			Context.Navigate(AdminPageIds.Packages, Capabilities.Packages?.KnowsSecurityUpdates == true ? "security" : "updates");
			return;
		}

		if (shows == "packages")
		{
			Context.Navigate(AdminPageIds.Packages);
			return;
		}

		OnViewChanged(shows);
	}

	private void Select(string id) => Select(id, keepOpen: false);

	private void Select(string id, bool keepOpen)
	{
		_selected = _selected == id && !keepOpen ? null : id;
		_editProblem = null;
	}

	/// <summary>
	/// Puts a fix in place: through the drop-in when it wins, else by opening the file that does in the editor, then
	/// checking the files with sshd -t and reloading.
	/// </summary>
	private async Task FixAsync(SshdFix fix, SshdChangeRoute route)
	{
		_editProblem = null;
		if (route.UsesDropIn)
		{
			await RunAsync(SshdCommands.SetInDropIn(fix, Profile.Init));
			return;
		}

		_editing = true;
		try
		{
			RemoteTextEditResult result = await AdminFileEditing.EditAsRootAsync(Editor, Feature, route.File, route.File, createNew: false, CancellationToken.None);
			switch (result.Outcome)
			{
				case RemoteTextEditOutcome.Saved:
					await RunAsync(SshdCommands.CheckAndReload(Profile.Init, route.File, fix));
					break;
				case RemoteTextEditOutcome.Failed:
					_editProblem = result.Message;
					break;
			}
		}
		finally
		{
			_editing = false;
		}
	}
}
