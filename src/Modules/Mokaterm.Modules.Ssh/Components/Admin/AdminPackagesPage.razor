@using Moka.Red.ContextMenu
@using Mokaterm.Modules.Ssh.Admin.Packages
@using Mokaterm.Modules.Ssh.Admin.Reboot
@inherits AdminPageBase

<ToolPageFrame Title="Packages"
				Summary="@Summary"
				Search="@_filter"
				SearchChanged="OnFilterChanged"
				SearchPlaceholder="Filter by name"
				PrimaryText="@PrimaryText"
				PrimaryIcon="PrimaryIcon"
				PrimaryDisabled="@(Busy || Capabilities.Packages is null || Context.RootChangeBlocked is not null || (_view != "installed" && _updates is not { Count: > 0 }))"
				PrimaryTitle="@Context.RootChangeBlocked"
				OnPrimary="OnPrimaryAsync"
				Loading="Loading"
				Loaded="Loaded"
				Error="@LoadError"
				OnRefresh="ReloadAsync"
				LoadingText="Reading the installed packages"
				ListPage
				Detail="@DetailFragment">
	<Chips>
		@if (Capabilities.Packages is not null)
		{
			<AdminChips Items="Chips" Value="@_view" ValueChanged="OnViewChangedAsync" AriaLabel="Packages to show" />
		}
	</Chips>
	<ChipsEnd>
		@if (_reboot is { Required: true } reboot)
		{
			<Hint Text="@($"Reboot {AdminUpdateReads.RebootText(reboot)}")">
				<MokaTag Text="Reboot required" Size="MokaSize.Xs" Color="MokaColor.Warning" />
			</Hint>
		}
		@if (RebootCommands.CanReboot(Profile))
		{
			<Hint Text="@(Context.RootChangeBlocked ?? $"Reboot the machine; the session reconnects once it is back. Reboot {(_reboot is { } known ? AdminUpdateReads.RebootText(known) : "status not read yet")}.")">
				<button type="button"
						class="mta-link"
						disabled="@(Busy || Context.RootChangeBlocked is not null)"
						@onclick="Context.Reboot">
					reboot
				</button>
			</Hint>
		}
		@if (_view != "installed" && Capabilities.Packages?.RefreshIndex() is not null)
		{
			<Hint Text="Fetch the current package lists from every repository, then check again">
				<button type="button"
						class="mta-link"
						disabled="@(Busy || Context.RootChangeBlocked is not null)"
						@onclick="RefreshIndexAsync">
					refresh package lists
				</button>
			</Hint>
		}
	</ChipsEnd>
	<ChildContent>
		@if (Capabilities.Packages is not { } packages)
		{
			<MokaEmptyState Icon="SshIcons.Package" Title="No package manager" Description="@Capabilities.PackagesMissing" />
		}
		else if (_view != "installed")
		{
			@if (_updatesError is { } updatesError)
			{
				<MokaAlert Severity="MokaToastSeverity.Error" Dense>@updatesError</MokaAlert>
			}
			else if (_updates is null)
			{
				<div class="mta-loading"><MokaSpinner Label="@($"Asking {packages.DisplayName} for updates")" /></div>
			}
			else if (_view == "security" && _security is null && _updates.Count > 0)
			{
				@if (_securityNote is { } securityNote)
				{
					<MokaEmptyState Icon="MokatermIcons.Shield" Title="Security updates are not known" Description="@securityNote" />
				}
				else
				{
					<div class="mta-loading"><MokaSpinner Label="@($"Asking {packages.DisplayName} which updates fix security problems")" /></div>
				}
			}
			else
			{
				<ToolTable TItem="PackageUpdate"
						   Items="_updatesShown"
						   ItemKey="@(update => update.Name + "/" + update.Architecture)"
						   Label="@(_view == "security" ? "Security updates" : "Upgradable packages")"
						   SortColumn="Package"
						   SortDirection="MokaSortDirection.Ascending"
						   Virtualize="@(_updatesShown.Count > VirtualizeAbove)"
						   EmptyIcon="@(_updates.Count == 0 ? MokaIcons.Status.CheckCircle : _view == "security" && _security is { Count: 0 } ? MokatermIcons.ShieldCheck : SshIcons.Package)"
						   EmptyTitle="@UpdatesEmptyTitle"
						   EmptyText="@UpdatesEmptyText(packages)">
					<MokaColumn TItem="PackageUpdate" Title="Package" Field="@(update => update.Name)" SortComparer="ByName" Mono Class="mt-col-main">
						<CellTemplate Context="update">
							<span title="@update.Name">@update.Name</span>
							@if (_view == "updates" && IsSecurity(update))
							{
								<span class="mta-after"><MokaTag Text="Security" Size="MokaSize.Xs" Color="MokaColor.Warning" /></span>
							}
							@if (IsDeferred(update))
							{
								<span class="mta-after"><Hint Text="@RolloutExplained"><MokaTag Text="Held by rollout" Size="MokaSize.Xs" Color="MokaColor.Info" /></Hint></span>
							}
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="PackageUpdate" Title="Installed" Field="@(update => update.CurrentVersion)" Mono Class="mt-col-wide mta-col-cut">
						<CellTemplate Context="update">
							<span class="mta-dim" title="@update.CurrentVersion">@update.CurrentVersion</span>
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="PackageUpdate" Title="Available" Field="@(update => update.NewVersion)" Mono Class="mta-col-cut">
						<CellTemplate Context="update">
							<span title="@update.NewVersion">@update.NewVersion</span>
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="PackageUpdate" Title="From" Field="@(update => update.Source)" SortComparer="BySource" Mono Class="mt-col-wider mta-col-cut">
						<CellTemplate Context="update">
							<span class="mta-dim" title="@update.Source">@update.Source</span>
						</CellTemplate>
					</MokaColumn>
				</ToolTable>
			}
		}
		else
		{
			<ToolTable TItem="InstalledPackage"
					   Items="_installedShown"
					   ItemKey="@(package => KeyOf(package))"
					   Label="Installed packages"
					   IsSelected="@(package => KeyOf(package) == _selected)"
					   OnRowClick="@(package => Select(KeyOf(package)))"
					   OnRowMenu="@(args => ShowRowMenu(args.MouseEvent, MenuFor(args.Item)))"
					   ActionsWidth="var(--moka-button-height-sm)"
					   SortColumn="Package"
					   SortDirection="MokaSortDirection.Ascending"
					   Virtualize="@(_installedShown.Count > VirtualizeAbove)"
					   EmptyIcon="SshIcons.Package"
					   EmptyTitle="@(_installed.Count == 0 ? "No packages" : "Nothing matches")"
					   EmptyText="@(_installed.Count == 0 ? $"{packages.DisplayName} listed none." : "No installed package matches the filter. Install, at the top, starts with the filter as the package's name.")">
				<RowActions Context="package">
					<IconButton Size="MokaSize.Xs"
								Icon="MokaIcons.Navigation.MoreHorizontal"
								OnClick="@(args => ShowRowMenu(args, MenuFor(package)))"
								Label="More actions"
								AriaLabel="@($"Actions for {package.Name}")"
								Position="MokaTooltipPosition.BottomEnd" />
				</RowActions>
				<ChildContent>
					<MokaColumn TItem="InstalledPackage" Title="Package" Field="@(package => package.Name)" SortComparer="ByName" Mono Class="mt-col-main">
						<CellTemplate Context="package">
							<span title="@package.Name">@package.Name</span>
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="InstalledPackage" Title="Version" Field="@(package => package.Version)" Mono Class="mta-col-cut">
						<CellTemplate Context="package">
							<span class="mta-dim" title="@package.Version">@package.Version</span>
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="InstalledPackage" Title="Arch" Field="@(package => package.Architecture)" Mono Class="mt-col-wide">
						<CellTemplate Context="package">
							<span class="mta-dim">@package.Architecture</span>
						</CellTemplate>
					</MokaColumn>
				</ChildContent>
			</ToolTable>
		}
	</ChildContent>
</ToolPageFrame>

@code {

	private IReadOnlyList<InstalledPackage> _installed = [];
	private List<InstalledPackage> _installedShown = [];
	private IReadOnlyList<PackageUpdate>? _updates;
	private List<PackageUpdate> _updatesShown = [];
	private string? _updatesError;
	private HashSet<string>? _security;
	private HashSet<string> _deferred = [];
	private string? _securityNote;
	private RebootStatus? _reboot;
	private string _view = "installed";
	private string _filter = "";
	private string? _selected;
	private bool _installing;
	private string _newPackage = "";

	private string Summary
	{
		get
		{
			if (Capabilities.Packages is not { } packages)
			{
				return "no package manager";
			}

			string updates = _updates is { } list ? $", {AdminFormat.Count(list.Count)} upgradable" : "";
			updates += _security is { Count: > 0 } security ? $", {AdminFormat.Count(security.Count)} for security" : "";
			updates += HeldCount > 0 ? $", {AdminFormat.Count(HeldCount)} held by rollout" : "";
			return $"{AdminFormat.Count(_installed.Count)} installed{updates} · {packages.DisplayName}";
		}
	}

	private string PrimaryText => _view == "installed" ? "Install" : "Upgrade all";

	private MokaIconDefinition? PrimaryIcon => _view == "installed" ? MokaIcons.Action.Add : (MokaIconDefinition?)null;

	private IReadOnlyList<AdminChip> Chips => Capabilities.Packages?.KnowsSecurityUpdates == true
		?
		[
			new("installed", "Installed", _installed.Count),
			new("updates", "Upgradable", _updates?.Count),
			new("security", "Security", _security?.Count, Alert: true),
		]
		:
		[
			new("installed", "Installed", _installed.Count),
			new("updates", "Upgradable", _updates?.Count),
		];

	private InstalledPackage? Selected => _selected is { } key
		? _installed.FirstOrDefault(package => KeyOf(package) == key)
		: null;

	private string UpdatesEmptyTitle => _updates is { Count: 0 }
		? "Up to date"
		: _view == "security" && _security is { Count: 0 } ? "No security updates" : "Nothing matches";

	private RenderFragment? DetailFragment => _view != "installed"
		? _updates is { Count: > 0 } ? UpdatesPanel : null
		: _installing ? InstallPanel : Selected is null ? null : PackagePanel;

	protected override void OnInitialized()
	{
		if (Context.TakeHint() is { } hint && hint is "updates" or "security")
		{
			_view = hint;
		}
	}

	protected override async Task LoadAsync(CancellationToken cancellationToken)
	{
		if (Capabilities.Packages is not { } packages)
		{
			return;
		}

		AdminOutcome outcome = await ReadAsync(packages.ListInstalled(), cancellationToken);
		if (!outcome.Succeeded && outcome.Output.Length == 0)
		{
			throw new AdminException(outcome.Problem());
		}

		_installed = packages.ParseInstalled(outcome.Output);
		ApplyFilter();
		_ = LoadRebootAsync(cancellationToken);
		if (_view != "installed" || _updates is not null)
		{
			await LoadUpdatesAsync(cancellationToken);
		}
	}

	private RenderFragment PackagePanel => __builder =>
	{
		if (Selected is not { } package || Capabilities.Packages is not { } packages)
		{
			return;
		}

		PackageUpdate? update = _updates?.FirstOrDefault(candidate => candidate.Name == package.Name);
		<ToolDetailPanel Title="@package.Name"
						  Subtitle="@(update is not null ? "An update is waiting" : _updates is null ? "Updates not checked yet" : "Up to date")"
						  DotColor="@(update is null ? _updates is null ? MokaColor.Surface : MokaColor.Success : IsSecurity(update) ? MokaColor.Error : MokaColor.Warning)"
						  DotGlow="@(update is not null)"
						  OnClose="@(() => _selected = null)">
			<Actions>
				<Hint Text="@Context.RootChangeBlocked">
					<MokaButton Variant="MokaVariant.Outlined"
								Color="MokaColor.Error"
								Size="MokaSize.Xs"
								StartIcon="MokaIcons.Action.Delete"
								Disabled="@(Busy || Context.RootChangeBlocked is not null)"
								OnClick="@(() => RemoveAsync(package.Name))">
						Remove
					</MokaButton>
				</Hint>
			</Actions>
			<ChildContent>
				<AdminFacts Items="PackageFacts(package, update, packages)" />
			</ChildContent>
		</ToolDetailPanel>
	};

	private RenderFragment UpdatesPanel => __builder =>
	{
		if (_updates is not { Count: > 0 } updates || Capabilities.Packages is not { } packages)
		{
			return;
		}

		<ToolDetailPanel Title="Pending updates" Subtitle="@($"From {packages.DisplayName}'s lists")" Mono="false" DotColor="@(_security is { Count: > 0 } ? MokaColor.Error : MokaColor.Warning)" DotGlow>
			<div class="mta-tiles">
				<MokaStat Tile Value="@AdminFormat.Count(updates.Count)" Label="Upgradable" HelpText="@($"of {AdminFormat.Count(_installed.Count)} installed")" Color="MokaColor.Warning" />
				@if (packages.KnowsSecurityUpdates)
				{
					<MokaStat Tile Value="@(_security is { } security ? AdminFormat.Count(security.Count) : "?")" Label="For security" HelpText="@(_security is null ? _securityNote ?? "asking" : "fix known problems")" Color="@(_security is { Count: > 0 } ? MokaColor.Error : MokaColor.Surface)" />
				}
				@if (_reboot is { } reboot)
				{
					<MokaStat Tile Value="@(reboot.Required switch { true => "Required", false => "Not needed", _ => "Unknown" })" Label="Reboot" HelpText="@AdminUpdateReads.RebootText(reboot)" Color="@(reboot.Required == true ? MokaColor.Error : reboot.Required == false ? MokaColor.Success : MokaColor.Surface)" />
				}
			</div>
			@if (HeldCount > 0)
			{
				<MokaText Element="span" Size="MokaSize.Xs">@(HeldCount == 1 ? "1 update is" : $"{AdminFormat.Count(HeldCount)} updates are") held back. @RolloutExplained</MokaText>
			}
			<section class="mta-section" aria-label="Updates by repository">
				<MokaText Element="span" Size="MokaSize.Xs" Weight="MokaFontWeight.Semibold" Class="mta-label">By repository</MokaText>
				<MokaDonutChart Segments="SourceShares(updates)" Thickness="30" Size="MokaSize.Sm" Label="Pending updates by repository" Class="mta-donut">
					<span class="mta-donut-total">@AdminFormat.Count(updates.Count)</span>
				</MokaDonutChart>
			</section>
			<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">
				@(packages.RefreshIndex() is not null
					? "These come from the package lists as they were last fetched. Refresh them to ask the repositories again."
					: "These come from the package manager's own check.")
			</MokaText>
		</ToolDetailPanel>
	};

	private RenderFragment InstallPanel => __builder =>
	{
		<ToolDetailPanel Title="Install a package" Mono="false" OnClose="@(() => _installing = false)">
			<TextSetting Label="Package name"
						 Value="@_newPackage"
						 ValueChanged="@(value => _newPackage = value)"
						 Validate="AdminNames.CheckPackage"
						 Placeholder="htop"
						 Disabled="@(Context.RootChangeBlocked is not null)" />
			<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">The name as the package manager spells it. Whatever it depends on comes with it.</MokaText>
			<div class="mta-form-actions">
				<MokaButton Variant="MokaVariant.Outlined"
							Size="MokaSize.Sm"
							StartIcon="MokaIcons.Action.Add"
							Disabled="@(Busy || _newPackage.Length == 0 || Context.RootChangeBlocked is not null)"
							OnClick="InstallAsync">
					Install
				</MokaButton>
			</div>
		</ToolDetailPanel>
	};

	private static string KeyOf(InstalledPackage package) => package.Name + "/" + package.Architecture;

	// The five repositories with the most updates, and the rest as one share, so the ring stays readable.
	private static IReadOnlyList<MokaDonutSegment> SourceShares(IReadOnlyList<PackageUpdate> updates)
	{
		List<(string Source, int Count)> sources =
		[
			.. updates
				.GroupBy(update => update.Source.Length > 0 ? update.Source : "unnamed")
				.Select(group => (group.Key, group.Count()))
				.OrderByDescending(pair => pair.Item2)
				.ThenBy(pair => pair.Key, StringComparer.Ordinal),
		];
		List<MokaDonutSegment> segments = [.. sources.Take(5).Select(pair => new MokaDonutSegment { Name = pair.Source, Value = pair.Count })];
		if (sources.Count > 5)
		{
			segments.Add(new MokaDonutSegment { Name = "others", Value = sources.Skip(5).Sum(pair => pair.Count), Color = MokaColor.Surface });
		}

		return segments;
	}

	private IReadOnlyList<MokaDataListItem> PackageFacts(InstalledPackage package, PackageUpdate? update, PackageCommands packages)
	{
		List<MokaDataListItem> facts = [new("Version", package.Version)];
		if (package.Architecture.Length > 0)
		{
			facts.Add(new("Architecture", package.Architecture));
		}

		if (update is not null)
		{
			bool security = IsSecurity(update);
			facts.Add(new("Update", ValueContent: @<span class="mta-facts-line">
				<span>@update.NewVersion</span>
				@if (security)
				{
					<MokaTag Text="Security" Size="MokaSize.Xs" Color="MokaColor.Error" />
				}
			</span>));
			if (update.Source.Length > 0)
			{
				facts.Add(new("From", update.Source));
			}
		}
		else
		{
			facts.Add(new("Update", _updates is null ? "not checked" : "none"));
		}

		facts.Add(new("Manager", packages.DisplayName));
		return facts;
	}

	private static int ByName(InstalledPackage left, InstalledPackage right) => StringComparer.OrdinalIgnoreCase.Compare(left.Name, right.Name);

	private static int ByName(PackageUpdate left, PackageUpdate right) => StringComparer.OrdinalIgnoreCase.Compare(left.Name, right.Name);

	private static int BySource(PackageUpdate left, PackageUpdate right) => StringComparer.OrdinalIgnoreCase.Compare(left.Source, right.Source);

	private string UpdatesEmptyText(PackageCommands packages) => _updates is { Count: 0 }
		? $"{packages.DisplayName} knows of no newer versions. Its lists may be old: refresh them to ask the repositories again."
		: _view == "security" && _security is { Count: 0 }
			? $"None of the pending updates fixes a security problem, as far as {packages.DisplayName}'s lists know."
			: "No pending update matches the filter.";

	private bool Matches(string name) => _filter.Trim().Length == 0 || name.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase);

	private void OnFilterChanged(string value)
	{
		_filter = value;
		ApplyFilter();
	}

	private void ApplyFilter()
	{
		_installedShown = [.. _installed.Where(package => Matches(package.Name))];
		_updatesShown = [.. (_updates ?? []).Where(update => Matches(update.Name) && (_view != "security" || IsSecurity(update)))];
	}

	private IReadOnlyList<MokaContextMenuItem> MenuFor(InstalledPackage package) =>
	[
		new MokaContextMenuItem { Text = "Details", OnClickSync = () => Select(KeyOf(package), keepOpen: true) },
		new MokaContextMenuItem
		{
			Text = "Remove",
			Icon = MokaIcons.Action.Delete,
			DividerBefore = true,
			Disabled = Busy || Context.RootChangeBlocked is not null,
			OnClick = () => RemoveAsync(package.Name),
		},
	];

	private async Task LoadUpdatesAsync(CancellationToken cancellationToken)
	{
		if (Capabilities.Packages is not { } packages)
		{
			return;
		}

		_updates = null;
		_updatesError = null;
		StateHasChanged();
		try
		{
			AdminOutcome outcome = await ReadAsync(packages.ListUpdates(), cancellationToken);
			if (!outcome.Succeeded)
			{
				_updatesError = outcome.Problem();
				return;
			}

			_updates = packages.ParseUpdates(outcome.Output);
			ApplyFilter();
		}
		catch (AdminException ex)
		{
			_updatesError = ex.Message;
			return;
		}

		await LoadSecurityAsync(packages, _updates, cancellationToken);
		await LoadDeferredAsync(packages, cancellationToken);
	}

	private async Task LoadDeferredAsync(PackageCommands packages, CancellationToken cancellationToken)
	{
		_deferred = [];
		if (_updates is not { Count: > 0 } || packages.ListDeferredUpdates() is not { } script)
		{
			return;
		}

		try
		{
			AdminOutcome outcome = await ReadAsync(script, cancellationToken);
			if (outcome.Succeeded)
			{
				_deferred = PackageListParser.ParseAptDeferred(outcome.Output);
				ApplyFilter();
			}
		}
		catch (AdminException)
		{
			// Only a marking on rows the page already has.
			return;
		}
	}

	/// <summary>Which pending updates fix security problems: read off apt's own list, asked of dnf and yum separately.</summary>
	private async Task LoadSecurityAsync(PackageCommands packages, IReadOnlyList<PackageUpdate> updates, CancellationToken cancellationToken)
	{
		_security = null;
		_securityNote = null;
		if (!packages.KnowsSecurityUpdates)
		{
			return;
		}

		IReadOnlyList<PackageUpdate>? security = packages.SecurityUpdatesAmong(updates);
		string? note = null;
		if (security is null)
		{
			(security, note) = await AdminUpdateReads.SecurityUpdatesAsync(Feature, packages, Capabilities.PackagesMissing, cancellationToken);
		}

		_security = security is null ? null : new HashSet<string>(security.Select(update => update.Name), StringComparer.Ordinal);
		_securityNote = note;
		ApplyFilter();
	}

	private async Task LoadRebootAsync(CancellationToken cancellationToken)
	{
		try
		{
			_reboot = await AdminUpdateReads.RebootAsync(Feature, cancellationToken);
		}
		catch (OperationCanceledException)
		{
			return;
		}

		await InvokeAsync(StateHasChanged);
	}

	private bool IsSecurity(PackageUpdate update) => _security?.Contains(update.Name) == true;

	private bool IsDeferred(PackageUpdate update) => _deferred.Contains(update.Name);

	private int HeldCount => _updates?.Count(IsDeferred) ?? 0;

	private const string RolloutExplained = "Ubuntu releases some updates to machines gradually, and Upgrade all installs these once this machine's turn comes, usually within a few days.";

	private async Task OnViewChangedAsync(string value)
	{
		_view = value;
		_selected = null;
		_installing = false;
		ApplyFilter();
		if (_view != "installed" && _updates is null)
		{
			await LoadUpdatesAsync(CancellationToken.None);
		}
	}

	private void Select(string key) => Select(key, keepOpen: false);

	private void Select(string key, bool keepOpen)
	{
		_installing = false;
		_selected = _selected == key && !keepOpen ? null : key;
	}

	private void StartInstall()
	{
		_view = "installed";
		_selected = null;
		_installing = true;
		_newPackage = _filter.Trim().Length > 0 && AdminNames.CheckPackage(_filter.Trim()) is null ? _filter.Trim() : "";
	}

	private async Task OnPrimaryAsync()
	{
		if (_view != "installed")
		{
			await UpgradeAllAsync();
		}
		else
		{
			StartInstall();
		}
	}

	private async Task InstallAsync()
	{
		if (Capabilities.Packages is not { } packages || AdminNames.CheckPackage(_newPackage) is not null)
		{
			return;
		}

		if (await RunAsync(packages.Install(_newPackage)) is { Succeeded: true })
		{
			_installing = false;
			_newPackage = "";
		}
	}

	private async Task RemoveAsync(string name)
	{
		if (Capabilities.Packages is { } packages && await RunAsync(packages.Remove(name)) is { Succeeded: true })
		{
			_selected = null;
		}
	}

	private async Task UpgradeAllAsync()
	{
		if (Capabilities.Packages is { } packages)
		{
			await RunAsync(packages.UpgradeAll());
		}
	}

	private async Task RefreshIndexAsync()
	{
		if (Capabilities.Packages?.RefreshIndex() is { } refresh)
		{
			await RunAsync(refresh);
		}
	}
}
