@using Moka.Red.ContextMenu
@using Mokaterm.Modules.Ssh.Admin.Accounts
@inherits AdminPageBase

<ToolPageFrame Title="Users"
				Summary="@Summary"
				Search="@_filter"
				SearchChanged="OnFilterChanged"
				SearchPlaceholder="Filter by name"
				PrimaryText="@(Capabilities.Accounts.CanChange ? _view == "groups" ? "Add group" : "Add user" : null)"
				PrimaryIcon="MokaIcons.Action.Add"
				PrimaryDisabled="@(Busy || Context.RootChangeBlocked is not null)"
				PrimaryTitle="@Context.RootChangeBlocked"
				OnPrimary="@(_view == "groups" ? StartAddGroup : StartAdd)"
				Loading="Loading"
				Loaded="Loaded"
				Error="@LoadError"
				OnRefresh="ReloadAsync"
				ListPage
				Detail="@DetailFragment">
	<Chips>
		<AdminChips Items="Chips" Value="@_view" ValueChanged="OnViewChanged" AriaLabel="Accounts to show" />
	</Chips>
	<ChipsEnd>
		@if (_snapshot is { KnowsPasswords: false })
		{
			<Hint Text="Only root can read whether a password is set or locked" Position="MokaTooltipPosition.BottomEnd">
				<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">password states need root mode</MokaText>
			</Hint>
		}
	</ChipsEnd>
	<ChildContent>
		@if (_snapshot is { } snapshot)
		{
			@if (_view == "groups")
			{
				@* A name can repeat (a local entry and a directory one), and a repeated key ends the page on the first
				   re-sort, so rows are keyed by name and number. *@
				<ToolTable TItem="GroupAccount"
						   Items="_groupsShown"
						   ItemKey="@(group => $"{group.Name}|{group.Gid}")"
						   Label="Groups"
						   IsSelected="@(group => group.Name == _selectedGroup && !_addingGroup)"
						   OnRowClick="@(group => SelectGroup(group.Name))"
						   OnRowMenu="@(args => ShowRowMenu(args.MouseEvent, MenuFor(args.Item, snapshot)))"
						   ActionsWidth="var(--moka-button-height-sm)"
						   SortColumn="GID"
						   SortDirection="MokaSortDirection.Ascending"
						   EmptyIcon="SshIcons.Users"
						   EmptyTitle="@(snapshot.Groups.Count == 0 ? "No groups" : "Nothing matches")"
						   EmptyText="@(snapshot.Groups.Count == 0 ? "The group database listed none." : "No group or member matches the filter.")">
					<RowActions Context="group">
						<IconButton Size="MokaSize.Xs"
									Icon="MokaIcons.Navigation.MoreHorizontal"
									OnClick="@(args => ShowRowMenu(args, MenuFor(group, snapshot)))"
									Label="More actions"
									AriaLabel="@($"Actions for {group.Name}")"
									Position="MokaTooltipPosition.BottomEnd" />
					</RowActions>
					<ChildContent>
						<MokaColumn TItem="GroupAccount" Title="Group" Field="@(group => group.Name)" SortComparer="ByName" Mono />
						<MokaColumn TItem="GroupAccount" Title="GID" Field="@(group => group.Gid)" Mono Class="mt-col-wide">
							<CellTemplate Context="group">
								<span class="mta-dim">@group.Gid</span>
							</CellTemplate>
						</MokaColumn>
						<MokaColumn TItem="GroupAccount" Title="Members" Field="@(group => string.Join(", ", group.Members))" Sortable="false" Mono Class="mt-col-main">
							<CellTemplate Context="group">
								<span class="mta-dim" title="@string.Join(", ", group.Members)">@string.Join(", ", group.Members)</span>
							</CellTemplate>
						</MokaColumn>
					</ChildContent>
				</ToolTable>
			}
			else
			{
				@* Keyed by name and number for the same reason as the groups above. *@
				<ToolTable TItem="UserAccount"
						   Items="_usersShown"
						   ItemKey="@(user => $"{user.Name}|{user.Uid}")"
						   Label="@(_view == "all" ? "All accounts" : "People")"
						   IsSelected="@(user => user.Name == _selected && !_adding)"
						   OnRowClick="@(user => Select(user.Name))"
						   OnRowMenu="@(args => ShowRowMenu(args.MouseEvent, MenuFor(args.Item)))"
						   ActionsWidth="var(--moka-button-height-sm)"
						   SortColumn="UID"
						   SortDirection="MokaSortDirection.Ascending"
						   EmptyIcon="SshIcons.Users"
						   EmptyTitle="Nothing matches"
						   EmptyText="@(Capabilities.Accounts.CanChange ? "No account matches the filter. Add user, at the top, makes a new one." : "No account matches the filter.")">
					<RowActions Context="user">
						<IconButton Size="MokaSize.Xs"
									Icon="MokaIcons.Navigation.MoreHorizontal"
									OnClick="@(args => ShowRowMenu(args, MenuFor(user)))"
									Label="More actions"
									AriaLabel="@($"Actions for {user.Name}")"
									Position="MokaTooltipPosition.BottomEnd" />
					</RowActions>
					<ChildContent>
						<MokaColumn TItem="UserAccount" Title="User" Field="@(user => user.Name)" SortComparer="ByName" Class="mt-col-main">
							<CellTemplate Context="user">
								<span class="mta-mono">@user.Name</span>
								@if (user.Name == Context.LoginName)
								{
									<span class="mta-after"><MokaTag Text="YOU" Size="MokaSize.Xs" Color="MokaColor.Info" /></span>
								}
								@if (user.Comment.Length > 0 && user.Comment != user.Name)
								{
									<span class="mta-dim mta-after" title="@user.Comment">@user.Comment</span>
								}
							</CellTemplate>
						</MokaColumn>
						<MokaColumn TItem="UserAccount" Title="UID" Field="@(user => user.Uid)" Mono Class="mt-col-wide">
							<CellTemplate Context="user">
								<span class="mta-dim">@user.Uid</span>
							</CellTemplate>
						</MokaColumn>
						<MokaColumn TItem="UserAccount" Title="Shell" Field="@(user => user.Shell)" Mono Class="mt-col-wide mta-col-cut">
							<CellTemplate Context="user">
								<span class="mta-dim" title="@user.Shell">@user.Shell</span>
							</CellTemplate>
						</MokaColumn>
						@* Without root every password reads as unknown, so the column would be a row of blanks. *@
						<MokaColumn TItem="UserAccount" Title="Password" Field="@(user => PasswordLabel(user.Password))" Visible="KnowsPasswords" Mono>
							<CellTemplate Context="user">
								<span class="@(user.Password is PasswordState.Set ? "" : "mta-dim")" style="@PasswordStyle(user.Password)">@PasswordLabel(user.Password)</span>
							</CellTemplate>
						</MokaColumn>
					</ChildContent>
				</ToolTable>
			}
		}
	</ChildContent>
</ToolPageFrame>

@code {
	private AccountsSnapshot? _snapshot;
	private List<UserAccount> _usersShown = [];
	private List<GroupAccount> _groupsShown = [];
	private string _view = "people";
	private string _filter = "";
	private string? _selected;
	private string _password = "";
	private string? _group;
	private bool _removeHome;

	private bool _adding;
	private int _formVersion;
	private string? _selectedGroup;
	private bool _addingGroup;
	private string _newGroup = "";
	private string _newName = "";
	private string _newComment = "";
	private string _newShell = "";
	private string _newPassword = "";
	private string _newPasswordAgain = "";
	private bool _newHome = true;

	protected override bool ReadsMoreAsRoot => true;

	private string Summary => _snapshot is { } snapshot
		? $"{snapshot.Users.Count(snapshot.IsPerson)} people, {snapshot.Users.Count} accounts, {snapshot.Groups.Count} groups · {ToolsName}"
		: "";

	private string ToolsName => Capabilities.Accounts.Tools switch
	{
		AccountToolKind.Shadow => "shadow-utils",
		AccountToolKind.BusyBox => "BusyBox",
		_ => "read only",
	};

	private IReadOnlyList<AdminChip> Chips =>
	[
		new("people", "People", _snapshot?.Users.Count(_snapshot.IsPerson)),
		new("all", "All accounts", _snapshot?.Users.Count),
		new("groups", "Groups", _snapshot?.Groups.Count),
	];

	private UserAccount? Selected => _selected is { } name ? _snapshot?.Users.FirstOrDefault(user => user.Name == name) : null;

	private RenderFragment? DetailFragment => _view == "groups"
		? _addingGroup ? AddGroupPanel : SelectedGroup is null ? null : GroupPanel
		: _adding ? AddPanel : Selected is null ? null : UserPanel;

	private GroupAccount? SelectedGroup => _selectedGroup is { } name ? _snapshot?.Groups.FirstOrDefault(group => group.Name == name) : null;

	private string? NewNameProblem => _snapshot?.Users.Any(user => user.Name == _newName) == true ? "That user already exists." : null;

	private string? PasswordMismatch => _newPassword.Length > 0 && _newPasswordAgain != _newPassword ? "The two passwords differ." : null;

	private bool CanAdd => _newName.Length > 0
		&& AdminNames.CheckAccount(_newName) is null
		&& NewNameProblem is null
		&& AdminNames.CheckComment(_newComment) is null
		&& AdminNames.CheckShellPath(_newShell) is null
		&& PasswordMismatch is null
		&& (_newPassword.Length == 0 || AdminNames.CheckPassword(_newPassword) is null);

	protected override async Task LoadAsync(CancellationToken cancellationToken)
	{
		AdminOutcome outcome = await ReadAsync(AccountCommands.Read(ReadAsRoot), cancellationToken);
		_snapshot = AccountCommands.Parse(outcome.Output);
		ApplyFilter();
	}

	protected override void Dispose(bool disposing)
	{
		// Typed passwords leave with the page.
		_password = "";
		_newPassword = "";
		_newPasswordAgain = "";
		base.Dispose(disposing);
	}

	private RenderFragment UserPanel => __builder =>
	{
		if (Selected is not { } user || _snapshot is not { } snapshot)
		{
			return;
		}

		string? refusal = AccountCommands.WhyNotDelete(user, Context.LoginName);
		bool blocked = Busy || Context.RootChangeBlocked is not null;
		<ToolDetailPanel Title="@user.Name" Subtitle="@(user.Comment.Length > 0 ? user.Comment : null)" OnClose="@(() => _selected = null)">
			<Actions>
				@if (Capabilities.Accounts.CanChange)
				{
					@if (user.Password != PasswordState.Locked)
					{
						<Hint Text="@Context.RootChangeBlocked">
							<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Error" Size="MokaSize.Xs" Disabled="blocked" OnClick="@(() => LockAsync(user, true))">Lock</MokaButton>
						</Hint>
					}
					@if (user.Password is PasswordState.Locked or PasswordState.Unknown)
					{
						<Hint Text="@Context.RootChangeBlocked">
							<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" Disabled="blocked" OnClick="@(() => LockAsync(user, false))">Unlock</MokaButton>
						</Hint>
					}
					<Hint Text="@(refusal ?? Context.RootChangeBlocked)">
						<MokaButton Variant="MokaVariant.Outlined"
									Color="MokaColor.Error"
									Size="MokaSize.Xs"
									StartIcon="MokaIcons.Action.Delete"
									Disabled="@(blocked || refusal is not null)"
									OnClick="@(() => DeleteAsync(user, snapshot))">
							Delete
						</MokaButton>
					</Hint>
				}
			</Actions>
			<ChildContent>
				<div class="mta-tiles">
					<MokaStat Tile Value="@user.Uid.ToString(CultureInfo.InvariantCulture)" Label="UID" HelpText="@($"gid {user.Gid}")" />
					<MokaStat Tile Value="@PasswordWord(user.Password)" Label="Password" HelpText="@(user.Password == PasswordState.Unknown ? "needs root mode" : PasswordMeaning(user.Password))" Color="@PasswordColor(user.Password)" />
					<MokaStat Tile Value="@AdminFormat.Count(user.Groups.Count)" Label="Groups" HelpText="@(user.Groups.Any(IsPrivileged) ? "one can act as root" : "none of them root's")" Color="@(user.Groups.Any(IsPrivileged) ? MokaColor.Warning : MokaColor.Surface)" />
				</div>
				<AdminFacts Items="UserFacts(user)" />
				@if (Capabilities.Accounts.CanChange)
				{
					@if (refusal is null)
					{
						<MokaCheckbox Value="_removeHome" ValueChanged="@(value => _removeHome = value)" Label="@($"Delete removes {user.Home} too")" />
					}

					<MokaText Element="span" Size="MokaSize.Xs" Weight="MokaFontWeight.Semibold" Class="mta-label">Add to a group</MokaText>
					<div class="mta-inline">
						<div class="mta-grow">
							<MokaSelect TValue="string"
										Items="GroupNames(snapshot, user)"
										Value="@_group"
										ValueChanged="@(value => _group = value)"
										Searchable
										Placeholder="Pick a group"
										Size="MokaSize.Sm"
										aria-label="Group" />
						</div>
						<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" Disabled="@(blocked || string.IsNullOrEmpty(_group))" OnClick="@(() => AddToGroupAsync(user))">Add</MokaButton>
					</div>

					@if (Capabilities.Accounts.CanSetPasswords && Feature.SupportsInput)
					{
						<MokaText Element="span" Size="MokaSize.Xs" Weight="MokaFontWeight.Semibold" Class="mta-label">Set a new password</MokaText>
						<div class="mta-inline">
							<div class="mta-grow">
								<MokaPasswordField @bind-Value="_password" Placeholder="New password" autocomplete="new-password" Size="MokaSize.Sm" aria-label="New password" />
							</div>
							<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" Disabled="@(blocked || AdminNames.CheckPassword(_password) is not null)" OnClick="@(() => SetPasswordAsync(user))">Set</MokaButton>
						</div>
					}
				}
				else
				{
					<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">This machine has neither useradd nor BusyBox's adduser, so accounts are shown and not changed.</MokaText>
				}

				<AdminAuthorizedKeys UserName="@user.Name" @key="user.Name" />
			</ChildContent>
		</ToolDetailPanel>
	};

	private RenderFragment GroupPanel => __builder =>
	{
		if (SelectedGroup is not { } group || _snapshot is not { } snapshot)
		{
			return;
		}

		string? refusal = AccountCommands.WhyNotDeleteGroup(group, snapshot);
		List<string> primaryOf = [.. snapshot.Users.Where(user => user.Gid == group.Gid).Select(user => user.Name)];
		<ToolDetailPanel Title="@group.Name" Subtitle="@($"gid {group.Gid}")" OnClose="@(() => _selectedGroup = null)">
			<Actions>
				@if (Capabilities.Accounts.CanChange)
				{
					<Hint Text="@(refusal ?? Context.RootChangeBlocked)">
						<MokaButton Variant="MokaVariant.Outlined"
									Color="MokaColor.Error"
									Size="MokaSize.Xs"
									StartIcon="MokaIcons.Action.Delete"
									Disabled="@(Busy || refusal is not null || Context.RootChangeBlocked is not null)"
									OnClick="@(() => DeleteGroupAsync(group, snapshot))">
							Delete
						</MokaButton>
					</Hint>
				}
			</Actions>
			<ChildContent>
				<div class="mta-tiles">
					<MokaStat Tile Value="@group.Gid.ToString(CultureInfo.InvariantCulture)" Label="GID" HelpText="@(IsPrivileged(group.Name) ? "can act as root" : "group id")" Color="@(IsPrivileged(group.Name) ? MokaColor.Warning : MokaColor.Surface)" />
					<MokaStat Tile Value="@AdminFormat.Count(group.Members.Count)" Label="Members" HelpText="listed in the group" />
					<MokaStat Tile Value="@AdminFormat.Count(primaryOf.Count)" Label="Primary of" HelpText="users whose own group" />
				</div>
				<AdminFacts Items="@([new("Members", ValueContent: NameTags(group.Members, "none listed")), new("Primary of", ValueContent: NameTags(primaryOf, "nobody"))])" />
				@if (refusal is not null)
				{
					<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">@refusal</MokaText>
				}
			</ChildContent>
		</ToolDetailPanel>
	};

	private RenderFragment AddGroupPanel => __builder =>
	{
		<ToolDetailPanel Title="Add group" Mono="false" OnClose="@(() => _addingGroup = false)">
			<TextSetting Label="Name" Value="@_newGroup" ValueChanged="@(value => _newGroup = value)" Validate="ValidateNewGroup" Placeholder="deploy" @key="_formVersion" />
			<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">The group gets the next free group id and no members; add users to it from their own panel.</MokaText>
			<div class="mta-form-actions">
				<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" Size="MokaSize.Sm" OnClick="@(() => _addingGroup = false)">Cancel</MokaButton>
				<MokaButton Variant="MokaVariant.Outlined"
							Size="MokaSize.Sm"
							Disabled="@(Busy || ValidateNewGroup(_newGroup) is not null || Context.RootChangeBlocked is not null)"
							OnClick="AddGroupAsync">
					Add group
				</MokaButton>
			</div>
		</ToolDetailPanel>
	};

	private RenderFragment AddPanel => __builder =>
	{
		<ToolDetailPanel Title="Add user" Mono="false" OnClose="CancelAdd">
			<div class="mta-form" @key="_formVersion">
				<TextSetting Label="Name" Value="@_newName" ValueChanged="@(value => _newName = value)" Validate="ValidateNewName" Placeholder="alice" />
				<TextSetting Label="Full name" Value="@_newComment" ValueChanged="@(value => _newComment = value)" Validate="AdminNames.CheckComment" AllowEmpty Placeholder="optional" />
			</div>
			<MokaSelect TValue="string"
						Label="Shell"
						Items="Shells"
						Value="@_newShell"
						ValueChanged="@(value => _newShell = value ?? "")"
						Size="MokaSize.Sm" />
			@if (Capabilities.Accounts.CanSetPasswords && Feature.SupportsInput)
			{
				<div class="mta-form">
					<MokaPasswordField Label="Password" @bind-Value="_newPassword" Placeholder="optional" autocomplete="new-password" Size="MokaSize.Sm" />
					<MokaPasswordField Label="Again" @bind-Value="_newPasswordAgain" ErrorText="@PasswordMismatch" autocomplete="new-password" Size="MokaSize.Sm" />
				</div>
				<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">Without a password the account cannot log in with one. A password goes to chpasswd on stdin, never on a command line.</MokaText>
			}
			<MokaCheckbox Value="_newHome" ValueChanged="@(value => _newHome = value)" Label="Create a home folder" />
			<div class="mta-form-actions">
				<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" Size="MokaSize.Sm" OnClick="CancelAdd">Cancel</MokaButton>
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" Disabled="@(Busy || !CanAdd || Context.RootChangeBlocked is not null)" OnClick="AddAsync">Add user</MokaButton>
			</div>
		</ToolDetailPanel>
	};

	private IReadOnlyList<string> Shells => _snapshot is { Shells.Count: > 0 } snapshot ? snapshot.Shells : ["/bin/sh"];

	// Membership in these hands out root, or root's equal through the Docker socket.
	private static bool IsPrivileged(string group) => group is "sudo" or "wheel" or "admin" or "root" or "docker";

	private static IReadOnlyList<MokaDataListItem> UserFacts(UserAccount user) =>
	[
		new("Home", user.Home),
		new("Shell", user.Shell),
		new("Groups", ValueContent: NameTags(user.Groups, "none")),
	];

	private static RenderFragment NameTags(IReadOnlyList<string> names, string none) => __builder =>
	{
		<span class="mta-facts-line">
			@if (names.Count == 0)
			{
				<span class="mta-dim">@none</span>
			}
			@foreach (string name in names)
			{
				<MokaTag @key="name" Text="@name" Size="MokaSize.Xs" Variant="MokaVariant.Soft" Color="@(IsPrivileged(name) ? MokaColor.Warning : MokaColor.Surface)" />
			}
		</span>
	};

	private static string PasswordWord(PasswordState state) => state switch
	{
		PasswordState.Set => "Set",
		PasswordState.Locked => "Locked",
		PasswordState.Disabled => "No login",
		PasswordState.Empty => "Empty",
		_ => "Unknown",
	};

	private static string PasswordMeaning(PasswordState state) => state switch
	{
		PasswordState.Set => "logs in with it",
		PasswordState.Locked => "kept but refused",
		PasswordState.Disabled => "no password login",
		PasswordState.Empty => "logs in without one",
		_ => "",
	};

	private static MokaColor PasswordColor(PasswordState state) => state switch
	{
		PasswordState.Locked => MokaColor.Warning,
		PasswordState.Empty => MokaColor.Error,
		PasswordState.Set => MokaColor.Success,
		_ => MokaColor.Surface,
	};

	private bool KnowsPasswords => _snapshot?.KnowsPasswords == true;

	private static string PasswordLabel(PasswordState state) => state switch
	{
		PasswordState.Set => "set",
		PasswordState.Locked => "locked",
		PasswordState.Disabled => "no login",
		PasswordState.Empty => "empty",
		_ => "",
	};

	private static string? PasswordStyle(PasswordState state) => state switch
	{
		PasswordState.Locked => "color:var(--moka-color-warning)",
		PasswordState.Empty => "color:var(--moka-color-error)",
		_ => null,
	};

	private static IReadOnlyList<string> GroupNames(AccountsSnapshot snapshot, UserAccount user) =>
		[.. snapshot.Groups.Select(group => group.Name).Where(name => !user.Groups.Contains(name) && AdminNames.CheckAccount(name) is null)];

	private string? ValidateNewName(string name) => AdminNames.CheckAccount(name) ?? (_snapshot?.Users.Any(user => user.Name == name) == true ? "That user already exists." : null);

	private static int ByName(UserAccount left, UserAccount right) => StringComparer.OrdinalIgnoreCase.Compare(left.Name, right.Name);

	private static int ByName(GroupAccount left, GroupAccount right) => StringComparer.OrdinalIgnoreCase.Compare(left.Name, right.Name);

	private void OnFilterChanged(string value)
	{
		_filter = value;
		ApplyFilter();
	}

	private void OnViewChanged(string value)
	{
		_view = value;
		_selected = null;
		_selectedGroup = null;
		_addingGroup = false;
		ApplyFilter();
	}

	private void ApplyFilter()
	{
		if (_snapshot is not { } snapshot)
		{
			return;
		}

		_usersShown = [.. snapshot.Users.Where(user => (_view == "all" || snapshot.IsPerson(user)) && Matches(user))];
		_groupsShown = [.. snapshot.Groups.Where(Matches)];
	}

	private bool Matches(UserAccount user) => _filter.Trim().Length == 0
		|| user.Name.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase)
		|| user.Comment.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase);

	private bool Matches(GroupAccount group) => _filter.Trim().Length == 0
		|| group.Name.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase)
		|| group.Members.Any(member => member.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase));

	private IReadOnlyList<MokaContextMenuItem> MenuFor(UserAccount user)
	{
		List<MokaContextMenuItem> items = [new MokaContextMenuItem { Text = "Details", OnClickSync = () => Select(user.Name, keepOpen: true) }];
		if (!Capabilities.Accounts.CanChange || _snapshot is not { } snapshot)
		{
			return items;
		}

		bool blocked = Busy || Context.RootChangeBlocked is not null;
		items.Add(user.Password == PasswordState.Locked
			? new MokaContextMenuItem { Text = "Unlock", DividerBefore = true, Disabled = blocked, OnClick = () => LockAsync(user, false) }
			: new MokaContextMenuItem { Text = "Lock", DividerBefore = true, Disabled = blocked, OnClick = () => LockAsync(user, true) });
		items.Add(new MokaContextMenuItem
		{
			Text = "Delete",
			Icon = MokaIcons.Action.Delete,
			Disabled = blocked || AccountCommands.WhyNotDelete(user, Context.LoginName) is not null,
			OnClick = () => DeleteAsync(user, snapshot),
		});
		return items;
	}

	private string? ValidateNewGroup(string name) => AdminNames.CheckAccount(name) ?? (_snapshot?.Groups.Any(group => group.Name == name) == true ? "That group already exists." : null);

	private IReadOnlyList<MokaContextMenuItem> MenuFor(GroupAccount group, AccountsSnapshot snapshot)
	{
		List<MokaContextMenuItem> items = [new MokaContextMenuItem { Text = "Details", OnClickSync = () => SelectGroup(group.Name, keepOpen: true) }];
		if (Capabilities.Accounts.CanChange)
		{
			items.Add(new MokaContextMenuItem
			{
				Text = "Delete",
				Icon = MokaIcons.Action.Delete,
				DividerBefore = true,
				Disabled = Busy || Context.RootChangeBlocked is not null || AccountCommands.WhyNotDeleteGroup(group, snapshot) is not null,
				OnClick = () => DeleteGroupAsync(group, snapshot),
			});
		}

		return items;
	}

	private void SelectGroup(string name) => SelectGroup(name, keepOpen: false);

	private void SelectGroup(string name, bool keepOpen)
	{
		_addingGroup = false;
		_selectedGroup = _selectedGroup == name && !keepOpen ? null : name;
	}

	private void StartAddGroup()
	{
		_addingGroup = true;
		_selectedGroup = null;
		_newGroup = "";
		_formVersion++;
	}

	private async Task AddGroupAsync()
	{
		string name = _newGroup;
		if (ValidateNewGroup(name) is not null)
		{
			return;
		}

		if (await RunAsync(Capabilities.Accounts.AddGroup(name)) is { Succeeded: true })
		{
			_addingGroup = false;
			_selectedGroup = name;
		}
	}

	private async Task DeleteGroupAsync(GroupAccount group, AccountsSnapshot snapshot)
	{
		if (await RunAsync(Capabilities.Accounts.DeleteGroup(group, snapshot, Context.LoginName)) is { Succeeded: true })
		{
			_selectedGroup = null;
		}
	}

	private void Select(string name) => Select(name, keepOpen: false);

	private void Select(string name, bool keepOpen)
	{
		_adding = false;
		_selected = _selected == name && !keepOpen ? null : name;
		_password = "";
		_group = null;
		_removeHome = false;
	}

	private void StartAdd()
	{
		_view = _view == "groups" ? "people" : _view;
		_adding = true;
		_selected = null;
		_newName = "";
		_newComment = "";
		_newPassword = "";
		_newPasswordAgain = "";
		_newHome = true;
		_newShell = Shells.FirstOrDefault(shell => shell.EndsWith("/bash", StringComparison.Ordinal)) ?? Shells[0];
		_formVersion++;
	}

	private void CancelAdd()
	{
		_adding = false;
		_newPassword = "";
		_newPasswordAgain = "";
	}

	private async Task AddAsync()
	{
		if (!CanAdd)
		{
			return;
		}

		string name = _newName;
		string? password = _newPassword.Length > 0 ? _newPassword : null;
		(AdminAction action, string? input) = Capabilities.Accounts.AddUser(name, _newComment, _newShell, _newHome, password);
		_newPassword = "";
		_newPasswordAgain = "";
		AdminInput? stdin = input is null ? null : AdminInput.Secret(input, $"{name}:********");
		if (await RunAsync(action, stdin) is { Succeeded: true })
		{
			_adding = false;
			_selected = name;
		}
	}

	private async Task SetPasswordAsync(UserAccount user)
	{
		if (AdminNames.CheckPassword(_password) is not null)
		{
			return;
		}

		(AdminAction action, string input) = Capabilities.Accounts.SetPassword(user.Name, _password);
		_password = "";
		await RunAsync(action, AdminInput.Secret(input, $"{user.Name}:********"));
	}

	private Task LockAsync(UserAccount user, bool locked) => RunAsync(Capabilities.Accounts.Lock(user.Name, locked));

	private async Task AddToGroupAsync(UserAccount user)
	{
		if (_group is { } group && AdminNames.CheckAccount(group) is null)
		{
			await RunAsync(Capabilities.Accounts.AddToGroup(user.Name, group));
			_group = null;
		}
	}

	private async Task DeleteAsync(UserAccount user, AccountsSnapshot snapshot)
	{
		if (await RunAsync(Capabilities.Accounts.DeleteUser(user, _removeHome, Context.LoginName, snapshot.FirstPersonUid)) is { Succeeded: true })
		{
			_selected = null;
		}
	}
}
