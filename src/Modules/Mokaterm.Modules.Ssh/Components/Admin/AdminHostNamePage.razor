@using Mokaterm.Modules.Ssh.Admin.Naming
@inherits AdminPageBase

<ToolPageFrame Title="Hostname" Summary="@Summary" Loading="Loading" Loaded="Loaded" Error="@LoadError" OnRefresh="ReloadAsync">
	@if (_info is { } info)
	{
		<dl class="mta-kv">
			<dt>Current</dt>
			<dd><MokaText Element="span" Size="MokaSize.Sm" Mono>@info.Current</MokaText></dd>
			<dt>At boot</dt>
			<dd>
				<MokaText Element="span" Size="MokaSize.Sm" Mono>@(info.Static.Length > 0 ? info.Static : "not set")</MokaText>
				@if (info.Static.Length > 0 && info.Static != info.Current)
				{
					<Hint Text="The name changes at the next boot." Class="mta-after"><MokaTag Text="DIFFERS" Size="MokaSize.Xs" Color="MokaColor.Warning" /></Hint>
				}
			</dd>
			@if (info.Pretty.Length > 0)
			{
				<dt>Pretty name</dt>
				<dd>@info.Pretty</dd>
			}
			@foreach ((string key, string value) in info.Details)
			{
				<dt>@key</dt>
				<dd><MokaText Element="span" Size="MokaSize.Sm" Mono>@value</MokaText></dd>
			}
		</dl>

		<section class="mta-section">
			<MokaText Element="span" Size="MokaSize.Xs" Weight="MokaFontWeight.Semibold" Class="mta-label">Rename the machine</MokaText>
			<div class="mta-inline">
				<div class="mta-grow">
					<TextSetting Value="@_name"
								 ValueChanged="@(value => _name = value)"
								 Validate="AdminNames.CheckHostName"
								 Placeholder="web-01.example.com"
								 AriaLabel="New host name"
								 Disabled="@(Context.RootChangeBlocked is not null)"
								 @key="_formVersion" />
				</div>
				<Hint Text="@Context.RootChangeBlocked">
					<MokaButton Variant="MokaVariant.Outlined"
								Size="MokaSize.Sm"
								Disabled="@(Busy || _name.Length == 0 || _name == info.Current || Context.RootChangeBlocked is not null)"
								OnClick="RenameAsync">
						Rename
					</MokaButton>
				</Hint>
			</div>
			<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">
				@(Capabilities.HostName.UsesHostnamectl
					? "Set with hostnamectl, now and for the next boot. /etc/hosts is left alone."
					: "Written to /etc/hostname and set with hostname(1). /etc/hosts is left alone.")
			</MokaText>
		</section>
	}
</ToolPageFrame>

@code {
	private HostNameInfo? _info;
	private string _name = "";
	private int _formVersion;

	private string Summary => _info is { } info
		? $"{info.Current} · {(Capabilities.HostName.UsesHostnamectl ? "hostnamectl" : "/etc/hostname")}"
		: "";

	protected override async Task LoadAsync(CancellationToken cancellationToken)
	{
		AdminOutcome outcome = await ReadAsync(Capabilities.HostName.Read(), cancellationToken);
		_info = HostNameCommands.Parse(outcome.Output);
	}

	private async Task RenameAsync()
	{
		if (AdminNames.CheckHostName(_name) is null && await RunAsync(Capabilities.HostName.Set(_name, Context.SessionAddress)) is { Succeeded: true })
		{
			_name = "";
			_formVersion++;
		}
	}
}
