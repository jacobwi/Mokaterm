@using Mokaterm.Modules.Ssh.Admin.Packages
@using Mokaterm.Modules.Ssh.Admin.Reboot
@implements IDisposable

@* Two overview tiles, security updates and whether a reboot is due, which read on their own so the overview only
   places them. Both open the packages page, where the reboot is offered. *@
<Hint Text="@_securityNote" Class="mta-ov-tile-hint">
	<button type="button" class="mta-ov-tile" @onclick="OpenSecurity" disabled="@(Context.Profile.Capabilities.Packages is null)">
		<MokaStat Tile
				  Value="@(_security is { } security ? AdminFormat.Count(security.Count) : _securityNote is null ? "..." : "?")"
				  Label="Security updates"
				  HelpText="@(_security is not null ? Context.Profile.Capabilities.Packages?.DisplayName : _securityNote is null ? "asking" : "not known")"
				  Color="@(_security is { Count: > 0 } ? MokaColor.Error : MokaColor.Surface)" />
	</button>
</Hint>

@if (RebootCommands.CanReboot(Context.Profile))
{
	<Hint Text="@(_reboot is { } status ? AdminUpdateReads.RebootText(status) : null)" Class="mta-ov-tile-hint">
		<button type="button" class="mta-ov-tile" @onclick="OpenPackages">
			<MokaStat Tile
					  Value="@(_reboot?.Required switch { true => "Required", false => "Not needed", _ => _reboot is null ? "..." : "Unknown" })"
					  Label="Reboot"
					  HelpText="@(_reboot is { } known ? AdminUpdateReads.RebootText(known) : "reading")"
					  Color="@(_reboot?.Required == true ? MokaColor.Error : _reboot?.Required == false ? MokaColor.Success : MokaColor.Surface)" />
		</button>
	</Hint>
}

@code {
	private readonly CancellationTokenSource _lifetime = new();
	private IReadOnlyList<PackageUpdate>? _security;
	private string? _securityNote;
	private RebootStatus? _reboot;

	[CascadingParameter]
	private AdminPageContext Context { get; set; } = default!;

	public void Dispose()
	{
		_lifetime.Cancel();
		_lifetime.Dispose();
	}

	protected override async Task OnInitializedAsync()
	{
		try
		{
			Task<RebootStatus> reboot = AdminUpdateReads.RebootAsync(Context.Feature, _lifetime.Token);
			(_security, _securityNote) = await AdminUpdateReads.SecurityUpdatesAsync(
				Context.Feature,
				Context.Profile.Capabilities.Packages,
				Context.Profile.Capabilities.PackagesMissing,
				_lifetime.Token);
			StateHasChanged();
			_reboot = await reboot;
		}
		catch (OperationCanceledException)
		{
		}
	}

	private void OpenSecurity() =>
		Context.Navigate(AdminPageIds.Packages, Context.Profile.Capabilities.Packages?.KnowsSecurityUpdates == true ? "security" : "updates");

	private void OpenPackages() => Context.Navigate(AdminPageIds.Packages, "updates");
}
