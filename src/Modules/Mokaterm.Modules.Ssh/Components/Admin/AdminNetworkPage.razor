@using Moka.Red.ContextMenu
@using Mokaterm.Modules.Ssh.Admin.Network
@inherits AdminPageBase

<ToolPageFrame Title="Network"
				Summary="@Summary"
				Search="@_filter"
				SearchChanged="OnFilterChanged"
				SearchPlaceholder="Filter"
				Loading="Loading"
				Loaded="Loaded"
				Error="@LoadError"
				OnRefresh="ReloadAsync"
				ListPage
				Detail="@DetailFragment">
	<Chips>
		<AdminChips Items="Chips" Value="@_view" ValueChanged="@(value => { _view = value; _selected = null; })" AriaLabel="Network details to show" />
	</Chips>
	<ChildContent>
		@if (_snapshot is { } snapshot)
		{
			@switch (_view)
			{
				case "interfaces":
					@if (!Capabilities.HasNetworkTools)
					{
						<MokaEmptyState Icon="SshIcons.Network" Title="No ip command" Description="iproute2 is not installed, so interfaces cannot be listed. Name servers and listening ports still can." />
					}
					else
					{
						<div class="mta-stack">
							<ToolTable TItem="NetInterface"
									   Items="_interfacesShown"
									   ItemKey="@(item => item.Name)"
									   Label="Interfaces"
									   IsSelected="@(item => item.Name == _selected)"
									   OnRowClick="@(item => Select(item.Name))"
									   OnRowMenu="@(args => ShowRowMenu(args.MouseEvent, MenuFor(args.Item)))"
									   ActionsWidth="var(--moka-button-height-sm)"
									   EmptyIcon="SshIcons.Network"
									   EmptyTitle="@(snapshot.Interfaces.Count == 0 ? "No interfaces" : "Nothing matches")"
									   EmptyText="@(snapshot.Interfaces.Count == 0 ? "ip listed none." : "No interface or address matches the filter.")">
								<RowActions Context="item">
									<IconButton Size="MokaSize.Xs"
												Icon="MokaIcons.Navigation.MoreHorizontal"
												OnClick="@(args => ShowRowMenu(args, MenuFor(item)))"
												Label="More actions"
												AriaLabel="@($"Actions for {item.Name}")"
												Position="MokaTooltipPosition.BottomEnd" />
								</RowActions>
								<ChildContent>
									<MokaColumn TItem="NetInterface" Title="" Sortable="false" Resizable="false" Class="mt-col-dot">
										<CellTemplate Context="item">
											<MokaStatusDot Size="MokaSize.Xs" Color="@LinkColor(item)" Glow="item.IsUp" />
										</CellTemplate>
									</MokaColumn>
									<MokaColumn TItem="NetInterface" Title="Interface" Field="@(item => item.Name)" SortComparer="ByName" Mono>
										<CellTemplate Context="item">
											<span>@item.Name</span>
											@if (CarriesSession(item))
											{
												<Hint Text="This SSH session arrives on this interface" Class="mta-after"><MokaTag Text="This session" Size="MokaSize.Xs" Color="MokaColor.Warning" /></Hint>
											}
										</CellTemplate>
									</MokaColumn>
									<MokaColumn TItem="NetInterface" Title="Addresses" Field="@(item => AddressText(item))" Mono Class="mt-col-main">
										<CellTemplate Context="item">
											<span class="mta-dim" title="@string.Join("\n", item.Addresses.Select(address => address.Cidr))">@AddressText(item)</span>
										</CellTemplate>
									</MokaColumn>
									<MokaColumn TItem="NetInterface" Title="MTU" Field="@(item => item.Mtu)" Mono Class="mt-col-wide">
										<CellTemplate Context="item">
											<span class="mta-dim">@item.Mtu</span>
										</CellTemplate>
									</MokaColumn>
								</ChildContent>
							</ToolTable>
							@if (snapshot.FromText)
							{
								<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">Read from plain ip output: this ip prints no JSON.</MokaText>
							}
						</div>
					}
					break;

				case "routes":
					<ToolTable TItem="NetRoute"
							   Items="_routesShown"
							   ItemKey="@(route => $"{route.Destination}|{route.Device}|{route.Gateway}|{route.Metric}")"
							   Label="Routes"
							   EmptyIcon="SshIcons.Network"
							   EmptyTitle="@(snapshot.Routes.Count == 0 ? "No routes" : "Nothing matches")"
							   EmptyText="@(snapshot.Routes.Count == 0 ? "ip listed no routes." : "No route matches the filter.")">
						<MokaColumn TItem="NetRoute" Title="Destination" Field="@(route => route.Destination)" Mono />
						<MokaColumn TItem="NetRoute" Title="Via" Field="@(route => route.Gateway)" Mono>
							<CellTemplate Context="route">
								<span class="mta-dim">@(route.Gateway.Length > 0 ? route.Gateway : "direct")</span>
							</CellTemplate>
						</MokaColumn>
						<MokaColumn TItem="NetRoute" Title="Device" Field="@(route => route.Device)" Mono />
						<MokaColumn TItem="NetRoute" Title="Source, protocol, metric" Field="@(route => RouteDetails(route))" Sortable="false" Mono Class="mt-col-main mt-col-wide">
							<CellTemplate Context="route">
								<span class="mta-dim">@RouteDetails(route)</span>
							</CellTemplate>
						</MokaColumn>
					</ToolTable>
					break;

				case "dns":
					<ToolTable TItem="DnsRow"
							   Items="_dnsShown"
							   ItemKey="@(row => row.IsSearch ? "|search" : row.Scope)"
							   Label="Name servers"
							   EmptyIcon="SshIcons.Network"
							   EmptyTitle="No name servers"
							   EmptyText="Neither resolvectl nor /etc/resolv.conf names one.">
						<MokaColumn TItem="DnsRow" Title="Where" Field="@(row => row.Scope)" Sortable="false">
							<CellTemplate Context="row">
								<span class="@(row.IsSearch ? "mta-dim" : "mta-mono")">@row.Scope</span>
							</CellTemplate>
						</MokaColumn>
						<MokaColumn TItem="DnsRow" Title="Name servers" Field="@(row => string.Join("  ", row.Values))" Sortable="false" Mono Class="mt-col-main">
							<CellTemplate Context="row">
								<span title="@string.Join("\n", row.Values)">@string.Join("  ", row.Values)</span>
							</CellTemplate>
						</MokaColumn>
					</ToolTable>
					break;

				case "ports":
					@if (snapshot.ListeningSource.Length == 0)
					{
						<MokaEmptyState Icon="SshIcons.Network" Title="No socket tool" Description="Neither ss nor netstat is installed." />
					}
					else
					{
						<div class="mta-stack">
							<ToolTable TItem="ListeningSocket"
									   Items="_portsShown"
									   ItemKey="@(socket => $"{socket.Protocol}|{socket.Address}|{socket.Port}|{socket.Pid}")"
									   Label="Listening sockets"
									   SortColumn="Port"
									   SortDirection="MokaSortDirection.Ascending"
									   EmptyIcon="SshIcons.Network"
									   EmptyTitle="@(snapshot.Listening.Count == 0 ? "Nothing listens" : "Nothing matches")"
									   EmptyText="@(snapshot.Listening.Count == 0 ? $"{snapshot.ListeningSource} listed no listening sockets." : "No socket matches the filter.")">
								<MokaColumn TItem="ListeningSocket" Title="Proto" Field="@(socket => socket.Protocol)" Mono>
									<CellTemplate Context="socket">
										<span class="mta-dim">@socket.Protocol</span>
									</CellTemplate>
								</MokaColumn>
								<MokaColumn TItem="ListeningSocket" Title="Address" Field="@(socket => socket.Address)" Mono Class="mta-col-cut">
									<CellTemplate Context="socket">
										<span title="@socket.Address">@socket.Address</span>
									</CellTemplate>
								</MokaColumn>
								<MokaColumn TItem="ListeningSocket" Title="Port" Field="@(socket => socket.Port)" SortComparer="ByPort" Mono>
									<CellTemplate Context="socket">
										<span>@socket.Port</span>
										@if (socket.Port == Profile.Facts.SshServerPort && !socket.IsUdp)
										{
											<Hint Text="This session arrived on this port" Class="mta-after"><MokaStatusDot Size="MokaSize.Xs" Color="MokaColor.Warning" Glow /></Hint>
										}
									</CellTemplate>
								</MokaColumn>
								<MokaColumn TItem="ListeningSocket" Title="Process" Field="@(socket => socket.Process)" Mono Class="mt-col-main mt-col-wide">
									<CellTemplate Context="socket">
										<span class="mta-dim">@(socket.Process.Length > 0 ? $"{socket.Process} ({socket.Pid})" : "")</span>
									</CellTemplate>
								</MokaColumn>
							</ToolTable>
						</div>
					}
					break;
			}
		}
	</ChildContent>
</ToolPageFrame>

@code {
	private NetworkSnapshot? _snapshot;
	private string _view = "interfaces";
	private string _filter = "";
	private string? _selected;
	private List<NetInterface> _interfacesShown = [];
	private List<NetRoute> _routesShown = [];
	private List<DnsRow> _dnsShown = [];
	private List<ListeningSocket> _portsShown = [];

	protected override bool ReadsMoreAsRoot => true;

	private string Summary => _snapshot is { } snapshot
		? $"{snapshot.Interfaces.Count} interfaces, {snapshot.Interfaces.Count(item => item.IsUp)} up · {snapshot.Routes.Count} routes · {snapshot.Listening.Count} listening sockets"
		: "";

	private IReadOnlyList<AdminChip> Chips =>
	[
		new("interfaces", "Interfaces", _snapshot?.Interfaces.Count),
		new("routes", "Routes", _snapshot?.Routes.Count),
		new("dns", "DNS"),
		new("ports", "Listening", _snapshot?.Listening.Count),
	];

	private NetInterface? Selected => _selected is { } name ? _snapshot?.Interfaces.FirstOrDefault(item => item.Name == name) : null;

	protected override async Task LoadAsync(CancellationToken cancellationToken)
	{
		AdminOutcome outcome = await ReadAsync(NetworkCommands.Read(ReadAsRoot), cancellationToken);
		_snapshot = NetworkParser.Parse(outcome.Output);
		ApplyFilter();
	}

	private RenderFragment InterfacePanel => __builder =>
	{
		if (Selected is not { } networkInterface)
		{
			return;
		}

		<ToolDetailPanel Title="@networkInterface.Name"
						  Subtitle="@($"{networkInterface.LinkType} · {(networkInterface.State.Length > 0 ? networkInterface.State : "state unknown")}")"
						  DotColor="@LinkColor(networkInterface)"
						  DotGlow="networkInterface.IsUp"
						  OnClose="@(() => _selected = null)">
			<Actions>
				@if (!networkInterface.IsLoopback)
				{
					<Hint Text="@Context.RootChangeBlocked">
						<MokaButton Variant="MokaVariant.Outlined"
									Color="@(networkInterface.IsUp ? MokaColor.Error : MokaColor.Primary)"
									Size="MokaSize.Xs"
									Disabled="@(Busy || Context.RootChangeBlocked is not null || AdminNames.CheckInterface(networkInterface.Name) is not null)"
									OnClick="@(() => SetLinkAsync(networkInterface, !networkInterface.IsUp))">
							@(networkInterface.IsUp ? "Bring down" : "Bring up")
						</MokaButton>
					</Hint>
				}
			</Actions>
			<ChildContent>
				@if (CarriesSession(networkInterface))
				{
					<MokaAlert Severity="MokaToastSeverity.Error" Dense>This SSH session arrives on this interface. Bringing it down cuts the session.</MokaAlert>
				}
				<div class="mta-tiles">
					<MokaStat Tile Value="@(networkInterface.IsUp ? "Up" : "Down")" Label="Link" HelpText="@(networkInterface.State.Length > 0 ? networkInterface.State : "state unknown")" Color="@LinkColor(networkInterface)" />
					<MokaStat Tile Value="@AdminFormat.Count(networkInterface.Addresses.Count)" Label="Addresses" HelpText="@(networkInterface.Addresses.Count == 1 ? "1 address" : $"{networkInterface.Addresses.Count} addresses")" />
					<MokaStat Tile Value="@(networkInterface.Mtu?.ToString(CultureInfo.InvariantCulture) ?? "?")" Label="MTU" HelpText="@(networkInterface.LinkType.Length > 0 ? networkInterface.LinkType : "link type unknown")" />
				</div>
				<AdminFacts Items="InterfaceFacts(networkInterface)" />
			</ChildContent>
		</ToolDetailPanel>
	};

	private RenderFragment? DetailFragment => _view switch
	{
		"interfaces" when Selected is not null => InterfacePanel,
		"ports" when _snapshot is { ListeningSource.Length: > 0 } snapshot && snapshot.Listening.Count > 0 => PortsPanel,
		_ => null,
	};

	private RenderFragment PortsPanel => _snapshot is { } snapshot
		? AdminListening.Panel(snapshot.Listening, snapshot.ListeningSource, Profile.Facts.SshServerPort, ReadAsRoot ? null : RootNote)
		: _ => { };

	private static RenderFragment RootNote => __builder =>
	{
		<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">Processes show for this login's own sockets. Root mode shows them all.</MokaText>
	};

	private IReadOnlyList<MokaDataListItem> InterfaceFacts(NetInterface networkInterface)
	{
		List<MokaDataListItem> facts =
		[
			new("Addresses", ValueContent: @<span class="mta-facts-stack">
				@if (networkInterface.Addresses.Count == 0)
				{
					<span class="mta-dim">none</span>
				}
				@foreach (NetAddress address in networkInterface.Addresses)
				{
					<span class="mta-facts-line" @key="address.Cidr">
						<span>@address.Cidr</span>
						@if (address.Scope.Length > 0)
						{
							<MokaTag Text="@address.Scope" Size="MokaSize.Xs" Variant="MokaVariant.Soft" Color="MokaColor.Surface" />
						}
					</span>
				}
			</span>),
			new("MAC", networkInterface.Mac.Length > 0 ? networkInterface.Mac : "none"),
			new("Flags", ValueContent: @<span class="mta-facts-line">
				@foreach (string flag in networkInterface.Flags)
				{
					<MokaTag @key="flag" Text="@flag" Size="MokaSize.Xs" Variant="MokaVariant.Soft" Color="@(flag is "UP" or "LOWER_UP" ? MokaColor.Success : MokaColor.Surface)" />
				}
			</span>),
		];
		if (_snapshot?.Routes.Any(route => route.IsDefault && route.Device == networkInterface.Name) == true)
		{
			facts.Add(new("Routes", ValueContent: @<span class="mta-facts-text">The default route leaves through this interface.</span>));
		}

		return facts;
	}

	private static MokaColor LinkColor(NetInterface networkInterface) => networkInterface.IsUp
		? networkInterface.State is "DOWN" or "LOWERLAYERDOWN" ? MokaColor.Warning : MokaColor.Success
		: MokaColor.Surface;

	private bool CarriesSession(NetInterface networkInterface) => NetworkParser.Holds(networkInterface, Profile.Facts.SshServerAddress);

	private bool Matches(string value) => _filter.Trim().Length == 0 || value.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase);

	private static string AddressText(NetInterface networkInterface) => networkInterface.Addresses.Count == 0
		? "no address"
		: string.Join("  ", networkInterface.Addresses.Select(address => address.Cidr));

	private static string RouteDetails(NetRoute route) =>
		string.Join(" ", new[] { route.Source, route.Protocol, route.Metric?.ToString(CultureInfo.InvariantCulture) ?? "" }.Where(part => part.Length > 0));

	private static int ByName(NetInterface left, NetInterface right) => StringComparer.OrdinalIgnoreCase.Compare(left.Name, right.Name);

	private static int ByPort(ListeningSocket left, ListeningSocket right) => left.Port.CompareTo(right.Port);

	private void OnFilterChanged(string value)
	{
		_filter = value;
		ApplyFilter();
	}

	private void ApplyFilter()
	{
		if (_snapshot is not { } snapshot)
		{
			return;
		}

		_interfacesShown = [.. snapshot.Interfaces.Where(item => Matches(item.Name) || item.Addresses.Any(address => Matches(address.Address)))];
		_routesShown = [.. snapshot.Routes.Where(route => Matches(route.Destination) || Matches(route.Device) || Matches(route.Gateway))];
		_dnsShown = [.. snapshot.Dns.Select(pair => new DnsRow(pair.Scope, pair.Servers))];
		if (snapshot.SearchDomains.Count > 0)
		{
			_dnsShown.Add(new DnsRow("search", snapshot.SearchDomains, IsSearch: true));
		}

		_portsShown = [.. snapshot.Listening.Where(socket => Matches(socket.Process) || Matches(socket.Address) || Matches(socket.Port.ToString(CultureInfo.InvariantCulture)))];
	}

	private IReadOnlyList<MokaContextMenuItem> MenuFor(NetInterface networkInterface)
	{
		List<MokaContextMenuItem> items = [new MokaContextMenuItem { Text = "Details", OnClickSync = () => _selected = networkInterface.Name }];
		if (!networkInterface.IsLoopback)
		{
			items.Add(new MokaContextMenuItem
			{
				Text = networkInterface.IsUp ? "Bring down" : "Bring up",
				DividerBefore = true,
				Disabled = Busy || Context.RootChangeBlocked is not null || AdminNames.CheckInterface(networkInterface.Name) is not null,
				OnClick = () => SetLinkAsync(networkInterface, !networkInterface.IsUp),
			});
		}

		return items;
	}

	private void Select(string name) => _selected = _selected == name ? null : name;

	private async Task SetLinkAsync(NetInterface networkInterface, bool up)
	{
		if (_snapshot is { } snapshot)
		{
			_selected = networkInterface.Name;
			await RunAsync(NetworkCommands.SetLink(networkInterface, up, snapshot, Profile.Facts.SshServerAddress));
		}
	}
}
