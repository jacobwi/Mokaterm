@using Moka.Red.ContextMenu
@using Mokaterm.Modules.Ssh.Admin.Firewall
@inherits AdminPageBase

<ToolPageFrame Title="Firewall"
				Summary="@Summary"
				Search="@_filter"
				SearchChanged="OnFilterChanged"
				SearchPlaceholder="Filter rules"
				PrimaryText="@(Capabilities.Firewall?.CanChange == true && _status is not null ? "Add rule" : null)"
				PrimaryIcon="MokaIcons.Action.Add"
				PrimaryDisabled="@(Busy || _adding)"
				OnPrimary="StartAdd"
				Loading="Loading"
				Loaded="Loaded"
				Error="@LoadError"
				OnRefresh="ReloadAsync"
				ListPage
				Detail="@(_adding ? AddPanel : SelectedRule is null ? null : RulePanel)">
	<Chips>
		@if (_status is { } status && Capabilities.Firewall is { } firewall)
		{
			<MokaStatusDot Size="MokaSize.Xs"
						   Color="@AdminFormat.Dot(status.Active)"
						   Glow="@(status.Active == true)"
						   Label="@(status.Active switch { true => "ACTIVE", false => "INACTIVE", _ => "SEE THE RULES" })" />
			@if (firewall.CanChange && firewall.AllowsSsh(status) == false && status.Active == true)
			{
				<Hint Text="No rule allows the port this session arrived on; something else, such as a source rule, lets it in.">
					<MokaTag Text="@($"No rule for port {firewall.SshPort}")" Size="MokaSize.Xs" Color="MokaColor.Warning" />
				</Hint>
			}
		}
	</Chips>
	<ChipsEnd>
		@if (_status is { } current && Capabilities.Firewall is { CanChange: true } changeable)
		{
			<button type="button"
					class="mta-link"
					disabled="@Busy"
					@onclick="@(() => RunAsync(current.Active == true ? changeable.Disable() : changeable.Enable(current)))">
				@(current.Active == true ? $"turn {changeable.DisplayName} off" : $"turn {changeable.DisplayName} on")
			</button>
		}
	</ChipsEnd>
	<ChildContent>
		@if (Capabilities.Firewall is not { } firewall)
		{
			<MokaEmptyState Icon="MokatermIcons.Shield" Title="No firewall tool" Description="@Capabilities.FirewallMissing" />
		}
		else if (!ReadAsRoot)
		{
			<MokaEmptyState Icon="MokatermIcons.Root"
							Title="The firewall needs root"
							Description="@(Context.RootChangeBlocked ?? $"{firewall.DisplayName} only answers root, even to say whether it is on.")">
				@if (Context.RootChangeBlocked is null)
				{
					<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" StartIcon="MokatermIcons.Lock" OnClick="Context.EnableRoot">Turn on root mode</MokaButton>
				}
			</MokaEmptyState>
		}
		else if (_status is { } status)
		{
			@if (status.Rules.Count > 0)
			{
				<div class="mta-stack">
					@Policies(status)
					<ToolTable TItem="AdminRow<FirewallRule>"
							   Items="_rulesShown"
							   ItemKey="@(row => row.Index)"
							   Label="Firewall rules"
							   IsSelected="@(row => row.Index == _selected && !_adding)"
							   OnRowClick="@(row => Select(row.Index))"
							   OnRowMenu="@(args => ShowRowMenu(args.MouseEvent, MenuFor(args.Item.Item, args.Item.Index, firewall, status)))"
							   ActionsWidth="var(--moka-button-height-sm)"
							   EmptyIcon="MokatermIcons.Shield"
							   EmptyTitle="Nothing matches"
							   EmptyText="No rule matches the filter.">
						<RowActions Context="row">
							<IconButton Size="MokaSize.Xs"
										Icon="MokaIcons.Navigation.MoreHorizontal"
										OnClick="@(args => ShowRowMenu(args, MenuFor(row.Item, row.Index, firewall, status)))"
										Label="More actions"
										AriaLabel="@($"Actions for {row.Item.Target}")"
										Position="MokaTooltipPosition.BottomEnd" />
						</RowActions>
						<ChildContent>
							<MokaColumn TItem="AdminRow<FirewallRule>" Title="#" Field="@(row => row.Item.Number)" Visible="@(status.Rules.Any(rule => rule.Number is not null))" Mono>
								<CellTemplate Context="row">
									<span class="mta-dim">@row.Item.Number</span>
								</CellTemplate>
							</MokaColumn>
							<MokaColumn TItem="AdminRow<FirewallRule>" Title="Rule" Field="@(row => row.Item.Target)" Mono Class="mt-col-main">
								<CellTemplate Context="row">
									<span title="@row.Item.Target">@row.Item.Target</span>
								</CellTemplate>
							</MokaColumn>
							<MokaColumn TItem="AdminRow<FirewallRule>" Title="Action" Field="@(row => row.Item.Action)" Mono>
								<CellTemplate Context="row">
									<MokaTag Text="@row.Item.Action" Size="MokaSize.Xs" Variant="MokaVariant.Soft" Color="@ActionColor(row.Item.Action)" />
								</CellTemplate>
							</MokaColumn>
							<MokaColumn TItem="AdminRow<FirewallRule>" Title="From" Field="@(row => row.Item.From)" Mono Class="mt-col-wide mta-col-cut">
								<CellTemplate Context="row">
									<span class="mta-dim" title="@row.Item.From">@row.Item.From</span>
								</CellTemplate>
							</MokaColumn>
						</ChildContent>
					</ToolTable>
				</div>
			}
			else
			{
				<div class="mta-stack">
					@Policies(status)
					@if (status.Raw.Length > 0)
					{
						<AdminOutput Label="@($"{firewall.DisplayName} rule set, read only")" Text="@status.Raw" CopyLabel="Copy the rule set" Fill Wrap="false" />
					}
					else
					{
						<MokaEmptyState Icon="MokatermIcons.Shield"
										Title="@(status.Active == true ? "No rules" : $"{firewall.DisplayName} is off")"
										Description="@(status.Active == true ? "Only the default policies apply." : "Nothing is filtered. Turn it on from the line above; the port this session uses is allowed first.")">
							@if (firewall.CanChange)
							{
								<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" StartIcon="MokaIcons.Action.Add" Disabled="Busy" OnClick="StartAdd">Add rule</MokaButton>
							}
						</MokaEmptyState>
					}
				</div>
			}
		}
	</ChildContent>
</ToolPageFrame>

@code {
	private FirewallStatus? _status;
	private List<AdminRow<FirewallRule>> _rulesShown = [];
	private string _filter = "";
	private bool _adding;
	private int _formVersion;
	private int? _selected;
	private FirewallPort? _port;

	protected override bool ReadsMoreAsRoot => true;

	private string Summary
	{
		get
		{
			if (Capabilities.Firewall is not { } firewall)
			{
				return "no firewall tool";
			}

			if (_status is not { } status)
			{
				return $"{firewall.DisplayName} · needs root";
			}

			string state = status.Active switch { true => "active", false => "inactive", _ => "rule set" };
			return $"{firewall.DisplayName} {state}, {status.Rules.Count} rules · this session uses port {firewall.SshPort}";
		}
	}

	private FirewallRule? SelectedRule => _selected is { } index && _status is { } status && index < status.Rules.Count ? status.Rules[index] : null;

	protected override async Task LoadAsync(CancellationToken cancellationToken)
	{
		if (Capabilities.Firewall is not { } firewall || !ReadAsRoot)
		{
			_status = null;
			return;
		}

		FirewallRule? selected = SelectedRule;
		AdminOutcome outcome = await ReadAsync(firewall.Status(), cancellationToken);
		_status = firewall.Parse(outcome);

		// Rules move up when one before them goes, so the selection follows the rule, not the line.
		int found = selected is null ? -1 : _status.Rules.ToList().FindIndex(rule => rule.Target == selected.Target && rule.Action == selected.Action && rule.From == selected.From);
		_selected = found < 0 ? null : found;
		ApplyFilter();
	}

	private static RenderFragment Policies(FirewallStatus status) => __builder =>
	{
		@if (status.Summary.Count > 0)
		{
			<AdminFacts Items="@([.. status.Summary.Select(pair => new MokaDataListItem(pair.Key, pair.Value))])" />
		}
	};

	private void OnFilterChanged(string value)
	{
		_filter = value;
		ApplyFilter();
	}

	private void ApplyFilter() =>
		_rulesShown = _status is { } status
			? [.. status.Rules.Select((rule, index) => new AdminRow<FirewallRule>(rule, index)).Where(row => Matches(row.Item))]
			: [];

	private RenderFragment RulePanel => __builder =>
	{
		if (SelectedRule is not { } rule || _status is not { } status || Capabilities.Firewall is not { } firewall)
		{
			return;
		}

		string? refusal = firewall.WhyNotDelete(rule);
		<ToolDetailPanel Title="@rule.Target" Subtitle="@rule.Action" OnClose="@(() => _selected = null)">
			<Actions>
				@if (firewall.CanChange)
				{
					<Hint Text="@refusal">
						<MokaButton Variant="MokaVariant.Outlined"
									Color="MokaColor.Error"
									Size="MokaSize.Xs"
									StartIcon="MokaIcons.Action.Delete"
									Disabled="@(Busy || refusal is not null)"
									OnClick="@(() => DeleteAsync(rule, firewall, status))">
							Delete
						</MokaButton>
					</Hint>
				}
			</Actions>
			<ChildContent>
				<div class="mta-tiles">
					<MokaStat Tile Value="@rule.Action" Label="Action" HelpText="@(rule.From.Length > 0 ? $"from {rule.From}" : "from anywhere")" Color="@ActionColor(rule.Action)" />
					@if (rule.Number is { } number)
					{
						<MokaStat Tile Value="@number.ToString(CultureInfo.InvariantCulture)" Label="Order" HelpText="first match wins" />
					}
				</div>
				<AdminFacts Items="RuleFacts(rule)" />
				@if (firewall.AllowsSsh(rule))
				{
					<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">@($"This rule lets in port {firewall.SshPort}, which this session arrived on.")</MokaText>
				}
				@if (!firewall.CanChange)
				{
					<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">@($"{firewall.DisplayName} rules are shown here, not changed.")</MokaText>
				}
				else if (refusal is not null)
				{
					<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">@refusal</MokaText>
				}
			</ChildContent>
		</ToolDetailPanel>
	};

	private IReadOnlyList<MokaContextMenuItem> MenuFor(FirewallRule rule, int index, FirewallCommands firewall, FirewallStatus status)
	{
		List<MokaContextMenuItem> items = [new MokaContextMenuItem { Text = "Details", OnClickSync = () => Select(index, keepOpen: true) }];
		if (firewall.CanChange)
		{
			items.Add(new MokaContextMenuItem
			{
				Text = "Delete",
				Icon = MokaIcons.Action.Delete,
				DividerBefore = true,
				Disabled = Busy || firewall.WhyNotDelete(rule) is not null,
				OnClick = () => DeleteAsync(rule, firewall, status),
			});
		}

		return items;
	}

	private void Select(int index) => Select(index, keepOpen: false);

	private void Select(int index, bool keepOpen)
	{
		_adding = false;
		_selected = _selected == index && !keepOpen ? null : index;
	}

	private async Task DeleteAsync(FirewallRule rule, FirewallCommands firewall, FirewallStatus status)
	{
		if (firewall.WhyNotDelete(rule) is null && await RunAsync(firewall.Delete(rule, status)) is { Succeeded: true })
		{
			_selected = null;
		}
	}

	private RenderFragment AddPanel => __builder =>
	{
		<ToolDetailPanel Title="Add a rule" Mono="false" OnClose="@(() => _adding = false)">
			<TextSetting Label="Port"
						 Value="@(_port?.ToString() ?? "")"
						 ValueChanged="OnPortChanged"
						 Validate="PortProblem"
						 Placeholder="8080/tcp, or 53 for tcp and udp"
						 @key="_formVersion" />
			<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">
				@(Capabilities.Firewall?.Kind == Mokaterm.Modules.Ssh.Admin.Detection.FirewallKind.Firewalld
					? "Allow opens the port in the default zone; deny removes it and adds a reject rule. Both are permanent."
					: "Allow and deny add a ufw rule for the port.")
			</MokaText>
			<div class="mta-form-actions">
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Sm" Disabled="@(Busy || _port is null)" OnClick="@(() => PortAsync(allow: true))">Allow</MokaButton>
				<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Error" Size="MokaSize.Sm" Disabled="@(Busy || _port is null)" OnClick="@(() => PortAsync(allow: false))">Deny</MokaButton>
			</div>
		</ToolDetailPanel>
	};

	private static string? PortProblem(string text)
	{
		FirewallPort.TryParse(text, out string? problem);
		return problem;
	}

	private static MokaColor ActionColor(string action) => action switch
	{
		_ when action.StartsWith("ALLOW", StringComparison.Ordinal) => MokaColor.Success,
		_ when action.StartsWith("DENY", StringComparison.Ordinal) || action.StartsWith("REJECT", StringComparison.Ordinal) => MokaColor.Error,
		_ when action.StartsWith("LIMIT", StringComparison.Ordinal) => MokaColor.Warning,
		_ => MokaColor.Surface,
	};

	private static IReadOnlyList<MokaDataListItem> RuleFacts(FirewallRule rule)
	{
		List<MokaDataListItem> facts = [new("Rule", rule.Target)];
		if (rule.From.Length > 0)
		{
			facts.Add(new("From", rule.From));
		}

		return facts;
	}

	private bool Matches(FirewallRule rule) => _filter.Trim().Length == 0
		|| rule.Target.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase)
		|| rule.From.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase);

	private void OnPortChanged(string text) => _port = FirewallPort.TryParse(text, out _);

	private void StartAdd()
	{
		_selected = null;
		_adding = true;
		_port = null;
		_formVersion++;
	}

	private async Task PortAsync(bool allow)
	{
		if (Capabilities.Firewall is not { } firewall || _port is not { } port)
		{
			return;
		}

		if (await RunAsync(allow ? firewall.Allow(port) : firewall.Deny(port)) is { Succeeded: true })
		{
			_adding = false;
		}
	}
}
