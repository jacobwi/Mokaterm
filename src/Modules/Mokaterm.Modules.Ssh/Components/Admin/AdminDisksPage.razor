@using Moka.Red.Navigation.Breadcrumb
@using Mokaterm.Modules.Ssh.Admin.Storage
@using Mokaterm.UI.Common.Formatting
@inherits AdminPageBase

<ToolPageFrame Title="Disks"
				Summary="@Summary"
				Search="@_filter"
				SearchChanged="OnFilterChanged"
				SearchPlaceholder="@(_view == "space" ? "Filter by name" : "Filter by device or mount point")"
				PrimaryText="@(_view == "space" ? "Find large files" : null)"
				PrimaryIcon="MokaIcons.Action.Search"
				PrimaryDisabled="_searching"
				PrimaryTitle="List the largest files under this folder, on its own file system"
				OnPrimary="FindLargeFilesAsync"
				Loading="Loading"
				Loaded="Loaded"
				Error="@LoadError"
				OnRefresh="ReloadAsync"
				ListPage
				Detail="@DetailFragment">
	<Chips>
		<AdminChips Items="Chips" Value="@_view" ValueChanged="OnViewChangedAsync" AriaLabel="Disk details to show" />
	</Chips>
	<ChipsEnd>
		@if (_view is "usage" or "mounts")
		{
			<MokaCheckbox Value="_everything" ValueChanged="OnEverythingChanged" Label="Kernel and memory file systems too" />
		}
	</ChipsEnd>
	<ChildContent>
		@if (_snapshot is { } snapshot)
		{
			@switch (_view)
			{
				case "space":
					@SpaceView(snapshot)
					break;

				case "devices":
					<div class="mta-stack">
						<ToolTable TItem="AdminRow<BlockDevice>"
								   Items="_devicesShown"
								   ItemKey="@(row => $"{row.Item.Name}|{row.Depth}|{row.Item.MountPoint}")"
								   Label="Block devices"
								   IsSelected="@(row => row.Item.Name == _device)"
								   OnRowClick="@(row => SelectDevice(row.Item))"
								   EmptyIcon="SshIcons.Disk"
								   EmptyTitle="@(snapshot.Devices.Count == 0 ? "No block devices" : "Nothing matches")"
								   EmptyText="@(snapshot.Devices.Count == 0 ? "Neither lsblk nor /proc/partitions listed one, which is usual in a container." : "No device or mount point matches the filter.")">
							<MokaColumn TItem="AdminRow<BlockDevice>" Title="Device" Sortable="false" Class="mt-col-main">
								<CellTemplate Context="row">
									<Hint Text="@DeviceTitle(row.Item)" Position="MokaTooltipPosition.BottomStart" Class="mta-cell" Style="@Indent(row.Depth, 14)">
										<span class="mta-mono">@row.Item.Name</span>
										@if (row.Item.Model.Length > 0 || row.Item.Label.Length > 0)
										{
											<span class="mta-dim mta-after">@(row.Item.Model.Length > 0 ? row.Item.Model : row.Item.Label)</span>
										}
										@if (_smart.TryGetValue(row.Item.Name, out SmartReport? health) && health.Passed is { } passed)
										{
											<span class="mta-after"><MokaTag Text="@(passed && !health.NeedsAttention ? "OK" : "Check")" Size="MokaSize.Xs" Color="@(passed && !health.NeedsAttention ? MokaColor.Success : MokaColor.Error)" /></span>
										}
									</Hint>
								</CellTemplate>
							</MokaColumn>
							<MokaColumn TItem="AdminRow<BlockDevice>" Title="Type" Sortable="false" Mono Class="mt-col-wide">
								<CellTemplate Context="row">
									<span class="mta-dim">@row.Item.Type</span>
								</CellTemplate>
							</MokaColumn>
							<MokaColumn TItem="AdminRow<BlockDevice>" Title="File system" Sortable="false" Mono Class="mt-col-wide">
								<CellTemplate Context="row">
									<span class="mta-dim">@row.Item.FileSystem</span>
								</CellTemplate>
							</MokaColumn>
							<MokaColumn TItem="AdminRow<BlockDevice>" Title="Size" Sortable="false" Mono Align="MokaTextAlign.Right">
								<CellTemplate Context="row">
									@(row.Item.SizeBytes is { } size ? DisplayFormat.Bytes(size) : "")
								</CellTemplate>
							</MokaColumn>
							<MokaColumn TItem="AdminRow<BlockDevice>" Title="Mounted on" Sortable="false" Mono Class="mta-col-cut">
								<CellTemplate Context="row">
									<span title="@row.Item.MountPoint">@row.Item.MountPoint</span>
								</CellTemplate>
							</MokaColumn>
						</ToolTable>
						@if (snapshot.DevicesFromPartitions)
						{
							<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">lsblk is not installed, so only names and sizes from /proc/partitions are known.</MokaText>
						}
					</div>
					break;

				case "usage":
					<ToolTable TItem="FileSystemUsage"
							   Items="_usageShown"
							   ItemKey="@(item => $"{item.MountPoint}|{item.Source}")"
							   Label="File systems"
							   OnRowClick="@(item => OpenSpaceAsync(item.MountPoint))"
							   SortColumn="Mounted on"
							   SortDirection="MokaSortDirection.Ascending"
							   EmptyIcon="SshIcons.Disk"
							   EmptyTitle="Nothing matches"
							   EmptyText="@(_everything ? "No file system matches the filter." : "No storage file system matches the filter. Tick kernel and memory file systems to see those too.")">
						<MokaColumn TItem="FileSystemUsage" Title="Mounted on" Field="@(item => item.MountPoint)" SortComparer="ByMountPoint" Class="mt-col-main">
							<CellTemplate Context="item">
								@* The hint names the whole mount point, so the cell needs no title of its own. *@
								<Hint Text="@($"See what is using space on {item.MountPoint}")" Position="MokaTooltipPosition.BottomStart" Class="mta-cell mta-mono">@item.MountPoint</Hint>
							</CellTemplate>
						</MokaColumn>
						<MokaColumn TItem="FileSystemUsage" Title="Source" Field="@(item => item.Source)" Mono Class="mt-col-wide mta-col-cut">
							<CellTemplate Context="item">
								<span class="mta-dim" title="@item.Source">@item.Source</span>
							</CellTemplate>
						</MokaColumn>
						<MokaColumn TItem="FileSystemUsage" Title="Type" Field="@(item => item.Type)" Mono Class="mt-col-wider">
							<CellTemplate Context="item">
								<span class="mta-dim">@item.Type</span>
							</CellTemplate>
						</MokaColumn>
						<MokaColumn TItem="FileSystemUsage" Title="Used" Field="@(item => item.UsedPercent)" SortComparer="ByUsed" SortDescendingFirst>
							<CellTemplate Context="item">
								<Hint Text="@($"{AdminFormat.Kb(item.UsedKb)} used, {AdminFormat.Kb(item.AvailableKb)} free")">
									<span class="mta-used">
										<span class="mta-mono mta-used-figure">@AdminFormat.Percent(item.UsedPercent)</span>
										<MokaMeter Value="item.UsedPercent" ShowValue="false" Color="@AdminFormat.LevelColor(item.UsedPercent)" Size="MokaSize.Xs" Class="mta-used-bar" aria-label="@($"{item.MountPoint} used")" />
										<span class="mta-mono mta-dim">@AdminFormat.Kb(item.AvailableKb) free</span>
									</span>
								</Hint>
							</CellTemplate>
						</MokaColumn>
						<MokaColumn TItem="FileSystemUsage" Title="Size" Field="@(item => item.TotalKb)" SortComparer="BySize" SortDescendingFirst Mono Align="MokaTextAlign.Right">
							<CellTemplate Context="item">
								@AdminFormat.Kb(item.TotalKb)
							</CellTemplate>
						</MokaColumn>
					</ToolTable>
					break;

				default:
					<ToolTable TItem="MountEntry"
							   Items="_mountsShown"
							   ItemKey="@(mount => $"{mount.MountPoint}|{mount.Source}|{mount.Type}")"
							   Label="Mounts"
							   EmptyIcon="SshIcons.Disk"
							   EmptyTitle="Nothing matches"
							   EmptyText="@(_everything ? "No mount matches the filter." : "No storage mount matches the filter. Tick kernel and memory file systems to see those too.")">
						<MokaColumn TItem="MountEntry" Title="Mounted on" Field="@(mount => mount.MountPoint)" Mono Class="mta-col-cut">
							<CellTemplate Context="mount">
								<span title="@mount.MountPoint">@mount.MountPoint</span>
								@if (mount.IsReadOnly)
								{
									<span class="mta-after"><MokaTag Text="RO" Size="MokaSize.Xs" Color="MokaColor.Warning" /></span>
								}
							</CellTemplate>
						</MokaColumn>
						<MokaColumn TItem="MountEntry" Title="Source" Field="@(mount => mount.Source)" Mono Class="mt-col-wide mta-col-cut">
							<CellTemplate Context="mount">
								<span class="mta-dim" title="@mount.Source">@mount.Source</span>
							</CellTemplate>
						</MokaColumn>
						<MokaColumn TItem="MountEntry" Title="Type" Field="@(mount => mount.Type)" Mono />
						<MokaColumn TItem="MountEntry" Title="Options" Field="@(mount => mount.Options)" Sortable="false" Mono Class="mt-col-main mt-col-wide">
							<CellTemplate Context="mount">
								<span class="mta-dim" title="@mount.Options">@mount.Options</span>
							</CellTemplate>
						</MokaColumn>
					</ToolTable>
					break;
			}
		}
	</ChildContent>
</ToolPageFrame>

@code {
	private const string SpaceTab = "space";

	private DiskSnapshot? _snapshot;
	private List<FileSystemUsage> _usageShown = [];
	private List<MountEntry> _mountsShown = [];
	private List<AdminRow<BlockDevice>> _devicesShown = [];
	private string _view = "usage";
	private string _filter = "";
	private bool _everything;

	private readonly Dictionary<string, SpaceReport> _spaceCache = new(StringComparer.Ordinal);
	private string _spacePath = "/";
	private SpaceReport? _space;
	private string? _spaceError;
	private bool _measuring;
	private CancellationTokenSource? _measure;

	private long _largeKb = SpaceCommands.LargeFileSizesKb[1];
	private SpaceReport? _large;
	private string? _largeError;
	private bool _searching;
	private CancellationTokenSource? _search;

	private readonly Dictionary<string, SmartReport> _smart = new(StringComparer.Ordinal);
	private string? _device;
	private string? _smartReading;
	private string? _smartError;
	private CancellationTokenSource? _smartRead;

	protected override bool ReadsMoreAsRoot => true;

	private string Summary
	{
		get
		{
			if (_snapshot is not { } snapshot)
			{
				return "";
			}

			if (_view == SpaceTab)
			{
				return $"du -x -k -d 1 {_spacePath} · stays on this file system{(ReadAsRoot ? "" : " · root mode reads folders this login cannot")}";
			}

			List<FileSystemUsage> storage = [.. snapshot.Usage.Where(DiskCommands.IsStorage)];
			int full = storage.Count(item => item.UsedPercent >= 90);
			return $"{storage.Count} file systems{(full > 0 ? $", {full} over 90% full" : "")} · {snapshot.Devices.Count} block devices · read only";
		}
	}

	private IReadOnlyList<AdminChip> Chips =>
	[
		new("usage", "Usage", _snapshot?.Usage.Count(DiskCommands.IsStorage)),
		new(SpaceTab, "What's using space"),
		new("devices", "Devices", _snapshot?.Devices.Count),
		new("mounts", "Mounts", _snapshot?.Mounts.Count),
	];

	private BlockDevice? SelectedDevice => _device is { } name && _snapshot is { } snapshot
		? Flatten(snapshot.Devices, 0).Select(pair => pair.Device).FirstOrDefault(device => device.Name == name)
		: null;

	protected override async Task LoadAsync(CancellationToken cancellationToken)
	{
		AdminOutcome outcome = await ReadAsync(DiskCommands.Read(), cancellationToken);
		_snapshot = DiskCommands.Parse(outcome.Output);
		ApplyFilter();

		// A refresh or a change of root mode reads everything again: what root can see is not what the login can.
		_spaceCache.Clear();
		_smart.Clear();
		_large = null;
		_largeError = null;
		if (_view == SpaceTab)
		{
			_ = MeasureAsync(_spacePath);
		}

		if (SelectedDevice is { } device)
		{
			StartSmartRead(device);
		}
	}

	protected override void Dispose(bool disposing)
	{
		if (disposing)
		{
			foreach (CancellationTokenSource? source in (CancellationTokenSource?[])[_measure, _search, _smartRead])
			{
				source?.Cancel();
				source?.Dispose();
			}

			_measure = _search = _smartRead = null;
		}

		base.Dispose(disposing);
	}

	private RenderFragment SpaceView(DiskSnapshot snapshot) => __builder =>
	{
		IReadOnlyList<(string Name, string Path)> trail = SpaceCommands.Trail(_spacePath);
		<div class="mta-stack">
			<div class="mta-crumbs">
				<MokaBreadcrumb @key="_spacePath" Look="MokaBreadcrumbLook.Path" Class="mta-crumbs-path" aria-label="Folder">
					<Root>
						@CrumbButton(trail[0].Name, trail[0].Path, trail.Count == 1)
					</Root>
					<ChildContent>
						@for (int index = 1; index < trail.Count; index++)
						{
							(string name, string path) = trail[index];
							<MokaBreadcrumbItem>@CrumbButton(name, path, index == trail.Count - 1)</MokaBreadcrumbItem>
						}
					</ChildContent>
				</MokaBreadcrumb>
				@if (SpaceCommands.Parent(_spacePath) is { } up)
				{
					<button type="button" class="mta-link" @onclick="@(() => MeasureAsync(up))">Up</button>
				}
				<button type="button" class="mta-link" disabled="@_measuring" @onclick="@(() => MeasureAsync(_spacePath, reuse: false))">Measure again</button>
			</div>

			@if (_measuring)
			{
				<div class="mta-loading">
					<MokaSpinner Label="@($"Measuring {_spacePath}; du takes a while on a big folder")" />
				</div>
			}
			else if (_spaceError is { } error)
			{
				<MokaAlert Severity="MokaToastSeverity.Error" Dense>@error</MokaAlert>
			}
			else if (_space is { } report)
			{
				List<SpaceRow> rows = SpaceRows(snapshot, report);
				<div class="mta-space-head">
					<span class="mta-stat mta-stat--small">@(report.TotalKb is { } total ? AdminFormat.Kb(total) : "?")</span>
					<span class="mta-dim">@SpaceNote(report)</span>
					@if (report.Unreadable > 0 && !ReadAsRoot && Context.RootChangeBlocked is null)
					{
						<button type="button" class="mta-link" @onclick="Context.EnableRoot">Turn on root mode to read them</button>
					}
				</div>
				<ToolTable TItem="SpaceRow"
						   Items="rows"
						   ItemKey="@(row => row.Mount is null ? row.Path ?? "" : "mount|" + row.Path)"
						   Label="@($"Folders in {_spacePath}")"
						   OnRowClick="OpenSpaceRowAsync"
						   RowClass="@(row => row.Path is null ? "mta-row--still" : null)"
						   EmptyIcon="SshIcons.Disk"
						   EmptyTitle="@(_filter.Trim().Length > 0 ? "Nothing matches" : "Nothing takes space")"
						   EmptyText="@(_filter.Trim().Length > 0 ? "No folder here matches the filter." : "Nothing under this folder takes any space.")">
					<MokaColumn TItem="SpaceRow" Title="Folder" Field="@(row => row.Name)" Class="mt-col-main">
						<CellTemplate Context="row">
							@if (row.Mount is { } mount)
							{
								<Hint Text="@($"{mount.Source}, a file system of its own, so du left it out here. Open it to measure it.")" Position="MokaTooltipPosition.BottomStart" Class="mta-cell mta-mono">
									@row.Name/
									<span class="mta-dim mta-after">@($"{mount.Type} file system of its own")</span>
								</Hint>
							}
							else if (row.Path is { } path)
							{
								<Hint Text="@($"Open {path}")" Position="MokaTooltipPosition.BottomStart" Class="mta-cell mta-mono">@row.Name/</Hint>
							}
							else
							{
								<span class="mta-dim">@row.Name</span>
							}
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="SpaceRow" Title="Size" Field="@(row => row.Kb)" SortComparer="BySize" SortDescendingFirst Mono Align="MokaTextAlign.Right">
						<CellTemplate Context="row">
							<span class="@(row.Mount is null ? null : "mta-dim")">@AdminFormat.Kb(row.Kb)</span>
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="SpaceRow" Title="Share" Field="@(row => row.Share)" Sortable="false" Class="mt-col-wide">
						<CellTemplate Context="row">
							@if (row.Mount is null)
							{
								<MokaMeter Value="row.Share" ShowValue="false" Color="MokaColor.Info" Size="MokaSize.Xs" Class="mta-share-bar" aria-label="@($"{row.Name}'s share")" />
							}
						</CellTemplate>
					</MokaColumn>
				</ToolTable>
			}

			@if (_searching || _large is not null || _largeError is not null)
			{
				<section class="@(_large is { Entries.Count: > 0 } ? "mta-section mta-large mta-large--table" : "mta-section mta-large")" aria-label="Large files">
					<div class="mta-inline">
						<MokaText Element="span" Size="MokaSize.Xs" Weight="MokaFontWeight.Semibold" Class="mta-label">Large files</MokaText>
						<AdminChips Items="LargeChoices" Value="@_largeKb.ToString(CultureInfo.InvariantCulture)" ValueChanged="OnLargeSizeChangedAsync" AriaLabel="Files over" />
						<span class="mta-spacer"></span>
						@if (_large is not null || _largeError is not null)
						{
							<button type="button" class="mta-link" @onclick="CloseLargeFiles">Hide</button>
						}
					</div>
					@if (_searching)
					{
						<MokaSpinner Label="@($"Looking for files over {AdminFormat.Kb(_largeKb)} under {_spacePath}")" />
					}
					else if (_largeError is { } largeError)
					{
						<MokaAlert Severity="MokaToastSeverity.Error" Dense>@largeError</MokaAlert>
					}
					else if (_large is { } large)
					{
						@if (large.Entries.Count == 0)
						{
							<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">@($"No file over {AdminFormat.Kb(_largeKb)} under {large.Path}{(large.StoppedEarly ? " in the time the search had" : "")}.")</MokaText>
						}
						else
						{
							long largest = Math.Max(1, large.Entries[0].Kb);
							<ToolTable TItem="SpaceEntry"
									   Items="@(large.Entries.Where(file => Matches(file.Path)).ToList())"
									   ItemKey="@(file => file.Path)"
									   Label="@($"Files over {AdminFormat.Kb(_largeKb)} under {large.Path}")"
									   EmptyIcon="SshIcons.Disk"
									   EmptyTitle="Nothing matches"
									   EmptyText="No large file matches the filter.">
								<MokaColumn TItem="SpaceEntry" Title="File" Field="@(file => file.Path)" Mono Class="mt-col-main">
									<CellTemplate Context="file">
										<span title="@file.Path">@Relative(file.Path, large.Path)</span>
									</CellTemplate>
								</MokaColumn>
								<MokaColumn TItem="SpaceEntry" Title="Size" Field="@(file => file.Kb)" SortDescendingFirst Mono Align="MokaTextAlign.Right">
									<CellTemplate Context="file">
										@AdminFormat.Kb(file.Kb)
									</CellTemplate>
								</MokaColumn>
								<MokaColumn TItem="SpaceEntry" Title="Share" Field="@(file => file.Kb)" Sortable="false" Class="mt-col-wide">
									<CellTemplate Context="file">
										<MokaMeter Value="@(file.Kb * 100.0 / largest)" ShowValue="false" Color="MokaColor.Info" Size="MokaSize.Xs" Class="mta-share-bar" aria-label="@($"{file.Path} against the largest")" />
									</CellTemplate>
								</MokaColumn>
							</ToolTable>
						}
						@if (LargeNote(large) is { Length: > 0 } note)
						{
							<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">@note</MokaText>
						}
					}
				</section>
			}
		</div>
	};

	private RenderFragment CrumbButton(string name, string path, bool here) => __builder =>
	{
		<button type="button"
				class="@(here ? "mta-crumb mta-crumb--here" : "mta-crumb")"
				aria-current="@(here ? "location" : null)"
				disabled="@here"
				@onclick="@(() => MeasureAsync(path))">
			@name
		</button>
	};

	private RenderFragment DevicePanel => __builder =>
	{
		if (SelectedDevice is not { } device)
		{
			return;
		}

		<ToolDetailPanel Title="@device.Name" Subtitle="@(device.Model.Length > 0 ? device.Model : device.Type)" OnClose="@(() => _device = null)">
			<Actions>
				@if (CanReadSmart(device) && ReadAsRoot)
				{
					<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="MokaIcons.Action.Refresh" Disabled="@(_smartReading == device.Name)" OnClick="@(() => ReadSmartAsync(device))">Read SMART again</MokaButton>
				}
			</Actions>
			<ChildContent>
				<div class="mta-tiles">
					<MokaStat Tile Value="@(device.SizeBytes is { } size ? DisplayFormat.Bytes(size) : "?")" Label="Size" HelpText="@(device.Type.Length > 0 ? device.Type : "type unknown")" />
					<MokaStat Tile Value="@(device.FileSystem.Length > 0 ? device.FileSystem : "none")" Label="File system" HelpText="@(device.Label.Length > 0 ? device.Label : "no label")" />
					@if (_smart.TryGetValue(device.Name, out SmartReport? health) && health.Passed is { } passed)
					{
						<MokaStat Tile Value="@(passed && !health.NeedsAttention ? "Healthy" : passed ? "Check" : "Failing")" Label="Health" HelpText="@($"SMART {(passed ? health.HealthText : "FAILED")}")" Color="@(passed && !health.NeedsAttention ? MokaColor.Success : passed ? MokaColor.Warning : MokaColor.Error)" />
					}
				</div>
				<AdminFacts Items="DeviceFacts(device)" />

				<MokaText Element="h5" Size="MokaSize.Xs" Weight="MokaFontWeight.Semibold" Class="mta-label mta-panel-heading">Health (SMART)</MokaText>
				@if (SmartUnavailable(device) is { } unavailable)
				{
					<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">@unavailable</MokaText>
				}
				else if (!ReadAsRoot)
				{
					<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">@(Context.RootChangeBlocked ?? "smartctl opens the raw disk, which only root may do.")</MokaText>
					@if (Context.RootChangeBlocked is null)
					{
						<div><MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="MokatermIcons.Lock" OnClick="Context.EnableRoot">Turn on root mode</MokaButton></div>
					}
				}
				else if (_smartReading == device.Name)
				{
					<MokaSpinner Label="Asking smartctl" />
				}
				else if (_smartError is { } smartError)
				{
					<MokaAlert Severity="MokaToastSeverity.Error" Dense>@smartError</MokaAlert>
				}
				else if (_smart.TryGetValue(device.Name, out SmartReport? report))
				{
					@SmartView(report)
				}
			</ChildContent>
		</ToolDetailPanel>
	};

	private static RenderFragment SmartView(SmartReport report) => __builder =>
	{
		@if (report.Passed is { } passed)
		{
			<div class="mta-inline">
				<MokaTag Text="@(passed ? report.HealthText : "FAILED")" Size="MokaSize.Xs" Color="@(passed ? MokaColor.Success : MokaColor.Error)" />
				<span class="mta-dim">@(passed
					? report.NeedsAttention ? "The disk passes its own test, but some of its counters below are worth a look." : "The disk's own overall assessment."
					: "The disk expects to fail soon. Back it up and replace it.")</span>
			</div>
		}
		else if (report.Problem is { } problem)
		{
			<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">@problem</MokaText>
		}

		@if (report.TemperatureCelsius is not null || report.PowerOnHours is not null || report.PowerCycles is not null)
		{
			<div class="mta-tiles">
				@if (report.TemperatureCelsius is { } temperature)
				{
					<MokaStat Tile Value="@($"{temperature} °C")" Label="Temperature" HelpText="as the disk reads it" Color="@(temperature >= 60 ? MokaColor.Error : temperature >= 50 ? MokaColor.Warning : MokaColor.Surface)" />
				}
				@if (report.PowerOnHours is { } hours)
				{
					<MokaStat Tile Value="@PowerOnShort(hours)" Label="Powered on" HelpText="@($"{hours.ToString("N0", CultureInfo.CurrentCulture)} hours")" />
				}
				@if (report.PowerCycles is { } cycles)
				{
					<MokaStat Tile Value="@cycles.ToString("N0", CultureInfo.CurrentCulture)" Label="Power cycles" HelpText="times switched on" />
				}
			</div>
		}

		<AdminFacts Items="SmartFacts(report)" />

		@if (report.Attributes.Count > 0)
		{
			<div class="mta-smart">
				<ToolTable TItem="SmartAttribute"
						   Items="report.Attributes"
						   ItemKey="@(row => row.Id)"
						   Label="SMART attributes"
						   RowClass="@(row => row.Failed ? "mta-smart--failed" : row.Worrying ? "mta-smart--worrying" : null)">
					<MokaColumn TItem="SmartAttribute" Title="ID" Field="@(row => row.Id)" Mono />
					<MokaColumn TItem="SmartAttribute" Title="Attribute" Field="@(row => row.Name)" Mono Class="mt-col-main">
						<CellTemplate Context="row">
							<span title="@row.Name">@row.Name</span>
						</CellTemplate>
					</MokaColumn>
					@* The name keeps its title for its full value, so the reason a row is coloured goes on its figure. *@
					<MokaColumn TItem="SmartAttribute" Title="Value" Field="@(row => row.Value)" Mono Align="MokaTextAlign.Right">
						<CellTemplate Context="row">
							<Hint Text="@(row.Failed ? $"The disk calls this attribute failed{(row.WhenFailed.Length > 0 ? $" ({row.WhenFailed})" : "")}." : row.Worrying ? "Damaged or unreadable sectors: a disk usually gets worse from here." : null)">@row.Value</Hint>
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="SmartAttribute" Title="Worst" Field="@(row => row.Worst)" Mono Align="MokaTextAlign.Right" Class="mt-col-wide">
						<CellTemplate Context="row">
							<span class="mta-dim">@row.Worst</span>
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="SmartAttribute" Title="Thresh" Field="@(row => row.Threshold)" Mono Align="MokaTextAlign.Right" Class="mt-col-wide">
						<CellTemplate Context="row">
							<span class="mta-dim">@row.Threshold</span>
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="SmartAttribute" Title="Raw" Field="@(row => row.Raw)" Mono Class="mta-col-cut">
						<CellTemplate Context="row">
							<span title="@row.Raw">@row.Raw</span>
						</CellTemplate>
					</MokaColumn>
				</ToolTable>
			</div>
		}

		@if (report.Passed is not null && report.Messages.Count > 0)
		{
			<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">@string.Join(" ", report.Messages)</MokaText>
		}
		<MokaText Element="span" Size="MokaSize.Xs" Class="mta-dim">@($"smartctl {report.Version}{(report.ExitStatus is { } exit && exit != 0 ? $" · exit status {exit}" : "")}")</MokaText>
	};

	private RenderFragment? DetailFragment => _view switch
	{
		"devices" when SelectedDevice is not null => DevicePanel,
		SpaceTab when _space is { Entries.Count: > 0 } && !_measuring => SpacePanel,
		_ => null,
	};

	private RenderFragment SpacePanel => __builder =>
	{
		if (_space is not { } report)
		{
			return;
		}

		<ToolDetailPanel Title="@_spacePath" Subtitle="@(ReadAsRoot ? "Measured as root" : $"Measured as {Context.LoginName}")" DotColor="@(report.Unreadable > 0 ? MokaColor.Warning : MokaColor.Success)">
			<div class="mta-tiles">
				<MokaStat Tile Value="@(report.TotalKb is { } total ? AdminFormat.Kb(total) : "?")" Label="In this folder" HelpText="on this file system" />
				<MokaStat Tile Value="@AdminFormat.Count(report.Entries.Count)" Label="Folders" HelpText="directly in it" />
				<MokaStat Tile Value="@AdminFormat.Count(report.Unreadable)" Label="Unreadable" HelpText="@(report.Unreadable > 0 ? "count as empty" : "every folder read")" Color="@(report.Unreadable > 0 ? MokaColor.Warning : MokaColor.Surface)" />
			</div>
			<section class="mta-section" aria-label="Biggest folders">
				<MokaText Element="span" Size="MokaSize.Xs" Weight="MokaFontWeight.Semibold" Class="mta-label">Biggest folders</MokaText>
				<MokaDonutChart Segments="SpaceShares(report)" Thickness="30" Size="MokaSize.Sm" Label="@($"What takes the space in {_spacePath}")" Class="mta-donut">
					<span class="mta-donut-total">@(report.TotalKb is { } sum ? AdminFormat.Kb(sum) : "")</span>
				</MokaDonutChart>
			</section>
			@if (report.Unreadable > 0 && !ReadAsRoot && Context.RootChangeBlocked is null)
			{
				<div><MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="MokatermIcons.Lock" OnClick="Context.EnableRoot">Turn on root mode to read them</MokaButton></div>
			}
		</ToolDetailPanel>
	};

	// The five biggest folders, then the rest and the files lying in the folder itself, so the ring stays readable.
	private static IReadOnlyList<MokaDonutSegment> SpaceShares(SpaceReport report)
	{
		List<SpaceEntry> biggest = [.. report.Entries.OrderByDescending(entry => entry.Kb).Take(5)];
		List<MokaDonutSegment> segments = [.. biggest.Select(entry => new MokaDonutSegment { Name = entry.Name + "/", Value = entry.Kb })];
		long rest = report.Entries.Sum(entry => entry.Kb) - biggest.Sum(entry => entry.Kb) + (report.FilesHereKb ?? 0);
		if (rest > 0)
		{
			segments.Add(new MokaDonutSegment { Name = "everything else", Value = rest, Color = MokaColor.Surface });
		}

		return segments;
	}

	private IReadOnlyList<MokaDataListItem> DeviceFacts(BlockDevice device)
	{
		List<MokaDataListItem> facts = [];
		if (device.Model.Length > 0 && device.Type.Length > 0)
		{
			facts.Add(new("Type", device.Type));
		}

		if (device.FileSystem.Length > 0)
		{
			facts.Add(new("File system", device.Label.Length > 0 ? $"{device.FileSystem} · {device.Label}" : device.FileSystem));
		}

		if (device.MountPoint.Length > 0)
		{
			facts.Add(new("Mounted on", ValueContent: @<button type="button" class="mta-link mta-mono" @onclick="@(() => OpenSpaceAsync(device.MountPoint))">@device.MountPoint</button>));
		}

		if (device.ReadOnly || device.Removable)
		{
			facts.Add(new("Flags", ValueContent: @<span class="mta-facts-line">
				@if (device.ReadOnly)
				{
					<MokaTag Text="Read only" Size="MokaSize.Xs" Color="MokaColor.Warning" />
				}
				@if (device.Removable)
				{
					<MokaTag Text="Removable" Size="MokaSize.Xs" Variant="MokaVariant.Soft" Color="MokaColor.Surface" />
				}
			</span>));
		}

		return facts;
	}

	private static IReadOnlyList<MokaDataListItem> SmartFacts(SmartReport report)
	{
		List<MokaDataListItem> facts = [];
		if (report.Model.Length > 0)
		{
			facts.Add(new("Model", report.Model));
		}

		if (report.Serial.Length > 0)
		{
			facts.Add(new("Serial", report.Serial));
		}

		if (report.Firmware.Length > 0)
		{
			facts.Add(new("Firmware", report.Firmware));
		}

		if (KindOf(report) is { Length: > 0 } kind)
		{
			facts.Add(new("Kind", kind));
		}

		facts.AddRange(report.NvmeHealth.Select(pair => new MokaDataListItem(pair.Label, pair.Value)));
		return facts;
	}

	private IReadOnlyList<AdminChip> LargeChoices =>
		[.. SpaceCommands.LargeFileSizesKb.Select(kb => new AdminChip(kb.ToString(CultureInfo.InvariantCulture), $"over {AdminFormat.Kb(kb)}"))];

	private static string? Indent(int depth, int step) => depth == 0
		? null
		: string.Create(CultureInfo.InvariantCulture, $"padding-left:{depth * step}px");

	private static int ByMountPoint(FileSystemUsage left, FileSystemUsage right) => StringComparer.OrdinalIgnoreCase.Compare(left.MountPoint, right.MountPoint);

	private static int ByUsed(FileSystemUsage left, FileSystemUsage right) => left.UsedPercent.CompareTo(right.UsedPercent);

	private static int BySize(FileSystemUsage left, FileSystemUsage right) => left.TotalKb.CompareTo(right.TotalKb);

	private static int BySize(SpaceRow left, SpaceRow right) => left.Kb.CompareTo(right.Kb);

	private List<SpaceRow> SpaceRows(DiskSnapshot snapshot, SpaceReport report)
	{
		List<FileSystemUsage> mounts = [.. MountsInside(snapshot, _spacePath)];
		long top = Math.Max(1, report.TotalKb ?? report.Entries.Select(entry => entry.Kb).DefaultIfEmpty(0).Sum());
		List<SpaceRow> rows =
		[
			.. report.Entries
				.Where(entry => Matches(entry.Name) && !mounts.Any(mount => mount.MountPoint == entry.Path))
				.Select(entry => new SpaceRow(entry.Name, entry.Path, entry.Kb, entry.Kb * 100.0 / top)),
		];
		if (report.FilesHereKb is { } files && files > 0)
		{
			rows.Add(new SpaceRow("Files directly in this folder", null, files, files * 100.0 / top));
		}

		rows.AddRange(mounts
			.Where(mount => Matches(SpaceCommands.NameOf(mount.MountPoint)))
			.Select(mount => new SpaceRow(SpaceCommands.NameOf(mount.MountPoint), mount.MountPoint, mount.UsedKb, 0, mount)));
		return rows;
	}

	private void OnFilterChanged(string value)
	{
		_filter = value;
		ApplyFilter();
	}

	private void OnEverythingChanged(bool value)
	{
		_everything = value;
		ApplyFilter();
	}

	private void ApplyFilter()
	{
		if (_snapshot is not { } snapshot)
		{
			return;
		}

		_usageShown = [.. snapshot.Usage.Where(item => (_everything || DiskCommands.IsStorage(item)) && (Matches(item.MountPoint) || Matches(item.Source)))];
		_mountsShown = [.. snapshot.Mounts.Where(mount => (_everything || IsStorageMount(mount, snapshot)) && (Matches(mount.MountPoint) || Matches(mount.Source)))];
		_devicesShown =
		[
			.. Flatten(snapshot.Devices, 0)
				.Select((pair, index) => new AdminRow<BlockDevice>(pair.Device, index, pair.Depth))
				.Where(row => Matches(row.Item.Name) || Matches(row.Item.MountPoint)),
		];
	}

	private static IEnumerable<(BlockDevice Device, int Depth)> Flatten(IEnumerable<BlockDevice> devices, int depth)
	{
		foreach (BlockDevice device in devices)
		{
			yield return (device, depth);
			foreach ((BlockDevice child, int childDepth) in Flatten(device.Children, depth + 1))
			{
				yield return (child, childDepth);
			}
		}
	}

	private static string DeviceTitle(BlockDevice device) => string.Join(", ", new[]
	{
		device.Model,
		device.Label.Length > 0 ? $"label {device.Label}" : "",
		device.Removable ? "removable" : "",
		device.ReadOnly ? "read only" : "",
	}.Where(part => part.Length > 0));

	/// <summary>A mount worth listing by default: one df counts as storage.</summary>
	private static bool IsStorageMount(MountEntry mount, DiskSnapshot snapshot) =>
		snapshot.Usage.Any(item => item.MountPoint == mount.MountPoint && DiskCommands.IsStorage(item));

	/// <summary>File systems mounted directly in <paramref name="folder"/>, which du's <c>-x</c> leaves out of its sizes.</summary>
	private static IEnumerable<FileSystemUsage> MountsInside(DiskSnapshot snapshot, string folder) =>
		snapshot.Usage.Where(item => DiskCommands.IsStorage(item) && item.MountPoint != folder && SpaceCommands.Parent(item.MountPoint) == folder);

	private static string SpaceNote(SpaceReport report)
	{
		List<string> parts = [report.Entries.Count == 1 ? "1 folder" : $"{AdminFormat.Count(report.Entries.Count)} folders"];
		if (report.StoppedEarly)
		{
			parts.Add($"du was stopped after {SpaceCommands.ServerSeconds} s, so only the folders it finished are listed");
		}

		if (report.Unreadable > 0)
		{
			parts.Add($"{AdminFormat.Count(report.Unreadable)} could not be read and count as empty ({report.FirstProblem})");
		}

		if (report.Truncated)
		{
			parts.Add("du printed more than this view keeps");
		}

		return string.Join(" · ", parts);
	}

	private static string LargeNote(SpaceReport report)
	{
		List<string> parts = [];
		if (report.Capped)
		{
			parts.Add($"Only the first {SpaceCommands.MaxLargeFiles} files found are listed; a larger size finds fewer.");
		}

		if (report.StoppedEarly)
		{
			parts.Add($"The search was stopped after {SpaceCommands.ServerSeconds} s, so files in folders it had not reached are missing.");
		}

		return string.Join(" ", parts);
	}

	private static string Relative(string file, string folder) =>
		folder == "/" ? file[1..] : file.StartsWith(folder + "/", StringComparison.Ordinal) ? file[(folder.Length + 1)..] : file;

	private static string KindOf(SmartReport report) => (report.Protocol, report.RotationRpm) switch
	{
		("NVMe", _) => "NVMe solid state",
		(_, 0) => $"{report.Protocol} solid state".Trim(),
		(_, { } rpm) => $"{report.Protocol} disk, {rpm.ToString(CultureInfo.InvariantCulture)} rpm".Trim(),
		_ => report.Protocol,
	};

	private static string PowerOnShort(long hours) => hours >= 24 * 365
		? string.Create(CultureInfo.CurrentCulture, $"{hours / (24.0 * 365):0.#} years")
		: hours >= 48
			? string.Create(CultureInfo.CurrentCulture, $"{hours / 24} days")
			: string.Create(CultureInfo.CurrentCulture, $"{hours} h");

	private bool Matches(string value) => _filter.Trim().Length == 0 || value.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase);

	/// <summary>Why the device's health cannot be asked for, or null when smartctl can be run on it.</summary>
	private string? SmartUnavailable(BlockDevice device) =>
		SmartCommands.Unavailable(device)
		?? (Capabilities.HasSmartctl ? null : "smartctl is not installed. It comes with the smartmontools package.")
		?? (_snapshot?.DevicesFromPartitions == true ? "Without lsblk this view cannot tell whole disks from partitions." : null);

	private bool CanReadSmart(BlockDevice device) => SmartUnavailable(device) is null;

	private async Task OnViewChangedAsync(string view)
	{
		_view = view;
		if (view == SpaceTab && _space is null && !_measuring)
		{
			await MeasureAsync(_spacePath);
		}
	}

	private Task OpenSpaceAsync(string mountPoint)
	{
		_view = SpaceTab;
		return MeasureAsync(mountPoint);
	}

	private Task OpenSpaceRowAsync(SpaceRow row) => row.Path is { } path ? MeasureAsync(path) : Task.CompletedTask;

	/// <summary>
	/// Opens <paramref name="path"/> in the space view, from what was measured already when it can. A newer call
	/// cancels the one before, so clicking through folders never shows an older folder's sizes.
	/// </summary>
	private async Task MeasureAsync(string path, bool reuse = true)
	{
		string folder = SpaceCommands.Tidy(path);
		if (folder != _spacePath)
		{
			CloseLargeFiles();
		}

		_spacePath = folder;
		OnFilterChanged("");
		_measure?.Cancel();
		_measure?.Dispose();
		_measure = null;
		if (reuse && _spaceCache.TryGetValue(folder, out SpaceReport? cached))
		{
			(_space, _spaceError, _measuring) = (cached, null, false);
			return;
		}

		CancellationTokenSource measure = CancellationTokenSource.CreateLinkedTokenSource(Lifetime);
		_measure = measure;
		(_space, _spaceError, _measuring) = (null, null, true);
		StateHasChanged();
		try
		{
			AdminOutcome outcome = await ReadAsync(SpaceCommands.Measure(folder, ReadAsRoot), measure.Token);
			SpaceReport report = SpaceCommands.ParseMeasure(outcome.Output, folder, outcome.IsTruncated);
			if (report.TotalKb is null && report.Entries.Count == 0 && !report.StoppedEarly)
			{
				_spaceError = report.FirstProblem.Length > 0 ? report.FirstProblem : outcome.Problem();
			}
			else
			{
				_space = report;
				_spaceCache[folder] = report;
			}
		}
		catch (AdminException ex) when (!measure.IsCancellationRequested)
		{
			_spaceError = ex.Message;
		}
		catch (OperationCanceledException) when (measure.IsCancellationRequested)
		{
			return;
		}
		finally
		{
			if (ReferenceEquals(_measure, measure))
			{
				_measuring = false;
			}
		}

		StateHasChanged();
	}

	private async Task FindLargeFilesAsync()
	{
		_search?.Cancel();
		_search?.Dispose();
		CancellationTokenSource search = CancellationTokenSource.CreateLinkedTokenSource(Lifetime);
		_search = search;
		string folder = _spacePath;
		(_large, _largeError, _searching) = (null, null, true);
		StateHasChanged();
		try
		{
			AdminOutcome outcome = await ReadAsync(SpaceCommands.LargeFiles(folder, _largeKb, ReadAsRoot), search.Token);
			_large = SpaceCommands.ParseLargeFiles(outcome.Output, folder, outcome.IsTruncated);
		}
		catch (AdminException ex) when (!search.IsCancellationRequested)
		{
			_largeError = ex.Message;
		}
		catch (OperationCanceledException) when (search.IsCancellationRequested)
		{
			return;
		}
		finally
		{
			if (ReferenceEquals(_search, search))
			{
				_searching = false;
			}
		}

		StateHasChanged();
	}

	private Task OnLargeSizeChangedAsync(string value)
	{
		_largeKb = long.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture, out long kb) ? kb : _largeKb;
		return FindLargeFilesAsync();
	}

	private void CloseLargeFiles()
	{
		_search?.Cancel();
		_search?.Dispose();
		_search = null;
		(_large, _largeError, _searching) = (null, null, false);
	}

	private void SelectDevice(BlockDevice device)
	{
		_device = _device == device.Name ? null : device.Name;
		if (_device is not null)
		{
			StartSmartRead(device);
		}
	}

	/// <summary>Reads the device's health on its own when root mode allows it and nothing was read for it yet.</summary>
	private void StartSmartRead(BlockDevice device)
	{
		_smartError = null;
		if (CanReadSmart(device) && ReadAsRoot && !_smart.ContainsKey(device.Name) && _smartReading != device.Name)
		{
			_ = ReadSmartAsync(device);
		}
	}

	private async Task ReadSmartAsync(BlockDevice device)
	{
		_smartRead?.Cancel();
		_smartRead?.Dispose();
		CancellationTokenSource read = CancellationTokenSource.CreateLinkedTokenSource(Lifetime);
		_smartRead = read;
		(_smartReading, _smartError) = (device.Name, null);
		StateHasChanged();
		try
		{
			AdminOutcome outcome = await ReadAsync(SmartCommands.Read(device.Name), read.Token);
			_smart[device.Name] = SmartCommands.Parse(outcome.Output);
		}
		catch (AdminException ex) when (!read.IsCancellationRequested)
		{
			_smartError = ex.Message;
		}
		catch (OperationCanceledException) when (read.IsCancellationRequested)
		{
			return;
		}
		finally
		{
			if (ReferenceEquals(_smartRead, read))
			{
				_smartReading = null;
			}
		}

		StateHasChanged();
	}
}
