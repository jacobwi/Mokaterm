@using Mokaterm.Modules.Ssh.Admin.Clock
@using Mokaterm.Modules.Ssh.Admin.Monitoring
@using Mokaterm.Modules.Ssh.Admin.Overview
@using Mokaterm.Modules.Ssh.Admin.Services
@using Mokaterm.Modules.Ssh.Admin.Storage
@using Mokaterm.UI.Common.Formatting
@inherits AdminPageBase

<ToolPageFrame Title="Overview" Summary="@Summary" Loading="Loading" Loaded="Loaded" Error="@LoadError" OnRefresh="ReloadAsync" LoadingText="Reading the machine">
	<ChipsEnd>
		@if (_snapshot is not null)
		{
			<Hint Text="@(SampleError ?? "CPU, memory, load, network and disk figures are read again every two seconds while this page is shown.")" Style="min-width: 0">
				<span class="mta-live">
					<MokaStatusDot Size="MokaSize.Xs" Color="@(SampleError is null ? MokaColor.Success : MokaColor.Warning)" Glow="@(SampleError is null)" />
					<span class="mta-label">@(SampleError is null ? "Live" : "Live figures paused")</span>
					@if (SampleError is { } error)
					{
						<span class="mta-dim mta-live-error">@error</span>
					}
				</span>
			</Hint>
		}
	</ChipsEnd>
	<ChildContent>
	@if (_snapshot is { } snapshot)
	{
		SystemSample? sample = History.Latest;
		SystemRates? rates = History.Rates;
		MemoryInfo memory = sample?.Memory ?? MemoryInfo.Unknown;
		<div class="mta-cards">
			<button type="button" class="mta-card" @onclick="@(() => Context.Navigate(AdminPageIds.HostName))">
				<span class="mta-card-label">System</span>
				<span class="mta-stat mta-stat--small" title="@Profile.DisplayName">@Profile.DisplayName</span>
				<span class="mta-card-sub" title="@Profile.Facts.Kernel">@Profile.Facts.Kernel</span>
			</button>

			<button type="button" class="mta-card" @onclick="@(() => Context.Navigate(AdminPageIds.Logs))">
				<span class="mta-card-label">Uptime</span>
				<span class="mta-stat">@(AdminFormat.Span(Uptime(sample) ?? snapshot.Uptime) is { Length: > 0 } up ? up : "?")</span>
				<span class="mta-card-sub">@(snapshot.BootedAt is { } booted ? $"booted {DisplayFormat.Timestamp(booted)}" : "boot time unknown")</span>
			</button>

			<button type="button" class="mta-card" @onclick="@(() => Context.Navigate(AdminPageIds.Processes))">
				<span class="mta-card-label">CPU</span>
				<span class="mta-stat">@(rates?.CpuPercent is { } cpu ? AdminFormat.Percent(cpu) : "...")</span>
				<UsageBar Percent="rates?.CpuPercent" />
				<Sparkline Values="History.Cpu" Max="100" Slots="MonitorHistory.Capacity" Height="28" Label="CPU busy over the last two minutes" />
				<span class="mta-card-sub">@CpuText(rates, snapshot)</span>
			</button>

			<button type="button" class="mta-card" @onclick="@(() => Context.Navigate(AdminPageIds.Processes))">
				<span class="mta-card-label">CPU load</span>
				<span class="mta-stat">@(sample?.Load is { } load ? AdminFormat.Number(load.One) : "?")</span>
				@if (LoadPercent(sample, snapshot) is { } loadPercent)
				{
					<UsageBar Percent="loadPercent" />
				}
				<Sparkline Values="History.Load" Max="@(snapshot.Cores is { } cores ? cores : null)" Slots="MonitorHistory.Capacity" Height="28" Label="Load over the last two minutes" />
				<span class="mta-card-sub">@LoadText(sample, snapshot)</span>
			</button>

			@if (memory.TotalKb is { } total && total > 0)
			{
				<button type="button" class="mta-card" @onclick="@(() => Context.Navigate(AdminPageIds.Processes))">
					<span class="mta-card-label">Memory</span>
					<span class="mta-stat">@AdminFormat.Percent(memory.UsedPercent ?? 0)</span>
					<UsageBar Percent="memory.UsedPercent" />
					<Sparkline Values="History.Memory" Max="100" Slots="MonitorHistory.Capacity" Height="28" Label="Memory used over the last two minutes" />
					<span class="mta-card-sub">@AdminFormat.Kb(memory.UsedKb) of @AdminFormat.Kb(total)</span>
				</button>
			}

			@if (memory.SwapTotalKb is { } swap && swap > 0)
			{
				<button type="button" class="mta-card" @onclick="@(() => Context.Navigate(AdminPageIds.Processes))">
					<span class="mta-card-label">Swap</span>
					<span class="mta-stat">@AdminFormat.Percent(memory.SwapUsedPercent ?? 0)</span>
					<UsageBar Percent="memory.SwapUsedPercent" />
					<Sparkline Values="History.Swap" Max="100" Slots="MonitorHistory.Capacity" Height="28" Label="Swap used over the last two minutes" />
					<span class="mta-card-sub">@AdminFormat.Kb(memory.SwapUsedKb) of @AdminFormat.Kb(swap)</span>
				</button>
			}

			@if (sample?.Interfaces.Count > 0)
			{
				<button type="button" class="mta-card" @onclick="@(() => Context.Navigate(AdminPageIds.Network))" title="@NetworkTitle(rates)">
					<span class="mta-card-label">Network</span>
					<span class="mta-stat">@(rates?.ReceivedPerSecond is { } received ? AdminFormat.Rate(received) : "...")</span>
					<span class="mta-spark-pair">
						<Sparkline Values="History.Received" Max="@Top(History.Received, History.Sent)" Slots="MonitorHistory.Capacity" Height="28" Class="mta-spark-in" Label="Received over the last two minutes" />
						<Sparkline Values="History.Sent" Max="@Top(History.Received, History.Sent)" Slots="MonitorHistory.Capacity" Height="28" Class="mta-spark-out" Label="Sent over the last two minutes" />
					</span>
					<span class="mta-card-sub">
						<span class="mta-key mta-key--in">in</span>
						<span class="mta-key mta-key--out">out @AdminFormat.Rate(rates?.SentPerSecond)</span>
					</span>
				</button>
			}

			@if (sample?.Disks.Count > 0)
			{
				<button type="button" class="mta-card" @onclick="@(() => Context.Navigate(AdminPageIds.Disks))" title="@DiskTitle(rates)">
					<span class="mta-card-label">Disk I/O</span>
					<span class="mta-stat">@(rates?.ReadPerSecond is { } read ? AdminFormat.Rate(read) : "...")</span>
					<span class="mta-spark-pair">
						<Sparkline Values="History.Read" Max="@Top(History.Read, History.Written)" Slots="MonitorHistory.Capacity" Height="28" Class="mta-spark-in" Label="Read from disk over the last two minutes" />
						<Sparkline Values="History.Written" Max="@Top(History.Read, History.Written)" Slots="MonitorHistory.Capacity" Height="28" Class="mta-spark-out" Label="Written to disk over the last two minutes" />
					</span>
					<span class="mta-card-sub">
						<span class="mta-key mta-key--in">read</span>
						<span class="mta-key mta-key--out">write @AdminFormat.Rate(rates?.WrittenPerSecond)</span>
					</span>
				</button>
			}

			<button type="button" class="mta-card" @onclick="OpenFailedServices" disabled="@(Capabilities.Services is null)">
				<span class="mta-card-label">Failed services</span>
				<span class="@(_failed > 0 ? "mta-stat mta-stat--alert" : "mta-stat")">@(_services is null ? ServicesPending : AdminFormat.Count(_failed))</span>
				<span class="mta-card-sub">@ServicesText</span>
			</button>

			<button type="button" class="mta-card" @onclick="OpenUpdates" disabled="@(Capabilities.Packages is null)">
				<span class="mta-card-label">Pending updates</span>
				<span class="mta-stat">@(_updates is { } updates ? AdminFormat.Count(updates) : Capabilities.Packages is null ? "none" : _updatesError is null ? "..." : "?")</span>
				<span class="mta-card-sub" title="@_updatesError">@UpdatesText</span>
			</button>

			<AdminUpdateCards />

			<button type="button" class="mta-card" @onclick="@(() => Context.Navigate(AdminPageIds.Time))">
				<span class="mta-card-label">Time zone</span>
				<span class="mta-stat mta-stat--small" title="@_clock?.LocalTime">@(_clock is { TimeZone.Length: > 0 } clock ? clock.TimeZone : "...")</span>
				<span class="mta-card-sub">
					<MokaStatusDot Size="MokaSize.Xs" Color="@AdminFormat.Dot(_clock?.Synchronized)" Glow="@(_clock?.Synchronized == true)" />
					@(_clock?.Synchronized switch { true => " NTP synchronized", false => " not synchronized", _ => " sync unknown" })
				</span>
			</button>

			@foreach (FileSystemUsage disk in snapshot.Disks)
			{
				<button type="button" class="mta-card" @key="disk.MountPoint" @onclick="@(() => Context.Navigate(AdminPageIds.Disks))" title="@($"{disk.Source} on {disk.MountPoint}")">
					<span class="mta-card-label">@($"Disk {disk.MountPoint}")</span>
					<span class="mta-stat">@AdminFormat.Percent(disk.UsedPercent)</span>
					<UsageBar Percent="disk.UsedPercent" />
					<span class="mta-card-sub">@AdminFormat.Kb(disk.AvailableKb) free of @AdminFormat.Kb(disk.TotalKb)</span>
				</button>
			}
		</div>

		@if (rates is not null && (rates.Interfaces.Count > 1 || rates.Disks.Count > 1))
		{
			<div class="mta-live-lists">
				@if (rates.Interfaces.Count > 1)
				{
					<div class="mta-table" style="--mta-cols: minmax(0, 1fr) 96px 96px" role="table" aria-label="Network interfaces">
						<div class="mta-row mta-row--head" role="row">
							<span role="columnheader">Interface</span>
							<span role="columnheader">In</span>
							<span role="columnheader">Out</span>
						</div>
						@foreach (InterfaceRate item in rates.Interfaces.Take(MaxDevices))
						{
							<div class="mta-row" role="row" @key="item.Name">
								<span class="mta-cell mta-mono" role="cell" title="@(item.IsDevice ? "A network device" : "A virtual interface: a bridge, a veth pair or a tunnel. Its traffic also crosses a device, so the total leaves it out.")">
									@item.Name
									@if (!item.IsDevice && rates.Interfaces.Any(other => other.IsDevice))
									{
										<span class="mta-dim mta-after">virtual</span>
									}
								</span>
								<span class="mta-cell mta-mono" role="cell">@AdminFormat.Rate(item.ReceivedPerSecond)</span>
								<span class="mta-cell mta-mono" role="cell">@AdminFormat.Rate(item.SentPerSecond)</span>
							</div>
						}
					</div>
				}
				@if (rates.Disks.Count > 1)
				{
					<div class="mta-table" style="--mta-cols: minmax(0, 1fr) 96px 96px" role="table" aria-label="Disks">
						<div class="mta-row mta-row--head" role="row">
							<span role="columnheader">Disk</span>
							<span role="columnheader">Read</span>
							<span role="columnheader">Write</span>
						</div>
						@foreach (DiskRate item in rates.Disks.Take(MaxDevices))
						{
							<div class="mta-row" role="row" @key="item.Name">
								<span class="mta-cell mta-mono" role="cell">@item.Name</span>
								<span class="mta-cell mta-mono" role="cell">@AdminFormat.Rate(item.ReadPerSecond)</span>
								<span class="mta-cell mta-mono" role="cell">@AdminFormat.Rate(item.WrittenPerSecond)</span>
							</div>
						}
					</div>
				}
			</div>
		}
	}
	</ChildContent>
</ToolPageFrame>

@code {
	/// <summary>The busiest interfaces and disks listed under the cards; the totals count them all.</summary>
	private const int MaxDevices = 8;

	private OverviewSnapshot? _snapshot;
	private HostMonitor? _monitor;
	private IDisposable? _watch;
	private IReadOnlyList<ServiceUnit>? _services;
	private int _failed;
	private int? _updates;
	private string? _updatesError;
	private ClockInfo? _clock;

	private string Summary => _snapshot?.Cores is { } cores
		? $"{Profile.Facts.HostName} · {cores} cores · logged in as {Profile.Facts.UserName}"
		: Profile.Facts.HostName;

	private string ServicesPending => Capabilities.Services is null ? "none" : "...";

	private string ServicesText => Capabilities.Services is null
		? "no service manager"
		: _services is { } services ? $"of {AdminFormat.Count(services.Count)} services" : "reading";

	private string UpdatesText => Capabilities.Packages is not { } packages
		? "no package manager"
		: _updatesError is not null ? "could not check" : _updates is null ? $"asking {packages.DisplayName}" : packages.DisplayName;

	private MonitorHistory History => Context.Monitor.History;

	private string? SampleError => Context.Monitor.State.Problem;

	/// <summary>Follows the session's sampler while the view is shown; the parameters come round again whenever it is hidden or shown.</summary>
	protected override void OnParametersSet() => Follow();

	protected override void Dispose(bool disposing)
	{
		if (disposing)
		{
			Leave();
		}

		base.Dispose(disposing);
	}

	protected override async Task LoadAsync(CancellationToken cancellationToken)
	{
		// The slow ones (a dnf metadata check can take a minute) fill their cards in as they arrive.
		_ = LoadServicesAsync(cancellationToken);
		_ = LoadUpdatesAsync(cancellationToken);
		_ = LoadClockAsync(cancellationToken);
		AdminOutcome outcome = await ReadAsync(OverviewCommands.Read(), cancellationToken);
		_snapshot = OverviewCommands.Parse(outcome.Output);
		Context.Monitor.Record(_snapshot.Sample);
		Follow();
	}

	private static TimeSpan? Uptime(SystemSample? sample) =>
		sample?.UptimeSeconds is { } seconds ? TimeSpan.FromSeconds(Math.Floor(seconds)) : null;

	private static double? LoadPercent(SystemSample? sample, OverviewSnapshot snapshot) =>
		sample?.Load is { } load && snapshot.Cores is { } cores && cores > 0 ? load.One * 100 / cores : null;

	private static string LoadText(SystemSample? sample, OverviewSnapshot snapshot) =>
		$"5m {AdminFormat.Number(sample?.Load?.Five)} · 15m {AdminFormat.Number(sample?.Load?.Fifteen)}{(snapshot.Cores is { } cores ? $" · {cores} cores" : "")}";

	private static string CpuText(SystemRates? rates, OverviewSnapshot snapshot) => rates?.CpuPercent is null
		? "measuring"
		: $"iowait {AdminFormat.Number(rates.IoWaitPercent, "0.0")}%{(snapshot.Cores is { } cores ? $" · {cores} cores" : "")}";

	/// <summary>One scale for both lines of a pair, so in and out can be compared by height.</summary>
	private static double? Top(SampleHistory first, SampleHistory second)
	{
		double top = Math.Max(first.Count > 0 ? first.Max() : 0, second.Count > 0 ? second.Max() : 0);
		return top > 0 ? top : null;
	}

	private static string NetworkTitle(SystemRates? rates) => rates is null
		? "Measuring"
		: rates.Interfaces.Any(item => item.IsDevice) && rates.Interfaces.Any(item => !item.IsDevice)
			? "Summed over network devices; bridges, veth pairs and tunnels carry the same traffic again and are left out."
			: "Summed over every interface but loopback.";

	private static string DiskTitle(SystemRates? rates) => rates is null
		? "Measuring"
		: $"Summed over {rates.Disks.Count} whole {(rates.Disks.Count == 1 ? "disk" : "disks")}; partitions and volumes on them are not counted twice.";

	private void OpenFailedServices() => Context.Navigate(AdminPageIds.Services, "failed");

	private void OpenUpdates() => Context.Navigate(AdminPageIds.Packages, "updates");

	/// <summary>
	/// Watches at the overview's pace while the view is shown and lets go while it is hidden, so a hidden System view
	/// reads nothing of its own. The first read already brings a sample, so watching starts once it is in, and the next
	/// sample comes an interval after it. A reconnect brings a new session and with it a new sampler.
	/// </summary>
	private void Follow()
	{
		if (IsDisposed)
		{
			return;
		}

		HostMonitor monitor = Context.Monitor;
		if (!ReferenceEquals(monitor, _monitor))
		{
			Leave();
			_monitor = monitor;
			monitor.Changed += OnMonitorChanged;
		}

		if (Context.IsVisible() && _snapshot is not null)
		{
			_watch ??= monitor.Watch(MonitorCommands.Interval);
		}
		else
		{
			_watch?.Dispose();
			_watch = null;
		}
	}

	private void Leave()
	{
		_watch?.Dispose();
		_watch = null;
		if (_monitor is { } monitor)
		{
			monitor.Changed -= OnMonitorChanged;
			_monitor = null;
		}
	}

	// Raised on the sampler's own loop.
	private void OnMonitorChanged() => _ = InvokeAsync(StateHasChanged);

	private async Task LoadServicesAsync(CancellationToken cancellationToken)
	{
		if (Capabilities.Services is not { } services)
		{
			return;
		}

		try
		{
			_services = services.ParseList((await ReadAsync(services.List(), cancellationToken)).Output);
			_failed = _services.Count(unit => unit.State == ServiceState.Failed);
		}
		catch (Exception ex) when (ex is AdminException or OperationCanceledException)
		{
			return;
		}

		await InvokeAsync(StateHasChanged);
	}

	private async Task LoadUpdatesAsync(CancellationToken cancellationToken)
	{
		if (Capabilities.Packages is not { } packages)
		{
			return;
		}

		_updates = null;
		_updatesError = null;
		try
		{
			AdminOutcome outcome = await ReadAsync(packages.ListUpdates(), cancellationToken);
			if (outcome.Succeeded)
			{
				_updates = packages.ParseUpdates(outcome.Output).Count;
			}
			else
			{
				_updatesError = outcome.Problem();
			}
		}
		catch (AdminException ex)
		{
			_updatesError = ex.Message;
		}
		catch (OperationCanceledException)
		{
			return;
		}

		await InvokeAsync(StateHasChanged);
	}

	private async Task LoadClockAsync(CancellationToken cancellationToken)
	{
		try
		{
			_clock = ClockCommands.Parse((await ReadAsync(Capabilities.Clock.Read(), cancellationToken)).Output);
		}
		catch (Exception ex) when (ex is AdminException or OperationCanceledException)
		{
			return;
		}

		await InvokeAsync(StateHasChanged);
	}
}
