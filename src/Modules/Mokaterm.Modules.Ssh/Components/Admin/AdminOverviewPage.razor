@using Mokaterm.Modules.Ssh.Admin.Clock
@using Mokaterm.Modules.Ssh.Admin.Monitoring
@using Mokaterm.Modules.Ssh.Admin.Overview
@using Mokaterm.Modules.Ssh.Admin.Services
@using Mokaterm.Modules.Ssh.Admin.Storage
@using Mokaterm.UI.Common.Formatting
@inherits AdminPageBase

<ToolPageFrame Title="Overview" Summary="@Summary" Loading="Loading" Loaded="Loaded" Error="@LoadError" OnRefresh="ReloadAsync" LoadingText="Reading the machine">
	<ChipsEnd>
		@if (_snapshot is not null)
		{
			<Hint Text="@(SampleError ?? "CPU, memory, load, network and disk figures are read again every two seconds while this page is shown.")" Style="min-width: 0">
				<span class="mta-live">
					<MokaStatusDot Size="MokaSize.Xs" Color="@(SampleError is null ? MokaColor.Success : MokaColor.Warning)" Glow="@(SampleError is null)" Pulse="@(SampleError is null)" />
					<span class="mta-label">@(SampleError is null ? "Live" : "Live figures paused")</span>
					@if (SampleError is { } error)
					{
						<span class="mta-dim mta-live-error">@error</span>
					}
				</span>
			</Hint>
		}
	</ChipsEnd>
	<ChildContent>
	@if (_snapshot is { } snapshot)
	{
		SystemSample? sample = History.Latest;
		SystemRates? rates = History.Rates;
		MemoryInfo memory = sample?.Memory ?? MemoryInfo.Unknown;
		FileSystemUsage? root = RootDisk(sample, snapshot);
		double? loadPercent = LoadPercent(sample, snapshot);
		<div class="mta-ov">
			<section class="mta-ov-gauges" aria-label="Now">
				@GaugeCard("CPU", "CPU busy", rates?.CpuPercent, "0'%'", 0, 100, rates?.CpuPercent, [CpuText(rates), CoresText(snapshot)], () => Context.Navigate(AdminPageIds.Processes))
				@GaugeCard("Load", "Load over one minute", sample?.Load?.One, "0.00", 0, snapshot.Cores is { } cores and > 0 ? cores : 1, loadPercent, LoadLines(sample, snapshot), () => Context.Navigate(AdminPageIds.Processes))
				@if (memory.TotalKb is { } total && total > 0)
				{
					@GaugeCard("Memory", "Memory used", memory.UsedPercent, "0'%'", 0, 100, memory.UsedPercent, [$"{AdminFormat.Kb(memory.UsedKb)} of {AdminFormat.Kb(total)}", SwapText(memory)], () => Context.Navigate(AdminPageIds.Processes))
				}
				@if (root is not null)
				{
					@GaugeCard("Disk /", "Root file system used", root.UsedPercent, "0'%'", 0, 100, root.UsedPercent, [$"{AdminFormat.Kb(root.AvailableKb)} free", $"of {AdminFormat.Kb(root.TotalKb)}"], () => Context.Navigate(AdminPageIds.Disks))
				}
			</section>

			<section class="mta-ov-charts" aria-label="The last two minutes">
				<MokaCard Outlined Elevation="0" Title="CPU" Subtitle="Busy and waiting on disks" Class="mta-ov-card">
					<MokaLineChart Series="CpuSeries" Label="CPU over the last two minutes" Formatter="PercentText" Min="0" Max="100" YTicks="2" Height="@ChartHeight"
								   ShowArea ShowPoints="false" ShowLastPoint ShowCurrent Smooth Live LiveInterval="MonitorCommands.Interval" ShowXLabels="false" EmptyText="Measuring" />
				</MokaCard>
				<MokaCard Outlined Elevation="0" Title="Memory" Subtitle="@(memory.SwapTotalKb > 0 ? "Used and swap" : "Used")" Class="mta-ov-card">
					<MokaLineChart Series="MemorySeries(memory)" Label="Memory over the last two minutes" Formatter="PercentText" Min="0" Max="100" YTicks="2" Height="@ChartHeight"
								   ShowArea ShowPoints="false" ShowLastPoint ShowCurrent Smooth Live LiveInterval="MonitorCommands.Interval" ShowXLabels="false" EmptyText="Measuring" />
				</MokaCard>
				@if (sample?.Interfaces.Count > 0)
				{
					<MokaCard Outlined Elevation="0" Title="Network" Subtitle="@NetworkTitle(rates)" Class="mta-ov-card">
						<MokaLineChart Series="NetworkSeries" Label="Network traffic over the last two minutes" Formatter="RateText" AutoScale ScaleUnits="DisplayFormat.ByteUnits" SuggestedMax="1024" YTicks="2" Height="@ChartHeight"
									   ShowArea ShowPoints="false" ShowLastPoint ShowCurrent ShowPeak Smooth Live LiveInterval="MonitorCommands.Interval" ShowXLabels="false" EmptyText="Measuring" />
					</MokaCard>
				}
				@if (sample?.Disks.Count > 0)
				{
					<MokaCard Outlined Elevation="0" Title="Disk I/O" Subtitle="@DiskTitle(rates)" Class="mta-ov-card">
						<MokaLineChart Series="DiskSeries" Label="Disk reads and writes over the last two minutes" Formatter="RateText" AutoScale ScaleUnits="DisplayFormat.ByteUnits" SuggestedMax="1024" YTicks="2" Height="@ChartHeight"
									   ShowArea ShowPoints="false" ShowLastPoint ShowCurrent ShowPeak Smooth Live LiveInterval="MonitorCommands.Interval" ShowXLabels="false" EmptyText="Measuring" />
					</MokaCard>
				}
			</section>

			<section class="mta-ov-tiles" aria-label="State">
				<button type="button" class="mta-ov-tile" @onclick="@(() => Context.Navigate(AdminPageIds.Logs))">
					<MokaStat Tile Value="@(AdminFormat.Span(Uptime(sample) ?? snapshot.Uptime) is { Length: > 0 } up ? up : "?")" Label="Uptime" HelpText="@(snapshot.BootedAt is { } booted ? $"booted {DisplayFormat.Timestamp(booted)}" : "boot time unknown")" />
				</button>
				<button type="button" class="mta-ov-tile" disabled="@(Capabilities.Services is null)" @onclick="OpenFailedServices">
					<MokaStat Tile Value="@(_services is null ? ServicesPending : AdminFormat.Count(_failed))" Label="Failed services" HelpText="@ServicesText" Color="@(_failed > 0 ? MokaColor.Error : MokaColor.Surface)" />
				</button>
				<Hint Text="@_updatesError" Class="mta-ov-tile-hint">
					<button type="button" class="mta-ov-tile" disabled="@(Capabilities.Packages is null)" @onclick="OpenUpdates">
						<MokaStat Tile Value="@UpdatesValue" Label="Pending updates" HelpText="@UpdatesText" Color="@(_updates > 0 ? MokaColor.Warning : MokaColor.Surface)" />
					</button>
				</Hint>
				<AdminUpdateCards />
				<button type="button" class="mta-ov-tile" @onclick="@(() => Context.Navigate(AdminPageIds.Time))">
					<MokaStat Tile Value="@(_clock is { TimeZone.Length: > 0 } clock ? clock.TimeZone : "...")" Label="Time zone" HelpText="@ClockText" Color="@(_clock?.Synchronized == false ? MokaColor.Warning : MokaColor.Surface)" />
				</button>
			</section>

			<section class="mta-ov-facts">
				<MokaCard Outlined Elevation="0" Title="System" Subtitle="@Profile.Facts.HostName" Class="mta-ov-card">
					<HeaderActions>
						<button type="button" class="mta-link" @onclick="@(() => Context.Navigate(AdminPageIds.HostName))">hostname</button>
					</HeaderActions>
					<ChildContent>
						<AdminFacts Items="SystemFacts(snapshot)" Class="mta-facts--plain" />
					</ChildContent>
				</MokaCard>
				@if (snapshot.Disks.Count > 0)
				{
					<MokaCard Outlined Elevation="0" Title="File systems" Subtitle="@FileSystemsText(snapshot)" Class="mta-ov-card">
						<HeaderActions>
							<button type="button" class="mta-link" @onclick="@(() => Context.Navigate(AdminPageIds.Disks))">disks</button>
						</HeaderActions>
						<ChildContent>
							<div class="mta-ov-fs-list">
								@foreach (FileSystemUsage disk in snapshot.Disks.Select(item => item.MountPoint == "/" && root is not null ? root : item))
								{
									<Hint @key="disk.MountPoint" Text="@($"{disk.Source} on {disk.MountPoint}, {AdminFormat.Kb(disk.UsedKb)} used")" Class="mta-ov-fs-hint">
										<button type="button" class="mta-ov-fs" @onclick="@(() => Context.Navigate(AdminPageIds.Disks))">
											<MokaMeter Value="disk.UsedPercent" Label="@disk.MountPoint" Format="0'%'" Color="@AdminFormat.LevelColor(disk.UsedPercent)" Size="MokaSize.Sm" />
											<span class="mta-ov-fs-sub">@($"{AdminFormat.Kb(disk.AvailableKb)} free of {AdminFormat.Kb(disk.TotalKb)}")</span>
										</button>
									</Hint>
								}
							</div>
						</ChildContent>
					</MokaCard>
				}
			</section>

			@if (rates is not null && (rates.Interfaces.Count > 1 || rates.Disks.Count > 1))
			{
				<section class="mta-live-lists" aria-label="By device">
					@if (rates.Interfaces.Count > 1)
					{
						bool anyDevice = rates.Interfaces.Any(other => other.IsDevice);
						<ToolTable TItem="InterfaceRate"
								   Items="@rates.Interfaces.Take(MaxDevices).ToList()"
								   ItemKey="@(item => item.Name)"
								   Label="Network interfaces">
							<MokaColumn TItem="InterfaceRate" Title="Interface" Field="@(item => item.Name)" Class="mt-col-main">
								<CellTemplate Context="item">
									<Hint Text="@(item.IsDevice ? "A network device" : "A virtual interface: a bridge, a veth pair or a tunnel. Its traffic also crosses a device, so the total leaves it out.")" Position="MokaTooltipPosition.BottomStart" Class="mta-cell mta-mono">
										@item.Name
										@if (!item.IsDevice && anyDevice)
										{
											<span class="mta-dim mta-after">virtual</span>
										}
									</Hint>
								</CellTemplate>
							</MokaColumn>
							<MokaColumn TItem="InterfaceRate" Title="In" Field="@(item => item.ReceivedPerSecond)" SortDescendingFirst Mono Align="MokaTextAlign.Right">
								<CellTemplate Context="item">@AdminFormat.Rate(item.ReceivedPerSecond)</CellTemplate>
							</MokaColumn>
							<MokaColumn TItem="InterfaceRate" Title="Out" Field="@(item => item.SentPerSecond)" SortDescendingFirst Mono Align="MokaTextAlign.Right">
								<CellTemplate Context="item">@AdminFormat.Rate(item.SentPerSecond)</CellTemplate>
							</MokaColumn>
						</ToolTable>
					}
					@if (rates.Disks.Count > 1)
					{
						<ToolTable TItem="DiskRate"
								   Items="@rates.Disks.Take(MaxDevices).ToList()"
								   ItemKey="@(item => item.Name)"
								   Label="Disks">
							<MokaColumn TItem="DiskRate" Title="Disk" Field="@(item => item.Name)" Mono Class="mt-col-main" />
							<MokaColumn TItem="DiskRate" Title="Read" Field="@(item => item.ReadPerSecond)" SortDescendingFirst Mono Align="MokaTextAlign.Right">
								<CellTemplate Context="item">@AdminFormat.Rate(item.ReadPerSecond)</CellTemplate>
							</MokaColumn>
							<MokaColumn TItem="DiskRate" Title="Write" Field="@(item => item.WrittenPerSecond)" SortDescendingFirst Mono Align="MokaTextAlign.Right">
								<CellTemplate Context="item">@AdminFormat.Rate(item.WrittenPerSecond)</CellTemplate>
							</MokaColumn>
						</ToolTable>
					}
				</section>
			}
		</div>
	}
	</ChildContent>
</ToolPageFrame>

@code {
	// The busiest interfaces and disks listed under the charts; the totals count them all.
	private const int MaxDevices = 8;

	private const string ChartHeight = "132px";

	private OverviewSnapshot? _snapshot;
	private HostMonitor? _monitor;
	private IDisposable? _watch;
	private IReadOnlyList<ServiceUnit>? _services;
	private int _failed;
	private int? _updates;
	private string? _updatesError;
	private ClockInfo? _clock;

	private string Summary => _snapshot?.Cores is { } cores
		? $"{Profile.Facts.HostName} · {cores} cores · logged in as {Profile.Facts.UserName}"
		: Profile.Facts.HostName;

	private string ServicesPending => Capabilities.Services is null ? "none" : "...";

	private string ServicesText => Capabilities.Services is null
		? "no service manager"
		: _services is { } services ? $"of {AdminFormat.Count(services.Count)} services" : "reading";

	private string UpdatesValue => _updates is { } updates
		? AdminFormat.Count(updates)
		: Capabilities.Packages is null ? "none" : _updatesError is null ? "..." : "?";

	private string UpdatesText => Capabilities.Packages is not { } packages
		? "no package manager"
		: _updatesError is not null ? "could not check" : _updates is null ? $"asking {packages.DisplayName}" : packages.DisplayName;

	private string ClockText => _clock?.Synchronized switch
	{
		true => "NTP synchronized",
		false => "not synchronized",
		_ => _clock is null ? "reading" : "sync unknown",
	};

	private MonitorHistory History => Context.Monitor.History;

	private string? SampleError => Context.Monitor.State.Problem;

	private IReadOnlyList<MokaLineSeries> CpuSeries =>
	[
		new MokaLineSeries { Name = "Busy", Values = Window(History.Cpu), Color = MokaColor.Primary },
		new MokaLineSeries { Name = "I/O wait", Values = Window(History.IoWait), Color = MokaColor.Warning },
	];

	private IReadOnlyList<MokaLineSeries> NetworkSeries =>
	[
		new MokaLineSeries { Name = "In", Values = Window(History.Received), Color = MokaColor.Primary },
		new MokaLineSeries { Name = "Out", Values = Window(History.Sent), Color = MokaColor.Info },
	];

	private IReadOnlyList<MokaLineSeries> DiskSeries =>
	[
		new MokaLineSeries { Name = "Read", Values = Window(History.Read), Color = MokaColor.Primary },
		new MokaLineSeries { Name = "Write", Values = Window(History.Written), Color = MokaColor.Info },
	];

	protected override void OnParametersSet() => Follow();

	protected override void Dispose(bool disposing)
	{
		if (disposing)
		{
			Leave();
		}

		base.Dispose(disposing);
	}

	protected override async Task LoadAsync(CancellationToken cancellationToken)
	{
		// The slow ones (a dnf metadata check can take a minute) fill their tiles in as they arrive.
		_ = LoadServicesAsync(cancellationToken);
		_ = LoadUpdatesAsync(cancellationToken);
		_ = LoadClockAsync(cancellationToken);
		AdminOutcome outcome = await ReadAsync(OverviewCommands.Read(), cancellationToken);
		_snapshot = OverviewCommands.Parse(outcome.Output);
		Context.Monitor.Record(_snapshot.Sample);
		Follow();
	}

	private RenderFragment GaugeCard(string title, string label, double? value, string format, double min, double max, double? percent, string[] lines, Action open) => __builder =>
	{
		<MokaCard Outlined Elevation="0" Clickable OnClick="open" Class="mta-ov-card mta-ov-gauge" ActionLabel="@($"{label}: {(value is { } known ? known.ToString(format, CultureInfo.InvariantCulture) : "measuring")}")">
			<MokaGauge Value="@(value ?? min)"
					   Min="min"
					   Max="max"
					   ShowValue="@(value is not null)"
					   Format="@format"
					   Word="@AdminFormat.LevelWord(percent)"
					   Color="@AdminFormat.LevelColor(percent)"
					   Label="@label"
					   SizeValue="104px" />
			<div class="mta-ov-gauge-text">
				<span class="mta-ov-gauge-title">@title</span>
				@foreach (string line in lines.Where(line => line.Length > 0))
				{
					<span class="mta-ov-gauge-line">@line</span>
				}
			</div>
		</MokaCard>
	};

	private static double[] Window(SampleHistory history) => SampleHistory.Window(history, MonitorHistory.Capacity);

	private IReadOnlyList<MokaLineSeries> MemorySeries(MemoryInfo memory) => memory.SwapTotalKb > 0
		?
		[
			new MokaLineSeries { Name = "Used", Values = Window(History.Memory), Color = MokaColor.Primary },
			new MokaLineSeries { Name = "Swap", Values = Window(History.Swap), Color = MokaColor.Secondary },
		]
		: [new MokaLineSeries { Name = "Used", Values = Window(History.Memory), Color = MokaColor.Primary }];

	private static string PercentText(double value) => string.Create(CultureInfo.InvariantCulture, $"{value:0}%");

	private static string RateText(double value) => AdminFormat.Rate(value);

	private IReadOnlyList<MokaDataListItem> SystemFacts(OverviewSnapshot snapshot)
	{
		List<MokaDataListItem> facts =
		[
			new("System", Profile.DisplayName),
			new("Kernel", Profile.Facts.Kernel),
		];
		if (snapshot.CpuModel.Length > 0)
		{
			facts.Add(new("Processor", snapshot.Cores is { } cores ? $"{snapshot.CpuModel} · {cores} cores" : snapshot.CpuModel));
		}

		if (snapshot.MemoryTotalKb is { } memory)
		{
			facts.Add(new("Memory", snapshot.SwapTotalKb is { } swap and > 0 ? $"{AdminFormat.Kb(memory)} · swap {AdminFormat.Kb(swap)}" : AdminFormat.Kb(memory)));
		}

		facts.Add(new("Booted", snapshot.BootedAt is { } booted ? DisplayFormat.Timestamp(booted) : "unknown"));
		facts.Add(new("Logged in as", Profile.Facts.IsRoot ? $"{Profile.Facts.UserName} (root)" : Profile.Facts.UserName));
		return facts;
	}

	private static string FileSystemsText(OverviewSnapshot snapshot)
	{
		int full = snapshot.Disks.Count(disk => UsageBar.LevelOf(disk.UsedPercent) == UsageLevel.Full);
		string count = snapshot.Disks.Count == 1 ? "1 mounted" : $"{snapshot.Disks.Count} mounted";
		return full > 0 ? $"{count}, {full} nearly full" : count;
	}

	private static FileSystemUsage? RootDisk(SystemSample? sample, OverviewSnapshot snapshot) =>
		sample?.RootDisk ?? snapshot.Disks.FirstOrDefault(disk => disk.MountPoint == "/");

	private static TimeSpan? Uptime(SystemSample? sample) =>
		sample?.UptimeSeconds is { } seconds ? TimeSpan.FromSeconds(Math.Floor(seconds)) : null;

	private static double? LoadPercent(SystemSample? sample, OverviewSnapshot snapshot) =>
		sample?.Load is { } load && snapshot.Cores is { } cores && cores > 0 ? load.One * 100 / cores : null;

	private static string[] LoadLines(SystemSample? sample, OverviewSnapshot snapshot) => sample?.Load is { } load
		? [$"5m {AdminFormat.Number(load.Five)}", $"15m {AdminFormat.Number(load.Fifteen)}", snapshot.Cores is { } cores ? $"of {cores} cores" : ""]
		: ["not read"];

	private static string CoresText(OverviewSnapshot snapshot) => snapshot.Cores is { } cores ? $"{cores} cores" : "";

	private static string CpuText(SystemRates? rates) => rates?.CpuPercent is null
		? "measuring"
		: $"iowait {AdminFormat.Number(rates.IoWaitPercent, "0.0")}%";

	private static string SwapText(MemoryInfo memory) => memory.SwapTotalKb is { } swap && swap > 0
		? $"swap {AdminFormat.Percent(memory.SwapUsedPercent ?? 0)} of {AdminFormat.Kb(swap)}"
		: "no swap";

	private static string NetworkTitle(SystemRates? rates) => rates is null
		? "Measuring"
		: rates.Interfaces.Any(item => item.IsDevice) && rates.Interfaces.Any(item => !item.IsDevice)
			? "Network devices; bridges and veth pairs are left out"
			: "Every interface but loopback";

	private static string DiskTitle(SystemRates? rates) => rates is null
		? "Measuring"
		: $"Summed over {rates.Disks.Count} whole {(rates.Disks.Count == 1 ? "disk" : "disks")}";

	private void OpenFailedServices() => Context.Navigate(AdminPageIds.Services, "failed");

	private void OpenUpdates() => Context.Navigate(AdminPageIds.Packages, "updates");

	// Watches at the overview's pace while the view is shown and lets go while it is hidden, so a hidden System view
	// reads nothing of its own. The first read already brings a sample, so watching starts once it is in. A reconnect
	// brings a new session and with it a new sampler.
	private void Follow()
	{
		if (IsDisposed)
		{
			return;
		}

		HostMonitor monitor = Context.Monitor;
		if (!ReferenceEquals(monitor, _monitor))
		{
			Leave();
			_monitor = monitor;
			monitor.Changed += OnMonitorChanged;
		}

		if (Context.IsVisible() && _snapshot is not null)
		{
			_watch ??= monitor.Watch(MonitorCommands.Interval);
		}
		else
		{
			_watch?.Dispose();
			_watch = null;
		}
	}

	private void Leave()
	{
		_watch?.Dispose();
		_watch = null;
		if (_monitor is { } monitor)
		{
			monitor.Changed -= OnMonitorChanged;
			_monitor = null;
		}
	}

	// Raised on the sampler's own loop.
	private void OnMonitorChanged() => _ = InvokeAsync(StateHasChanged);

	private async Task LoadServicesAsync(CancellationToken cancellationToken)
	{
		if (Capabilities.Services is not { } services)
		{
			return;
		}

		try
		{
			_services = services.ParseList((await ReadAsync(services.List(), cancellationToken)).Output);
			_failed = _services.Count(unit => unit.State == ServiceState.Failed);
		}
		catch (Exception ex) when (ex is AdminException or OperationCanceledException)
		{
			return;
		}

		await InvokeAsync(StateHasChanged);
	}

	private async Task LoadUpdatesAsync(CancellationToken cancellationToken)
	{
		if (Capabilities.Packages is not { } packages)
		{
			return;
		}

		_updates = null;
		_updatesError = null;
		try
		{
			AdminOutcome outcome = await ReadAsync(packages.ListUpdates(), cancellationToken);
			if (outcome.Succeeded)
			{
				_updates = packages.ParseUpdates(outcome.Output).Count;
			}
			else
			{
				_updatesError = outcome.Problem();
			}
		}
		catch (AdminException ex)
		{
			_updatesError = ex.Message;
		}
		catch (OperationCanceledException)
		{
			return;
		}

		await InvokeAsync(StateHasChanged);
	}

	private async Task LoadClockAsync(CancellationToken cancellationToken)
	{
		try
		{
			_clock = ClockCommands.Parse((await ReadAsync(Capabilities.Clock.Read(), cancellationToken)).Output);
		}
		catch (Exception ex) when (ex is AdminException or OperationCanceledException)
		{
			return;
		}

		await InvokeAsync(StateHasChanged);
	}
}
