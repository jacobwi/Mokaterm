@namespace Mokaterm.Modules.Ssh.Components.Docker
@inherits DockerPageBase

@code {
	/// <summary>A chip for an image this session's update check found behind its tag; nothing otherwise.</summary>
	private protected RenderFragment UpdateChip(string? image) => @<text>
		@if (Feature?.ImageUpdates.Find(image) is { HasUpdate: true } update)
		{
			<Hint Text="@update.Detail">
				<MokaTag Text="Update" Size="MokaSize.Xs" Color="MokaColor.Info" />
			</Hint>
		}
	</text>;

	private protected static RenderFragment LoopChip(DockerRestartRecord? loop) => @<text>
		@if (loop is { IsLooping: true })
		{
			<Hint Text="@DockerRestartWording.Summary(loop)">
				<MokaTag Text="Restart loop" Size="MokaSize.Xs" Color="MokaColor.Error" />
			</Hint>
		}
	</text>;

	/// <summary>
	/// A size in a list: our own byte figure beside a bar as long as its share of <paramref name="largest"/>, the biggest
	/// in the list, so the heavy rows show at a glance. A dash while the size is not known.
	/// </summary>
	private protected static RenderFragment SizeCell(long? bytes, long largest) => @<span class="mt-dk-size">
		@if (bytes is { } size)
		{
			<MokaMeter Value="@(largest > 0 ? Math.Min(100, size * 100d / largest) : 0)"
					   ShowValue="false"
					   Size="MokaSize.Xs"
					   Color="MokaColor.Info"
					   Class="mt-dk-size-bar"
					   aria-hidden="true" />
			<span class="mt-dk-size-text">@DisplayFormat.Bytes(size)</span>
		}
		else
		{
			<span class="mt-dk-size-text mt-dk-dim">-</span>
		}
	</span>;

	/// <summary>Names in one cell, cut to its width with the whole list in the title, or a quiet word when there are none.</summary>
	private protected static RenderFragment NamesCell(IReadOnlyList<string> names, string none) => @<text>
		@if (names.Count == 0)
		{
			<span class="mt-dk-flag">@none</span>
		}
		else
		{
			<span class="mt-dk-dim mt-dk-clip mt-dk-clip--short" title="@string.Join(", ", names)">@string.Join(", ", names)</span>
		}
	</text>;

	/// <summary>What docker system df prints, one row per kind: the overview's summary and the cleanup page's.</summary>
	private protected static RenderFragment DiskUsageTable(IReadOnlyList<DockerDiskUsage> rows) => @<ToolTable TItem="DockerDiskUsage"
																										   Items="rows"
																										   ItemKey="@(row => row.Type)"
																										   Label="Disk usage">
		<MokaColumn TItem="DockerDiskUsage" Title="Kind" Field="@(row => row.Type)" Class="mt-col-main">
			<CellTemplate Context="row">@row.Type</CellTemplate>
		</MokaColumn>
		<MokaColumn TItem="DockerDiskUsage" Title="Total" Field="@(row => row.TotalCount)" SortComparer="ByTotal" SortDescendingFirst Mono Align="MokaTextAlign.Right">
			<CellTemplate Context="row">@row.TotalCount</CellTemplate>
		</MokaColumn>
		<MokaColumn TItem="DockerDiskUsage" Title="Active" Field="@(row => row.Active)" SortComparer="ByActive" SortDescendingFirst Mono Align="MokaTextAlign.Right">
			<CellTemplate Context="row">@row.Active</CellTemplate>
		</MokaColumn>
		<MokaColumn TItem="DockerDiskUsage" Title="Size" Field="@(row => row.Size)" SortComparer="BySize" SortDescendingFirst Mono Align="MokaTextAlign.Right">
			<CellTemplate Context="row">@row.Size</CellTemplate>
		</MokaColumn>
		<MokaColumn TItem="DockerDiskUsage" Title="Reclaimable" Field="@(row => row.Reclaimable)" SortComparer="ByReclaimable" SortDescendingFirst Mono Align="MokaTextAlign.Right">
			<CellTemplate Context="row">
				<span class="@(row.ReclaimableBytes is > 0 ? null : "mt-dk-dim")">@row.Reclaimable</span>
			</CellTemplate>
		</MokaColumn>
	</ToolTable>;

	private static int ByTotal(DockerDiskUsage left, DockerDiskUsage right) => Number(left.TotalCount).CompareTo(Number(right.TotalCount));

	private static int ByActive(DockerDiskUsage left, DockerDiskUsage right) => Number(left.Active).CompareTo(Number(right.Active));

	private static int BySize(DockerDiskUsage left, DockerDiskUsage right) => (DockerSizes.Parse(left.Size) ?? -1).CompareTo(DockerSizes.Parse(right.Size) ?? -1);

	private static int ByReclaimable(DockerDiskUsage left, DockerDiskUsage right) => (left.ReclaimableBytes ?? -1).CompareTo(right.ReclaimableBytes ?? -1);

	private static int Number(string text) => int.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out int value) ? value : -1;
}
