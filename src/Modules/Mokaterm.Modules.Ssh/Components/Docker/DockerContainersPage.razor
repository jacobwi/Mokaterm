@namespace Mokaterm.Modules.Ssh.Components.Docker
@inherits DockerManagerPageBase

<ToolPageFrame Title="Containers"
			   Summary="@Summary"
			   Search="@_query"
			   SearchChanged="SearchCallback"
			   SearchPlaceholder="Filter by name, image, port or project"
			   PrimaryText="@(ShowsList ? "New container" : null)"
			   PrimaryIcon="MokaIcons.Action.Add"
			   PrimaryDisabled="IsBusy"
			   OnPrimary="@(() => NewContainer(""))"
			   Loading="FrameLoading"
			   Loaded="@(!IsFirstLoad)"
			   Error="@LoadError"
			   LoadingText="Listing containers"
			   OnRefresh="RefreshCallback"
			   ListPage="ShowsList"
			   Detail="@DetailFragment">
	<Chips>
		@if (ShowsList)
		{
			<MokaSegmentedControl Size="MokaSize.Xs" Value="@_filter" ValueChanged="OnFilterChanged" AriaLabel="Which containers">
				<MokaSegment Value="all" Text="@($"All {_containers.Count.ToString(CultureInfo.CurrentCulture)}")" />
				<MokaSegment Value="running" Text="@($"Up {RunningCount.ToString(CultureInfo.CurrentCulture)}")" />
				<MokaSegment Value="stopped" Text="@($"Down {(_containers.Count - RunningCount).ToString(CultureInfo.CurrentCulture)}")" />
				@if (LoopingCount > 0 || _filter == LoopsFilter)
				{
					<MokaSegment Value="@LoopsFilter" Text="@($"Looping {LoopingCount.ToString(CultureInfo.CurrentCulture)}")" />
				}
			</MokaSegmentedControl>
		}
	</Chips>
	<Notices>
		@ChangePanel
		@if (_shellProblem is { } shellProblem)
		{
			<MokaAlert Severity="MokaToastSeverity.Warning" Dense Closable OnClose="@(() => _shellProblem = null)">@shellProblem</MokaAlert>
		}
	</Notices>
	<ChildContent>
		@if (_newImage is { } newImage)
		{
			<DockerNewContainerView Session="Session"
									Visible="Visible"
									Image="@newImage"
									TakenNames="TakenNames"
									OnCreated="OnCreatedAsync"
									OnCancel="CloseNewContainer" />
		}
		else
		{
			<ToolTable TItem="DockerContainer"
					   Items="_shown"
					   ItemKey="@(container => container.Id)"
					   Label="Containers"
					   IsSelected="@(container => container.Id == _selected)"
					   OnRowClick="OnRowClick"
					   OnRowMenu="@(args => ShowRowMenu(args.MouseEvent, MenuFor(args.Item)))"
					   RowClass="@(container => container.IsAlive ? null : "mt-dk-row--down")"
					   GroupBy="GroupKey"
					   GroupHeader="GroupHeader"
					   CollapsedGroups="_collapsedGroups"
					   GroupToggled="OnGroupToggled"
					   BulkActions="BulkBar"
					   ItemName="@(container => container.Name)"
					   ItemsName="containers"
					   ShowColumnToggle
					   Layout="@Navigation?.LayoutOf(DockerPageIds.Containers)"
					   LayoutChanged="@(layout => Navigation?.KeepLayout(DockerPageIds.Containers, layout))"
					   EmptyIcon="DockerIcons.Container"
					   EmptyTitle="@(_containers.Count == 0 ? "No containers" : "Nothing matches")"
					   EmptyText="@(_containers.Count == 0 ? "docker ps -a lists nothing on this host." : "No container matches the filter.")">
				<RowActions Context="container">
					<span class="mt-dk-quick">
						<IconButton Size="MokaSize.Xs" Icon="MokaIcons.File.FileText"
									OnClick="@(() => Select(container, "logs"))" Label="Logs" AriaLabel="@($"Logs of {container.Name}")" />
						@if (container.IsRunning)
						{
							<DockerPortLinks Session="Session" Ports="container.Ports" Name="@container.Name" />
							<IconButton Size="MokaSize.Xs" Icon="MokatermIcons.Terminal"
										Disabled="@(IsBusy || !CanOpenShellTab)"
										OnClick="@(() => ShellAsync(container))" Label="Open a shell in a new tab" AriaLabel="@($"Open a shell in {container.Name}")" />
						}
						<IconButton Size="MokaSize.Xs" Icon="@(container.IsAlive ? MokatermIcons.Reconnect : MokatermIcons.Play)"
									Disabled="IsBusy"
									OnClick="@(() => container.IsAlive ? RestartAsync(container) : StartAsync(container))"
									Label="@(container.IsAlive ? "Restart" : "Start")" AriaLabel="@($"{(container.IsAlive ? "Restart" : "Start")} {container.Name}")" />
					</span>
					<DockerContainerMenu Name="@container.Name"
										 State="@container.State"
										 Disabled="IsBusy"
										 HasTerminal="CanOpenShellTab"
										 HasUpdate="@HasUpdate(container)"
										 OnAction="@(action => OnMenuAsync(container, action))" />
				</RowActions>
				<ChildContent>
					<MokaColumn TItem="DockerContainer" Title="Name" Field="ShortName" SortComparer="ByName" Fixed>
						<CellTemplate Context="container">
							<span class="mt-dk-name" title="@container.Name">@ShortName(container)</span>
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="DockerContainer" Title="Status" Field="@(container => DockerStateDisplay.Rank(container))" SortComparer="ByStatus">
						<CellTemplate Context="container">
							<span class="mt-dk-status">
								<Hint Text="@container.Status" Position="MokaTooltipPosition.BottomStart">
									<MokaTag Text="@DockerStateDisplay.TagText(container)" Size="MokaSize.Xs" Color="@DockerStateDisplay.Color(container.State, container.Health)" />
								</Hint>
								@if (DockerStateDisplay.Since(container) is { Length: > 0 } since)
								{
									<span class="mt-dk-dim mt-dk-since">@since</span>
								}
							</span>
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="DockerContainer" Title="Image" Field="@(container => container.Image)" SortComparer="ByImage" Mono Class="mt-col-main">
						<CellTemplate Context="container">
							<span class="mt-dk-dim" title="@container.Image">@container.Image</span>
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="DockerContainer" Title="" Sortable="false" Resizable="false" Fixed>
						<CellTemplate Context="container">
							<span class="mt-dk-chips">
								@LoopChip(LoopOf(container.Id, container.Name))
								@UpdateChip(container.Image)
							</span>
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="DockerContainer" Title="Ports" Field="Ports" SortComparer="ByPorts" Mono Class="mt-col-wider">
						<CellTemplate Context="container">
							@PortsCell(container)
						</CellTemplate>
					</MokaColumn>
				</ChildContent>
			</ToolTable>
		}
	</ChildContent>
</ToolPageFrame>

@code {
	private RenderFragment? DetailFragment => ShowsList && SelectedContainer is { } selected ? DetailPanel(selected) : null;

	private RenderFragment DetailPanel(DockerContainer selected) => @<div class="mt-dk-detail-fill">
		<DockerContainerPanel @key="selected.Id"
							  Session="Session"
							  ContainerId="@selected.Id"
							  DisplayName="@selected.Name"
							  Tab="@_tab"
							  TabChanged="OnTabChanged"
							  Visible="Visible"
							  OnClose="ClosePanel"
							  OnChanged="RefreshAsync" />
	</div>;

	/// <summary>Published ports as tags, two of them and a count of the rest; ports that are only exposed stay quiet text.</summary>
	private static RenderFragment PortsCell(DockerContainer container) => @<text>
		@if (PublishedPorts(container) is { Count: > 0 } published)
		{
			<span class="mt-dk-ports">
				@foreach (string port in published.Take(ShownPorts))
				{
					<MokaTag Text="@port" Size="MokaSize.Xs" Color="MokaColor.Surface" Mono />
				}
				@if (published.Count > ShownPorts)
				{
					<Hint Text="@string.Join(", ", published.Skip(ShownPorts))" Position="MokaTooltipPosition.BottomEnd">
						<MokaTag Text="@($"+{(published.Count - ShownPorts).ToString(CultureInfo.CurrentCulture)}")" Size="MokaSize.Xs" Color="MokaColor.Surface" Mono />
					</Hint>
				}
			</span>
		}
		else if (container.Ports.Count > 0)
		{
			<span class="mt-dk-dim mt-dk-clip" title="@Ports(container)">@Ports(container)</span>
		}
	</text>;

	/// <summary>What the picked containers can have done together. A button whose action fits none of them is off.</summary>
	private RenderFragment<IReadOnlyList<DockerContainer>> BulkBar => picked => @<text>
		<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="MokatermIcons.Play"
					Disabled="@(IsBusy || picked.All(container => container.IsAlive))"
					OnClick="@(() => RunManyAsync("start", picked))">
			Start
		</MokaButton>
		<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="DockerIcons.Stop"
					Disabled="@(IsBusy || !picked.Any(container => container.IsAlive))"
					OnClick="@(() => RunManyAsync("stop", picked))">
			Stop
		</MokaButton>
		<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="MokatermIcons.Reconnect"
					Disabled="IsBusy"
					OnClick="@(() => RunManyAsync("restart", picked))">
			Restart
		</MokaButton>
		<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Error" Size="MokaSize.Xs" StartIcon="MokaIcons.Action.Delete"
					Disabled="IsBusy"
					OnClick="@(() => RunManyAsync("remove", picked))">
			Remove
		</MokaButton>
	</text>;

	private RenderFragment<MokaTableGroup<DockerContainer>> GroupHeader => group => @<text>
		<span class="mt-dk-group-name">@(group.Key.Length == 0 ? "Standalone" : group.Key)</span>
		<span class="mt-dk-group-count">@group.Items.Count(container => container.IsRunning).ToString(CultureInfo.InvariantCulture)/@group.Count.ToString(CultureInfo.InvariantCulture)</span>
	</text>;
}
