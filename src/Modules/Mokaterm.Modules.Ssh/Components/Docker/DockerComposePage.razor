@namespace Mokaterm.Modules.Ssh.Components.Docker
@inherits DockerManagerPageBase

<ToolPageFrame Title="Compose"
			   Summary="@Summary"
			   Search="@_query"
			   SearchChanged="SearchCallback"
			   SearchPlaceholder="Filter by project, folder or service"
			   PrimaryText="@(ShowsList ? "Find compose files" : null)"
			   PrimaryIcon="MokaIcons.Action.Search"
			   PrimaryDisabled="_finding"
			   PrimaryTitle="@FindTitle"
			   OnPrimary="FindAsync"
			   Loading="FrameLoading"
			   Loaded="@(!IsFirstLoad)"
			   Error="@(ShowsList ? LoadError : null)"
			   LoadingText="Listing compose projects"
			   OnRefresh="RefreshCallback"
			   ListPage="ShowsList"
			   Detail="@FoundFragment">
	<Notices>
		@if (ShowsList)
		{
			@if (ToolNote is { } note)
			{
				<MokaAlert Severity="MokaToastSeverity.Info" Dense>@note</MokaAlert>
			}
			@ChangePanel
		}
	</Notices>
	<ChildContent>
		@if (_selected is { } selected)
		{
			<DockerComposeProjectView @key="selected" Session="Session" ProjectName="@selected" Visible="Visible" OnBack="CloseProjectAsync" OnFind="FindFromProjectAsync" />
		}
		else
		{
			<ToolTable TItem="ComposeProject"
					   Items="_shown"
					   ItemKey="@(project => project.Name)"
					   Label="Compose projects"
					   OnRowClick="Open"
					   OnRowMenu="@(args => ShowRowMenu(args.MouseEvent, MenuFor(args.Item)))"
					   RowClass="@(project => project.RunningCount == 0 ? "mt-dk-row--down" : null)"
					   EmptyIcon="DockerIcons.Compose"
					   EmptyTitle="@(_projects.Count == 0 ? "No compose projects" : "Nothing matches")"
					   EmptyText="@(_projects.Count == 0 ? "Compose lists a project while it has containers, running or stopped. Find compose files looks for the ones that have none." : "No project matches the filter.")">
				<RowActions Context="project">
					@if (Feature?.Compose is not null)
					{
						<span class="mt-dk-quick">
							<IconButton Size="MokaSize.Xs" Icon="MokatermIcons.Reconnect"
										Disabled="IsBusy" OnClick="@(() => RestartAsync(project))" Label="Restart" AriaLabel="@($"Restart {project.Name}")" />
						</span>
					}
					<IconButton Size="MokaSize.Xs" Icon="MokaIcons.Navigation.MoreHorizontal"
								OnClick="@(args => ShowRowMenu(args, MenuFor(project)))"
								Label="More actions"
								AriaLabel="@($"Actions for {project.Name}")"
								Position="MokaTooltipPosition.BottomEnd" />
				</RowActions>
				<ChildContent>
					<MokaColumn TItem="ComposeProject" Title="" Sortable="false" Resizable="false" Class="mt-col-dot">
						<CellTemplate Context="project">
							<Hint Text="@project.Status" Position="MokaTooltipPosition.BottomStart" Class="mt-dk-state">
								<MokaStatusDot Size="MokaSize.Xs" Color="@ProjectColor(project)" Glow="@(project.Health is ComposeProjectHealth.Running or ComposeProjectHealth.Unhealthy)" />
							</Hint>
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="ComposeProject" Title="Project" Field="@(project => project.Name)" SortComparer="ByName" Mono>
						<CellTemplate Context="project">
							<span class="mt-dk-name mt-dk-clip" title="@project.Name">@project.Name</span>
							@DriftChip(DriftOf(project))
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="ComposeProject" Title="Running" Field="@(project => project.RunningCount)" SortComparer="ByRunning" SortDescendingFirst Mono>
						<CellTemplate Context="project">
							<span class="mt-dk-size">
								<MokaMeter Value="@(project.Containers.Count > 0 ? project.RunningCount * 100d / project.Containers.Count : 0)"
										   ShowValue="false"
										   Size="MokaSize.Xs"
										   Color="@ProjectColor(project)"
										   Class="mt-dk-size-bar"
										   aria-hidden="true" />
								<span class="mt-dk-dim">@project.RunningCount.ToString(CultureInfo.InvariantCulture)/@project.Containers.Count.ToString(CultureInfo.InvariantCulture)</span>
							</span>
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="ComposeProject" Title="Status" Field="@(project => project.Status)" Mono Class="mt-col-wider">
						<CellTemplate Context="project">
							@if (StateCounts(project) is { Count: > 0 } states)
							{
								<span class="mt-dk-chips">
									@foreach ((string state, int count) in states)
									{
										<MokaTag Text="@($"{DockerStateDisplay.StateWord(state)} {count.ToString(CultureInfo.CurrentCulture)}")"
												 Size="MokaSize.Xs"
												 Color="@DockerStateDisplay.Color(state)" />
									}
								</span>
							}
							else
							{
								<span class="mt-dk-dim mt-dk-clip" title="@project.Status">@project.Status</span>
							}
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="ComposeProject" Title="Folder" Field="@(project => project.WorkingDirectory)" Mono Class="mt-col-main">
						<CellTemplate Context="project">
							<span class="mt-dk-dim" title="@project.WorkingDirectory">@project.WorkingDirectory</span>
						</CellTemplate>
					</MokaColumn>
				</ChildContent>
			</ToolTable>
		}
	</ChildContent>
</ToolPageFrame>

@code {
	private RenderFragment? FoundFragment => ShowsList && _found is { } found ? FoundPanel(found) : null;

	private RenderFragment FoundPanel(IReadOnlyList<string> found) => @<ToolDetailPanel Title="Compose files with no project running"
																					   Subtitle="@($"Searched {SearchedText}, {DockerHostScripts.SearchDepth} folders deep")"
																					   Mono="false"
																					   OnClose="CloseFound">
		<div class="mt-dk-scroll">
			@if (_findProblem is { } findProblem)
			{
				<MokaAlert Severity="MokaToastSeverity.Error" Dense>@findProblem</MokaAlert>
			}
			else if (found.Count == 0)
			{
				<span class="mt-dk-note">@($"Nothing under {SearchedText}.")</span>
			}
			@foreach (string file in found)
			{
				@* The only things to do with a found file, so they stay in sight rather than wait for a hover. *@
				<div class="mt-dk-found" @key="file">
					@PathLine(file, "Copy the path")
					@if (Feature?.Compose is not null)
					{
						<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Primary" Size="MokaSize.Xs" StartIcon="MokaIcons.Navigation.ArrowUp"
									Disabled="IsBusy" OnClick="@(() => UpAsync(file))" aria-label="@($"Bring up {file}")">
							Up
						</MokaButton>
					}
				</div>
			}
		</div>
	</ToolDetailPanel>;
}
