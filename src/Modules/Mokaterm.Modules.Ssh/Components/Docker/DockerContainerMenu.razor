@namespace Mokaterm.Modules.Ssh.Components.Docker

@* Every action on one container, in one menu: the row and the panel show only the ones used most. A right-click on
   the row opens the same items. *@
<IconButton Size="MokaSize.Xs"
			Icon="MokaIcons.Navigation.MoreHorizontal"
			Disabled="Disabled"
			OnClick="Open"
			Label="More actions"
			AriaLabel="@($"Actions for {Name}")"
			Position="MokaTooltipPosition.BottomEnd" />

@code {
	[Inject]
	private IMokaContextMenuService Menu { get; set; } = default!;

	[Parameter, EditorRequired]
	public string Name { get; set; } = "";

	/// <summary>Docker's state, lower case: what decides between start and stop.</summary>
	[Parameter]
	public string State { get; set; } = "";

	[Parameter]
	public bool Disabled { get; set; }

	/// <summary>False for a login whose protocol has no terminal for a shell tab.</summary>
	[Parameter]
	public bool HasTerminal { get; set; }

	/// <summary>True when the session's update check found a newer image for its tag, which offers <c>update</c>.</summary>
	[Parameter]
	public bool HasUpdate { get; set; }

	/// <summary>The action picked: <c>start</c>, <c>stop</c>, <c>remove-volumes</c> and so on.</summary>
	[Parameter]
	public EventCallback<string> OnAction { get; set; }

	/// <summary>
	/// The menu of one container. While a change runs (<paramref name="busy"/>) the items that change something are off
	/// and the ones that only show something stay.
	/// </summary>
	internal static List<MokaContextMenuItem> Items(string state, bool hasTerminal, bool hasUpdate, bool busy, Func<string, Task> act)
	{
		bool alive = state is "running" or "paused" or "restarting";
		bool running = state == "running";
		List<MokaContextMenuItem> items = [];
		if (alive)
		{
			items.Add(Item("Restart", MokatermIcons.Reconnect, "restart", busy, act));
			items.Add(Item("Stop", DockerIcons.Stop, "stop", busy, act));
			items.Add(state == "paused" ? Item("Unpause", MokatermIcons.Play, "unpause", busy, act) : Item("Pause", MokatermIcons.Pause, "pause", busy, act));
			items.Add(Item("Kill", DockerIcons.Kill, "kill", busy, act));
		}
		else
		{
			items.Add(Item("Start", MokatermIcons.Play, "start", busy, act));
		}

		if (hasUpdate)
		{
			items.Add(Item("Update the image", DockerIcons.Update, "update", busy, act));
		}

		items.Add(Item("Open a shell in a new tab", MokatermIcons.Terminal, "shell", busy || !running || !hasTerminal, act, dividerBefore: true));
		items.Add(Item("Run a command", MokatermIcons.Command, "run", !running, act));
		items.Add(Item("Browse files", MokatermIcons.FolderOpen, "files", !running, act));
		items.Add(Item("Logs", MokaIcons.File.FileText, "logs", false, act));
		items.Add(Item("Inspect", MokaIcons.File.Code, "inspect", false, act));
		items.Add(Item("Stats", DockerIcons.Stats, "stats", false, act));
		items.Add(Item("Mounts", DockerIcons.Volume, "mounts", false, act));
		items.Add(Item("Limits and restart policy", DockerIcons.Limits, "limits", false, act));
		items.Add(Item("Copy name", MokaIcons.Content.Copy, "copy-name", false, act, dividerBefore: true));
		items.Add(Item("Copy id", MokaIcons.Content.Copy, "copy-id", false, act));
		items.Add(Item("Remove", MokaIcons.Action.Delete, "remove", busy, act, dividerBefore: true));
		items.Add(Item("Remove with its volumes", MokaIcons.Action.Delete, "remove-volumes", busy, act));
		return items;
	}

	private static MokaContextMenuItem Item(string text, MokaIconDefinition icon, string action, bool disabled, Func<string, Task> act, bool dividerBefore = false) => new()
	{
		Text = text,
		Icon = icon,
		Disabled = disabled,
		DividerBefore = dividerBefore,
		OnClick = () => act(action),
	};

	private void Open(MouseEventArgs args) => Menu.Show(args, Items(State, HasTerminal, HasUpdate, busy: false, OnAction.InvokeAsync));
}
