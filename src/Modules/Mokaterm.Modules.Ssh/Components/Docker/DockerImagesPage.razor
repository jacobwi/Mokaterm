@namespace Mokaterm.Modules.Ssh.Components.Docker
@inherits DockerManagerPageBase

<ToolPageFrame Title="Images"
			   Summary="@Summary"
			   Search="@_query"
			   SearchChanged="SearchCallback"
			   SearchPlaceholder="Filter by name, tag or id"
			   PrimaryText="@(ShowsList ? "Build" : null)"
			   PrimaryIcon="DockerIcons.Build"
			   PrimaryDisabled="IsWorking"
			   PrimaryTitle="@(LiveRuns?.IsRunning == true ? "A build or a push is still running" : null)"
			   OnPrimary="ShowBuild"
			   Loading="FrameLoading"
			   Loaded="@(!IsFirstLoad)"
			   Error="@LoadError"
			   LoadingText="Listing images"
			   OnRefresh="RefreshCallback"
			   ListPage="ShowsList"
			   Detail="@DetailFragment">
	<Chips>
		@if (ShowsList)
		{
			<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" Size="MokaSize.Xs" StartIcon="MokaIcons.Action.Download"
						OnClick="TogglePull" aria-expanded="@(_pulling ? "true" : "false")">
				Pull
			</MokaButton>
			<DockerUpdateCheck Session="Session" References="TaggedReferences" OnChecked="StateHasChanged" />
			@if (LiveRun is { } live)
			{
				<Hint Text="@($"{live.Title}: show its output")">
					<MokaButton Variant="MokaVariant.Text" Color="@(live.IsRunning ? MokaColor.Warning : MokaColor.Surface)" Size="MokaSize.Xs"
								StartIcon="@(live.IsRunning ? DockerIcons.Build : MokaIcons.File.FileText)" OnClick="ShowLive">
						@(live.IsRunning ? "Running" : $"Last run: {live.StateText}")
					</MokaButton>
				</Hint>
			}
		}
	</Chips>
	<ChipsEnd>
		@if (ShowsList && Navigation is { } navigation)
		{
			<Hint Text="Dangling and unused images, with what each frees">
				<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" Size="MokaSize.Xs" StartIcon="DockerIcons.Prune"
							OnClick="@(() => navigation.ShowCleanup("images"))">
					@($"Clean up ({DanglingCount.ToString(CultureInfo.CurrentCulture)} dangling)")
				</MokaButton>
			</Hint>
		}
	</ChipsEnd>
	<Notices>
		@if (_pulling && ShowsList)
		{
			<form class="mt-dk-form" @onsubmit="PullAsync" @onsubmit:preventDefault="true">
				<div class="mt-dk-form-field">
					<MokaTextField Value="@_pull"
								   ValueChanged="OnPullChanged"
								   ErrorText="@_pullError"
								   Placeholder="nginx:1.27 or registry.example.com/team/app:tag"
								   Disabled="IsBusy"
								   Size="MokaSize.Sm"
								   spellcheck="false"
								   autocomplete="off"
								   aria-label="Image to pull" />
				</div>
				<MokaButton Type="submit" Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="MokaIcons.Action.Download" Disabled="IsBusy">Pull</MokaButton>
				<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" Size="MokaSize.Xs" OnClick="TogglePull">Cancel</MokaButton>
			</form>
		}
		@ChangePanel
	</Notices>
	<ChildContent>
		@if (_view == BuildView)
		{
			<DockerBuildView Session="Session" Visible="Visible" OnStarted="ShowLive" OnCancel="ShowList" />
		}
		else if (_view == LiveView)
		{
			<DockerLiveRunPanel Session="Session" Visible="Visible" Owner="@DockerLivePlan.ImagesOwner" OnBack="ShowList" BackLabel="Back to the images" />
		}
		else
		{
			<ToolTable TItem="DockerImage"
					   Items="_shown"
					   ItemKey="@(image => Key(image))"
					   Label="Images"
					   IsSelected="@(image => Key(image) == _selected)"
					   OnRowClick="OnRowClick"
					   OnRowMenu="@(args => ShowRowMenu(args.MouseEvent, MenuFor(args.Item)))"
					   RowClass="@(image => image.IsDangling ? "mt-dk-row--down" : null)"
					   BulkActions="BulkBar"
					   ItemName="@(image => image.Reference)"
					   ItemsName="images"
					   ShowColumnToggle
					   Layout="@Navigation?.LayoutOf(DockerPageIds.Images)"
					   LayoutChanged="@(layout => Navigation?.KeepLayout(DockerPageIds.Images, layout))"
					   FootContent="@(_shown.Count > 0 ? Foot : null)"
					   EmptyIcon="DockerIcons.Image"
					   EmptyTitle="@(_images.Count == 0 ? "No images" : "Nothing matches")"
					   EmptyText="@(_images.Count == 0 ? "Pull one, or let compose build one." : "No image matches the filter.")">
				<RowActions Context="image">
					<span class="mt-dk-quick">
						<CopyButton Text="@image.Reference" Label="Copy the reference" />
						@if (Navigation is { } rowNavigation)
						{
							<IconButton Size="MokaSize.Xs" Icon="MokatermIcons.Play"
										Disabled="IsBusy" OnClick="@(() => rowNavigation.NewContainer(image.Reference))"
										Label="New container from this image" AriaLabel="@($"New container from {image.Reference}")" />
						}
						<IconButton Color="MokaColor.Error" Size="MokaSize.Xs" Icon="MokaIcons.Action.Delete"
									Disabled="IsBusy" OnClick="@(() => RemoveAsync(image, force: false))" Label="Remove" AriaLabel="@($"Remove {image.Reference}")" />
					</span>
					<IconButton Size="MokaSize.Xs" Icon="MokaIcons.Navigation.MoreHorizontal"
								Disabled="IsBusy"
								OnClick="@(args => ShowRowMenu(args, MenuFor(image)))"
								Label="More actions"
								AriaLabel="@($"Actions for {image.Reference}")"
								Position="MokaTooltipPosition.BottomEnd" />
				</RowActions>
				<ChildContent>
					<MokaColumn TItem="DockerImage" Title="Image" Field="@(image => image.Reference)" SortComparer="ByReference" Mono Class="mt-col-main" Fixed>
						<CellTemplate Context="image">
							<span class="mt-dk-name" title="@image.Reference">@image.Reference</span>
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="DockerImage" Title="" Sortable="false" Resizable="false" Fixed>
						<CellTemplate Context="image">
							@if (image.IsDangling)
							{
								<span class="mt-dk-flag">dangling</span>
							}
							else if (UpdateOf(image) is { HasUpdate: true })
							{
								@UpdateChip(image.Reference)
							}
							else if (UpdateOf(image) is { Label.Length: > 0 } checkedImage)
							{
								<Hint Text="@checkedImage.Detail"><span class="mt-dk-flag">@checkedImage.Label</span></Hint>
							}
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="DockerImage" Title="Used by" Field="@(image => UsersOf(image).Count)" SortComparer="ByUsers" SortDescendingFirst Mono Class="mt-col-wider">
						<CellTemplate Context="image">
							@NamesCell(UsersOf(image), "unused")
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="DockerImage" Title="Id" Field="@(image => image.ShortId)" Mono Class="mt-col-wider">
						<CellTemplate Context="image">
							<span class="mt-dk-dim">@image.ShortId</span>
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="DockerImage" Title="Created" Field="@(image => image.CreatedAt)" SortComparer="ByCreated" SortDescendingFirst Mono Class="mt-col-wide">
						<CellTemplate Context="image">
							<span class="mt-dk-dim">@image.CreatedSince</span>
						</CellTemplate>
					</MokaColumn>
					<MokaColumn TItem="DockerImage" Title="Size" Field="@(image => image.SizeBytes)" SortComparer="BySize" SortDescendingFirst Mono Align="MokaTextAlign.Right">
						<CellTemplate Context="image">@SizeCell(image.SizeBytes, _largest)</CellTemplate>
					</MokaColumn>
				</ChildContent>
			</ToolTable>
		}
	</ChildContent>
</ToolPageFrame>

@code {
	/// <summary>Removes the picked images together. One goes the way its own row's Remove does.</summary>
	private RenderFragment<IReadOnlyList<DockerImage>> BulkBar => picked => @<MokaButton Variant="MokaVariant.Outlined"
																						Color="MokaColor.Error"
																						Size="MokaSize.Xs"
																						StartIcon="MokaIcons.Action.Delete"
																						Disabled="IsBusy"
																						OnClick="@(() => RemoveManyAsync(picked))">
		Remove
	</MokaButton>;

	/// <summary>The rows shown, and what they take on disk with every image counted once however many tags it has.</summary>
	private RenderFragment Foot => @<text>
		<span>@ShownText</span>
		<span class="mt-dk-mono">@($"{DisplayFormat.Bytes(TotalBytes(_shown))} in all")</span>
	</text>;

	private RenderFragment? DetailFragment => ShowsList && SelectedImage is { } selected
		? @<DockerImagePanel @key="Key(selected)"
							 Session="Session"
							 Visible="Visible"
							 Reference="@selected.Reference"
							 ImageId="@selected.Id"
							 Repository="@selected.Repository"
							 Tagged="selected.IsTagged"
							 TagSource="@selected.RemoveTarget"
							 Size="@selected.Size"
							 Created="@selected.CreatedSince"
							 Containers="UsersOf(selected).Count"
							 RepositoryTags="RepositoryTags(selected)"
							 OnClose="ClosePanel"
							 OnChanged="RefreshAsync"
							 OnPushStarted="ShowLive" />
		: null;
}
