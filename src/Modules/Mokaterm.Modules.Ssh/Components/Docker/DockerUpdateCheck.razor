@namespace Mokaterm.Modules.Ssh.Components.Docker
@inherits DockerManagerPageBase

@* Asks the registries about the images a page shows, on demand only, and says how it went in a notice. *@
<Hint Text="@Title">
	<MokaButton Variant="MokaVariant.Text"
				Color="MokaColor.Surface"
				Size="MokaSize.Xs"
				StartIcon="DockerIcons.Update"
				Loading="_checking"
				Disabled="@(_checking || References.Count == 0)"
				OnClick="CheckAsync">
		@Text
	</MokaButton>
</Hint>
