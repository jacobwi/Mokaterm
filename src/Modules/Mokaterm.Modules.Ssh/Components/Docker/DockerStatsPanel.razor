@namespace Mokaterm.Modules.Ssh.Components.Docker
@inherits DockerManagerPageBase

<div class="mt-dk-panel">
	@LoadErrorPanel(RefreshAsync)

	@if (_stats is { } stats)
	{
		<DockerStatsCharts Cpu="_history.Cpu(stats.Id)"
						   MemoryBytes="_history.MemoryBytes(stats.Id)"
						   Received="_history.Received(stats.Id)"
						   Sent="_history.Sent(stats.Id)"
						   Read="_history.Read(stats.Id)"
						   Written="_history.Written(stats.Id)"
						   Cores="CoreCount"
						   MemoryPercent="@stats.MemoryPercent"
						   MemoryLimit="@stats.MemoryLimit"
						   Pids="@stats.Pids"
						   ChartHeight="120px" />
		<span class="mt-dk-note">
			Sampled every @DockerStatsHistory.SampleInterval.TotalSeconds.ToString("0", CultureInfo.CurrentCulture) s while this tab is
			open, from docker stats. Docker prints its network and disk totals to three figures, so the rates are measured over
			the last half minute.
		</span>
	}
	else if (IsFirstLoad)
	{
		<MokaSpinner Label="Sampling the container" />
	}
	else if (LoadError is null)
	{
		<MokaEmptyState Icon="DockerIcons.Stats" Title="No figures" Description="docker stats reports nothing for a container that is not running." />
	}
</div>
