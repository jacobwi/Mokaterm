@namespace Mokaterm.Modules.Ssh.Components.Docker
@inherits DockerPageBase

<div class="mt-dk-toolbar">
	<div class="mt-dk-toolbar-search">
		<MokaSearchInput Value="@_query" ValueChanged="OnQueryChanged" Placeholder="Filter by name" Debounce="100" aria-label="Filter containers" />
	</div>
	<span class="mt-dk-mono mt-dk-muted" title="Running containers, sampled every three seconds while this page shows">@CountText</span>
	<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" Size="MokaSize.Xs" StartIcon="MokaIcons.Action.Refresh"
				Disabled="IsLoading" OnClick="RefreshAsync" title="Sample now" aria-label="Sample now" />
</div>

@LoadErrorPanel(RefreshAsync)

<div class="mt-dk-scroll">
	@if (IsFirstLoad)
	{
		<div class="mt-dk-center"><MokaSpinner Label="Sampling every running container" /></div>
	}
	else if (_rows.Count == 0 && LoadError is null)
	{
		<MokaEmptyState Icon="DockerIcons.Stats"
						Title="@(_samples.Count == 0 ? "Nothing is running" : "Nothing matches")"
						Description="@(_samples.Count == 0 ? "docker stats reports only running containers." : "No running container matches the filter.")" />
	}
	else if (_rows.Count > 0)
	{
		<table class="mt-dk-table mt-dks-table">
			<thead>
				<tr>
					@foreach ((StatsColumn column, string text) in Columns)
					{
						<th class="@ColumnClass(column)" aria-sort="@AriaSort(column)" @key="column">
							<button type="button" class="@(column == _sort ? "mt-dks-sort mt-dks-sort--active" : "mt-dks-sort")" @onclick="@(() => SortBy(column))">
								@text
								@if (column == _sort)
								{
									<MokaIcon Icon="@(_descending ? MokaIcons.Navigation.ChevronDown : MokaIcons.Navigation.ChevronUp)" Size="MokaSize.Xs" />
								}
							</button>
						</th>
					}
				</tr>
			</thead>
			<tbody>
				@foreach (DockerContainerStats row in _rows)
				{
					<tr @key="row.Id">
						<td class="mt-dks-name" title="@row.Id">@row.Name</td>
						<td>
							<div class="mt-dks-cpu">
								<span class="mt-dks-figure">@row.Cpu</span>
								<Sparkline Values="_history.Cpu(row.Id)" Max="CpuScale" Slots="DockerStatsHistory.Length" Height="16" Class="mt-dks-spark" Label="@($"Recent CPU of {row.Name}")" />
							</div>
						</td>
						<td>
							<span class="mt-dks-figure">@row.MemoryPercent</span>
							<span class="mt-dk-muted">@MemoryUsed(row)</span>
							<UsageBar Percent="row.MemoryPercentValue" />
						</td>
						<td class="mt-dks-optional">@row.NetworkIo</td>
						<td class="mt-dks-optional">@row.BlockIo</td>
						<td>@row.Pids</td>
					</tr>
				}
			</tbody>
		</table>
	}
</div>

@if (_rows.Count > 0)
{
	<span class="mt-dk-note">
		From docker stats, every three seconds while this page shows. CPU counts every core, so on this host's
		@CoreCount.ToString(CultureInfo.CurrentCulture) cores a container can reach @((CoreCount * 100).ToString(CultureInfo.CurrentCulture))%.
		The lines show the last two minutes.
	</span>
}
