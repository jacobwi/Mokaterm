@namespace Mokaterm.Modules.Ssh.Components.Docker
@inherits DockerManagerPageBase

<ToolDetailPanel Title="@Reference" OnClose="OnClose">
	<Actions>
		@if (Tagged)
		{
			<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="DockerIcons.Push"
						Disabled="IsWorking" OnClick="@(() => PushAsync(allTags: false))">
				Push
			</MokaButton>
		}
		<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Surface" Size="MokaSize.Xs" StartIcon="DockerIcons.Tag"
					Disabled="IsWorking" OnClick="ToggleTag" aria-expanded="@(_tagging ? "true" : "false")">
			Tag
		</MokaButton>
		@if (Navigation is { } navigation)
		{
			<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Surface" Size="MokaSize.Xs" StartIcon="MokatermIcons.Play"
						Disabled="IsWorking" OnClick="@(() => navigation.NewContainer(Reference))">
				New container
			</MokaButton>
		}
		@if (Tagged && RepositoryTags.Count > 1)
		{
			<Hint Text="@($"docker push --all-tags {Repository}: every local tag of the repository")">
				<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Surface" Size="MokaSize.Xs" StartIcon="DockerIcons.Push"
							Disabled="IsWorking" OnClick="@(() => PushAsync(allTags: true))">
					Push all @RepositoryTags.Count tags
				</MokaButton>
			</Hint>
		}
	</Actions>
	<ChildContent>
		@if (_tagging)
		{
			<form class="mt-dk-form" @onsubmit="TagAsync" @onsubmit:preventDefault="true">
				<div class="mt-dk-form-field">
					<MokaTextField Value="@_tag"
								   ValueChanged="OnTagChanged"
								   ErrorText="@_tagError"
								   Placeholder="registry.example.com/team/app:1.4"
								   Disabled="IsWorking"
								   Size="MokaSize.Sm"
								   spellcheck="false"
								   autocomplete="off"
								   aria-label="New tag"
								   data-autofocus />
				</div>
				<MokaButton Type="submit" Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="DockerIcons.Tag" Disabled="IsWorking">Tag</MokaButton>
			</form>
		}

		@ChangePanel

		<div class="mt-dk-scroll">
			<div class="mt-dk-tiles mt-dk-tiles--small">
				@if (Size.Length > 0)
				{
					<MokaStat Tile Value="@Size" Label="Size" />
				}
				@if (Created.Length > 0)
				{
					<MokaStat Tile Value="@Created" Label="Created" />
				}
				@if (Containers is { } containers)
				{
					<MokaStat Tile Value="@containers.ToString("N0", CultureInfo.CurrentCulture)" Label="Containers" />
				}
				<MokaStat Tile Value="@TagCount" Label="Local tags" HelpText="@(Tagged ? Repository : "tag it to push it")" />
			</div>

			<MokaCard Inner Class="mt-dk-card">
				<Header><span class="mt-dk-label">Image id</span></Header>
				<ChildContent>@PathLine(ImageId, "Copy the image id")</ChildContent>
			</MokaCard>

			@if (Tagged)
			{
				<MokaCard Inner Class="mt-dk-card">
					<Header><span class="mt-dk-label">Pushes to</span></Header>
					<HeaderActions>
						@if (Navigation is { } registries)
						{
							<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" Size="MokaSize.Xs" StartIcon="DockerIcons.Registry"
										OnClick="@(() => registries.Navigate(DockerPageIds.Registries))">
								Registries
							</MokaButton>
						}
					</HeaderActions>
					<ChildContent>
						<span class="mt-dk-name mt-dk-mono">@RegistryDisplay</span>
						@if (_configProblem is { } configProblem)
						{
							<span class="mt-dk-note">@configProblem</span>
						}
						else if (Feature?.ClientConfig is { } config)
						{
							<span class="mt-dk-note">@DockerRegistryWording.LoginState(config, Registry)</span>
						}
						else
						{
							<MokaSpinner SpinnerStyle="MokaSpinnerStyle.Dots" Size="MokaSize.Xs" />
						}
					</ChildContent>
				</MokaCard>
			}
		</div>
	</ChildContent>
</ToolDetailPanel>
