@namespace Mokaterm.Modules.Ssh.Components.Docker
@inherits DockerManagerPageBase

<ToolPageFrame Title="Cleanup"
			   Summary="@Summary"
			   PrimaryText="@(_usage is null ? null : RemoveText)"
			   PrimaryIcon="@(_kind == VolumesKind ? MokaIcons.Action.Delete : DockerIcons.Prune)"
			   PrimaryDisabled="@(IsBusy || ShownCount == 0)"
			   OnPrimary="RemoveAsync"
			   Loading="FrameLoading"
			   Loaded="@(!IsFirstLoad)"
			   Error="@LoadError"
			   LoadingText="Measuring what Docker keeps on disk"
			   OnRefresh="@(() => RefreshByHandAsync(RefreshAsync))">
	<Chips>
		@if (_usage is not null)
		{
			<MokaSegmentedControl Size="MokaSize.Xs" Value="@_kind" ValueChanged="OnKindChanged" AriaLabel="What to clean up">
				<MokaSegment Value="@ContainersKind" Text="@($"Stopped containers {_containers.Count.ToString(CultureInfo.CurrentCulture)}")" />
				<MokaSegment Value="@ImagesKind" Text="@($"Images {_images.Count.ToString(CultureInfo.CurrentCulture)}")" />
				<MokaSegment Value="@VolumesKind" Text="@($"Volumes {_volumes.Count.ToString(CultureInfo.CurrentCulture)}")" />
				<MokaSegment Value="@CacheKind" Text="@($"Build cache {_cache.Count.ToString(CultureInfo.CurrentCulture)}")" />
			</MokaSegmentedControl>
		}
	</Chips>
	<ChipsEnd>
		@if (_usage is not null && _kind == ImagesKind)
		{
			<MokaSegmentedControl Size="MokaSize.Xs" Value="@(_taggedImages ? "unused" : "dangling")" ValueChanged="OnImageScopeChanged" AriaLabel="Which images">
				<MokaSegment Value="dangling" Text="@($"Dangling {DanglingCount.ToString(CultureInfo.CurrentCulture)}")" />
				<MokaSegment Value="unused" Text="@($"Unused {UnusedImageCount.ToString(CultureInfo.CurrentCulture)}")" />
			</MokaSegmentedControl>
		}
		else if (_usage is not null && _kind == VolumesKind)
		{
			<MokaSegmentedControl Size="MokaSize.Xs" Value="@(_namedVolumes ? "all" : "anonymous")" ValueChanged="OnVolumeScopeChanged" AriaLabel="Which volumes">
				<MokaSegment Value="anonymous" Text="@($"Anonymous {AnonymousCount.ToString(CultureInfo.CurrentCulture)}")" />
				<MokaSegment Value="all" Text="@($"All unused {UnusedVolumeCount.ToString(CultureInfo.CurrentCulture)}")" />
			</MokaSegmentedControl>
		}
	</ChipsEnd>
	<Notices>
		@ChangePanel
	</Notices>
	<ChildContent>
		@if (_summary.Count > 0)
		{
			<div class="mt-dk-section">
				<div class="mt-dk-section-head">
					<span class="mt-dk-label">Disk usage</span>
					<span class="mt-dk-mono mt-dk-muted">docker system df</span>
				</div>
				<div class="mt-dk-inline-table">@DiskUsageTable(_summary)</div>
			</div>
		}

		@if (_usage is null)
		{
			@if (!IsFirstLoad && LoadError is null)
			{
				<span class="mt-dk-note">This docker prints no item by item listing, so nothing can be previewed or removed from here.</span>
			}
		}
		else
		{
			<div class="mt-dk-section">
				<div class="mt-dk-section-head">
					<span class="mt-dk-label">@KindTitle</span>
					<span class="mt-dk-mono mt-dk-muted">@ShownTotals</span>
				</div>
				<span class="@(_kind == VolumesKind ? "mt-dk-note mt-dk-note--error" : "mt-dk-note")">@KindNote</span>
				<div class="mt-dk-inline-table">@CandidateTable</div>
				@if (ShownCount > ShownRows && !_expanded.Contains(_kind))
				{
					<div class="mt-dk-toolbar">
						<span class="mt-dk-note">@($"Showing {ShownRows.ToString(CultureInfo.CurrentCulture)} of {ShownCount.ToString(CultureInfo.CurrentCulture)}; the command names every one of them.")</span>
						<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" Size="MokaSize.Xs" OnClick="@(() => _expanded.Add(_kind))">Show all</MokaButton>
					</div>
				}
				<span class="mt-dk-note">Each list is exactly what its button removes, and the confirmation shows the command, which names every one of them.</span>
			</div>
		}
	</ChildContent>
</ToolPageFrame>

@code {
	private RenderFragment CandidateTable => _kind switch
	{
		ImagesKind => ImagesTable,
		VolumesKind => VolumesTable,
		CacheKind => CacheTable,
		_ => ContainersTable,
	};

	private RenderFragment ContainersTable => @<ToolTable TItem="DockerContainer"
															 Items="Capped(_containers)"
															 ItemKey="@(container => container.Id)"
															 Label="Stopped containers"
															 EmptyIcon="DockerIcons.Container"
															 EmptyTitle="Nothing to remove"
															 EmptyText="Every container is running or paused.">
		<MokaColumn TItem="DockerContainer" Title="Container" Field="@(container => container.Name)" Mono>
			<CellTemplate Context="container">
				<span class="mt-dk-name mt-dk-clip" title="@container.Name">@container.Name</span>
			</CellTemplate>
		</MokaColumn>
		<MokaColumn TItem="DockerContainer" Title="Image" Field="@(container => container.Image)" Mono Class="mt-col-main">
			<CellTemplate Context="container">
				<span class="mt-dk-dim" title="@container.Image">@container.Image</span>
			</CellTemplate>
		</MokaColumn>
		<MokaColumn TItem="DockerContainer" Title="Status" Field="@(container => container.Status)" Mono Class="mt-col-wide">
			<CellTemplate Context="container">
				<span class="mt-dk-dim">@container.Status</span>
			</CellTemplate>
		</MokaColumn>
		<MokaColumn TItem="DockerContainer" Title="Size" Field="@(container => DockerSizes.Parse(container.Row.Size))" SortDescendingFirst Mono Align="MokaTextAlign.Right">
			<CellTemplate Context="container">@container.Row.Size</CellTemplate>
		</MokaColumn>
	</ToolTable>;

	private RenderFragment ImagesTable => @<ToolTable TItem="DockerImage"
														 Items="Capped(_images)"
														 ItemKey="@(image => image.Reference + "|" + image.Id)"
														 Label="Images to remove"
														 EmptyIcon="DockerIcons.Image"
														 EmptyTitle="Nothing to remove"
														 EmptyText="@(_taggedImages ? "Every image is in use by a container." : "No image is dangling. Unused ones may still be.")">
		<MokaColumn TItem="DockerImage" Title="Image" Field="@(image => image.Reference)" Mono Class="mt-col-main">
			<CellTemplate Context="image">
				<span class="mt-dk-name" title="@image.Reference">@image.Reference</span>
			</CellTemplate>
		</MokaColumn>
		<MokaColumn TItem="DockerImage" Title="Id" Field="@(image => image.ShortId)" Mono Class="mt-col-wider">
			<CellTemplate Context="image">
				<span class="mt-dk-dim">@image.ShortId</span>
			</CellTemplate>
		</MokaColumn>
		<MokaColumn TItem="DockerImage" Title="Created" Field="@(image => image.CreatedAt)" SortDescendingFirst Mono Class="mt-col-wide">
			<CellTemplate Context="image">
				<span class="mt-dk-dim">@image.CreatedSince</span>
			</CellTemplate>
		</MokaColumn>
		<MokaColumn TItem="DockerImage" Title="Frees" Field="@(image => image.FreedBytes)" SortDescendingFirst Mono Align="MokaTextAlign.Right">
			<CellTemplate Context="image">@(image.UniqueSize.Length > 0 ? image.UniqueSize : image.Size)</CellTemplate>
		</MokaColumn>
	</ToolTable>;

	private RenderFragment VolumesTable => @<ToolTable TItem="DockerVolume"
														  Items="Capped(_volumes)"
														  ItemKey="@(volume => volume.Name)"
														  Label="Volumes to delete"
														  EmptyIcon="DockerIcons.Volume"
														  EmptyTitle="Nothing to delete"
														  EmptyText="@(_namedVolumes ? "Every volume is in use by a container." : "No anonymous volume is unused. Named ones may be.")">
		<MokaColumn TItem="DockerVolume" Title="Volume" Field="@(volume => volume.Name)" Mono Class="mt-col-main">
			<CellTemplate Context="volume">
				<span class="mt-dk-name" title="@volume.Name">@volume.Name</span>
				@if (volume.IsAnonymous)
				{
					<span class="mt-dk-flag mt-dk-after">anonymous</span>
				}
			</CellTemplate>
		</MokaColumn>
		<MokaColumn TItem="DockerVolume" Title="Driver" Field="@(volume => volume.Driver)" Mono Class="mt-col-wide">
			<CellTemplate Context="volume">
				<span class="mt-dk-dim">@volume.Driver</span>
			</CellTemplate>
		</MokaColumn>
		<MokaColumn TItem="DockerVolume" Title="Size" Field="@(volume => volume.SizeBytes)" SortDescendingFirst Mono Align="MokaTextAlign.Right">
			<CellTemplate Context="volume">@volume.Size</CellTemplate>
		</MokaColumn>
	</ToolTable>;

	private RenderFragment CacheTable => @<ToolTable TItem="DockerBuildCacheEntry"
														Items="Capped(_cache)"
														ItemKey="@(entry => entry.Id)"
														Label="Build cache to clear"
														EmptyIcon="DockerIcons.Build"
														EmptyTitle="Nothing to clear"
														EmptyText="No build cache is unused.">
		<MokaColumn TItem="DockerBuildCacheEntry" Title="Id" Field="@(entry => entry.ShortId)" Mono>
			<CellTemplate Context="entry">
				<span class="mt-dk-dim" title="@entry.Id">@entry.ShortId</span>
			</CellTemplate>
		</MokaColumn>
		<MokaColumn TItem="DockerBuildCacheEntry" Title="Type" Field="@(entry => entry.CacheType)" Class="mt-col-wide">
			<CellTemplate Context="entry">
				<span class="mt-dk-flag">@entry.CacheType</span>
			</CellTemplate>
		</MokaColumn>
		<MokaColumn TItem="DockerBuildCacheEntry" Title="Description" Field="@(entry => entry.Description)" Mono Class="mt-col-main">
			<CellTemplate Context="entry">
				<span class="mt-dk-dim" title="@entry.Description">@entry.Description</span>
			</CellTemplate>
		</MokaColumn>
		<MokaColumn TItem="DockerBuildCacheEntry" Title="Last used" Field="@(entry => entry.LastUsedSince)" Mono Class="mt-col-wider">
			<CellTemplate Context="entry">
				<span class="mt-dk-dim">@entry.LastUsedSince</span>
			</CellTemplate>
		</MokaColumn>
		<MokaColumn TItem="DockerBuildCacheEntry" Title="Size" Field="@(entry => entry.SizeBytes)" SortDescendingFirst Mono Align="MokaTextAlign.Right">
			<CellTemplate Context="entry">@entry.Size</CellTemplate>
		</MokaColumn>
	</ToolTable>;
}
