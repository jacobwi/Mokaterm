@namespace Mokaterm.Modules.Ssh.Components.Docker
@inherits DockerPageBase

<div class="mt-dk-panel">
	<LogView Tail="_lines"
			 Label="Project logs"
			 SearchPlaceholder="Search the logs"
			 EmptyText="@EmptyText"
			 LineChoices="TailChoices"
			 LineCount="_tail"
			 LineCountChanged="OnTailChangedAsync"
			 Following="_follow"
			 FollowingChanged="OnFollowingChanged"
			 CanFollow="@(Context?.Target is not null)"
			 OnRefresh="ReloadAsync"
			 RefreshDisabled="@(IsLoading || Context?.Target is null)"
			 SourceHue="SourceHue">
		<Controls>
			<MokaSelect TValue="string"
						Items="Choices"
						Value="@_service"
						ValueChanged="OnServiceChangedAsync"
						ValueSelector="ChoiceLabel"
						Size="MokaSize.Sm"
						aria-label="Which service" />
		</Controls>
		<Status>@LoadErrorPanel(ReloadAsync)</Status>
	</LogView>
</div>
