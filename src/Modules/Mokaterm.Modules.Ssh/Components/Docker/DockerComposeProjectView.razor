@namespace Mokaterm.Modules.Ssh.Components.Docker
@using Moka.Red.Feedback.Dropdown
@using Moka.Red.Feedback.Popover
@using Moka.Red.Primitives.Chip
@inherits DockerManagerPageBase

<div class="mt-dk-project">
	<div class="mt-dk-panel-head">
		<IconButton Size="MokaSize.Xs" Icon="MokaIcons.Navigation.ArrowLeft" OnClick="OnBack" Label="Back to the projects" />
		<MokaStatusDot Size="MokaSize.Xs" Color="@HealthColor(Health)" Pulse="IsBusy" Glow="@(Health is ComposeProjectHealth.Running or ComposeProjectHealth.Unhealthy)" />
		<span class="mt-dk-title mt-dk-title--data">@ProjectName</span>
		<span class="mt-dk-flag">@HealthLabel(Health)</span>
		<Hint Text="Services running, of all of them"><span class="mt-dk-mono mt-dk-muted">@ServiceCount</span></Hint>
		@if (_project?.WorkingDirectory is { } folder)
		{
			<div class="mt-dk-project-folder">@PathLine(folder, "Copy the project folder")</div>
		}
		<span class="mt-dk-spacer"></span>
		@if (Tool is { } tool)
		{
			<Hint Text="Every command here runs with this compose">
				<MokaTag Text="@tool.Display" Size="MokaSize.Xs" Color="MokaColor.Surface" />
			</Hint>
		}
		<IconButton Size="MokaSize.Xs" Icon="MokaIcons.Action.Refresh"
					Disabled="IsLoading" OnClick="RefreshAsync" Label="Refresh (the project also refreshes every five seconds)" AriaLabel="Refresh"
					Position="MokaTooltipPosition.BottomEnd" />
	</div>

	@LoadErrorPanel(RefreshAsync)

	@if (_project is not null)
	{
		@if (_target is null)
		{
			<MokaAlert Severity="MokaToastSeverity.Warning" Dense>@NoTargetText</MokaAlert>
		}
		else
		{
			<div class="mt-dk-toolbar">
				<span class="mt-dk-toolbar mt-dk-wide-only">
					<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Surface" Size="MokaSize.Xs" StartIcon="MokatermIcons.Reconnect" Disabled="IsBusy" OnClick="@(() => RunAsync("restart"))">Restart</MokaButton>
					<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Surface" Size="MokaSize.Xs" StartIcon="DockerIcons.Stop" Disabled="IsBusy" OnClick="@(() => RunAsync("stop"))">Stop</MokaButton>
					<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Surface" Size="MokaSize.Xs" StartIcon="MokatermIcons.Play" Disabled="IsBusy" OnClick="@(() => RunAsync("start"))">Start</MokaButton>
					<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Primary" Size="MokaSize.Xs" StartIcon="MokaIcons.Navigation.ArrowUp" Disabled="@(IsBusy || !_target.HasFiles)" OnClick="@(() => RunAsync("up"))">Up</MokaButton>
					<Hint Text="Up builds images first (--build)">
						<MokaChip Text="rebuild" Size="MokaSize.Xs" Selected="_build" OnClick="ToggleBuild" />
					</Hint>
					<Hint Text="Up pulls images first">
						<MokaChip Text="pull first" Size="MokaSize.Xs" Selected="_pullFirst" OnClick="TogglePullFirst" />
					</Hint>
					<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Error" Size="MokaSize.Xs" StartIcon="MokaIcons.Action.Delete" Disabled="IsBusy" OnClick="@(() => RunAsync("down"))">Down</MokaButton>
				</span>
				<span class="mt-dk-spacer"></span>
				<DockerUpdateCheck Session="Session" References="ServiceImages" OnChecked="StateHasChanged" />
				<MokaDropdown Position="MokaPopoverPosition.BottomEnd">
					<ChildContent>
						<IconButton Size="MokaSize.Xs" Icon="MokaIcons.Navigation.MoreHorizontal" Disabled="IsBusy" Label="More project actions" Position="MokaTooltipPosition.BottomEnd" />
					</ChildContent>
					<Items>
						<MokaDropdownItem Text="Restart" Icon="MokatermIcons.Reconnect" Class="mt-dk-narrow-only" OnClick="@(() => RunAsync("restart"))" />
						<MokaDropdownItem Text="Stop" Icon="DockerIcons.Stop" Class="mt-dk-narrow-only" OnClick="@(() => RunAsync("stop"))" />
						<MokaDropdownItem Text="Start" Icon="MokatermIcons.Play" Class="mt-dk-narrow-only" OnClick="@(() => RunAsync("start"))" />
						<MokaDropdownItem Text="Up" Icon="MokaIcons.Navigation.ArrowUp" Class="mt-dk-narrow-only" Disabled="@(!_target.HasFiles)" OnClick="@(() => RunAsync("up"))" />
						<MokaDropdownItem Text="Down" Icon="MokaIcons.Action.Delete" Class="mt-dk-narrow-only" OnClick="@(() => RunAsync("down"))" />
						<MokaDropdownItem Text="Pull" Icon="MokaIcons.Action.Download" Disabled="@(!_target.HasFiles)" OnClick="@(() => RunAsync("pull"))" />
						<MokaDropdownItem Text="Build" Icon="DockerIcons.Build" Disabled="@(!_target.HasFiles || IsWorking)" OnClick="@(() => RunAsync("build"))" />
						<MokaDropdownItem Text="Update (pull, then up)" Icon="DockerIcons.Update" Disabled="@(!_target.HasFiles)" OnClick="@(() => RunAsync("update"))" />
						<MokaDropdownItem Text="Recreate (--force-recreate)" Icon="MokatermIcons.Reconnect" Disabled="@(!_target.HasFiles)" OnClick="@(() => RunAsync("recreate"))" />
						<MokaDropdownItem Divider />
						<MokaDropdownItem Text="Logs" Icon="MokaIcons.File.FileText" OnClick="@(() => Show("logs"))" />
						<MokaDropdownItem Text="Config" Icon="MokaIcons.File.Code" OnClick="@(() => Show("config"))" />
						<MokaDropdownItem Text="Find compose files" Icon="MokaIcons.Action.Search" OnClick="OnFind" />
						<MokaDropdownItem Divider />
						<MokaDropdownItem Text="Down and remove volumes" Icon="MokaIcons.Action.Delete" OnClick="@(() => RunAsync("down-volumes"))" />
					</Items>
				</MokaDropdown>
			</div>
		}

		@ChangePanel

		<ViewTabs Tabs="ShownTabs" Active="@_tab" ActiveChanged="Show" Label="Project views" />

		<CascadingValue Value="_context">
			@switch (_tab)
			{
				case "logs":
					<ComposeLogsPanel Session="Session" Service="@_logService" Visible="Visible" />
					break;
				case "files":
					<div class="mt-dk-scroll"><ComposeFilesPanel Session="Session" Visible="Visible" /></div>
					break;
				case "env":
					<div class="mt-dk-scroll"><ComposeEnvPanel Session="Session" Visible="Visible" /></div>
					break;
				case BuildTab:
					<DockerLiveRunPanel Session="Session" Visible="Visible" Owner="@LiveOwner" OnBack="@(() => Show("services"))" BackLabel="Back to the services" />
					break;
				case "config":
					<div class="mt-dk-scroll"><ComposeConfigPanel Session="Session" Visible="Visible" /></div>
					break;
				default:
					@ServicesContent
					break;
			}
		</CascadingValue>
	}
	else if (IsFirstLoad)
	{
		<div class="mt-dk-center"><MokaSpinner Label="Reading the project" /></div>
	}
	else if (LoadError is null)
	{
		<MokaEmptyState Icon="DockerIcons.Compose" Title="The project is gone" Description="Compose no longer lists it: its containers were removed." />
	}
</div>

@code {
	private RenderFragment ServicesContent => @<div class="mt-dk-fill">
		<ToolTable TItem="ServiceLine"
				   Items="Lines"
				   ItemKey="@(line => line.Key)"
				   Label="Services"
				   OnRowClick="ToggleService"
				   OnRowMenu="@(args => ShowRowMenu(args.MouseEvent, MenuFor(args.Item)))"
				   RowClass="LineClass"
				   EmptyIcon="DockerIcons.Compose"
				   EmptyTitle="No services"
				   EmptyText="No service is known: the project has no container, and its files could not be read.">
			<RowActions Context="line">
				@if (_target is not null && line.Container is null)
				{
					ComposeService service = line.Service;
					<span class="mt-dk-quick">
						<IconButton Size="MokaSize.Xs" Icon="MokaIcons.File.FileText"
									OnClick="@(() => ShowLogs(service.Name))" Label="Logs" AriaLabel="@($"Logs of {service.Name}")" />
						@if (RunningContainer(service) is { } running)
						{
							<DockerPortLinks Session="Session" Ports="RunningPorts(service)" Name="@($"{ProjectName} {service.Name}")" />
							<IconButton Size="MokaSize.Xs" Icon="MokatermIcons.Terminal"
										Disabled="@(IsBusy || !CanOpenShellTab)" OnClick="@(() => ShellAsync(running.Name))"
										Label="Open a shell in a new tab" AriaLabel="@($"Open a shell in {service.Name}")" />
						}
						<IconButton Size="MokaSize.Xs" Icon="MokatermIcons.Reconnect"
									Disabled="IsBusy" OnClick="@(() => RunAsync("restart", service.Name))" Label="Restart" AriaLabel="@($"Restart {service.Name}")" />
					</span>
					<IconButton Size="MokaSize.Xs" Icon="MokaIcons.Navigation.MoreHorizontal"
								Disabled="IsBusy"
								OnClick="@(args => ShowRowMenu(args, MenuFor(service)))"
								Label="More actions"
								AriaLabel="@($"Actions for {service.Name}")"
								Position="MokaTooltipPosition.BottomEnd" />
				}
			</RowActions>
			<ChildContent>
				<MokaColumn TItem="ServiceLine" Title="" Sortable="false" Resizable="false" Class="mt-col-dot">
					<CellTemplate Context="line">
						@if (line.Container is { } container)
						{
							<MokaStatusDot Size="MokaSize.Xs" Color="@DockerStateDisplay.Color(container.State, container.Health)" />
						}
						else
						{
							<Hint Text="@ServiceTitle(line.Service)" Position="MokaTooltipPosition.BottomStart" Class="mt-dk-state">
								<MokaStatusDot Size="MokaSize.Xs" Color="@ServiceColor(line.Service)" Pulse="@(line.Service.Health == DockerHealth.Starting)"
											   Glow="@(line.Service.State is ComposeServiceState.Running or ComposeServiceState.Failed or ComposeServiceState.Unhealthy)" />
							</Hint>
						}
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="ServiceLine" Title="Service" Sortable="false">
					<CellTemplate Context="line">
						@if (line.Container is { } container)
						{
							<span class="mt-dk-nested mt-dk-clip" title="@container.Name">@container.Name</span>
						}
						else
						{
							<span class="mt-dk-name mt-dk-clip" title="@line.Service.Name">
								@if (line.Service.IsScaled)
								{
									<MokaIcon Icon="@(_expanded.Contains(line.Service.Name) ? MokaIcons.Navigation.ChevronDown : MokaIcons.Navigation.ChevronRight)" Size="MokaSize.Xs" Class="mt-dk-twisty" />
								}
								@line.Service.Name
							</span>
						}
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="ServiceLine" Title="Health" Sortable="false" Class="mt-col-wide">
					<CellTemplate Context="line">
						@if (line.Container is { } container)
						{
							<span class="mt-dk-flag">@DockerStateDisplay.HealthLabel(container.Health)</span>
						}
						else if (line.Service.Problem.Length > 0)
						{
							<span class="mt-dk-problem mt-dk-clip" title="@line.Service.Problem">@line.Service.Problem</span>
						}
						else
						{
							<span class="@(line.Service.Health == DockerHealth.Unhealthy ? "mt-dk-flag mt-dk-flag--bad" : "mt-dk-flag")">@DockerStateDisplay.HealthLabel(line.Service.Health)</span>
						}
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="ServiceLine" Title="Image" Sortable="false" Mono Class="mt-col-main">
					<CellTemplate Context="line">
						@if (line.Container is { } container)
						{
							<span class="mt-dk-dim" title="@container.Status">@container.Status</span>
						}
						else
						{
							<span class="mt-dk-dim" title="@line.Service.Image">@line.Service.Image</span>
						}
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="ServiceLine" Title="" Sortable="false" Resizable="false">
					<CellTemplate Context="line">
						@if (line.Container is null)
						{
							<span class="mt-dk-chips">
								@LoopChip(ServiceLoop(line.Service))
								@UpdateChip(line.Service.Image)
							</span>
						}
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="ServiceLine" Title="Ports" Sortable="false" Mono Class="mt-col-wide">
					<CellTemplate Context="line">
						@if (line.Container is null)
						{
							<span class="mt-dk-dim mt-dk-clip" title="@string.Join(", ", line.Service.Ports)">@string.Join(", ", line.Service.Ports)</span>
						}
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="ServiceLine" Title="Running" Sortable="false" Mono>
					<CellTemplate Context="line">
						@if (line.Container is null)
						{
							<span class="mt-dk-dim">@line.Service.Running.ToString(CultureInfo.InvariantCulture)/@line.Service.Total.ToString(CultureInfo.InvariantCulture)</span>
						}
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="ServiceLine" Title="Up for" Sortable="false" Mono Class="mt-col-wider">
					<CellTemplate Context="line">
						@if (line.Container is null)
						{
							<span class="mt-dk-dim">@line.Service.Uptime</span>
						}
					</CellTemplate>
				</MokaColumn>
			</ChildContent>
		</ToolTable>
	</div>;
}
