@namespace Mokaterm.Modules.Ssh.Components.Docker
@inherits DockerManagerPageBase

<div class="mt-dk-toolbar">
	<div class="mt-dk-toolbar-search">
		<MokaSearchInput Value="@_query" ValueChanged="OnQueryChanged" Placeholder="Filter by name, driver or path" Debounce="100" aria-label="Filter volumes" />
	</div>
	<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" Size="MokaSize.Xs" StartIcon="MokaIcons.Action.Add"
				OnClick="ToggleCreate" aria-expanded="@(_creating ? "true" : "false")">
		New
	</MokaButton>
	@if (Navigation is { } navigation)
	{
		<MokaButton Variant="MokaVariant.Text"
					Color="MokaColor.Surface"
					Size="MokaSize.Xs"
					StartIcon="DockerIcons.Prune"
					OnClick="@(() => navigation.Navigate(DockerPageIds.Cleanup))"
					title="Unused volumes with their sizes, removed together">
			@($"Clean up ({UnusedCount.ToString(CultureInfo.CurrentCulture)} unused)")
		</MokaButton>
	}
	<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" Size="MokaSize.Xs" StartIcon="MokaIcons.Action.Refresh"
				Disabled="IsLoading" OnClick="RefreshAsync" title="Refresh" aria-label="Refresh" />
</div>

@if (_creating)
{
	<form class="mt-dk-form" @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
		<div class="mt-dk-form-field">
			<MokaTextField Value="@_name"
						   ValueChanged="OnNameChanged"
						   ErrorText="@_nameError"
						   Placeholder="New volume: letters, digits, '_', '.' and '-'"
						   Disabled="IsBusy"
						   Size="MokaSize.Sm"
						   spellcheck="false"
						   autocomplete="off"
						   aria-label="New volume name" />
		</div>
		<MokaButton Type="submit" Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="MokaIcons.Action.Add" Disabled="IsBusy">Create</MokaButton>
	</form>
}

@LoadErrorPanel(RefreshAsync)
@ChangePanel

<div class="@(_selected is null ? "mt-dk-split" : "mt-dk-split mt-dk-split--open")">
	<div class="mt-dk-split-list" role="list" aria-label="Volumes">
		@if (IsFirstLoad)
		{
			<div class="mt-dk-center"><MokaSpinner Label="Listing volumes" /></div>
		}
		else if (Shown.Count == 0)
		{
			<MokaEmptyState Icon="DockerIcons.Volume"
							Title="@(_volumes.Count == 0 ? "No volumes" : "Nothing matches")"
							Description="@(_volumes.Count == 0 ? "Containers and compose create them, or New creates one." : "No volume matches the filter.")" />
		}
		@foreach (DockerVolume volume in Shown)
		{
			<div class="@(volume.Name == _selected ? "mt-dk-row mt-dk-row--selected" : "mt-dk-row")" role="listitem" @key="volume.Name">
				<button type="button" class="mt-dk-row-main" @onclick="@(() => Select(volume))" title="@volume.Mountpoint">
					<MokaStatusDot Size="MokaSize.Xs" Color="@(volume.InUse ? MokaColor.Success : MokaColor.Surface)" Glow="volume.InUse" />
					<span class="mt-dk-cell-name mt-dk-cell--w45">@volume.Name</span>
					<span class="mt-dk-cell mt-dk-cell--w12">@volume.Driver</span>
					<span class="mt-dk-cell mt-dk-cell--grow">@(volume.InUse ? "" : "unused")</span>
				</button>
				<span class="mt-dk-hover">
					<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Error" Size="MokaSize.Xs" StartIcon="MokaIcons.Action.Delete"
								Disabled="@(IsBusy || !CanRemove(volume))" OnClick="@(() => RemoveAsync(volume))"
								title="@(volume.InUse ? "A container still uses it" : $"Remove {volume.Name}")" aria-label="@($"Remove {volume.Name}")" />
				</span>
			</div>
		}
	</div>

	@if (_selected is { } selected)
	{
		<div class="mt-dk-split-panel">
			<div class="mt-dk-panel-head">
				<span class="mt-dk-cell-name">@selected</span>
				<span class="mt-dk-spacer"></span>
				<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" Size="MokaSize.Xs" StartIcon="MokaIcons.Navigation.Close" OnClick="ClosePanel" aria-label="Close the panel" />
			</div>
			<div class="mt-dk-scroll">
				@if (_details is { } details && details.Name == selected)
				{
					<div class="mt-dk-section">
						<span class="mt-dk-label">On the docker host</span>
						@if (details.Mountpoint.Length > 0)
						{
							@PathLine(details.Mountpoint, "Copy the host path")
						}
						else
						{
							<span class="mt-dk-note">The @details.Driver driver names no path on this host.</span>
						}
					</div>
					<div class="mt-dk-section">
						<span class="mt-dk-label">Mounted by</span>
						@if (details.UsedBy.Count == 0)
						{
							<span class="mt-dk-note">No container, running or stopped.</span>
						}
						@foreach (DockerVolumeUse use in details.UsedBy)
						{
							<div class="mt-dk-variable" @key="use.Container + use.Destination">
								<MokaStatusDot Size="MokaSize.Xs" Color="@DockerStateDisplay.Color(use.State)" />
								<span class="mt-dk-variable-name">@use.Container</span>
								<span class="mt-dk-variable-value">@use.Destination</span>
								<span class="mt-dk-label">@(use.ReadWrite ? "rw" : "ro")</span>
							</div>
						}
					</div>
					@if (details.Mountpoint.StartsWith('/'))
					{
						<div class="mt-dk-section">
							<span class="mt-dk-label">Files (read-only)</span>
							<DockerFileViewer @key="details.Mountpoint" Session="Session" Root="@details.Mountpoint" Visible="Visible" />
						</div>
					}
				}
				else if (_detailsProblem is { } problem)
				{
					<MokaAlert Severity="MokaToastSeverity.Error" Dense>@problem</MokaAlert>
				}
				else
				{
					<MokaSpinner SpinnerStyle="MokaSpinnerStyle.Dots" Size="MokaSize.Sm" />
				}
			</div>
		</div>
	}
</div>
