@namespace Mokaterm.Modules.Ssh.Components.Docker
@inherits DockerManagerPageBase

<ToolPageFrame Title="Volumes"
			   Summary="@Summary"
			   Search="@_query"
			   SearchChanged="OnQueryChanged"
			   SearchPlaceholder="Filter by name, driver or path"
			   PrimaryText="New volume"
			   PrimaryIcon="MokaIcons.Action.Add"
			   PrimaryDisabled="IsBusy"
			   OnPrimary="ToggleCreate"
			   Loading="FrameLoading"
			   Loaded="@(!IsFirstLoad)"
			   Error="@LoadError"
			   LoadingText="Listing volumes"
			   OnRefresh="@(() => RefreshByHandAsync(RefreshAsync))"
			   ListPage
			   Detail="@DetailFragment">
	<ChipsEnd>
		@if (Navigation is { } navigation)
		{
			<Hint Text="Unused volumes with their sizes, removed together">
				<MokaButton Variant="MokaVariant.Text"
							Color="MokaColor.Surface"
							Size="MokaSize.Xs"
							StartIcon="DockerIcons.Prune"
							OnClick="@(() => navigation.ShowCleanup("volumes"))">
					@($"Clean up ({UnusedCount.ToString(CultureInfo.CurrentCulture)} unused)")
				</MokaButton>
			</Hint>
		}
	</ChipsEnd>
	<Notices>
		@if (_creating)
		{
			<form class="mt-dk-form" @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
				<div class="mt-dk-form-field">
					<MokaTextField Value="@_name"
								   ValueChanged="OnNameChanged"
								   ErrorText="@_nameError"
								   Placeholder="New volume: letters, digits, '_', '.' and '-'"
								   Disabled="IsBusy"
								   Size="MokaSize.Sm"
								   spellcheck="false"
								   autocomplete="off"
								   aria-label="New volume name" />
				</div>
				<MokaButton Type="submit" Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="MokaIcons.Action.Add" Disabled="IsBusy">Create</MokaButton>
				<MokaButton Variant="MokaVariant.Text" Color="MokaColor.Surface" Size="MokaSize.Xs" OnClick="ToggleCreate">Cancel</MokaButton>
			</form>
		}
		@ChangePanel
	</Notices>
	<ChildContent>
		<ToolTable TItem="DockerVolume"
				   Items="_shown"
				   ItemKey="@(volume => volume.Name)"
				   Label="Volumes"
				   IsSelected="@(volume => volume.Name == _selected)"
				   OnRowClick="OnRowClick"
				   OnRowMenu="@(args => ShowRowMenu(args.MouseEvent, MenuFor(args.Item)))"
				   RowClass="@(volume => volume.InUse ? null : "mt-dk-row--down")"
				   EmptyIcon="DockerIcons.Volume"
				   EmptyTitle="@(_volumes.Count == 0 ? "No volumes" : "Nothing matches")"
				   EmptyText="@(_volumes.Count == 0 ? "Containers and compose create them, or New volume creates one." : "No volume matches the filter.")">
			<RowActions Context="volume">
				<span class="mt-dk-quick">
					<IconButton Color="MokaColor.Error" Size="MokaSize.Xs" Icon="MokaIcons.Action.Delete"
								Disabled="@(IsBusy || !CanRemove(volume))" OnClick="@(() => RemoveAsync(volume))"
								Label="@(volume.InUse ? "A container still uses it" : $"Remove {volume.Name}")" AriaLabel="@($"Remove {volume.Name}")"
								Position="MokaTooltipPosition.BottomEnd" />
				</span>
				<IconButton Size="MokaSize.Xs" Icon="MokaIcons.Navigation.MoreHorizontal"
							OnClick="@(args => ShowRowMenu(args, MenuFor(volume)))"
							Label="More actions"
							AriaLabel="@($"Actions for {volume.Name}")"
							Position="MokaTooltipPosition.BottomEnd" />
			</RowActions>
			<ChildContent>
				<MokaColumn TItem="DockerVolume" Title="" Sortable="false" Resizable="false" Class="mt-col-dot">
					<CellTemplate Context="volume">
						<MokaStatusDot Size="MokaSize.Xs" Color="@(volume.InUse ? MokaColor.Success : MokaColor.Surface)" Glow="volume.InUse" />
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="DockerVolume" Title="Volume" Field="@(volume => volume.Name)" SortComparer="ByName" Mono Class="mt-col-main">
					<CellTemplate Context="volume">
						<span class="mt-dk-name" title="@volume.Name">@volume.Name</span>
						@if (volume.IsAnonymous)
						{
							<span class="mt-dk-flag mt-dk-after">anonymous</span>
						}
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="DockerVolume" Title="Driver" Field="@(volume => volume.Driver)" Mono Class="mt-col-wide">
					<CellTemplate Context="volume">
						<span class="mt-dk-dim">@volume.Driver</span>
					</CellTemplate>
				</MokaColumn>
				<MokaColumn TItem="DockerVolume" Title="Use" Field="@(volume => volume.InUse)" SortComparer="ByUse">
					<CellTemplate Context="volume">
						<span class="@(volume.InUse ? "mt-dk-flag mt-dk-flag--on" : "mt-dk-flag")">@(volume.InUse ? "in use" : "unused")</span>
					</CellTemplate>
				</MokaColumn>
			</ChildContent>
		</ToolTable>
	</ChildContent>
</ToolPageFrame>

@code {
	private RenderFragment? DetailFragment => _selected is { } selected ? DetailPanel(selected) : null;

	private RenderFragment DetailPanel(string selected) => @<ToolDetailPanel Title="@selected"
																			 Subtitle="@(_details is { } shown && shown.Name == selected ? shown.Driver + " driver" : null)"
																			 DotColor="@(SelectedVolume?.InUse == true ? MokaColor.Success : MokaColor.Surface)"
																			 DotGlow="@(SelectedVolume?.InUse == true)"
																			 OnClose="ClosePanel">
		<Actions>
			@if (SelectedVolume is { } volume)
			{
				<Hint Text="@(volume.InUse ? "A container still uses it" : null)">
					<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Error" Size="MokaSize.Xs" StartIcon="MokaIcons.Action.Delete"
								Disabled="@(IsBusy || !CanRemove(volume))" OnClick="@(() => RemoveAsync(volume))">
						Remove
					</MokaButton>
				</Hint>
			}
		</Actions>
		<ChildContent>
			<div class="mt-dk-scroll">
				@if (_details is { } details && details.Name == selected)
				{
					<MokaCard Inner Class="mt-dk-card">
						<Header><span class="mt-dk-label">On the docker host</span></Header>
						<ChildContent>
							@if (details.Mountpoint.Length > 0)
							{
								@PathLine(details.Mountpoint, "Copy the host path")
							}
							else
							{
								<span class="mt-dk-note">The @details.Driver driver names no path on this host.</span>
							}
						</ChildContent>
					</MokaCard>
					<MokaCard Inner Class="mt-dk-card">
						<Header><span class="mt-dk-label">Mounted by</span></Header>
						<ChildContent>
							@if (details.UsedBy.Count == 0)
							{
								<span class="mt-dk-note">No container, running or stopped.</span>
							}
							@foreach (DockerVolumeUse use in details.UsedBy)
							{
								<div class="mt-dk-variable" @key="use.Container + use.Destination">
									<MokaStatusDot Size="MokaSize.Xs" Color="@DockerStateDisplay.Color(use.State)" />
									<span class="mt-dk-variable-name">@use.Container</span>
									<span class="mt-dk-variable-value">@use.Destination</span>
									<MokaTag Text="@(use.ReadWrite ? "RW" : "RO")" Size="MokaSize.Xs" Color="@(use.ReadWrite ? MokaColor.Surface : MokaColor.Info)" />
								</div>
							}
						</ChildContent>
					</MokaCard>
					@if (details.Mountpoint.StartsWith('/'))
					{
						<div class="mt-dk-section">
							<span class="mt-dk-label">Files (read-only)</span>
							<DockerFileViewer @key="details.Mountpoint" Session="Session" Root="@details.Mountpoint" Visible="Visible" />
						</div>
					}
				}
				else if (_detailsProblem is { } problem)
				{
					<MokaAlert Severity="MokaToastSeverity.Error" Dense>@problem</MokaAlert>
				}
				else
				{
					<MokaSpinner SpinnerStyle="MokaSpinnerStyle.Dots" Size="MokaSize.Sm" />
				}
			</div>
		</ChildContent>
	</ToolDetailPanel>;
}
