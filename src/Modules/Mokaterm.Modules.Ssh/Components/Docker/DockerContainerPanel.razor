@namespace Mokaterm.Modules.Ssh.Components.Docker
@inherits DockerManagerPageBase

<ToolDetailPanel Title="@Name"
				 Subtitle="@Subtitle"
				 DotColor="@(_details is { } dot ? DockerStateDisplay.Color(dot.Status, HealthOf(dot)) : null)"
				 DotGlow="@(_details is { Status: "running" })"
				 OnClose="OnClose">
	<Actions>
		@if (_details is { } actions)
		{
			@if (IsAlive(actions))
			{
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="MokatermIcons.Reconnect" Disabled="IsBusy" OnClick="@(() => OnMenuAsync("restart"))">Restart</MokaButton>
				<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Error" Size="MokaSize.Xs" StartIcon="DockerIcons.Stop" Disabled="IsBusy" OnClick="@(() => OnMenuAsync("stop"))">Stop</MokaButton>
			}
			else
			{
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="MokatermIcons.Play" Disabled="IsBusy" OnClick="@(() => OnMenuAsync("start"))">Start</MokaButton>
			}
			@if (actions.Status == "running")
			{
				<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Surface" Size="MokaSize.Xs" StartIcon="MokatermIcons.Terminal"
							Disabled="@(IsBusy || !CanOpenShellTab)" OnClick="ShellAsync">
					Shell
				</MokaButton>
				<MokaButton Variant="MokaVariant.Outlined" Color="MokaColor.Surface" Size="MokaSize.Xs" StartIcon="MokatermIcons.FolderOpen" OnClick="BrowseAsync">Files</MokaButton>
				<DockerPortLinks Session="Session" Ports="actions.Ports" Name="@Name" />
			}
			<DockerContainerMenu Name="@Name" State="@actions.Status" Disabled="IsBusy" HasTerminal="CanOpenShellTab" OnAction="OnMenuAsync" />
		}
	</Actions>
	<ChildContent>
		@LoadErrorPanel(LoadDetailsAsync)
		@ChangePanel
		@if (_shellProblem is { } shellProblem)
		{
			<MokaAlert Severity="MokaToastSeverity.Warning" Dense Closable OnClose="@(() => _shellProblem = null)">@shellProblem</MokaAlert>
		}

		@if (_details is { } details)
		{
			<ViewTabs Tabs="ShownTabs" Active="@Tab" ActiveChanged="OnTabChangedAsync" Label="Container views" />

			@* The log scrolls inside its own box, so following stays at its end; the other views scroll as a whole. *@
			@switch (Tab)
			{
				case RestartsTab:
					<div class="mt-dk-scroll">
						<DockerRestartsPanel @key="details.Id" Session="Session" ContainerId="@details.Id" Visible="Visible" OnChanged="AfterChangeAsync" />
					</div>
					break;
				case "inspect":
					<div class="mt-dk-scroll">@InspectContent(details)</div>
					break;
				case "stats":
					<div class="mt-dk-scroll">
						<DockerStatsPanel @key="details.Id" Session="Session" ContainerId="@details.Id" Visible="Visible" />
					</div>
					break;
				case "env":
					<div class="mt-dk-scroll">@EnvironmentContent(details)</div>
					break;
				case "mounts":
					<div class="mt-dk-scroll">
						<DockerMountsPanel @key="details.Id" Session="Session" Mounts="@MountsOf(details)" Visible="Visible" />
					</div>
					break;
				case "run":
					<div class="mt-dk-scroll">
						<DockerExecPanel @key="details.Id" Session="Session" Container="@Name" Running="@(details.Status == "running")" Visible="Visible" />
					</div>
					break;
				default:
					<DockerLogsPanel @key="details.Id" Session="Session" ContainerId="@details.Id" Visible="Visible" />
					break;
			}
		}
		else if (IsFirstLoad)
		{
			<div class="mt-dk-center"><MokaSpinner Label="Inspecting the container" /></div>
		}
	</ChildContent>
</ToolDetailPanel>

@code {
	private RenderFragment InspectContent(DockerContainerDetails details) => @<text>
		<div class="mt-dk-toolbar">
			<MokaSegmentedControl Size="MokaSize.Xs" Value="@(_raw ? "raw" : "summary")" ValueChanged="OnInspectViewChanged" AriaLabel="Inspect view">
				<MokaSegment Value="summary" Text="Summary" />
				<MokaSegment Value="raw" Text="Raw JSON" />
			</MokaSegmentedControl>
			@if (_raw)
			{
				<MokaCheckbox Label="Show environment values" Value="_revealRaw" ValueChanged="OnRevealRawChanged" />
				<span class="mt-dk-spacer"></span>
				<CopyButton Text="@RawJson(details)" Label="Copy the JSON as shown" />
			}
		</div>

		@if (_raw)
		{
			<MokaCodeBlock Code="@RawJson(details)" Language="json" ShowCopyButton="false" Class="mt-dk-code-block" />
		}
		else
		{
			<div class="mt-dk-tiles mt-dk-tiles--small">
				@foreach (InspectTile tile in DockerInspectSummary.Tiles(details, Time.GetUtcNow()))
				{
					<MokaStat Tile Value="@tile.Value" Label="@tile.Label" HelpText="@tile.Help" Color="@tile.Color" />
				}
			</div>

			<div class="mt-dk-cards">
				@FactCard("Runtime", DockerInspectSummary.Runtime(details))
				@FactCard("Image and command", DockerInspectSummary.Command(details))

				@if (details.Health is { Probes.Count: > 0 } checks && checks.Probes[^1] is { Output.Length: > 0 } last)
				{
					<MokaCard Inner Class="mt-dk-card">
						<Header><span class="mt-dk-label">Last health check</span></Header>
						<ChildContent>
							<MokaCodeBlock Code="@last.Output" ShowLineNumbers="false" ShowCopyButton="false" Wrap="true" MaxHeight="160px" Class="mt-dk-code-block" />
						</ChildContent>
					</MokaCard>
				}

				<MokaCard Inner Class="mt-dk-card">
					<Header><span class="mt-dk-label">Ports</span></Header>
					<ChildContent>
						@if (details.Ports.Count == 0)
						{
							<span class="mt-dk-note">None published or exposed.</span>
						}
						else
						{
							<MokaDataList Items="DockerInspectSummary.Ports(details)" Orientation="MokaDirection.Row" Dense Class="mt-dk-facts mt-dk-facts--data" />
							@if (details.Ports.Any(port => !port.IsPublished))
							{
								<span class="mt-dk-note">
									A port that is not published answers only on the container's docker networks. Publish it (ports: in
									compose, -p for docker run) to open it in the browser from here.
								</span>
							}
						}
					</ChildContent>
				</MokaCard>

				<MokaCard Inner Class="mt-dk-card">
					<Header><span class="mt-dk-label">Networks</span></Header>
					<ChildContent>
						@if (details.Networks.Count == 0)
						{
							<span class="mt-dk-note">Not attached to any network.</span>
						}
						else
						{
							<MokaDataList Items="DockerInspectSummary.Networks(details)" Orientation="MokaDirection.Row" Dense Class="mt-dk-facts mt-dk-facts--data" />
						}
					</ChildContent>
				</MokaCard>

				<MokaCard Inner Class="mt-dk-card">
					<Header><span class="mt-dk-label">Mounts</span></Header>
					<ChildContent>
						@if (details.Mounts.Count == 0)
						{
							<span class="mt-dk-note">Nothing is mounted into this container.</span>
						}
						else
						{
							<MokaDataList Items="DockerInspectSummary.Mounts(details)" Orientation="MokaDirection.Row" Dense Class="mt-dk-facts mt-dk-facts--data" />
						}
					</ChildContent>
				</MokaCard>

				@if (details.Labels.Count > 0)
				{
					<MokaCard Inner Class="mt-dk-card">
						<Header><span class="mt-dk-label">Labels</span></Header>
						<ChildContent>
							<MokaDataList Items="DockerInspectSummary.Labels(details)" Orientation="MokaDirection.Column" Dense Class="mt-dk-facts mt-dk-facts--data" />
						</ChildContent>
					</MokaCard>
				}
			</div>
		}
	</text>;

	private static RenderFragment FactCard(string title, IReadOnlyList<MokaDataListItem> facts) => @<MokaCard Inner Class="mt-dk-card">
		<Header><span class="mt-dk-label">@title</span></Header>
		<ChildContent>
			<MokaDataList Items="facts" Orientation="MokaDirection.Row" Dense Class="mt-dk-facts" />
		</ChildContent>
	</MokaCard>;

	private RenderFragment EnvironmentContent(DockerContainerDetails details) => @<text>
		@if (details.Environment.Count == 0)
		{
			<MokaEmptyState Icon="DockerIcons.Container" Title="No variables" Description="docker inspect lists no environment for this container." />
		}
		else
		{
			<span class="mt-dk-note">Values are hidden until shown one at a time; copying one clears the clipboard again shortly.</span>
			<div class="mt-dk-variables">
				@foreach ((DockerVariable variable, int index) in details.Environment.Select((variable, index) => (variable, index)))
				{
					<DockerVariableRow @key="index" Name="@variable.Name" Value="@variable.Value" />
				}
			</div>
		}
	</text>;
}
