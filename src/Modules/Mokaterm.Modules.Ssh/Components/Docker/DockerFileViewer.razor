@namespace Mokaterm.Modules.Ssh.Components.Docker
@inherits DockerManagerPageBase

<div class="mt-dk-panel-head">
	@if (_path != Root)
	{
		<IconButton Size="MokaSize.Xs" Icon="MokaIcons.Navigation.ArrowUp"
					Disabled="_busy" OnClick="UpAsync" Label="Up one folder" />
	}
	<span class="mt-dk-path-text" title="@_path">@_path</span>
	@if (_asRoot)
	{
		<Hint Text="Read through sudo">
			<MokaTag Text="AS ROOT" Icon="MokatermIcons.Root" Size="MokaSize.Xs" Color="MokaColor.Warning" />
		</Hint>
	}
	<span class="mt-dk-spacer"></span>
	<CopyButton Text="@_path" Label="Copy the path" />
	<IconButton Size="MokaSize.Xs" Icon="MokaIcons.Action.Refresh"
				Disabled="_busy" OnClick="ReloadAsync" Label="Read again" />
</div>

@if (_busy && _entries is null && _file is null)
{
	<MokaSpinner SpinnerStyle="MokaSpinnerStyle.Dots" Size="MokaSize.Sm" />
}

@if (_problem is { } problem)
{
	<MokaAlert Severity="@(_needsRoot ? MokaToastSeverity.Warning : MokaToastSeverity.Error)" Dense>
		<div class="mt-dk-alert-line">
			<span>@problem</span>
			@if (_needsRoot && CanUseRoot)
			{
				<MokaButton Variant="MokaVariant.Outlined" Size="MokaSize.Xs" StartIcon="MokatermIcons.Root" Disabled="_busy" OnClick="UseRootAsync">
					Read as root
				</MokaButton>
			}
		</div>
	</MokaAlert>
	@if (_needsRoot)
	{
		<span class="mt-dk-note">@RootNote</span>
	}
}

@if (_file is { } file)
{
	<span class="mt-dk-mono mt-dk-muted">@FileLine(file, _fileSize)</span>
	<pre class="mt-dk-box mt-dk-box--nowrap">@file.Text</pre>
}
else if (_entries is { } entries)
{
	<div class="mt-dk-inline-table">
		<ToolTable TItem="RemoteFileEntry"
				   Items="entries"
				   ItemKey="@(entry => entry.Path)"
				   Label="Files"
				   OnRowClick="OpenEntryAsync"
				   EmptyTitle="Empty"
				   EmptyText="Nothing is in this folder.">
			<MokaColumn TItem="RemoteFileEntry" Title="Name" Field="@(entry => entry.Name)" Sortable="false" Mono Class="mt-col-main">
				<CellTemplate Context="entry">
					<span class="mt-dk-file" title="@entry.Name">
						<MokaIcon Icon="@(entry.IsDirectoryLike ? MokatermIcons.Folder : entry.Kind == RemoteEntryKind.SymbolicLink ? MokatermIcons.Symlink : MokatermIcons.File)" Size="MokaSize.Xs" />
						@entry.Name
						@if (entry.LinkTarget is { Length: > 0 } target)
						{
							<span class="mt-dk-dim">@($"\u2192 {target}")</span>
						}
					</span>
				</CellTemplate>
			</MokaColumn>
			<MokaColumn TItem="RemoteFileEntry" Title="Size" Field="@(entry => entry.Size)" Sortable="false" Mono Align="MokaTextAlign.Right">
				<CellTemplate Context="entry">@(entry.IsDirectoryLike ? "" : DisplayFormat.Bytes(entry.Size))</CellTemplate>
			</MokaColumn>
			<MokaColumn TItem="RemoteFileEntry" Title="Modified" Field="@(entry => entry.LastModified)" Sortable="false" Mono Class="mt-col-wide">
				<CellTemplate Context="entry">
					<span class="mt-dk-dim">@DisplayFormat.Timestamp(entry.LastModified)</span>
				</CellTemplate>
			</MokaColumn>
		</ToolTable>
	</div>
}
