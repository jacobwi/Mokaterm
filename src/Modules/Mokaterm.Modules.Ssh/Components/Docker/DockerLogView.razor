@namespace Mokaterm.Modules.Ssh.Components.Docker

@* Column-reverse keeps the scroll at the newest line as lines arrive, without script; the lines inside stay in order. *@
<div class="@(Fill ? "mt-dk-box mt-dk-box--fill mt-dk-logbox" : "mt-dk-box mt-dk-box--tall mt-dk-logbox")" role="log" aria-label="@Label">
	<div class="mt-dk-log">
		@if (Shown.Count == 0)
		{
			<span class="mt-dk-log-line mt-dk-muted">@EmptyText</span>
		}
		@if (Hidden > 0)
		{
			<span class="mt-dk-log-line mt-dk-muted">@HiddenText</span>
		}
		@foreach (DockerLogLine line in Shown)
		{
			<span class="@(line.IsError ? "mt-dk-log-line mt-dk-log-line--error" : "mt-dk-log-line")">@if (line.Source.Length > 0)
				{<span class="@SourceCss(line.Source)">@line.Source</span>}@if (ShowTimestamps && line.Timestamp.Length > 0)
				{<span class="mt-dk-log-time">@ShortTime(line.Timestamp)</span>}@foreach ((string text, bool match) in Pieces(line.Text))
				{
					@if (match)
					{<MokaMark>@text</MokaMark>}
					else
					{@text}
				}</span>
		}
	</div>
</div>
