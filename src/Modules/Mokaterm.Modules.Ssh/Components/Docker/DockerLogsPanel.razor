@namespace Mokaterm.Modules.Ssh.Components.Docker
@inherits DockerManagerPageBase

<div class="mt-dk-panel">
	<LogView Tail="_tail"
			 Label="Container log"
			 EmptyText="@EmptyText"
			 LineChoices="TailChoices"
			 LineCount="_lines"
			 LineCountChanged="OnLinesChangedAsync"
			 Following="_follow"
			 FollowingChanged="OnFollowingChanged"
			 FollowTitle="Fetch new lines every two seconds"
			 OnRefresh="ReloadAsync"
			 RefreshDisabled="IsLoading">
		<Status>@LoadErrorPanel(ReloadAsync)</Status>
	</LogView>
</div>
