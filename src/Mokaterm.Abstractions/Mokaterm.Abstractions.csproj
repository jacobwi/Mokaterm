<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Contracts shared by Core, the UI libraries, protocol modules and hosts.
		Keep this assembly free of UI frameworks and third-party packages: a module author should
		be able to depend on it without pulling anything but Microsoft.Extensions abstractions.
	-->
	<PropertyGroup>
		<TargetFramework>$(MokatermTargetFramework)</TargetFramework>
		<RootNamespace>Mokaterm.Abstractions</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

</Project>
