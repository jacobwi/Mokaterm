<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Contracts shared by Core, the UI libraries, protocol modules and hosts.
		Keep this assembly free of UI frameworks and third-party packages: a module author should
		be able to depend on it without pulling anything but Microsoft.Extensions abstractions.
	-->
	<PropertyGroup>
		<TargetFramework>$(MokatermTargetFramework)</TargetFramework>
		<RootNamespace>Mokaterm.Abstractions</RootNamespace>
	</PropertyGroup>

	<!-- Packed for plugin authors, who compile against it; the host supplies the assembly at run time. -->
	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>Mokaterm.Abstractions</PackageId>
		<Description>Contracts for Mokaterm plugins and modules: protocols, sessions, terminals, file systems, settings and the MokatermPlugin attribute. Plugins compile against it; the Mokaterm host supplies it at run time.</Description>
		<PackageTags>mokaterm;plugin;ssh;terminal</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

</Project>
